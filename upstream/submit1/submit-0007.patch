+/* Growable byte buffer for intermediate substream assemblies. */
+typedef struct {
+    uint8_t *p;
+    size_t n;
+    size_t cap;
+} bytebuf_t;
+
+static int
+bb_reserve(bytebuf_t *b, size_t extra)
+{
+    if (b->n + extra <= b->cap)
+        return 0;
+    size_t cap = b->cap ? b->cap : 64;
+    while (cap < b->n + extra)
+        cap *= 2;
+    uint8_t *p = av_realloc(b->p, cap);
+    if (!p)
+        return -1;
+    b->p = p;
+    b->cap = cap;
+    return 0;
+}
+
+static int
+bb_put(bytebuf_t *b, const uint8_t *d, size_t n)
+{
+    if (bb_reserve(b, n))
+        return -1;
+    memcpy(b->p + b->n, d, n);
+    b->n += n;
+    return 0;
+}
+
+static int
+bb_putc(bytebuf_t *b, uint8_t v, size_t n)
+{
+    if (bb_reserve(b, n))
+        return -1;
+    memset(b->p + b->n, v, n);
+    b->n += n;
+    return 0;
+}
+
+static void
+bb_free(bytebuf_t *b)
+{
+    av_free(b->p);
+    b->p = NULL;
+    b->n = b->cap = 0;
+}
+
+/* Checked put: the BitWriter.fit rule as -1 (never abort). Raw
+ * ac4_bw_put stays for literals that obviously fit. */
+static int
+ck(ac4_bitwriter_t *w, int64_t v, int n)
+{
+    if (v < 0 || (n < 63 && (v >> n) != 0))
+        return -1;
+    ac4_bw_put(w, (uint64_t)v, n);
+    return 0;
+}
+
+/* Copy an aligned writer's bytes into out (outcap checked). */
+static int
+w_extract(ac4_bitwriter_t *w, uint8_t *out, size_t outcap)
+{
+    size_t n = ac4_bw_nbits(w) / 8;
+    if (ac4_bw_nbits(w) % 8 != 0 || n > outcap || n > (size_t)0x7fffffff)
+        return -1;
+    if (ac4_bw_bytes(w, out, outcap) != n)
+        return -1;
+    return (int)n;
+}
+
+/* ---- loudness stamping ---- */
+
+int
+ac4_enc_core_content16(double m, int peak, double f, double target_db)
+{
+    if (isinf(m) && m < 0)
+        m = AC4_ENC_CORE_M_UNGATED_FLOOR;
+    double pdb = 20.0 * log10((peak > 1 ? peak : 1) / 32768.0);
+    int v = ac4_pycompat_round_half_even(
+        160.0 * (target_db - m + pdb) + 49152.0);
+    if (f > 0.1)
+        v += 512;
+    if (v < 0)
+        v = 0;
+    if (v > 0xFFFF)
+        v = 0xFFFF;
+    return v & ~0xF;
+}
+
+int
+ac4_enc_core_content16_f(double m, double peak, double f,
+                     double target_db)
+{
+    double pdb, arg;
+    int v;
+    if (isinf(m) && m < 0)
+        m = AC4_ENC_CORE_M_UNGATED_FLOOR;
+    pdb = 20.0 * log10((peak > 1 ? peak : 1) / 32768.0);
+    arg = 160.0 * (target_db - m + pdb) + 49152.0;
+    v = ac4_pycompat_round_half_even(arg);
+    if (f > 0.1)
+        v += 512;
+    if (v < 0)
+        v = 0;
+    if (v > 0xFFFF)
+        v = 0xFFFF;
+    return v & ~0xF;
+}
+
+int
+ac4_enc_core_tail16(int sparse, double tf)
+{
+    if (!sparse)
+        return tf < 0.75 ? AC4_ENC_CORE_TAIL16_GATED
+                         : AC4_ENC_CORE_TAIL16_DENSE;
+    return tf < 0.3 ? AC4_ENC_CORE_TAIL16_DIRAC : AC4_ENC_CORE_TAIL16_IMPULSE;
+}
+
+int
+ac4_enc_core_compose_sub0(int iframe, int sparse, int stamp,
+                      int content16, const uint8_t *mid23, int pid,
+                      uint8_t *out)
+{
+    if (!out || stamp < 0 || stamp > 255 || pid < 0 || pid > 255)
+        return -1;
+    if (!iframe) {
+        out[0] = (uint8_t)stamp;
+        out[1] = (uint8_t)pid;
+        memcpy(out + 2, AC4_ENC_CORE_P_TAIL + 1, 4);
+        return 6;
+    }
+    if (sparse) {
+        out[0] = (uint8_t)stamp;
+        out[1] = (uint8_t)pid;
+        memcpy(out + 2, AC4_ENC_CORE_I12_MID, 2);
+        out[4] = 0x03;
+        out[5] = 0x00;
+        memcpy(out + 6, AC4_ENC_CORE_I11_TAIL, 5);
+        return 11;
+    }
+    if (content16 < 0 || content16 > 0xFFFF)
+        return -1;
+    if (!mid23)
+        mid23 = AC4_ENC_CORE_I12_MID;
+    out[0] = (uint8_t)stamp;
+    out[1] = (uint8_t)pid;
+    out[2] = mid23[0];
+    out[3] = mid23[1];
+    out[4] = (uint8_t)(content16 >> 8);
+    out[5] = (uint8_t)content16;
+    memcpy(out + 6, AC4_ENC_CORE_I12_TAIL, 6);
+    return 12;
+}
+
+int
+ac4_enc_core_dmx_block17(int loro_c, int loro_s, int ltrt_c,
+                     int ltrt_s, int preferred)
+{
+    int64_t v = 1;
+    v = (v << 3) | loro_c;
+    v = (v << 3) | loro_s;
+    v = (v << 1) | 1;
+    v = (v << 3) | ltrt_c;
+    v = (v << 3) | ltrt_s;
+    v = (v << 1) | 0;
+    v = (v << 2) | preferred;
+    return (int)v;
+}
+
+int
+ac4_enc_core_compose_sub0_51(int stamp, int content16,
+                         const uint8_t *mid23, int pid,
+                         const int *dmx, uint8_t *out)
+{
+    if (!out || stamp < 0 || stamp > 255 || pid < 0 || pid > 255 ||
+        content16 < 0 || content16 > 0xFFFF)
+        return -1;
+    if (!mid23)
+        mid23 = AC4_ENC_CORE_I12_MID;
+    out[0] = (uint8_t)stamp;
+    out[1] = (uint8_t)pid;
+    out[2] = mid23[0];
+    out[3] = mid23[1];
+    out[4] = (uint8_t)(content16 >> 8);
+    out[5] = (uint8_t)content16;
+    memcpy(out + 6, AC4_ENC_CORE_I12_TAIL, 6);
+    memcpy(out + 12, AC4_ENC_CORE_I15_TAIL51, 3);
+    if (dmx) {
+        int b17 = ac4_enc_core_dmx_block17(dmx[0], dmx[1], dmx[2],
+                                       dmx[3], dmx[4]);
+        out[12] = (uint8_t)((b17 >> 9) & 0xFF);
+        out[13] = (uint8_t)((b17 >> 1) & 0xFF);
+        out[14] = (uint8_t)((out[14] & 0x7F) | ((b17 & 1) << 7));
+    }
+    return 15;
+}
+
+int
+ac4_enc_core_preset_id(const char *name)
+{
+    if (!name)
+        return -1;
+    if (!strcmp(name, "manual"))
+        return 0x9c;
+    if (!strcmp(name, "atsc_a85"))
+        return 0x82;
+    if (!strcmp(name, "freetv_op59"))
+        return 0x88;
+    if (!strcmp(name, "arib_b32"))
+        return 0x86;
+    if (!strcmp(name, "ebu_r128"))
+        return 0x84;
+    return -1;
+}
+
+/* ---- channel folds ---- */
+
+static int
+fold_n(const int *lens, int nch)
+{
+    int n = 0;
+    for (int c = 0; c < nch; c++)
+        if (lens[c] > n)
+            n = lens[c];
+    return n;
+}
+
+static double
+fold_at(const double *ch, int len, int i)
+{
+    return i < len ? ch[i] : 0.0;
+}
+
+int
+ac4_enc_core_fold_8ch_to_51(const double *const *chs, const int *lens,
+                        double **out)
+{
+    int n;
+    if (!chs || !lens || !out)
+        return -1;
+    n = fold_n(lens, 8);
+    for (int c = 0; c < 4; c++)
+        for (int i = 0; i < n; i++)
+            out[c][i] = fold_at(chs[c], lens[c], i);
+    for (int i = 0; i < n; i++) {
+        out[4][i] = (fold_at(chs[4], lens[4], i) +
+                     fold_at(chs[6], lens[6], i)) / 2.0;
+        out[5][i] = (fold_at(chs[5], lens[5], i) +
+                     fold_at(chs[7], lens[7], i)) / 2.0;
+    }
+    return n;
+}
+
+int
+ac4_enc_core_mix51_to_stereo(const double *const *chs, const int *lens,
+                         double **out)
+{
+    int n;
+    double g;
+    if (!chs || !lens || !out)
+        return -1;
+    n = fold_n(lens, 6);
+    g = 1.0 / sqrt(2.0);
+    for (int i = 0; i < n; i++) {
+        double gC = g * fold_at(chs[2], lens[2], i);
+        double gLs = g * fold_at(chs[4], lens[4], i);
+        double gRs = g * fold_at(chs[5], lens[5], i);
+        out[0][i] =
+            fold_at(chs[0], lens[0], i) + gC + gLs;
+        out[1][i] =
+            fold_at(chs[1], lens[1], i) + gC + gRs;
+    }
+    return n;
+}
+
+int
+ac4_enc_core_fold_8ch_to_stereo(const double *const *chs,
+                            const int *lens, double **out)
+{
+    const double *folded[6];
+    double *tmp[6];
+    int lens6[6];
+    int n, m;
+    if (!chs || !lens || !out)
+        return -1;
+    n = fold_n(lens, 8);
+    for (int c = 0; c < 6; c++) {
+        tmp[c] = av_malloc((size_t)(n > 0 ? n : 1) * sizeof(double));
+        if (!tmp[c]) {
+            for (int k = 0; k < c; k++)
+                av_free(tmp[k]);
+            return -1;
+        }
+        folded[c] = tmp[c];
+        lens6[c] = n;
+    }
+    m = ac4_enc_core_fold_8ch_to_51(chs, lens, tmp);
+    if (m < 0)
+        m = -1;
+    else
+        m = ac4_enc_core_mix51_to_stereo(folded, lens6, out);
+    for (int c = 0; c < 6; c++)
+        av_free(tmp[c]);
+    return m;
+}
+
+/* ---- TOC / framing ---- */
+
+int
+ac4_enc_core_nframes_for_samples(int nsamples)
+{
+    return (nsamples + AC4_ENC_CORE_FRAME_SAMPLES - 1) /
+        AC4_ENC_CORE_FRAME_SAMPLES + 2;
+}
+
+int
+ac4_enc_core_seq_counter(int i)
+{
+    if (i == 0)
+        return 1019;
+    if (i == 1)
+        return 1020;
+    return ((i - 2) % 1020 + 1020) % 1020 + 1;
+}
+
+int
+ac4_enc_core_b6hi_phase(int i)
+{
+    static const int tab[4] = { 3, 1, 2, 0 };
+    if (i < 2)
+        return 3;
+    return tab[(i - 2) % 4];
+}
+
+/* Parse the iframe interval: NULL/"1sec" -> 0, else decimal step. */
+static int
+parse_interval(const char *interval, long long *step)
+{
+    if (!interval || !strcmp(interval, "1sec"))
+        return 0;
+    if (ac4_pycompat_int(interval, step))
+        return -1;
+    if (*step < 2)
+        return -1;
+    /* FUZZ-CENC crash-2: ac4_pycompat_int saturates huge decimals at
+     * LLONG_MAX, and 1 + LLONG_MAX overflows in the iframe loops
+     * (iframe_set/joint_iframes) and ac4_enc_step_open's if_j init.
+     * Reject exactly the overflowing step (verified boundary:
+     * LLONG_MAX-1 encodes, LLONG_MAX aborts) -- loud -EINVAL. */
+    if (*step >= LLONG_MAX)
+        return -1;
+    return 1;
+}
+
+int
+ac4_enc_core_iframe_set(int nframes, const char *interval,
+                    const int *forced, int nforced, int *out)
+{
+    long long step = 0;
+    int istep, cnt = 0;
+    unsigned char *mark;
+    if (nframes <= 0 || !out)
+        return nframes <= 0 && out ? 0 : -1;
+    istep = parse_interval(interval, &step);
+    if (istep < 0)
+        return -1;
+    mark = av_calloc((size_t)nframes, 1);
+    if (!mark)
+        return -1;
+    mark[0] = 1;
+    if (nframes > 1)
+        mark[1] = 1;
+    if (istep == 0) {
+        for (long long n = 1;; n++) {
+            long long j =
+                1 + (n * AC4_ENC_CORE_SAMPLE_RATE) /
+                    AC4_ENC_CORE_FRAME_SAMPLES;
+            if (j >= nframes)
+                break;
+            mark[j] = 1;
+        }
+    } else {
+        long long j = 1;
+        for (;;) {
+            j += step;
+            if (j >= nframes)
+                break;
+            mark[(size_t)j] = 1;
+        }
+    }
+    if (forced) {
+        for (int k = 0; k < nforced; k++)
+            if (0 <= forced[k] && forced[k] < nframes)
+                mark[forced[k]] = 1;
+    }
+    for (int j = 0; j < nframes; j++)
+        if (mark[j])
+            out[cnt++] = j;
+    av_free(mark);
+    return cnt;
+}
+
+int
+ac4_enc_core_joint_iframes(int nframes, int base, int total,
+                       const char *interval, const int *forced,
+                       int nforced, int *out)
+{
+    long long step = 0;
+    int istep, cnt = 0;
+    unsigned char *mark;
+    if (nframes <= 0 || !out)
+        return nframes <= 0 && out ? 0 : -1;
+    istep = parse_interval(interval, &step);
+    if (istep < 0)
+        return -1;
+    mark = av_calloc((size_t)nframes, 1);
+    if (!mark)
+        return -1;
+    mark[0] = 1;
+    if (istep == 0) {
+        for (long long n = 1;; n++) {
+            long long j =
+                1 + (n * AC4_ENC_CORE_SAMPLE_RATE) /
+                    AC4_ENC_CORE_FRAME_SAMPLES;
+            if (j >= total)
+                break;
+            if (base <= j && j < base + nframes)
+                mark[(size_t)(j - base)] = 1;
+        }
+    } else {
+        long long j = 1;
+        for (;;) {
+            j += step;
+            if (j >= total)
+                break;
+            if (base <= j && j < base + nframes)
+                mark[(size_t)(j - base)] = 1;
+        }
+    }
+    if (forced) {
+        for (int k = 0; k < nforced; k++)
+            if (base <= forced[k] && forced[k] < base + nframes)
+                mark[forced[k] - base] = 1;
+    }
+    for (int j = 0; j < nframes; j++)
+        if (mark[j])
+            out[cnt++] = j;
+    av_free(mark);
+    return cnt;
+}
+
+int
+ac4_enc_core_cbr_raw_sizes(int nframes, int rate_kbps, int *out)
+{
+    long long num, acc;
+    if (nframes < 0 || !out)
+        return -1;
+    num = (long long)rate_kbps * 16;
+    acc = ((-num) % 3 + 3) % 3;
+    for (int i = 0; i < nframes; i++) {
+        long long q;
+        acc += num;
+        q = acc / 3;
+        acc = acc % 3;
+        out[i] = (int)q;
+    }
+    return 0;
+}
+
+int
+ac4_enc_core_emdf_info(ac4_bitwriter_t *w, int preset, int b_si, int si,
+                   int len_pri, int len_sec, const uint8_t *resv,
+                   int nresv)
+{
+    int nresv_expect;
+    if (!w)
+        return -1;
+    if (preset >= 0) {
+        static const int tab[5][5] = {
+            { 0, 0, 0, 0, 0 }, /* none */
+            { 1, 2, 2, 0, 4 }, /* deeI */
+            { 0, 0, 1, 0, 1 }, /* deeP */
+            { 0, 0, 2, 0, 4 }, /* I4 */
+            { 0, 0, 1, 0, 1 }, /* P1 */
+        };
+        if (preset > 4)
+            return -1;
+        b_si = tab[preset][0];
+        si = tab[preset][1];
+        len_pri = tab[preset][2];
+        len_sec = tab[preset][3];
+        nresv_expect = tab[preset][4];
+    } else {
+        if (len_pri < 0 || len_pri > 3 || len_sec < 0 ||
+            len_sec > 3)
+            return -1;
+        nresv_expect = (len_pri ? 1 << (2 * (len_pri - 1)) : 0) +
+            (len_sec ? 1 << (2 * (len_sec - 1)) : 0);
+    }
+    if (nresv != nresv_expect)
+        return -1;
+    if (nresv > 0 && !resv)
+        return -1;
+    ac4_bw_put(w, 0, 2);
+    ac4_bw_put(w, 0, 3);
+    if (ck(w, b_si, 1))
+        return -1;
+    if (b_si && ck(w, si, 2))
+        return -1;
+    if (ck(w, len_pri, 2) || ck(w, len_sec, 2))
+        return -1;
+    for (int k = 0; k < nresv; k++)
+        ac4_bw_put(w, resv[k], 8);
+    return 0;
+}
+
+int
+ac4_enc_core_write_toc(ac4_bitwriter_t *w, int i, int iframe,
+                   const char *layout, int audio_si,
+                   int content_type, int emdf,
+                   const uint8_t *resv, int nresv)
+{
+    const char *cm_bits;
+    int md_compat;
+    if (!w || !layout)
+        return -1;
+    if (!strcmp(layout, "stereo")) {
+        cm_bits = "10";
+        md_compat = 0;
+    } else if (!strcmp(layout, "5.1")) {
+        cm_bits = "1110";
+        md_compat = 1;
+    } else {
+        return -1;
+    }
+    iframe = !!iframe;
+    ac4_bw_put(w, 2, 2);
+    if (ck(w, ac4_enc_core_seq_counter(i), 10))
+        return -1;
+    ac4_bw_put(w, 1, 1);
+    ac4_bw_put(w, 6, 3);
+    ac4_bw_put(w, (unsigned)ac4_enc_core_b6hi_phase(i), 2);
+    ac4_bw_put(w, 1, 1);
+    ac4_bw_put(w, 13, 4);
+    ac4_bw_put(w, (unsigned)iframe, 1);
+    ac4_bw_put(w, 1, 1);
+    ac4_bw_put(w, 1, 1);
+    ac4_bw_put(w, 0, 5);
+    ac4_bw_put(w, 0, 1);
+    ac4_bw_put(w, 1, 1);
+    ac4_bw_putbits(w, "10");
+    ac4_bw_put(w, (unsigned)md_compat, 3);
+    ac4_bw_put(w, 1, 1);
+    ac4_bw_varbits(w, 2, 0);
+    if (ac4_enc_core_emdf_info(w, emdf, 0, 0, 0, 0, resv, nresv))
+        return -1;
+    ac4_bw_put(w, 0, 1);
+    ac4_bw_put(w, 0, 3);
+    ac4_bw_put(w, 0, 1);
+    ac4_bw_put(w, 0, 1);
+    ac4_bw_put(w, 0, 1);
+    ac4_bw_put(w, (unsigned)iframe, 1);
+    ac4_bw_put(w, 0, 2);
+    ac4_bw_put(w, 1, 1);
+    ac4_bw_put(w, 0, 1);
+    ac4_bw_put(w, 1, 1);
+    ac4_bw_put(w, 1, 1);
+    ac4_bw_putbits(w, cm_bits);
+    ac4_bw_put(w, 0, 1);
+    ac4_bw_put(w, 0, 1);
+    ac4_bw_put(w, (unsigned)iframe, 1);
+    if (ck(w, audio_si, 2))
+        return -1;
+    if (content_type) {
+        ac4_bw_put(w, 1, 1);
+        ac4_bw_put(w, 0, 3);
+        ac4_bw_put(w, 0, 1);
+    } else {
+        ac4_bw_put(w, 0, 1);
+    }
+    return 0;
+}
+
+int
+ac4_enc_core_finish_toc(ac4_bitwriter_t *w, const int *sizes, int nsizes)
+{
+    if (!w || !sizes || nsizes < 1 || nsizes > 3)
+        return -1;
+    if (ck(w, nsizes, 2))
+        return -1;
+    if (nsizes == 1)
+        ac4_bw_put(w, 1, 1);
+    for (int k = 0; k < nsizes; k++) {
+        int s = sizes[k];
+        if (s < 0)
+            return -1;
+        if (s < 1024) {
+            ac4_bw_put(w, 0, 1);
+            if (ck(w, s, 10))
+                return -1;
+        } else {
+            ac4_bw_put(w, 1, 1);
+            ac4_bw_put(w, (unsigned)(s % 1024), 10);
+            ac4_bw_varbits_long(w, 2, (uint64_t)(s / 1024));
+        }
+    }
+    ac4_bw_align(w, 0);
+    return 0;
+}
+
+/* ---- sf_info / silence legs ---- */
+
+static void
+sf_info_fullband(ac4_bitwriter_t *w)
+{
+    ac4_bw_put(w, 1, 1);
+    ac4_bw_put(w, AC4_ENC_CORE_MAX_SFB_FULL, 6);
+}
+
+typedef struct {
+    const int *offs;
+    int msfb;
+    int sect_bits;
+} mix_geo_t;
+
+static int
+mixed_group_geo(int orient, mix_geo_t *geo)
+{
+    const int *o1024 = ac4_sfb_offsets48(1024);
+    const int *o128 = ac4_sfb_offsets48(128);
+    if (!o1024 || !o128)
+        return -1;
+    if (orient == AC4_ENC_CORE_ORIENT_1024_FIRST) {
+        geo[0].offs = o1024;
+        geo[0].msfb = AC4_ENC_CORE_MSFB_MIX_1024;
+        geo[0].sect_bits = 5;
+        for (int k = 1; k < 9; k++) {
+            geo[k].offs = o128;
+            geo[k].msfb = AC4_ENC_CORE_MSFB_MIX_128;
+            geo[k].sect_bits = 3;
+        }
+        return 0;
+    }
+    if (orient == AC4_ENC_CORE_ORIENT_128_FIRST) {
+        for (int k = 0; k < 8; k++) {
+            geo[k].offs = o128;
+            geo[k].msfb = AC4_ENC_CORE_MSFB_MIX_128;
+            geo[k].sect_bits = 3;
+        }
+        geo[8].offs = o1024;
+        geo[8].msfb = AC4_ENC_CORE_MSFB_MIX_1024;
+        geo[8].sect_bits = 5;
+        return 0;
+    }
+    return -1;
+}
+
+static int
+sf_info_mixed(ac4_bitwriter_t *w, int orient)
+{
+    if (orient != AC4_ENC_CORE_ORIENT_1024_FIRST &&
+        orient != AC4_ENC_CORE_ORIENT_128_FIRST)
+        return -1;
+    ac4_bw_put(w, 0, 1);
+    if (orient == AC4_ENC_CORE_ORIENT_1024_FIRST) {
+        ac4_bw_put(w, AC4_ENC_CORE_TL_1024, 2);
+        ac4_bw_put(w, AC4_ENC_CORE_TL_128, 2);
+        ac4_bw_put(w, AC4_ENC_CORE_MSFB_MIX_1024, 6);
+        ac4_bw_put(w, AC4_ENC_CORE_MSFB_MIX_128, 4);
+    } else {
+        ac4_bw_put(w, AC4_ENC_CORE_TL_128, 2);
+        ac4_bw_put(w, AC4_ENC_CORE_TL_1024, 2);
+        ac4_bw_put(w, AC4_ENC_CORE_MSFB_MIX_128, 4);
+        ac4_bw_put(w, AC4_ENC_CORE_MSFB_MIX_1024, 6);
+    }
+    ac4_bw_put(w, AC4_ENC_CORE_MIX_GROUPING, 7);
+    return 0;
+}
+
+static void
+sf_data_silence(ac4_bitwriter_t *w, int max_sfb)
+{
+    int remaining;
+    ac4_bw_put(w, 0, 4);
+    remaining = max_sfb - 1;
+    while (remaining >= 31) {
+        ac4_bw_put(w, 31, 5);
+        remaining -= 31;
+    }
+    ac4_bw_put(w, (unsigned)remaining, 5);
+    ac4_bw_put(w, 0, 8);
+    ac4_bw_put(w, 0, 1);
+}
+
+static void
+mono_data(ac4_bitwriter_t *w, int lfe)
+{
+    if (lfe) {
+        ac4_bw_put(w, AC4_ENC_CORE_MAX_SFB_LFE, 3);
+        sf_data_silence(w, AC4_ENC_CORE_MAX_SFB_LFE);
+    } else {
+        ac4_bw_put(w, 0, 1);
+        sf_info_fullband(w);
+        sf_data_silence(w, AC4_ENC_CORE_MAX_SFB_FULL);
+    }
+}
+
+static void
+stereo_data(ac4_bitwriter_t *w)
+{
+    ac4_bw_put(w, 0, 1);
+    ac4_bw_put(w, 0, 1);
+    sf_info_fullband(w);
+    ac4_bw_put(w, 0, 1);
+    sf_info_fullband(w);
+    sf_data_silence(w, AC4_ENC_CORE_MAX_SFB_FULL);
+    sf_data_silence(w, AC4_ENC_CORE_MAX_SFB_FULL);
+}
+
+static void
+two_channel_data(ac4_bitwriter_t *w)
+{
+    ac4_bw_put(w, 0, 1);
+    sf_info_fullband(w);
+    sf_info_fullband(w);
+    sf_data_silence(w, AC4_ENC_CORE_MAX_SFB_FULL);
+    sf_data_silence(w, AC4_ENC_CORE_MAX_SFB_FULL);
+}
+
+/* Validate one LONG leg for ac4_asf_write_sf_data (never abort into
+ * the dep's asserts): line/q ranges, ref range, v2 chain rule. */
+static int
+leg_sf_ok(const int *lines, const int *qs, int n, int ref,
+          int max_sfb, const int *refs, int *has_refs_out,
+          const int *offs)
+{
+    int has = 0;
+    int qb[64];
+    int nqb = 0;
+    if (n < 0 || ref < 0 || ref > 255 || max_sfb < 1 ||
+        max_sfb > 63 || !offs)
+        return -1;
+    if (n > 0 && (!lines || !qs))
+        return -1;
+    for (int k = 0; k < n; k++) {
+        int q = qs[k] < 0 ? -qs[k] : qs[k];
+        if (lines[k] < 0 || lines[k] >= offs[max_sfb] || q < 1 ||
+            q > AC4_ASF_MAX_Q)
+            return -1;
+    }
+    if (refs) {
+        for (int b = 0; b < max_sfb; b++) {
+            if (refs[b] < -1 || refs[b] > 255)
+                return -1;
+            if (refs[b] >= 0)
+                has = 1;
+        }
+    }
+    if (n == 0 && has)
+        return -1; /* Python IndexError-class (refs[qb[0]]) */
+    if (n > 0 && has) {
+        for (int k = 0; k < n; k++) {
+            int b = ac4_asf_band_of(lines[k], offs, max_sfb);
+            int seen = 0;
+            if (b < 0)
+                return -1;
+            for (int j = 0; j < nqb; j++)
+                if (qb[j] == b)
+                    seen = 1;
+            if (!seen)
+                qb[nqb++] = b;
+        }
+        /* ascending (insertion; nqb <= 63) */
+        for (int k = 1; k < nqb; k++) {
+            int t = qb[k], j = k - 1;
+            while (j >= 0 && qb[j] > t) {
+                qb[j + 1] = qb[j];
+                j--;
+            }
+            qb[j + 1] = t;
+        }
+        for (int k = 0; k < nqb; k++)
+            if (refs[qb[k]] < 0)
+                return -1;
+        if (refs[qb[0]] != ref)
+            return -1;
+        for (int k = 1; k < nqb; k++) {
+            int step = refs[qb[k]] - refs[qb[k - 1]];
+            if (step < -60 || step > 60)
+                return -1;
+        }
+    }
+    if (has_refs_out)
+        *has_refs_out = has;
+    return 0;
+}
+
+static int
+leg_write(ac4_bitwriter_t *w, const ac4_enc_core_leg_t *leg, int max_sfb)
+{
+    const int *offs = ac4_sfb_offsets48(2048);
+    int has = 0;
+    if (!leg || !offs)
+        return -1;
+    if (leg_sf_ok(leg->lines, leg->qs, leg->n, leg->ref,
+                  max_sfb, leg->refs, &has, offs))
+        return -1;
+    ac4_asf_write_sf_data(w, leg->lines, leg->qs, leg->n, leg->ref,
+                      max_sfb, has ? leg->refs : NULL, has,
+                      offs, 5);
+    return 0;
+}
+
+/* Validate one mixed group for ac4_asf_write_mixed_leg. */
+static int
+mgroup_ok(const ac4_enc_core_mgroup_t *g, const mix_geo_t *geo)
+{
+    for (int k = 0; k < g->n; k++) {
+        int q = g->qs[k] < 0 ? -g->qs[k] : g->qs[k];
+        if (g->lines[k] < 0 ||
+            g->lines[k] >= geo->offs[geo->msfb] || q < 1 ||
+            q > AC4_ASF_MAX_Q)
+            return -1;
+    }
+    for (int b = 0; b < 63; b++)
+        if (g->refs[b] < -1 || g->refs[b] > 255)
+            return -1;
+    return 0;
+}
+
+/* Full mixed-leg chain rule (first ref + 60-step DPCM). */
+static int
+mixed_chain_ok(const ac4_enc_core_mixed_leg_t *leg,
+               const mix_geo_t *geo, int ref)
+{
+    int first = 1;
+    int prev = 0;
+    for (int gi = 0; gi < 9; gi++) {
+        int qb[64];
+        int nqb = 0;
+        for (int k = 0; k < leg->g[gi].n; k++) {
+            int b = ac4_asf_band_of(leg->g[gi].lines[k],
+                                geo[gi].offs, geo[gi].msfb);
+            int seen = 0;
+            if (b < 0)
+                return -1;
+            for (int j = 0; j < nqb; j++)
+                if (qb[j] == b)
+                    seen = 1;
+            if (!seen)
+                qb[nqb++] = b;
+        }
+        for (int k = 1; k < nqb; k++) {
+            int t = qb[k], j = k - 1;
+            while (j >= 0 && qb[j] > t) {
+                qb[j + 1] = qb[j];
+                j--;
+            }
+            qb[j + 1] = t;
+        }
+        for (int k = 0; k < nqb; k++) {
+            int r = leg->g[gi].refs[qb[k]];
+            if (r < 0 || r > 255)
+                return -1;
+            if (first) {
+                if (r != ref)
+                    return -1;
+                first = 0;
+            } else if (r - prev < -60 || r - prev > 60) {
+                return -1;
+            }
+            prev = r;
+        }
+    }
+    return 0;
+}
+
+static int
+mixed_write(ac4_bitwriter_t *w, const ac4_enc_core_mixed_leg_t *leg,
+            int ref, int orient)
+{
+    mix_geo_t geo[9];
+    ac4_asf_group_t groups[9];
+    if (!leg || ref < 0 || ref > 255)
+        return -1;
+    if (mixed_group_geo(orient, geo))
+        return -1;
+    for (int gi = 0; gi < 9; gi++)
+        if (mgroup_ok(&leg->g[gi], &geo[gi]))
+            return -1;
+    if (mixed_chain_ok(leg, geo, ref))
+        return -1;
+    for (int gi = 0; gi < 9; gi++) {
+        groups[gi].lines = leg->g[gi].lines;
+        groups[gi].wins = NULL;
+        groups[gi].qs = leg->g[gi].qs;
+        groups[gi].n = leg->g[gi].n;
+        groups[gi].offs = geo[gi].offs;
+        groups[gi].max_sfb = geo[gi].msfb;
+        groups[gi].sect_bits = geo[gi].sect_bits;
+        groups[gi].nwins = 1;
+        groups[gi].refs_by_band = leg->g[gi].refs;
+    }
+    ac4_asf_write_mixed_leg(w, groups, 9, ref);
+    return 0;
+}
+
+static int
+audio_51_w(ac4_bitwriter_t *w, const ac4_enc_core_leg_t *lfe,
+           const ac4_enc_core_leg_t *l, const ac4_enc_core_leg_t *r,
+           const ac4_enc_core_leg_t *ls, const ac4_enc_core_leg_t *rs,
+           const ac4_enc_core_leg_t *c)
+{
+    const ac4_enc_core_leg_t *pairs[4] = { l, r, ls, rs };
+    if (!w || !lfe || !l || !r || !ls || !rs || !c)
+        return -1;
+    ac4_bw_put(w, 0, 3);
+    ac4_bw_put(w, AC4_ENC_CORE_MAX_SFB_LFE, 3);
+    if (leg_write(w, lfe, AC4_ENC_CORE_MAX_SFB_LFE))
+        return -1;
+    ac4_bw_put(w, 0, 2);
+    ac4_bw_put(w, 0, 1);
+    for (int p = 0; p < 4; p += 2) {
+        ac4_bw_put(w, 0, 1);
+        sf_info_fullband(w);
+        sf_info_fullband(w);
+        if (leg_write(w, pairs[p], AC4_ENC_CORE_MAX_SFB_FULL))
+            return -1;
+        if (leg_write(w, pairs[p + 1], AC4_ENC_CORE_MAX_SFB_FULL))
+            return -1;
+    }
+    ac4_bw_put(w, 0, 1);
+    sf_info_fullband(w);
+    if (leg_write(w, c, AC4_ENC_CORE_MAX_SFB_FULL))
+        return -1;
+    ac4_bw_align(w, 0);
+    return 0;
+}
+
+int
+ac4_enc_core_write_audio_51(const ac4_enc_core_leg_t *lfe,
+                        const ac4_enc_core_leg_t *l,
+                        const ac4_enc_core_leg_t *r,
+                        const ac4_enc_core_leg_t *ls,
+                        const ac4_enc_core_leg_t *rs,
+                        const ac4_enc_core_leg_t *c, uint8_t *out,
+                        size_t outcap)
+{
+    ac4_bitwriter_t w;
+    int n;
+    if (!out)
+        return -1;
+    ac4_bw_init(&w);
+    n = audio_51_w(&w, lfe, l, r, ls, rs, c);
+    if (n == 0)
+        n = w_extract(&w, out, outcap);
+    else
+        n = -1;
+    ac4_bw_free(&w);
+    return n;
+}
+
+static int
+audio_51_mixed_w(ac4_bitwriter_t *w, const ac4_enc_core_leg_t *lfe,
+                 const ac4_enc_core_mixed_leg_t *l, int refL,
+                 const ac4_enc_core_mixed_leg_t *r, int refR,
+                 const ac4_enc_core_mixed_leg_t *ls, int refLs,
+                 const ac4_enc_core_mixed_leg_t *rs, int refRs,
+                 const ac4_enc_core_mixed_leg_t *c, int refC,
+                 int orient)
+{
+    if (!w || !lfe || !l || !r || !ls || !rs || !c)
+        return -1;
+    if (orient != AC4_ENC_CORE_ORIENT_1024_FIRST &&
+        orient != AC4_ENC_CORE_ORIENT_128_FIRST)
+        return -1;
+    ac4_bw_put(w, 0, 3);
+    ac4_bw_put(w, AC4_ENC_CORE_MAX_SFB_LFE, 3);
+    if (leg_write(w, lfe, AC4_ENC_CORE_MAX_SFB_LFE))
+        return -1;
+    ac4_bw_put(w, 0, 2);
+    ac4_bw_put(w, 0, 1);
+    {
+        const ac4_enc_core_mixed_leg_t *legs[4] = { l, r, ls, rs };
+        int refs[4] = { refL, refR, refLs, refRs };
+        for (int p = 0; p < 4; p += 2) {
+            ac4_bw_put(w, 0, 1);
+            if (sf_info_mixed(w, orient))
+                return -1;
+            if (sf_info_mixed(w, orient))
+                return -1;
+            if (mixed_write(w, legs[p], refs[p], orient))
+                return -1;
+            if (mixed_write(w, legs[p + 1], refs[p + 1],
+                            orient))
+                return -1;
+        }
+    }
+    ac4_bw_put(w, 0, 1);
+    if (sf_info_mixed(w, orient))
+        return -1;
+    if (mixed_write(w, c, refC, orient))
+        return -1;
+    ac4_bw_align(w, 0);
+    return 0;
+}
+
+int
+ac4_enc_core_write_audio_51_mixed(const ac4_enc_core_leg_t *lfe,
+                              const ac4_enc_core_mixed_leg_t *l,
+                              int refL,
+                              const ac4_enc_core_mixed_leg_t *r,
+                              int refR,
+                              const ac4_enc_core_mixed_leg_t *ls,
+                              int refLs,
+                              const ac4_enc_core_mixed_leg_t *rs,
+                              int refRs,
+                              const ac4_enc_core_mixed_leg_t *c,
+                              int refC, int orient, uint8_t *out,
+                              size_t outcap)
+{
+    ac4_bitwriter_t w;
+    int n;
+    if (!out)
+        return -1;
+    ac4_bw_init(&w);
+    n = audio_51_mixed_w(&w, lfe, l, refL, r, refR, ls, refLs,
+                         rs, refRs, c, refC, orient);
+    if (n == 0)
+        n = w_extract(&w, out, outcap);
+    else
+        n = -1;
+    ac4_bw_free(&w);
+    return n;
+}
+
+static int
+audio_data_w(ac4_bitwriter_t *w, const char *layout)
+{
+    if (!w || !layout)
+        return -1;
+    if (!strcmp(layout, "stereo")) {
+        ac4_bw_put(w, 0, 2);
+        stereo_data(w);
+    } else if (!strcmp(layout, "5.1")) {
+        ac4_bw_put(w, 0, 3);
+        mono_data(w, 1);
+        ac4_bw_put(w, 0, 2);
+        ac4_bw_put(w, 0, 1);
+        two_channel_data(w);
+        two_channel_data(w);
+        mono_data(w, 0);
+    } else {
+        return -1;
+    }
+    ac4_bw_align(w, 0);
+    return 0;
+}
