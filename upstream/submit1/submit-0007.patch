+
+/* ac4_bits.c: MSB-first bit writer + CRC-16. See ac4_bits.h. */
+#include "ac4_bits.h"
+#include "libavutil/mem.h"
+
+#include <assert.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define CRC_POLY 0x8005u
+
+
+uint16_t
+ac4_crc16(const uint8_t *data, size_t len)
+{
+    uint32_t crc = 0;
+    for (size_t i = 0; i < len; i++) {
+        crc ^= (uint32_t)data[i] << 8;
+        for (int k = 0; k < 8; k++) {
+            if (crc & 0x8000u)
+                crc = ((crc << 1) ^ CRC_POLY) & 0xFFFFu;
+            else
+                crc = (crc << 1) & 0xFFFFu;
+        }
+    }
+    return (uint16_t)crc;
+}
+
+
+void
+ac4_bw_init(ac4_bitwriter_t *w)
+{
+    w->buf = NULL;
+    w->nbits = 0;
+    w->cap_bits = 0;
+}
+
+
+void
+ac4_bw_free(ac4_bitwriter_t *w)
+{
+    av_free(w->buf);
+    w->buf = NULL;
+    w->nbits = 0;
+    w->cap_bits = 0;
+}
+
+
+static void
+ac4_bw_reserve(ac4_bitwriter_t *w, size_t extra)
+{
+    size_t need = w->nbits + extra;
+    if (need <= w->cap_bits)
+        return;
+    size_t cap = w->cap_bits ? w->cap_bits : 64;
+    while (cap < need)
+        cap *= 2;
+    uint8_t *nb = av_realloc(w->buf, (cap + 7) / 8);
+    assert(nb != NULL);
+    memset(nb + (w->cap_bits + 7) / 8, 0,
+           (cap + 7) / 8 - (w->cap_bits + 7) / 8);
+    w->buf = nb;
+    w->cap_bits = cap;
+}
+
+
+static void
+ac4_bw_push_bit(ac4_bitwriter_t *w, int bit)
+{
+    ac4_bw_reserve(w, 1);
+    if (bit)
+        w->buf[w->nbits / 8] |= (uint8_t)(0x80u >> (w->nbits % 8));
+    w->nbits++;
+}
+
+
+void
+ac4_bw_put(ac4_bitwriter_t *w, uint64_t value, int nbits)
+{
+    assert(nbits >= 0 && nbits <= 64);
+    assert(nbits == 0 ? value == 0
+                      : nbits == 64 || (value >> nbits) == 0);
+    for (int i = nbits - 1; i >= 0; i--)
+        ac4_bw_push_bit(w, (int)((value >> i) & 1u));
+}
+
+
+void
+ac4_bw_putbits(ac4_bitwriter_t *w, const char *bits)
+{
+    for (const char *p = bits; *p; p++) {
+        assert(*p == '0' || *p == '1');
+        ac4_bw_push_bit(w, *p - '0');
+    }
+}
+
+
+int
+ac4_bw_align(ac4_bitwriter_t *w, int fill)
+{
+    int pad = (int)((8 - w->nbits % 8) % 8);
+    for (int i = 0; i < pad; i++)
+        ac4_bw_push_bit(w, fill);
+    return pad;
+}
+
+
+void
+ac4_bw_varbits(ac4_bitwriter_t *w, int nbits, uint64_t value)
+{
+    assert(nbits > 0 && nbits < 64 && (value >> nbits) == 0);
+    ac4_bw_put(w, value, nbits);
+    ac4_bw_put(w, 0, 1);
+}
+
+
+void
+ac4_bw_varbits_long(ac4_bitwriter_t *w, int nbits, uint64_t value)
+{
+    uint64_t base = 1u << nbits;
+    uint64_t off = 0, span = base;
+    int groups = 1;
+    while (value >= off + span) {
+        off += span;
+        span *= base;
+        groups++;
+    }
+    uint64_t rem = value - off;
+    for (int j = 0; j < groups; j++) {
+        int shift = nbits * (groups - 1 - j);
+        ac4_bw_put(w, (rem >> shift) & (base - 1), nbits);
+        ac4_bw_put(w, j < groups - 1 ? 1u : 0u, 1);
+    }
+}
+
+
+size_t
+ac4_bw_nbits(const ac4_bitwriter_t *w)
+{
+    return w->nbits;
+}
+
+
+size_t
+ac4_bw_bytes(const ac4_bitwriter_t *w, uint8_t *out, size_t outcap)
+{
+    if (w->nbits % 8 != 0)
+        return 0;
+    if (outcap < w->nbits / 8)
+        return 0;
+    memcpy(out, w->buf, w->nbits / 8);
+    return w->nbits / 8;
+}
diff --git a/libavcodec/ac4_bits.h b/libavcodec/ac4_bits.h
new file mode 100644
index 0000000000..9c9d2d4700
--- /dev/null
+++ b/libavcodec/ac4_bits.h
@@ -0,0 +1,70 @@
+/*
+ * MSB-first bit writer and CRC-16
+ * Copyright (c) 2026 Michael Rowlinson
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+/* ac4_bits.h: MSB-first bit writer + CRC-16 for the clean AC-4 encoder.
+ *
+ * Byte-identical contract: the same op sequence produces the
+ * same bit stream as the reference BitWriter; see
+ * tests/test_bits_parity.py. C11, zero deps.
+ */
+#ifndef AC4_BITS_H
+#define AC4_BITS_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+typedef struct {
+    uint8_t *buf;     /* packed bits, MSB-first within each byte */
+    size_t nbits;     /* live bit count */
+    size_t cap_bits;  /* allocated capacity in bits */
+} ac4_bitwriter_t;
+
+void ac4_bw_init(ac4_bitwriter_t *w);
+void ac4_bw_free(ac4_bitwriter_t *w);
+
+/* Append the low nbits of value, most-significant bit first. */
+void ac4_bw_put(ac4_bitwriter_t *w, uint64_t value, int nbits);
+
+/* Append a "0101..." string. */
+void ac4_bw_putbits(ac4_bitwriter_t *w, const char *bits);
+
+/* Pad with fill bits to the next byte; returns the pad count. */
+int ac4_bw_align(ac4_bitwriter_t *w, int fill);
+
+/* variable_bits() writer, single group + stop bit. */
+void ac4_bw_varbits(ac4_bitwriter_t *w, int nbits, uint64_t value);
+
+/* variable_bits() writer, any value (multi-group + stop). */
+void ac4_bw_varbits_long(ac4_bitwriter_t *w, int nbits, uint64_t value);
+
+size_t ac4_bw_nbits(const ac4_bitwriter_t *w);
+
+/*
+ * Pack whole bytes MSB-first into out (outcap bytes). Returns the
+ * byte count, or 0 when the writer is not byte-aligned or outcap
+ * is short (mirrors bytes()' assert on alignment).
+ */
+size_t ac4_bw_bytes(const ac4_bitwriter_t *w, uint8_t *out, size_t outcap);
+
+/* CRC-16: poly 0x8005, init 0, no reflect, no xorout. */
+uint16_t ac4_crc16(const uint8_t *data, size_t len);
+
+#endif
diff --git a/libavcodec/ac4_enc_acpl.c b/libavcodec/ac4_enc_acpl.c
new file mode 100644
index 0000000000..7f9fb7e23c
--- /dev/null
+++ b/libavcodec/ac4_enc_acpl.c
@@ -0,0 +1,89 @@
+/*
+ * Encoder-side A-CPL param writer
+ * Copyright (c) 2026 Michael Rowlinson
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include "ac4_enc_acpl.h"
+
+#include "ac4_huffman_tab.h"
+
+const ac4_enc_acpl_books_t AC4_ENC_ACPL_FINE_BOOKS = {
+    {AC4_ACPL_HCB_ALPHA_FINE_F0_CW, AC4_ACPL_HCB_ALPHA_FINE_F0_LEN, 33, 0},
+    {AC4_ACPL_HCB_ALPHA_FINE_DF_CW, AC4_ACPL_HCB_ALPHA_FINE_DF_LEN, 65, 32},
+    {AC4_ACPL_HCB_BETA_FINE_F0_CW, AC4_ACPL_HCB_BETA_FINE_F0_LEN, 9, 0},
+    {AC4_ACPL_HCB_BETA_FINE_DF_CW, AC4_ACPL_HCB_BETA_FINE_DF_LEN, 17, 8},
+};
+
+int ac4_enc_acpl_write_param(ac4_bitwriter_t *w, int f0, const int *dfs,
+                         int ndfs, const ac4_enc_acpl_book_t *f0book,
+                         const ac4_enc_acpl_book_t *dfbook, int diff_t) {
+    if (diff_t < 0 || diff_t > 1)
+        return -1;
+    if (f0 < 0 || f0 >= f0book->entries)
+        return -1;
+    ac4_bw_put(w, (unsigned)diff_t, 1);
+    ac4_bw_put(w, f0book->cw[f0], f0book->ln[f0]);
+    for (int i = 0; i < ndfs; i++) {
+        int sym = dfs[i] + dfbook->off;
+        if (sym < 0 || sym >= dfbook->entries)
+            return -1;
+        ac4_bw_put(w, dfbook->cw[sym], dfbook->ln[sym]);
+    }
+    return 0;
+}
+
+int ac4_enc_acpl_write_1ch(ac4_bitwriter_t *w, int interp, int alpha_f0,
+                       const int *alpha_dfs, int nalpha, int beta_f0,
+                       const int *beta_dfs, int nbeta,
+                       const ac4_enc_acpl_books_t *books, int has_slot,
+                       int slot_val, int nps, int beta_first) {
+    const int *f0s[2];
+    const int *dfss[2];
+    int ndfs[2];
+    const ac4_enc_acpl_book_t *f0b[2], *dfb[2];
+    int ia = beta_first ? 1 : 0;
+
+    if (interp < 0 || interp > 1)
+        return -1;
+    if (nps != 0)
+        return -1;
+    if (has_slot && (slot_val < 0 || slot_val > 31))
+        return -1;
+    ac4_bw_put(w, (unsigned)interp, 1);
+    ac4_bw_put(w, 0u, 1);
+    if (has_slot)
+        ac4_bw_put(w, (unsigned)slot_val, 5);
+    f0s[ia] = &alpha_f0;
+    dfss[ia] = alpha_dfs;
+    ndfs[ia] = nalpha;
+    f0b[ia] = &books->alpha_f0;
+    dfb[ia] = &books->alpha_df;
+    f0s[1 - ia] = &beta_f0;
+    dfss[1 - ia] = beta_dfs;
+    ndfs[1 - ia] = nbeta;
+    f0b[1 - ia] = &books->beta_f0;
+    dfb[1 - ia] = &books->beta_df;
+    for (int i = 0; i < 2; i++) {
+        int rc = ac4_enc_acpl_write_param(w, *f0s[i], dfss[i], ndfs[i],
+                                      f0b[i], dfb[i], 0);
+        if (rc)
+            return rc;
+    }
+    return 0;
+}
diff --git a/libavcodec/ac4_enc_acpl.h b/libavcodec/ac4_enc_acpl.h
new file mode 100644
index 0000000000..950f001c33
--- /dev/null
+++ b/libavcodec/ac4_enc_acpl.h
@@ -0,0 +1,66 @@
+/*
+ * Encoder-side A-CPL param writer
+ * Copyright (c) 2026 Michael Rowlinson
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#ifndef AC4_ENC_ACPL_H
+#define AC4_ENC_ACPL_H
+
+/* Encoder-side A-CPL (AISP) param writer.
+ * (Decoder-side parse/synth lives in acpl.[ch]; separate module.)
+ * Framing per A-59 Sec. 4: interp 1b + nps 1b + slot 5b iff present,
+ * then ALPHA/BETA runs in wire order (alpha first, or beta first
+ * when beta_first). Each run: diffT 1b + F0 u(HC) + DFs s_var(HC).
+ */
+#include <stddef.h>
+
+#include "ac4_bits.h"
+
+typedef struct {
+    const unsigned *cw;
+    const unsigned char *ln;
+    int entries;
+    int off;
+} ac4_enc_acpl_book_t;
+
+typedef struct {
+    ac4_enc_acpl_book_t alpha_f0;
+    ac4_enc_acpl_book_t alpha_df;
+    ac4_enc_acpl_book_t beta_f0;
+    ac4_enc_acpl_book_t beta_df;
+} ac4_enc_acpl_books_t;
+
+extern const ac4_enc_acpl_books_t AC4_ENC_ACPL_FINE_BOOKS;
+
+/* One ALPHA/BETA param run: diffT 1b + F0 + DFs. Returns 0 on
+ * success, -1 on out-of-range symbol or bad diff_t. */
+int ac4_enc_acpl_write_param(ac4_bitwriter_t *w, int f0, const int *dfs,
+                         int ndfs, const ac4_enc_acpl_book_t *f0book,
+                         const ac4_enc_acpl_book_t *dfbook, int diff_t);
+
+/* One-channel block (steady single-set, nps must be 0). has_slot /
+ * slot_val: optional 5b slot. beta_first: beta run before alpha.
+ * Returns 0 on success, -1 on out-of-range symbol or bad shape. */
+int ac4_enc_acpl_write_1ch(ac4_bitwriter_t *w, int interp, int alpha_f0,
+                       const int *alpha_dfs, int nalpha, int beta_f0,
+                       const int *beta_dfs, int nbeta,
+                       const ac4_enc_acpl_books_t *books, int has_slot,
+                       int slot_val, int nps, int beta_first);
+
+#endif
diff --git a/libavcodec/ac4_enc_aspx.c b/libavcodec/ac4_enc_aspx.c
new file mode 100644
index 0000000000..5b99fe150b
--- /dev/null
+++ b/libavcodec/ac4_enc_aspx.c
@@ -0,0 +1,368 @@
+/*
+ * Encoder-side ASPX tail emitters
+ * Copyright (c) 2026 Michael Rowlinson
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include "ac4_enc_aspx.h"
+#include "libavutil/mem.h"
+
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "ac4_pycompat.h"
+
+#define ENC_ASPX_NBOOKS 18
+
+static int is_bit(int v) {
+    return v == 0 || v == 1;
+}
+
+int ac4_enc_aspx_write_2ch_head(ac4_bitwriter_t *w,
+                            const ac4_enc_aspx_2ch_head_t *h) {
+    int i;
+
+    if (!is_bit(h->int_class0) || !is_bit(h->tmp_num_env0) ||
+        !is_bit(h->balance) || !is_bit(h->fic) || !is_bit(h->tic) ||
+        !is_bit(h->ah_left) || !is_bit(h->ah_right))
+        return -1;
+    if (h->balance == 0 &&
+        (!is_bit(h->int_class1) || !is_bit(h->tmp_num_env1)))
+        return -1;
+    for (i = 0; i < 4; i++) {
+        if (!is_bit(h->delta_dir[i]))
+            return -1;
+    }
+    for (i = 0; i < 3; i++) {
+        if (h->tna0[i] < 0 || h->tna0[i] > 3 ||
+            h->tna1[i] < 0 || h->tna1[i] > 3)
+            return -1;
+    }
+    if (h->ah_left && (h->add_harm0 < 0 || h->add_harm0 >= (1 << 12)))
+        return -1;
+    if (h->ah_right &&
+        (h->add_harm1 < 0 || h->add_harm1 >= (1 << 12)))
+        return -1;
+    if (h->has_xover && (h->xover < 0 || h->xover > 7))
+        return -1;
+    if (h->has_xover)
+        ac4_bw_put(w, (unsigned)h->xover, 3);
+    ac4_bw_put(w, (unsigned)h->int_class0, 1);
+    ac4_bw_put(w, (unsigned)h->tmp_num_env0, 1);
+    ac4_bw_put(w, (unsigned)h->balance, 1);
+    if (h->balance == 0) {
+        ac4_bw_put(w, (unsigned)h->int_class1, 1);
+        ac4_bw_put(w, (unsigned)h->tmp_num_env1, 1);
+    }
+    for (i = 0; i < 4; i++)
+        ac4_bw_put(w, (unsigned)h->delta_dir[i], 1);
+    for (i = 0; i < 3; i++) {
+        ac4_bw_put(w, (unsigned)h->tna0[i], 2);
+    }
+    for (i = 0; i < 3; i++) {
+        ac4_bw_put(w, (unsigned)h->tna1[i], 2);
+    }
+    ac4_bw_put(w, (unsigned)h->ah_left, 1);
+    if (h->ah_left)
+        ac4_bw_put(w, (unsigned)h->add_harm0, 12);
+    ac4_bw_put(w, (unsigned)h->ah_right, 1);
+    if (h->ah_right)
+        ac4_bw_put(w, (unsigned)h->add_harm1, 12);
+    ac4_bw_put(w, (unsigned)h->fic, 1);
+    ac4_bw_put(w, (unsigned)h->tic, 1);
+    return 0;
+}
+
+int ac4_enc_aspx_write_1ch_head(ac4_bitwriter_t *w,
+                            const ac4_enc_aspx_1ch_head_t *h) {
+    int i;
+
+    if (!is_bit(h->int_class) || !is_bit(h->tmp_num_env) ||
+        !is_bit(h->ah_present) || !is_bit(h->fic) ||
+        !is_bit(h->tic))
+        return -1;
+    for (i = 0; i < 2; i++) {
+        if (!is_bit(h->delta_dir[i]))
+            return -1;
+    }
+    for (i = 0; i < 3; i++) {
+        if (h->tna[i] < 0 || h->tna[i] > 3)
+            return -1;
+    }
+    if (h->ah_present &&
+        (h->add_harm < 0 || h->add_harm >= (1 << 12)))
+        return -1;
+    if (h->has_xover && (h->xover < 0 || h->xover > 7))
+        return -1;
+    if (h->has_xover)
+        ac4_bw_put(w, (unsigned)h->xover, 3);
+    ac4_bw_put(w, (unsigned)h->int_class, 1);
+    ac4_bw_put(w, (unsigned)h->tmp_num_env, 1);
+    for (i = 0; i < 2; i++)
+        ac4_bw_put(w, (unsigned)h->delta_dir[i], 1);
+    for (i = 0; i < 3; i++)
+        ac4_bw_put(w, (unsigned)h->tna[i], 2);
+    ac4_bw_put(w, (unsigned)h->ah_present, 1);
+    if (h->ah_present)
+        ac4_bw_put(w, (unsigned)h->add_harm, 12);
+    ac4_bw_put(w, (unsigned)h->fic, 1);
+    ac4_bw_put(w, (unsigned)h->tic, 1);
+    return 0;
+}
+
+int ac4_enc_aspx_book_name(char *out, size_t cap, int is_noise,
+                       int is_balance, int qm, const char *ht) {
+    const char *fam;
+    char fambuf[32];
+    int n;
+
+    if (qm != 0 && qm != 1)
+        return -1;
+    if (strcmp(ht, "F0") && strcmp(ht, "DF") && strcmp(ht, "DT"))
+        return -1;
+    if (is_noise) {
+        fam = is_balance ? "NOISE_BALANCE" : "NOISE_LEVEL";
+    } else {
+        n = snprintf(fambuf, sizeof fambuf, "ENV_%s_%s",
+                     is_balance ? "BALANCE" : "LEVEL",
+                     qm == 0 ? "15" : "30");
+        if (n < 0 || (size_t)n >= sizeof fambuf)
+            return -1;
+        fam = fambuf;
+    }
+    n = snprintf(out, cap, "AC4_ASPX_HCB_%s_%s", fam, ht);
+    if (n < 0 || (size_t)n >= cap)
+        return -1;
+    return 0;
+}
+
+const ac4_aspx_book_t *ac4_enc_aspx_book_by_name(const char *name) {
+    int i;
+
+    for (i = 0; i < ENC_ASPX_NBOOKS; i++) {
+        if (!strcmp(ac4_aspx_books[i].name, name))
+            return &ac4_aspx_books[i];
+    }
+    return NULL;
+}
+
+int ac4_enc_aspx_harm_mask(const int *flags) {
+    int m = 0;
+    int b;
+
+    for (b = 0; b < 12; b++) {
+        if (!is_bit(flags[b]))
+            return -1;
+        if (flags[b])
+            m |= 1 << (11 - b);
+    }
+    return m;
+}
+
+static int emit_idx(ac4_bitwriter_t *w, const ac4_aspx_book_t *b, int idx) {
+    if (idx < 0 || idx >= b->entries)
+        return -1;
+    ac4_bw_put(w, b->cw[idx], b->len[idx]);
+    return 0;
+}
+
+int ac4_enc_aspx_write_ec_freq(ac4_bitwriter_t *w, const int *idxs, int n,
+                           const ac4_aspx_book_t *f0,
+                           const ac4_aspx_book_t *df) {
+    int prev;
+    int i;
+
+    if (idxs == NULL || n <= 0)
+        return -1;
+    if (emit_idx(w, f0, idxs[0]))
+        return -1;
+    prev = idxs[0];
+    for (i = 1; i < n; i++) {
+        if (emit_idx(w, df, idxs[i] - prev + df->off))
+            return -1;
+        prev = idxs[i];
+    }
+    return 0;
+}
+
+int ac4_enc_aspx_write_ec_time(ac4_bitwriter_t *w, const int *idxs,
+                           const int *prev_or_null, int n,
+                           const ac4_aspx_book_t *dt) {
+    int i;
+
+    if (idxs == NULL || n <= 0)
+        return -1;
+    for (i = 0; i < n; i++) {
+        int p = prev_or_null == NULL ? 0 : prev_or_null[i];
+        if (emit_idx(w, dt, idxs[i] - p + dt->off))
+            return -1;
+    }
+    return 0;
+}
+
+int ac4_enc_aspx_sig_q(double e, double p, int qm, int *out) {
+    double r;
+    double a;
+
+    if (qm != 0 && qm != 1)
+        return -1;
+    if (!(e > 0.0) || !(p > 0.0))
+        return -1;
+    a = qm == 0 ? 2.0 : 1.0;
+    r = a * log2(e / p);
+    if (!isfinite(r))
+        return -1;
+    *out = ac4_pycompat_round_half_even(r);
+    return 0;
+}
+
+int ac4_enc_aspx_noise_q(double scf, int *out) {
+    double r;
+
+    if (!(scf > 0.0))
+        return -1;
+    r = 6.0 - log2(scf);
+    if (!isfinite(r))
+        return -1;
+    *out = ac4_pycompat_round_half_even(r);
+    return 0;
+}
+
+static int clamp_int(int v, int lo, int hi) {
+    if (v < lo)
+        return lo;
+    if (v > hi)
+        return hi;
+    return v;
+}
+
+int ac4_enc_aspx_freq_wire(const int *qs, int n,
+                       const ac4_aspx_book_t *f0,
+                       const ac4_aspx_book_t *df, int *wire_out,
+                       int *scf_out) {
+    int f0max;
+    int dmin;
+    int dmax;
+    int i;
+
+    if (qs == NULL || n <= 0 || wire_out == NULL)
+        return -1;
+    f0max = f0->entries - 1;
+    dmin = -df->off;
+    dmax = df->entries - 1 - df->off;
+    wire_out[0] = clamp_int(qs[0], 0, f0max);
+    for (i = 1; i < n; i++) {
+        int d = clamp_int(qs[i] - wire_out[i - 1], dmin, dmax);
+        wire_out[i] = wire_out[i - 1] + d;
+    }
+    if (scf_out != NULL) {
+        for (i = 0; i < n; i++)
+            scf_out[i] = wire_out[i];
+        if (n > 1 && wire_out[0] == 0 && scf_out[1] < 0)
+            scf_out[0] = scf_out[1];
+    }
+    return 0;
+}
+
+int ac4_enc_aspx_time_wire(const int *qs, const int *prev_or_null,
+                       int n, const ac4_aspx_book_t *dt, int *wire_out,
+                       int *scf_out) {
+    int dmin;
+    int dmax;
+    int i;
+
+    if (qs == NULL || n <= 0 || wire_out == NULL)
+        return -1;
+    dmin = -dt->off;
+    dmax = dt->entries - 1 - dt->off;
+    for (i = 0; i < n; i++) {
+        int p = prev_or_null == NULL ? 0 : prev_or_null[i];
+        wire_out[i] = p + clamp_int(qs[i] - p, dmin, dmax);
+        if (scf_out != NULL)
+            scf_out[i] = wire_out[i];
+    }
+    return 0;
+}
+
+int ac4_enc_aspx_run_cost_freq(const int *wire, int n,
+                           const ac4_aspx_book_t *f0,
+                           const ac4_aspx_book_t *df) {
+    int cost;
+    int i;
+
+    if (wire == NULL || n <= 0)
+        return -1;
+    if (wire[0] < 0 || wire[0] >= f0->entries)
+        return -1;
+    cost = f0->len[wire[0]];
+    for (i = 1; i < n; i++) {
+        int s = wire[i] - wire[i - 1] + df->off;
+        if (s < 0 || s >= df->entries)
+            return -1;
+        cost += df->len[s];
+    }
+    return cost;
+}
+
+int ac4_enc_aspx_run_cost_time(const int *wire,
+                           const int *prev_or_null, int n,
+                           const ac4_aspx_book_t *dt) {
+    int cost = 0;
+    int i;
+
+    if (wire == NULL || n <= 0)
+        return -1;
+    for (i = 0; i < n; i++) {
+        int p = prev_or_null == NULL ? 0 : prev_or_null[i];
+        int s = wire[i] - p + dt->off;
+        if (s < 0 || s >= dt->entries)
+            return -1;
+        cost += dt->len[s];
+    }
+    return cost;
+}
+
+int ac4_enc_aspx_pick_dir(const int *qs, const int *prev_or_null,
+                      int n, const ac4_aspx_book_t *f0,
+                      const ac4_aspx_book_t *df, const ac4_aspx_book_t *dt) {
+    int *wf;
+    int *wt;
+    int cf;
+    int ct;
+    int dir;
+
+    if (qs == NULL || n <= 0)
+        return -1;
+    wf = av_malloc(sizeof *wf * (size_t)n);
+    wt = av_malloc(sizeof *wt * (size_t)n);
+    if (wf == NULL || wt == NULL) {
+        av_free(wf);
+        av_free(wt);
+        return -1;
+    }
+    ac4_enc_aspx_freq_wire(qs, n, f0, df, wf, NULL);
+    ac4_enc_aspx_time_wire(qs, prev_or_null, n, dt, wt, NULL);
+    cf = ac4_enc_aspx_run_cost_freq(wf, n, f0, df);
+    ct = ac4_enc_aspx_run_cost_time(wt, prev_or_null, n, dt);
+    dir = (ct >= 0 && cf >= 0 && ct < cf) ? 1 : 0;
+    av_free(wf);
+    av_free(wt);
+    return dir;
+}
