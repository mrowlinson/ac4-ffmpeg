+
+/* ac4enc_lib.c: opaque-ctx incremental API (r2).
+ * See ac4enc_lib.h for the contract notes. */
+#include "ac4enc_lib.h"
+#include "libavutil/mem.h"
+
+#include <errno.h>
+#include <limits.h>
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "ac4_enc_core.h"
+#include "ac4_enc_step.h"
+#include "ac4_loudness.h"
+#include "ac4_mdct.h"
+#include "ac4_pycompat.h"
+
+/* M4: the public DRC mirror must track the core layout. */
+_Static_assert(sizeof(ac4enc_drc_curve_t) ==
+                   sizeof(ac4_enc_core_drc_curve_t),
+               "drc curve mirror");
+_Static_assert(sizeof(ac4enc_drc_mode_t) ==
+                   sizeof(ac4_enc_core_drc_mode_t),
+               "drc mode mirror");
+_Static_assert(offsetof(ac4enc_drc_mode_t, mid) ==
+                   offsetof(ac4_enc_core_drc_mode_t, mid),
+               "drc mid");
+_Static_assert(offsetof(ac4enc_drc_mode_t, kind) ==
+                   offsetof(ac4_enc_core_drc_mode_t, kind),
+               "drc kind");
+_Static_assert(offsetof(ac4enc_drc_mode_t, gain) ==
+                   offsetof(ac4_enc_core_drc_mode_t, gain),
+               "drc gain");
+_Static_assert(offsetof(ac4enc_drc_mode_t, curve) ==
+                   offsetof(ac4_enc_core_drc_mode_t, curve),
+               "drc curve");
+_Static_assert(AC4ENC_DRC_DEFAULT == AC4_ENC_CORE_DRC_DEFAULT &&
+                   AC4ENC_DRC_GAINS == AC4_ENC_CORE_DRC_GAINS &&
+                   AC4ENC_DRC_CURVE == AC4_ENC_CORE_DRC_CURVE,
+               "drc kinds");
+
+struct ac4enc_ctx {
+    char *layout;
+    int nch;
+    int rate_kbps;
+    char *interval;
+    int *forced;
+    int nforced;
+    char *preset;
+    double *window;
+    int ns2_tone;
+    int shorts;
+    int joint_shorts;
+    int priming;
+    int iframe_base;
+    int iframe_total;
+    double target_db;
+    int has_bake;
+    double bake_db;
+    ac4_enc_core_drc_t drcbuf;
+    ac4_enc_core_drc_mode_t *modes;
+    int has_drc;
+    int *dmx;
+    int sample_rate;
+    int has_measure;
+    ac4_enc_core_measure_t ms;
+    int has_spec_lines;
+    int n_spec_lines;
+    int spec_lines[7];
+    /* Prologue products (mirror the _m entries exactly). */
+    double b0[6];
+    double b1[6];
+    int bake_two;
+    int do_bake;
+    int do_peak;
+    int have_stamp;
+    ac4_enc_core_stamp_t stamp_i;
+    ac4_enc_core_stamp_t stamp_f;
+    uint8_t si_p6[6], si_i12[15], si_s4[4], si_fr0[15];
+    uint8_t sf_p6[6], sf_i12[15], sf_s4[4], sf_fr0[15];
+    int flat_file;
+    int stamp_set;
+    /* Stream state. */
+    ac4_enc_step_ctx_t *eng;
+    int domain; /* 0 none, 1 int, 2 float */
+    int64_t fed_total; /* m2: 64-bit sample total (per ch) */
+    int input_ended;
+    int enc_err;
+    ac4enc_subcode_t err_sub;
+    const char *err_stage;
+    int err_frame;
+    /* R3 loud refusal: gate + offending values for the bake
+     * subcodes, else "". Follows err_sub (record clears). */
+    char err_detail[256];
+};
+
+static const int kRates[] = { 48, 64, 96, 128, 144, 192, 256,
+                              288, 320, 384, 448, 512, 768 };
