+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#ifndef AC4_ENC_MC3_H
+#define AC4_ENC_MC3_H
+
+/* 5.1 codec_mode-3 (ASPX_ACPL_2) frame assembler. Element
+ * ORDER + header bits only; core/tail VALUES are
+ * caller-supplied. Pure int/bit assembly (no float ops;
+ * submodules keep their own float discipline).
+ *
+ * Mirrors the reference entry points 1:1 (maps/tuples become
+ * the structs below; absent values become NULL or a has_*
+ * flag):
+ *   write_iframe_cfg -> ac4_enc_mc3_write_iframe_cfg (+ defaults)
+ *   write_compand_off -> ac4_enc_mc3_write_compand_off
+ *   write_audio_51_mode3 -> ac4_enc_mc3_write_audio_51_mode3
+ *   quiet_aspx -> ac4_enc_mc3_quiet_aspx
+ *   measured_aspx -> ac4_enc_mc3_measured_aspx
+ *   write_audio_51_mode3_silence -> ac4_enc_mc3_write_audio_51_mode3_silence
+ * The nbooks dict param has no C counterpart (books resolve
+ * from the committed tables via ac4_enc_aspx_book_by_name).
+ *
+ * Python assert/KeyError/IndexError/ValueError-class failures
+ * return -1. mc3-owned ranges are pre-checked (writer
+ * untouched); submodule -1s propagate with prefix bits kept,
+ * exactly like a mid-write Python exception.
+ */
+
+#include "ac4_bits.h"
+#include "ac4_enc_acpl.h"
+#include "ac4_enc_jshort.h"
+#include "ac4_enc_tail59.h"
+
+/* write_iframe_cfg kwargs (widths: 1/3/2/1/1/1/1/2/1/2/2/1). */
+typedef struct {
+    int qmode;
+    int start;
+    int stop;
+    int mfscale;
+    int interp;
+    int preflat;
+    int limiter;
+    int noisesbg;
+    int envbits;
+    int freqres;
+    int npb_id;
+    int acpl_qm;
+} ac4_enc_mc3_iframe_cfg_t;
+
+/* DEE defaults (fr0/fr1/fr24 identical). */
+void ac4_enc_mc3_default_iframe_cfg(ac4_enc_mc3_iframe_cfg_t *cfg);
+
+/* I-frame aspx_config 15b + acpl_config_1ch 3b. 0 ok, -1 on
+ * NULL or any out-of-range field (BitWriter.put fit rule). */
+int ac4_enc_mc3_write_iframe_cfg(ac4_bitwriter_t *w,
+                             const ac4_enc_mc3_iframe_cfg_t *cfg);
+
+/* Compand off-shape 5b. */
+void ac4_enc_mc3_write_compand_off(ac4_bitwriter_t *w);
+
+/* One LFE/mono sf leg: (coeffs, ref, refs|None, msfb).
+ * refs_by_band covers [0, msfb) with -1 = absent; NULL iff
+ * has_refs == 0 (refs None). */
+typedef struct {
+    const int *lines;
+    const int *qs;
+    int n;
+    int ref;
+    const int *refs_by_band;
+    int has_refs;
+    int msfb;
+} ac4_enc_mc3_leg_t;
+
+/* Joint LONG: ("long", msfb, sap, chparam, legM, legS, offs,
+ * leg_refs?). offs NULL = 2048 ladder; cp NULL = chparam
+ * None; leg_refs used iff has_leg_refs (empty legs). */
+typedef struct {
+    int msfb;
+    int sap;
+    ac4_enc_jshort_long_leg_t legM;
+    ac4_enc_jshort_long_leg_t legS;
+    const int *offs;
+    const ac4_enc_jshort_chparam_t *cp;
+    int leg_refs[2];
+    int has_leg_refs;
+} ac4_enc_mc3_joint_long_t;
+
+/* Joint SHORT: ("short", tl0, tl1, m0, m1, grp7, sap, legs,
+ * refs, geo, chparam, leg_refs). leg0/leg1/geo hold ngroups
+ * entries; cp NULL = None; leg_refs NULL unless a leg has
+ * empty refs. */
+typedef struct {
+    int tl0;
+    int tl1;
+    int m0;
+    int m1;
+    int grp7;
+    int sap;
+    const ac4_enc_jshort_group_data_t *leg0;
+    const ac4_enc_jshort_group_data_t *leg1;
+    const ac4_enc_jshort_geo_t *geo;
+    int ngroups;
+    const ac4_enc_jshort_chparam_t *cp;
+    const int *leg_refs;
+} ac4_enc_mc3_joint_short_t;
+
+#define ENC_MC3_JOINT_LONG 0
+#define ENC_MC3_JOINT_SHORT 1
+
+typedef struct {
+    int kind;
+    union {
+        ac4_enc_mc3_joint_long_t lon;
+        ac4_enc_mc3_joint_short_t sh;
+    } u;
+} ac4_enc_mc3_joint_t;
+
+/* Tail: (s2ch, s1ch, a0, a1, abooks). */
+typedef struct {
+    const ac4_enc_tail_s2ch_t *s2ch;
+    const ac4_enc_tail_s1ch_t *s1ch;
+    const ac4_enc_tail_acpl_t *a0;
+    const ac4_enc_tail_acpl_t *a1;
+    const ac4_enc_acpl_books_t *abooks;
+} ac4_enc_mc3_tail_t;
+
+/* One mode-3 5.1 audio_data. iframe != 0 writes the I-frame
+ * cfg + xover 0. 0 ok, -1 on NULL, bad joint kind, or any
+ * submodule assert-class failure. */
+int ac4_enc_mc3_write_audio_51_mode3(ac4_bitwriter_t *w, int iframe,
+                                 const ac4_enc_mc3_leg_t *lfe,
+                                 const ac4_enc_mc3_joint_t *joint,
+                                 const ac4_enc_mc3_leg_t *mono,
+                                 const ac4_enc_mc3_tail_t *tail);
+
+/* ASPX wire/scf run bundles (steady 12/12/3/3 + 12/3). */
+typedef struct {
+    int sig0[12];
+    int sig1[12];
+    int noise0[3];
+    int noise1[3];
+} ac4_enc_mc3_aspx2_runs_t;
+
+typedef struct {
+    int sig[12];
+    int noise[3];
+} ac4_enc_mc3_aspx1_runs_t;
+
+/* quiet_aspx(freq) outputs. s2ch/s1ch wire pointers alias
+ * r2/r1 (self-contained: valid while out lives). */
+typedef struct {
+    ac4_enc_tail_s2ch_t s2ch;
+    ac4_enc_tail_s1ch_t s1ch;
+    ac4_enc_mc3_aspx2_runs_t r2;
+    ac4_enc_mc3_aspx1_runs_t r1;
+} ac4_enc_mc3_quiet_t;
+
+/* Quiet ASPX pair (zero indices; TIME-flat dirs unless freq).
+ * 0 ok, -1 on NULL out. */
+int ac4_enc_mc3_quiet_aspx(int freq, ac4_enc_mc3_quiet_t *out);
+
+/* measured_aspx inputs: decoded-q runs; has_prev gates per
+ * run (0 = None -> FREQ forced); harm 12b masks (0 = none). */
+typedef struct {
+    int qsig0[12];
+    int qsig1[12];
+    int qnoise0[3];
+    int qnoise1[3];
+    int has_prev[4];
+    int psig0[12];
+    int psig1[12];
+    int pnoise0[3];
+    int pnoise1[3];
+    int harm0;
+    int harm1;
+} ac4_enc_mc3_aspx2_in_t;
+
+typedef struct {
+    int qsig[12];
+    int qnoise[3];
+    int has_prev[2];
+    int psig[12];
+    int pnoise[3];
+    int harm;
+} ac4_enc_mc3_aspx1_in_t;
+
+/* measured_aspx outputs: (s2ch, s1ch) + (scf2, scf1). Wire
+ * pointers alias wire2/wire1 (valid while out lives). */
+typedef struct {
+    ac4_enc_tail_s2ch_t s2ch;
+    ac4_enc_tail_s1ch_t s1ch;
+    ac4_enc_mc3_aspx2_runs_t wire2;
+    ac4_enc_mc3_aspx2_runs_t scf2;
+    ac4_enc_mc3_aspx1_runs_t wire1;
+    ac4_enc_mc3_aspx1_runs_t scf1;
+} ac4_enc_mc3_measured_t;
+
+/* Measured-envelope ASPX pair. 0 ok, -1 on NULL, bad
+ * has_prev flag, or out-of-range harm mask. */
+int ac4_enc_mc3_measured_aspx(const ac4_enc_mc3_aspx2_in_t *in2,
+                          const ac4_enc_mc3_aspx1_in_t *in1,
+                          ac4_enc_mc3_measured_t *out);
+
+/* One mode-3 5.1 silence audio_data (container proof). 0 ok,
+ * -1 on NULL. */
+int ac4_enc_mc3_write_audio_51_mode3_silence(
+    ac4_bitwriter_t *w, int iframe, const ac4_enc_acpl_books_t *abooks);
+
+#endif
diff --git a/libavcodec/ac4_enc_step.h b/libavcodec/ac4_enc_step.h
new file mode 100644
index 0000000000..9f93ff4169
--- /dev/null
+++ b/libavcodec/ac4_enc_step.h
@@ -0,0 +1,147 @@
+/*
+ * Incremental-encode engine (private)
+ * Copyright (c) 2026 Michael Rowlinson
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+/* ac4_enc_step.h: private incremental-encode engine (r2).
+ *
+ * The engine is the single frame-stepping implementation behind
+ * both the whole-stream core drivers (which feed all input, then
+ * drain: thin wrappers proving zero-divergence) and the
+ * incremental ac4enc_lib ctx (feed 2048-sample frames, emit bare
+ * frames with 1-frame lookahead, drain at end).
+ *
+ * Private to the enc-lib build: NOT installed, NOT part of the
+ * core's public API (ac4_enc_core.h is untouched by r2). All mutable
+ * scratch is heap-owned by the ctx (B1: no function-static
+ * mutable state anywhere in the tree); separate ctx objects
+ * encode concurrently without sharing.
+ *
+ * Return codes mirror the lib: 0 ok / 1 frame ready (ready/emit
+ * only) / -EINVAL config or protocol error / -ENOMEM /
+ * -EIO encode refusal or internal failure. ac4_enc_step_detail
+ * reports the sticky subcode (ESHORT is NOT sticky: the frame
+ * stays pending and the call is retryable with room).
+ */
+#ifndef AC4ENC_STEP_H
+#define AC4ENC_STEP_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "ac4_enc_core.h"
+
+typedef struct ac4_enc_step_ctx ac4_enc_step_ctx_t;
+
+/* Static run config. Borrowed pointers must outlive the ctx
+ * (the lib holds owned copies; the core wrappers pass prologue
+ * locals that outlive the call). */
+typedef struct {
+    int nch; /* 2 stereo | 6 5.1 */
+    int rate_kbps;
+    const char *layout; /* nch=2: "stereo" (checked); else ignored */
+    const char *interval; /* iframe rule: NULL/"1sec"/decimal (checked) */
+    const double *window; /* borrowed 4096 taps or NULL=KBD4096 */
+    int ns2_tone;
+    int shorts;
+    int joint_shorts; /* stereo only */
+    const int *forced;
+    int nforced;
+    const ac4_enc_core_drc_t *drc; /* dry-run validated at open */
+    const int *dmx; /* NULL or 5 ints; range-free by construction */
+    int priming; /* stereo: 1 priming (coff 0) | 0 joint (coff 2) */
+    int iframe_base; /* stereo joint only */
+    int iframe_total; /* stereo joint: >=0 explicit cap, <0 open-ended.
+                       * Whole-stream wrappers resolve <0 to the true
+                       * nframes before open (exact). Open-ended is
+                       * exact for iframe_base==0 (the cap never
+                       * binds); base>0 + open-ended documents the
+                       * edge (late-cadence marks past the unknown
+                       * total are kept). */
+    /* Prologue products (caller-computed; the engine applies them
+     * in exact core op order). */
+    double bake0[6]; /* per-ch factor; stereo: full bake. mc: bc. */
+    double bake1[6]; /* mc leg-comp lin[c]; stereo ignored. */
+    int bake_two; /* 0: v=x*bake0[c]. 1: v=(x*bake0[c])*bake1[c]. */
+    int do_bake; /* apply bake_round on ingest */
+    int do_peak; /* track baked peak; end() refuses >= 32767 */
+    const ac4_enc_core_stamp_t *stamp; /* borrowed or NULL (neutral) */
+    int flat_file;
+    /* Stereo spectral path (H6): caller-measured lines. mc ignores. */
+    int nlines; /* 0..7 */
+    int lines[7]; /* each 0..2047 (checked) */
+} ac4_enc_step_cfg_t;
+
+/* Sticky failure detail (ac4_enc_step_detail). */
+enum {
+    AC4_ENC_STEP_OK = 0,
+    AC4_ENC_STEP_EBCFG, /* bad static config at open */
+    AC4_ENC_STEP_ENOMEM,
+    AC4_ENC_STEP_EBAKE, /* bake_round overflow on ingest (refusal) */
+    AC4_ENC_STEP_EPEAK, /* baked peak >= 32767 at end (refusal) */
+    AC4_ENC_STEP_EEMIT, /* per-frame encode refusal / internal failure */
+    AC4_ENC_STEP_EPROTO, /* feed after end, emit when not ready, ... */
+    AC4_ENC_STEP_ESHORT /* outcap < frame bytes (*out_len = needed) */
+};
+
+int ac4_enc_step_open(ac4_enc_step_ctx_t **cp, const ac4_enc_step_cfg_t *cfg);
+/* Feed n samples per ch (ns[c] each; rows defined as
+ * (double)x for feed_int). ns!=NULL. */
+int ac4_enc_step_feed(ac4_enc_step_ctx_t *c, const double *const *rows,
+                  const int *ns);
+int ac4_enc_step_feed_int(ac4_enc_step_ctx_t *c, const int *const *rows,
+                      const int *ns);
+/* Signal end of input: freezes the frame plan (nframes from fed
+ * samples) and runs the baked-peak check. Strictly once. */
+int ac4_enc_step_end(ac4_enc_step_ctx_t *c);
+/* 1 = next frame ready (call emit), 0 = need more input (or
+ * drained: end() + emitted == plan), <0 sticky failure. */
+int ac4_enc_step_ready(ac4_enc_step_ctx_t *c);
+/* Pure peek: 1 if a frame would be ready with n more fed
+ * samples (lets callers size/check buffers before feeding).
+ * 0 otherwise. Never fails (NULL -> 0). */
+int ac4_enc_step_ready_after(const ac4_enc_step_ctx_t *c, int n);
+/* Set the stamp before the first emit (the lib composes it
+ * per-domain at first feed). Allowed iff emitted==0; EPROTO
+ * after. Borrowed like cfg.stamp. */
+int ac4_enc_step_set_stamp(ac4_enc_step_ctx_t *c,
+                       const ac4_enc_core_stamp_t *stamp);
+/* CBR byte size of the next emittable frame (pure peek; no
+ * advance), or -1. Sized buffers never go short. */
+int ac4_enc_step_next_size(ac4_enc_step_ctx_t *c);
+/* Emit one bare frame (TOC..pad, no sync/size/trailer). 1 with
+ * *out_len/is_iframe set, or <0 (ESHORT sets *out_len). */
+int ac4_enc_step_emit(ac4_enc_step_ctx_t *c, uint8_t *out, size_t outcap,
+                  size_t *out_len, int *is_iframe);
+int ac4_enc_step_emitted(const ac4_enc_step_ctx_t *c);
+int ac4_enc_step_detail(const ac4_enc_step_ctx_t *c);
+/* R3 loud refusal: baked peak tracked on ingest (the EPEAK
+ * offending value), or -1 on NULL. */
+int ac4_enc_step_err_peak(const ac4_enc_step_ctx_t *c);
+/* R3 loud refusal: EBAKE failing-sample locus (ch, per-ch fed
+ * index, pre-bake value). 0 ok / -1 none (NULLs, or no EBAKE
+ * recorded). */
+int ac4_enc_step_err_sample(const ac4_enc_step_ctx_t *c, int *ch,
+                        int *idx, double *val);
+/* Closed-form max CBR raw size for a rate (period max), or -1
+ * on bad rate. Backs ac4enc_max_packet. */
+int ac4_enc_step_max_cbr(int rate_kbps);
+void ac4_enc_step_close(ac4_enc_step_ctx_t *c);
+
+#endif
diff --git a/libavcodec/ac4_enc_tail59.c b/libavcodec/ac4_enc_tail59.c
new file mode 100644
index 0000000000..b6c943f8e3
--- /dev/null
+++ b/libavcodec/ac4_enc_tail59.c
@@ -0,0 +1,157 @@
+/*
+ * Frame-level ASPX/ACPL tail assembler
+ * Copyright (c) 2026 Michael Rowlinson
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include "ac4_enc_tail59.h"
+
+#include "ac4_enc_aspx.h"
+
+static int run_ec(ac4_bitwriter_t *w, const int *idxs, int n, int dt,
+                  int is_noise, int is_balance, int qm) {
+    char name[27];
+    const ac4_aspx_book_t *dtb;
+    const ac4_aspx_book_t *f0b;
+    const ac4_aspx_book_t *dfb;
+
+    if (dt) {
+        if (ac4_enc_aspx_book_name(name, sizeof name, is_noise,
+                               is_balance, qm, "DT"))
+            return -1;
+        dtb = ac4_enc_aspx_book_by_name(name);
+        if (dtb == NULL)
+            return -1;
+        return ac4_enc_aspx_write_ec_time(w, idxs, NULL, n, dtb);
+    }
+    if (ac4_enc_aspx_book_name(name, sizeof name, is_noise,
+                           is_balance, qm, "F0"))
+        return -1;
+    f0b = ac4_enc_aspx_book_by_name(name);
+    if (f0b == NULL)
+        return -1;
+    if (ac4_enc_aspx_book_name(name, sizeof name, is_noise,
+                           is_balance, qm, "DF"))
+        return -1;
+    dfb = ac4_enc_aspx_book_by_name(name);
+    if (dfb == NULL)
+        return -1;
+    return ac4_enc_aspx_write_ec_freq(w, idxs, n, f0b, dfb);
+}
+
+static int write_2ch_ec(ac4_bitwriter_t *w, const ac4_enc_tail_s2ch_t *s) {
+    int ch1bal = s->balance == 1;
+
+    if (s->qm0 != 0 && s->qm0 != 1)
+        return -1;
+    if (s->qm1 != 0 && s->qm1 != 1)
+        return -1;
+    if (run_ec(w, s->sig0, s->nsig0, s->delta_dir[0] == 1, 0, 0,
+               s->qm0))
+        return -1;
+    if (run_ec(w, s->sig1, s->nsig1, s->delta_dir[2] == 1, 0,
+               ch1bal, s->qm1))
+        return -1;
+    if (run_ec(w, s->noise0, s->nnoise0, s->delta_dir[1] == 1, 1,
+               0, 0))
+        return -1;
+    if (run_ec(w, s->noise1, s->nnoise1, s->delta_dir[3] == 1, 1,
+               ch1bal, 0))
+        return -1;
+    return 0;
+}
+
+static int write_1ch_ec(ac4_bitwriter_t *w, const ac4_enc_tail_s1ch_t *h) {
+    if (h->qm != 0 && h->qm != 1)
+        return -1;
+    if (run_ec(w, h->sig, h->nsig, h->delta_dir[0] == 1, 0, 0,
+               h->qm))
+        return -1;
+    if (run_ec(w, h->noise, h->nnoise, h->delta_dir[1] == 1, 1,
+               0, 0))
+        return -1;
+    return 0;
+}
+
+static int write_acpl_side(ac4_bitwriter_t *w, const ac4_enc_tail_acpl_t *a,
+                           const ac4_enc_acpl_books_t *abooks) {
+    return ac4_enc_acpl_write_1ch(w, a->interp, a->alpha_f0,
+                              a->alpha_dfs, a->nalpha, a->beta_f0,
+                              a->beta_dfs, a->nbeta, abooks,
+                              a->has_slot, a->slot, 0,
+                              a->beta_first);
+}
+
+int ac4_enc_tail_write_steady(ac4_bitwriter_t *w,
+                          const ac4_enc_tail_s2ch_t *s2ch,
+                          const ac4_enc_tail_s1ch_t *s1ch,
+                          const ac4_enc_tail_acpl_t *a0,
+                          const ac4_enc_tail_acpl_t *a1,
+                          const ac4_enc_acpl_books_t *abooks,
+                          int has_xover, int xover) {
+    ac4_enc_aspx_2ch_head_t h2;
+    ac4_enc_aspx_1ch_head_t h1;
+    int i;
+
+    /* 2ch head: tail59 leaves int_class/tmp_num_env at 0. */
+    h2.int_class0 = 0;
+    h2.tmp_num_env0 = 0;
+    h2.balance = s2ch->balance;
+    h2.int_class1 = 0;
+    h2.tmp_num_env1 = 0;
+    for (i = 0; i < 4; i++)
+        h2.delta_dir[i] = s2ch->delta_dir[i];
+    for (i = 0; i < 3; i++) {
+        h2.tna0[i] = s2ch->tna0[i];
+        h2.tna1[i] = s2ch->tna1[i];
+    }
+    h2.ah_left = s2ch->ah_left;
+    h2.ah_right = s2ch->ah_right;
+    h2.add_harm0 = s2ch->add_harm0;
+    h2.add_harm1 = s2ch->add_harm1;
+    h2.fic = s2ch->fic;
+    h2.tic = s2ch->tic;
+    h2.has_xover = has_xover;
+    h2.xover = xover;
+    if (ac4_enc_aspx_write_2ch_head(w, &h2))
+        return -1;
+    if (write_2ch_ec(w, s2ch))
+        return -1;
+    /* 1ch head: int_class/tmp_num_env/fic/tic stay 0. */
+    h1.int_class = 0;
+    h1.tmp_num_env = 0;
+    h1.delta_dir[0] = s1ch->delta_dir[0];
+    h1.delta_dir[1] = s1ch->delta_dir[1];
+    for (i = 0; i < 3; i++)
+        h1.tna[i] = s1ch->tna[i];
+    h1.ah_present = s1ch->ah_present;
+    h1.add_harm = s1ch->add_harm;
+    h1.fic = 0;
+    h1.tic = 0;
+    h1.has_xover = has_xover;
+    h1.xover = xover;
+    if (ac4_enc_aspx_write_1ch_head(w, &h1))
+        return -1;
+    if (write_1ch_ec(w, s1ch))
+        return -1;
+    if (write_acpl_side(w, a0, abooks))
+        return -1;
+    if (write_acpl_side(w, a1, abooks))
+        return -1;
+    return 0;
+}
diff --git a/libavcodec/ac4_enc_tail59.h b/libavcodec/ac4_enc_tail59.h
new file mode 100644
index 0000000000..af380cfd99
--- /dev/null
+++ b/libavcodec/ac4_enc_tail59.h
@@ -0,0 +1,99 @@
+/*
+ * Frame-level ASPX/ACPL tail assembler
+ * Copyright (c) 2026 Michael Rowlinson
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
