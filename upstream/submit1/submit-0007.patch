+int
+ac4_enc_core_write_audio_data(const char *layout, int iframe,
+                          uint8_t *out, size_t outcap)
+{
+    ac4_bitwriter_t w;
+    int n;
+    (void)iframe;
+    if (!out)
+        return -1;
+    ac4_bw_init(&w);
+    n = audio_data_w(&w, layout);
+    if (n == 0)
+        n = w_extract(&w, out, outcap);
+    else
+        n = -1;
+    ac4_bw_free(&w);
+    return n;
+}
