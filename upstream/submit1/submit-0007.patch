+
+/* ---- transient detector ---- */
+
+/* 16 plain-KBD 128-line spectra covering [start, start+2048). */
+static void
+tile_specs_128(const double *pcm, int n_pcm, int start,
+               double out[16][128])
+{
+    for (int k = 0; k < AC4_ENC_CORE_N_MIX_TILE128; k++)
+        ac4_mdct_forward_n(pcm, n_pcm, start + 128 * k, 128,
+                       NULL, out[k]);
+}
+
+/* max/min-ratio vote over masked HF energies of all channels. */
+static int
+per_channel_votes(const double *hfs, int nch, const int *valid)
+{
+    for (int c = 0; c < nch; c++) {
+        const double *hf = hfs + c * 16;
+        int nh = 0, npos = 0;
+        double mn = 0.0, mx = 0.0;
+        for (int k = 0; k < 16; k++) {
+            double h;
+            if (valid && !valid[k])
+                continue;
+            h = hf[k];
+            nh++;
+            if (h > 0.0) {
+                if (!npos || h < mn)
+                    mn = h;
+                if (!npos || h > mx)
+                    mx = h;
+                npos++;
+            }
+        }
+        if (!npos)
+            continue;
+        if (npos < nh)
+            return 1;
+        if (mx / mn > AC4_ENC_CORE_MIX_HF_RATIO)
+            return 1;
+    }
+    return 0;
+}
+
+static int
+tile_orient(const double *const *specs, int nch, int start,
+            int total, int *o0, int *o1, int mc)
+{
+    double *hfs;
+    double hmax = 0.0;
+    int valid[16];
+    const int *vp = NULL;
+    int rc = 0;
+    if (!specs || nch < 1 || nch > 16 || !o0 || !o1)
+        return -1;
+    hfs = av_malloc((size_t)nch * 16 * sizeof *hfs);
+    if (!hfs)
+        return -1;
+    for (int c = 0; c < nch; c++) {
+        for (int k = 0; k < 16; k++) {
+            double e[128 - AC4_ENC_CORE_MIX_HF_LO];
+            const double *X = specs[c] + k * 128;
+            for (int j = AC4_ENC_CORE_MIX_HF_LO; j < 128; j++)
+                e[j - AC4_ENC_CORE_MIX_HF_LO] = X[j] * X[j];
+            hfs[c * 16 + k] = ac4_pycompat_sum(
+                e, 128 - AC4_ENC_CORE_MIX_HF_LO);
+            if (hfs[c * 16 + k] > hmax)
+                hmax = hfs[c * 16 + k];
+        }
+    }
+    if (!(hmax > 0.0))
+        goto done;
+    if (total >= 0) {
+        for (int k = 0; k < 16; k++)
+            valid[k] = start + 128 * k - 64 >= 0 &&
+                start + 128 * k + 192 <= total;
+        vp = valid;
+    }
+    if (!per_channel_votes(hfs, nch, vp))
+        goto done;
+    {
+        double p0[16], p1[16];
+        double e0, e1;
+        for (int c = 0; c < nch; c++) {
+            p0[c] = ac4_pycompat_sum(hfs + c * 16, 8);
+            p1[c] = ac4_pycompat_sum(hfs + c * 16 + 8, 8);
+        }
+        if (!mc) {
+            /* sum(hf[0:8])+sum(hf[16:24]) over the concat */
+            e0 = p0[0] + p0[1];
+            e1 = p1[0] + p1[1];
+        } else {
+            e0 = ac4_pycompat_sum(p0, (size_t)nch);
+            e1 = ac4_pycompat_sum(p1, (size_t)nch);
+        }
+        if (e1 >= e0) {
+            *o0 = AC4_ENC_CORE_TL_1024;
+            *o1 = AC4_ENC_CORE_TL_128;
+        } else {
+            *o0 = AC4_ENC_CORE_TL_128;
+            *o1 = AC4_ENC_CORE_TL_1024;
+        }
+        rc = 1;
+    }
+done:
+    av_free(hfs);
+    return rc;
+}
+
+int
+ac4_enc_core_tile_transient_orient(const double *specL16,
+                               const double *specR16, int start,
+                               int total, int *o0, int *o1)
+{
+    const double *specs[2];
+    if (!specL16 || !specR16)
+        return -1;
+    specs[0] = specL16;
+    specs[1] = specR16;
+    return tile_orient(specs, 2, start, total, o0, o1, 0);
+}
+
+int
+ac4_enc_core_tile_transient_orient_mc(const double *const *specs,
+                                  int nch, int start, int total,
+                                  int *o0, int *o1)
+{
+    if (!specs || nch < 1)
+        return -1;
+    return tile_orient(specs, nch, start, total, o0, o1, 1);
+}
+
+/* (first, last) window lengths for an orient code. */
+static void
+frame_edge_lens(int orient, int *first, int *last)
+{
+    if (orient == AC4_ENC_CORE_ORIENT_1024_FIRST) {
+        *first = 1024;
+        *last = 128;
+    } else if (orient == AC4_ENC_CORE_ORIENT_128_FIRST) {
+        *first = 128;
+        *last = 1024;
+    } else {
+        *first = 2048;
+        *last = 2048;
+    }
+}
+
+int
+ac4_enc_core_mixed_specs_for_frame(const double *pcm, int n_pcm,
+                               int start, int orient,
+                               const double *cache16,
+                               int edge_prev, int edge_next,
+                               double out[9][1024])
+{
+    double wbuf[2048];
+    if (!pcm || n_pcm < 0 || !cache16 || !out)
+        return -1;
+    memset(out, 0, 9 * 1024 * sizeof(double));
+    if (orient == AC4_ENC_CORE_ORIENT_1024_FIRST) {
+        int tl = 0;
+        if (edge_prev < 1024) {
+            if (edge_prev != 128 && edge_prev != 256 &&
+                edge_prev != 512)
+                return -1;
+            tl = edge_prev;
+        }
+        ac4_mdct_bridged_window(1024, tl, 128, wbuf);
+        ac4_mdct_forward_n(pcm, n_pcm, start, 1024, wbuf,
+                       out[0]);
+        for (int k = 0; k < 8; k++)
+            memcpy(out[1 + k], cache16 + (8 + k) * 128,
+                   128 * sizeof(double));
+        return 0;
+    }
+    if (orient == AC4_ENC_CORE_ORIENT_128_FIRST) {
+        int tr = 0;
+        if (edge_next < 1024) {
+            if (edge_next != 128 && edge_next != 256 &&
+                edge_next != 512)
+                return -1;
+            tr = edge_next;
+        }
+        ac4_mdct_bridged_window(1024, 128, tr, wbuf);
+        ac4_mdct_forward_n(pcm, n_pcm, start + 1024, 1024, wbuf,
+                       out[8]);
+        for (int k = 0; k < 8; k++)
+            memcpy(out[k], cache16 + k * 128,
+                   128 * sizeof(double));
+        return 0;
+    }
+    return -1;
+}
+
+/* ---- 5.1 assembly / rate loops ---- */
+
+int
+ac4_enc_core_assemble_51(int i, const uint8_t *audio, int n_audio,
+                     int raw_size, int iframe,
+                     const ac4_enc_core_stamp_t *stamp51,
+                     int content_type, const ac4_enc_core_drc_t *drc,
+                     const int *dmx, uint8_t *out, size_t outcap)
+{
+    static const uint8_t z10[10] = { 0 };
+    static const uint8_t z6[6] = { 0 };
+    static const uint8_t z4[4] = { 0 };
+    bytebuf_t sub1 = { NULL, 0, 0 };
+    const uint8_t *subs[3];
+    int nlens[3], nsubs, n = -1;
+    if (!audio || n_audio < 0 || !out)
+        return -1;
+    iframe = !!iframe;
+    if (sub_audio_bb(&sub1, audio, n_audio, "5.1", iframe,
+                     drc))
+        goto done;
+    if (!stamp51) {
+        if (iframe) {
+            subs[0] = z10;
+            nlens[0] = AC4_ENC_CORE_DEE_SUB0_I;
+            subs[1] = sub1.p;
+            nlens[1] = (int)sub1.n;
+            subs[2] = z4;
+            nlens[2] = AC4_ENC_CORE_DEE_SUB2_I;
+            nsubs = 3;
+        } else {
+            subs[0] = z6;
+            nlens[0] = AC4_ENC_CORE_DEE_SUB0_P;
+            subs[1] = sub1.p;
+            nlens[1] = (int)sub1.n;
+            nsubs = 2;
+        }
+    } else {
+        if (!stamp51->p6 || !stamp51->i12 || !stamp51->s4)
+            goto done;
+        if (iframe) {
+            subs[0] = stamp51->i12;
+            nlens[0] = stamp51->n_i12;
+            subs[1] = sub1.p;
+            nlens[1] = (int)sub1.n;
+            subs[2] = stamp51->s4;
+            nlens[2] = stamp51->n_s4;
+            nsubs = 3;
+        } else {
+            subs[0] = stamp51->p6;
+            nlens[0] = stamp51->n_p6;
+            subs[1] = sub1.p;
+            nlens[1] = (int)sub1.n;
+            nsubs = 2;
+        }
+    }
+    n = assemble_raw(i, iframe, "5.1", content_type ? 1 : 0,
+                     subs, nlens, nsubs, raw_size, out,
+                     outcap);
+done:
+    (void)dmx;
+    bb_free(&sub1);
+    return n;
+}
+
+static int
+try_fit_51(int i, const double *const *Xs, int shift, int kcap,
+           int raw_size, int iframe,
+           const ac4_enc_core_stamp_t *stamp51,
+           const ac4_enc_core_drc_t *drc, const int *dmx,
+           int floor_adaptive_mains, uint8_t *out,
+           size_t outcap)
+{
+    const int *offs = ac4_sfb_offsets48(2048);
+    ac4_enc_core_leg_t *qs;
+    ac4_bitwriter_t w;
+    uint8_t *audio = NULL;
+    int n_audio, n = -1, any = 0;
+    if (!Xs || !offs)
+        return -1;
+    qs = av_malloc(6 * sizeof *qs);
+    if (!qs)
+        return -1;
+    for (int ch = 0; ch < 6; ch++) {
+        int rc;
+        if (ch == 3)
+            rc = ac4_enc_core_quantize_bands(
+                Xs[ch], 2048, AC4_ENC_CORE_DIG_GAIN, shift,
+                kcap, offs, AC4_ENC_CORE_MAX_SFB_FULL,
+                AC4_ENC_CORE_MAX_SFB_LFE, 1, &qs[ch]);
+        else
+            rc = ac4_enc_core_quantize_full(
+                Xs[ch], 2048, AC4_ENC_CORE_DIG_GAIN, shift,
+                kcap, floor_adaptive_mains, &qs[ch]);
+        if (rc) {
+            av_free(qs);
+            return -1;
+        }
+        if (qs[ch].n > 0)
+            any = 1;
+    }
+    if (!any)
+        goto done;
+    ac4_bw_init(&w);
+    /* WAV order L R C LFE Ls Rs -> (lfe, l, r, ls, rs, c) */
+    if (audio_51_w(&w, &qs[3], &qs[0], &qs[1], &qs[4],
+                   &qs[5], &qs[2])) {
+        ac4_bw_free(&w);
+        goto done;
+    }
+    n_audio = w_drain(&w, &audio);
+    ac4_bw_free(&w);
+    if (n_audio < 0)
+        goto done;
+    n = ac4_enc_core_assemble_51(i, audio, n_audio, raw_size,
+                             iframe, stamp51, 0, drc, dmx,
+                             out, outcap);
+done:
+    av_free(qs);
+    av_free(audio);
+    return n;
+}
+
+static int
+fit_51(int i, const double *const *Xs, int raw_size,
+       int iframe, const ac4_enc_core_stamp_t *stamp51,
+       const ac4_enc_core_drc_t *drc, const int *dmx,
+       int floor_adaptive_mains, uint8_t *out, size_t outcap)
+{
+    static const int kcaps[6] = { 63, 31, 15, 7, 3, 1 };
+    for (int k = 0; k < 6; k++) {
+        int shift = 0;
+        for (;;) {
+            int n = try_fit_51(i, Xs, shift, kcaps[k],
+                               raw_size, iframe, stamp51,
+                               drc, dmx, floor_adaptive_mains,
+                               out, outcap);
+            if (n >= 0)
+                return n;
+            shift += AC4_ENC_CORE_SHIFT_STEP;
+            if (shift > AC4_ENC_CORE_SHIFT_MAX)
+                break;
+        }
+    }
+    return -1;
+}
+
+static int
+try_fit_51_mixed(int i, const double *const *Xs9,
+                 const double *XsLFE, int orient, int shift,
+                 int kcap, int raw_size, int iframe,
+                 const ac4_enc_core_stamp_t *stamp51,
+                 const ac4_enc_core_drc_t *drc, const int *dmx,
+                 uint8_t *out, size_t outcap)
+{
+    const int *offs = ac4_sfb_offsets48(2048);
+    ac4_enc_core_leg_t lfe;
+    ac4_enc_core_mixed_leg_t *mixed;
+    ac4_bitwriter_t w;
+    uint8_t *audio = NULL;
+    int refs[5];
+    int n_audio, n = -1, any = 0;
+    if (!Xs9 || !XsLFE || !offs)
+        return -1;
+    mixed = av_malloc(5 * sizeof *mixed);
+    if (!mixed)
+        return -1;
+    if (ac4_enc_core_quantize_bands(XsLFE, 2048, AC4_ENC_CORE_DIG_GAIN,
+                                shift, kcap, offs,
+                                AC4_ENC_CORE_MAX_SFB_FULL,
+                                AC4_ENC_CORE_MAX_SFB_LFE, 1,
+                                &lfe)) {
+        av_free(mixed);
+        return -1;
+    }
+    for (int c = 0; c < 5; c++) {
+        if (ac4_enc_core_quantize_mixed(Xs9 + c * 9, orient,
+                                    AC4_ENC_CORE_DIG_GAIN, shift,
+                                    kcap, &mixed[c], NULL)) {
+            av_free(mixed);
+            return -1;
+        }
+        if (mixed_any(&mixed[c]))
+            any = 1;
+    }
+    if (!any && lfe.n == 0)
+        goto done;
+    for (int c = 0; c < 5; c++) {
+        refs[c] = 100;
+        if (mixed_any(&mixed[c]) &&
+            leg_ref_first(&mixed[c], &refs[c]))
+            goto done;
+    }
+    ac4_bw_init(&w);
+    if (audio_51_mixed_w(&w, &lfe, &mixed[0], refs[0],
+                         &mixed[1], refs[1], &mixed[3],
+                         refs[3], &mixed[4], refs[4],
+                         &mixed[2], refs[2], orient)) {
+        ac4_bw_free(&w);
+        goto done;
+    }
+    n_audio = w_drain(&w, &audio);
+    ac4_bw_free(&w);
+    if (n_audio < 0)
+        goto done;
+    n = ac4_enc_core_assemble_51(i, audio, n_audio, raw_size,
+                             iframe, stamp51, 0, drc, dmx,
+                             out, outcap);
+done:
+    av_free(mixed);
+    av_free(audio);
+    return n;
+}
+
+static int
+fit_51_mixed(int i, const double *const *Xs9,
+             const double *XsLFE, int orient, int raw_size,
+             int iframe, const ac4_enc_core_stamp_t *stamp51,
+             const ac4_enc_core_drc_t *drc, const int *dmx,
+             uint8_t *out, size_t outcap)
+{
+    static const int kcaps[5] = { 12, 7, 4, 2, 1 };
+    int shift = 0;
+    for (;;) {
+        int n = try_fit_51_mixed(i, Xs9, XsLFE, orient, shift,
+                                 63, raw_size, iframe,
+                                 stamp51, drc, dmx, out,
+                                 outcap);
+        if (n >= 0)
+            return n;
+        shift += AC4_ENC_CORE_SHIFT_STEP;
+        if (shift > AC4_ENC_CORE_SHIFT_MAX)
+            break;
+    }
+    shift = 0;
+    for (;;) {
+        for (int k = 0; k < 5; k++) {
+            int n = try_fit_51_mixed(i, Xs9, XsLFE, orient,
+                                     shift, kcaps[k], raw_size,
+                                     iframe, stamp51, drc,
+                                     dmx, out, outcap);
+            if (n >= 0)
+                return n;
+        }
+        shift += AC4_ENC_CORE_SHIFT_STEP;
+        if (shift > AC4_ENC_CORE_SHIFT_MAX)
+            return -1;
+    }
+}
+
+/* ---- full-stream drivers ---- */
+
+/* Half-even round to int with overflow -> -1 (bake path). */
+static int
+bake_round(double v, int *out)
+{
+    long long ll;
+    if (ac4_pycompat_round_half_even_ll(v, &ll))
+        return -1;
+    if (ll < -2147483647L - 1 || ll > 2147483647L)
+        return -1;
+    *out = (int)ll;
+    return 0;
+}
+
+/* int PCM -> exact doubles. */
+static double *
+pcm_to_double(const int *pcm, int n)
+{
+    double *d = av_malloc((size_t)(n > 0 ? n : 1) * sizeof *d);
+    if (!d)
+        return NULL;
+    for (int k = 0; k < n; k++)
+        d[k] = (double)pcm[k];
+    return d;
+}
+
+/* Stereo content frames from double PCM (post-bake baked
+ * ints as doubles, or raw rows at target 0). Shared by the int
+ * and float entries; bytes or -1. */
+static int encode_pcm_frames(const double *dL, int nL,
+                             const double *dR, int nR, int rate_kbps,
+                             const char *layout, const char *interval,
+                             const char *trailer,
+                             const double *window, int ns2_tone,
+                             int shorts, int joint_shorts,
+                             const int *forced, int nforced,
+                             const ac4_enc_core_drc_t *drc, const int *dmx,
+                             int priming, int iframe_base,
+                             int iframe_total,
+                             const ac4_enc_core_stamp_t *stamp,
+                             int flat_file, uint8_t *out,
+                             size_t outcap);
+
+int
+ac4_enc_core_encode_pcm(const int *pcmL, int nL, const int *pcmR,
+                    int nR, int rate_kbps, const char *layout,
+                    const char *interval, const char *trailer,
+                    const double *window, int ns2_tone,
+                    int shorts, double target_db, int has_bake,
+                    double bake_db, int joint_shorts,
+                    const int *forced, int nforced,
+                    const char *preset, const ac4_enc_core_drc_t *drc,
+                    const int *dmx, int priming, int iframe_base,
+                    int iframe_total, uint8_t *out,
+                    size_t outcap)
+{
+    int *bL = NULL, *bR = NULL;
+    double *dL = NULL, *dR = NULL;
+    uint8_t p6[6], i12[12], s4[4], fr0[12];
+    ac4_enc_core_stamp_t stampbuf;
+    const ac4_enc_core_stamp_t *stamp = NULL;
+    int flat_file = 0;
+    int n = -1;
+    if (!pcmL || !pcmR || nL < 0 || nR < 0 || !layout ||
+        !trailer || !out)
+        return -1;
+    if (strcmp(layout, "stereo"))
+        return -1;
+    if (strcmp(trailer, "crc") && strcmp(trailer, "zero"))
+        return -1;
+    if (!(target_db == 0.0 ||
+          (-31.0 <= target_db && target_db <= -10.0)))
+        return -1;
+    dL = pcm_to_double(pcmL, nL);
+    dR = pcm_to_double(pcmR, nR);
+    if (!dL || !dR)
+        goto done;
+    if (target_db != 0.0) {
+        double m, f, tf, gain, bake;
+        int nb = 0, ng = 0, in_peak = 0, peak = 0, sby;
+        int sparse, c16, t16, pid, np6, ni12, nfr0;
+        ac4_loud_integrated(dL, nL, dR, nR, 48000, &m, &nb,
+                        &ng);
+        ac4_loud_flatness(dL, nL, dR, nR, 2048, &f, &tf);
+        for (int k = 0; k < nL; k++)
+            if (ac4_enc_core_abs_sat(pcmL[k]) > in_peak)
+                in_peak = ac4_enc_core_abs_sat(pcmL[k]);
+        for (int k = 0; k < nR; k++)
+            if (ac4_enc_core_abs_sat(pcmR[k]) > in_peak)
+                in_peak = ac4_enc_core_abs_sat(pcmR[k]);
+        if (has_bake)
+            gain = bake_db;
+        else if (isinf(m) && m < 0)
+            gain = 0.0;
+        else
+            gain = ac4_loud_bake_gain(m, f, tf, target_db);
+        bake = pow(10.0, gain / 20.0);
+        bL = av_malloc((size_t)(nL > 0 ? nL : 1) * sizeof *bL);
+        bR = av_malloc((size_t)(nR > 0 ? nR : 1) * sizeof *bR);
+        if (!bL || !bR)
+            goto done;
+        for (int k = 0; k < nL; k++)
+            if (bake_round((double)pcmL[k] * bake, &bL[k]))
+                goto done;
+        for (int k = 0; k < nR; k++)
+            if (bake_round((double)pcmR[k] * bake, &bR[k]))
+                goto done;
+        for (int k = 0; k < nL; k++)
+            if (ac4_enc_core_abs_sat(bL[k]) > peak)
+                peak = ac4_enc_core_abs_sat(bL[k]);
+        for (int k = 0; k < nR; k++)
+            if (ac4_enc_core_abs_sat(bR[k]) > peak)
+                peak = ac4_enc_core_abs_sat(bR[k]);
+        if (!(peak < 32767)) {
+            goto done;
+        }
+        av_free(dL);
+        av_free(dR);
+        dL = pcm_to_double(bL, nL);
+        dR = pcm_to_double(bR, nR);
+        if (!dL || !dR)
+            goto done;
+        sby = ac4_pycompat_round_half_even(-4.0 * target_db);
+        sparse = tf < 0.6 && f > 0.5;
+        c16 = ac4_enc_core_content16(m, in_peak, f, target_db);
+        t16 = ac4_enc_core_tail16(sparse, tf);
+        pid = ac4_enc_core_preset_id(preset ? preset : "manual");
+        if (pid < 0)
+            goto done;
+        np6 = ac4_enc_core_compose_sub0(0, sparse, sby, 0, NULL,
+                                   pid, p6);
+        ni12 = ac4_enc_core_compose_sub0(
+            1, 0, sby, t16, AC4_ENC_CORE_I12_MID_TAIL, pid,
+            i12);
+        nfr0 = ac4_enc_core_compose_sub0(1, sparse, sby, c16,
+                                     NULL, pid, fr0);
+        if (np6 != 6 || ni12 != 12 ||
+            nfr0 != (sparse ? 11 : 12)) {
+            goto done;
+        }
+        memcpy(s4, AC4_ENC_CORE_SUB2_DEE, 4);
+        stampbuf.p6 = p6;
+        stampbuf.n_p6 = 6;
+        stampbuf.i12 = i12;
+        stampbuf.n_i12 = 12;
+        stampbuf.s4 = s4;
+        stampbuf.n_s4 = 4;
+        stampbuf.fr0 = fr0;
+        stampbuf.n_fr0 = nfr0;
+        stamp = &stampbuf;
+        flat_file = f > AC4_ENC_CORE_FLAT_F_THRESH;
+    } else {
+        double f, tf;
+        ac4_loud_flatness(dL, nL, dR, nR, 2048, &f, &tf);
+        flat_file = f > AC4_ENC_CORE_FLAT_F_THRESH;
+    }
+    n = encode_pcm_frames(dL, nL, dR, nR, rate_kbps, layout,
+                          interval, trailer, window, ns2_tone,
+                          shorts, joint_shorts, forced, nforced,
+                          drc, dmx, priming, iframe_base,
+                          iframe_total, stamp, flat_file, out,
+                          outcap);
+done:
+    av_free(bL);
+    av_free(bR);
+    av_free(dL);
+    av_free(dR);
+    return n;
+}
+
+static int
+encode_pcm_frames(const double *dL, int nL, const double *dR,
+                  int nR, int rate_kbps, const char *layout,
+                  const char *interval, const char *trailer,
+                  const double *window, int ns2_tone, int shorts,
+                  int joint_shorts, const int *forced, int nforced,
+                  const ac4_enc_core_drc_t *drc, const int *dmx,
+                  int priming, int iframe_base, int iframe_total,
+                  const ac4_enc_core_stamp_t *stamp, int flat_file,
+                  uint8_t *out, size_t outcap)
+{
+    /* r2: thin wrapper over the incremental engine (feed all,
+     * drain with sync wrap). Byte-identical to the former
+     * whole-stream body by construction (same per-frame code). */
+    ac4_enc_step_ctx_t *st = NULL;
+    ac4_enc_step_cfg_t cfg;
+    const double *rows[2];
+    int ns[2];
+    int lines[7], nlines, nsamples, nframes;
+    uint8_t *raw = NULL;
+    int n = -1, pos = 0;
+    double freq;
+    if (!dL || !dR || nL < 0 || nR < 0 || !layout ||
+        !trailer || !out)
+        return -1;
+    nsamples = nL > nR ? nL : nR;
+    if (priming)
+        nframes = ac4_enc_core_nframes_for_samples(nsamples);
+    else if (nsamples <= 0)
+        nframes = 0;
+    else
+        nframes = (nsamples + AC4_ENC_CORE_FRAME_SAMPLES - 1) /
+            AC4_ENC_CORE_FRAME_SAMPLES;
+    freq = ac4_mdct_estimate_freq(dL, nL, 50.0, 20000.0);
+    nlines = ac4_mdct_lines_for_freq(freq, 3, lines);
+    if (nlines < 0)
+        return -1;
+    memset(&cfg, 0, sizeof cfg);
+    cfg.nch = 2;
+    cfg.rate_kbps = rate_kbps;
+    cfg.layout = layout;
+    cfg.interval = interval;
+    cfg.window = window;
+    cfg.ns2_tone = ns2_tone;
+    cfg.shorts = shorts;
+    cfg.joint_shorts = joint_shorts;
+    cfg.forced = forced;
+    cfg.nforced = nforced;
+    cfg.drc = drc;
+    cfg.dmx = dmx;
+    cfg.priming = priming;
+    cfg.iframe_base = iframe_base;
+    cfg.iframe_total =
+        (!priming && iframe_total < 0) ? nframes
+                                       : iframe_total;
+    cfg.stamp = stamp;
+    cfg.flat_file = flat_file;
+    cfg.nlines = nlines;
+    memcpy(cfg.lines, lines, sizeof lines);
+    if (ac4_enc_step_open(&st, &cfg))
+        return -1;
+    rows[0] = dL;
+    rows[1] = dR;
+    ns[0] = nL;
+    ns[1] = nR;
+    if (ac4_enc_step_feed(st, rows, ns) || ac4_enc_step_end(st))
+        goto done;
+    raw = av_malloc(65536);
+    if (!raw)
+        goto done;
+    for (;;) {
+        size_t olen = 0;
+        int is_if = 0, rc, n_sync;
+        rc = ac4_enc_step_ready(st);
+        if (rc < 0)
+            goto done;
+        if (rc == 0)
+            break;
+        rc = ac4_enc_step_emit(st, raw, 65536, &olen, &is_if);
+        if (rc != 1 || olen > 65536)
+            goto done;
+        n_sync = ac4_enc_core_write_sync_frame(
+            raw, (int)olen, trailer, out + pos,
+            outcap - (size_t)pos);
+        if (n_sync < 0)
+            goto done;
+        pos += n_sync;
+    }
+    n = pos;
+done:
+    av_free(raw);
+    ac4_enc_step_close(st);
+    return n;
+}
+
+/* 5.1 content frames from double PCM (post-bake baked ints
+ * as doubles, or raw rows at target 0). Shared by the int and
+ * float entries; bytes or -1. */
+static int encode_pcm_mc_frames(const double *const *dp,
+                                const int *lens, int rate_kbps,
+                                const char *interval,
+                                const char *trailer,
+                                const double *window, int shorts,
+                                const int *forced, int nforced,
+                                const ac4_enc_core_drc_t *drc,
+                                const int *dmx,
+                                const ac4_enc_core_stamp_t *stamp51,
+                                int flat_file, uint8_t *out,
+                                size_t outcap);
+
+int
+ac4_enc_core_encode_pcm_mc(const int *const *chs, const int *lens,
+                       int rate_kbps, const char *interval,
+                       const char *trailer,
+                       const double *window, double target_db,
+                       int has_bake, double bake_db, int shorts,
+                       const int *const *meter_chs,
+                       const int *meter_lens,
+                       const int *forced, int nforced,
+                       const char *preset,
+                       const ac4_enc_core_drc_t *drc, const int *dmx,
+                       uint8_t *out, size_t outcap)
+{
+    int *pcm[6];
+    double *dp[6];
+    uint8_t p6[6], i15[15], s4[4], fr0[15];
+    ac4_enc_core_stamp_t stampbuf;
+    const ac4_enc_core_stamp_t *stamp51 = NULL;
+    int n6 = 0;
+    int flat_file = 0;
+    int n = -1;
+    if (!chs || !lens || !trailer || !out)
+        return -1;
+    if (strcmp(trailer, "crc") && strcmp(trailer, "zero"))
+        return -1;
+    if (!(target_db == 0.0 ||
+          (-31.0 <= target_db && target_db <= -10.0)))
+        return -1;
+    for (int c = 0; c < 6; c++) {
+        pcm[c] = NULL;
+        dp[c] = NULL;
+        if (!chs[c] || lens[c] < 0)
+            goto done;
+        if (lens[c] > n6)
+            n6 = lens[c];
+    }
+    for (int c = 0; c < 6; c++) {
+        pcm[c] = av_malloc(
+            (size_t)(lens[c] > 0 ? lens[c] : 1) *
+            sizeof *pcm[c]);
+        if (!pcm[c])
+            goto done;
+        memcpy(pcm[c], chs[c],
+               (size_t)lens[c] * sizeof *pcm[c]);
+        dp[c] = pcm_to_double(pcm[c], lens[c]);
+        if (!dp[c])
+            goto done;
+    }
+    if (target_db != 0.0) {
+        const int *met[6];
+        int metlens[6];
+        double *dm[6];
+        double *mono6 = NULL;
+        double m, f, tf, gain, bake, lfe_bake, lin[6];
+        int nb = 0, ng = 0, peak = 0, sby, c16, pid;
+        int hits51, np6, ni15, nfr0, nm = 0;
+        for (int c = 0; c < 6; c++) {
+            dm[c] = NULL;
+            if (meter_chs) {
+                if (!meter_chs[c] || !meter_lens ||
+                    meter_lens[c] < 0)
+                    goto done;
+                met[c] = meter_chs[c];
+                metlens[c] = meter_lens[c];
+            } else {
+                met[c] = pcm[c];
+                metlens[c] = lens[c];
+            }
+            if (metlens[c] > nm)
+                nm = metlens[c];
+        }
+        for (int c = 0; c < 6; c++) {
+            dm[c] = pcm_to_double(met[c], metlens[c]);
+            if (!dm[c]) {
+                for (int k = 0; k < c; k++)
+                    av_free(dm[k]);
+                goto done;
+            }
+        }
+        {
+            const double *dmp[6];
+            for (int c = 0; c < 6; c++)
+                dmp[c] = dm[c];
+            ac4_loud_integrated_mc(dmp, metlens, 48000, &m,
+                               &nb, &ng);
+        }
+        mono6 = av_malloc((size_t)(nm > 0 ? nm : 1) *
+                       sizeof *mono6);
+        if (!mono6) {
+            for (int c = 0; c < 6; c++)
+                av_free(dm[c]);
+            goto done;
+        }
+        for (int k = 0; k < nm; k++) {
+            long long s = 0;
+            for (int c = 0; c < 6; c++)
+                s += k < metlens[c] ? met[c][k] : 0;
+            mono6[k] = (double)s / 6.0;
+        }
+        ac4_loud_flatness(mono6, nm, mono6, nm, 2048, &f, &tf);
+        av_free(mono6);
+        for (int c = 0; c < 6; c++) {
+            for (int k = 0; k < metlens[c]; k++)
+                if (ac4_enc_core_abs_sat(met[c][k]) > peak)
+                    peak = ac4_enc_core_abs_sat(met[c][k]);
+            av_free(dm[c]);
+        }
+        flat_file = f > AC4_ENC_CORE_FLAT_F_THRESH;
+        hits51 = tf < 0.6 && f > 0.5;
+        if (has_bake)
+            gain = bake_db;
+        else if (isinf(m) && m < 0)
+            gain = 0.0;
+        else if (hits51)
+            gain = AC4_ENC_CORE_T_HIT_51_DB -
+                (m > -23.0 ? m : -23.0) +
+                (target_db + 24.0);
+        else
+            gain = target_db - m;
+        bake = pow(10.0, gain / 20.0);
+        for (int c = 0; c < 6; c++)
+            lin[c] = pow(
+                10.0, AC4_ENC_CORE_LEG_COMP_51_DB[c] / 20.0);
+        lfe_bake = hits51
+            ? pow(10.0, AC4_ENC_CORE_LFE_HITS_BAKE_DB / 20.0)
+            : bake;
+        for (int c = 0; c < 6; c++) {
+            double bc = c == 3 ? lfe_bake : bake;
+            for (int k = 0; k < lens[c]; k++) {
+                double v =
+                    (double)pcm[c][k] * bc * lin[c];
+                if (bake_round(v, &pcm[c][k]))
+                    goto done;
+            }
+        }
+        {
+            int pk = 0;
+            for (int c = 0; c < 6; c++)
+                for (int k = 0; k < lens[c]; k++)
+                    if (ac4_enc_core_abs_sat(pcm[c][k]) > pk)
+                        pk = ac4_enc_core_abs_sat(pcm[c][k]);
+            if (!(pk < 32767)) {
+                goto done;
+            }
+        }
+        for (int c = 0; c < 6; c++) {
+            av_free(dp[c]);
+            dp[c] = pcm_to_double(pcm[c], lens[c]);
+            if (!dp[c])
+                goto done;
+        }
+        sby = ac4_pycompat_round_half_even(-4.0 * target_db);
+        c16 = ac4_enc_core_content16(m, peak, f, target_db);
+        pid = ac4_enc_core_preset_id(preset ? preset : "manual");
+        if (pid < 0)
+            goto done;
+        nfr0 = ac4_enc_core_compose_sub0_51(sby, c16, NULL, pid,
+                                        dmx, fr0);
+        ni15 = ac4_enc_core_compose_sub0_51(
+            sby, AC4_ENC_CORE_TAIL16_DENSE,
+            AC4_ENC_CORE_I12_MID_TAIL, pid, dmx, i15);
+        np6 = ac4_enc_core_compose_sub0(0, 0, sby, 0, NULL, pid,
+                                   p6);
+        if (nfr0 != 15 || ni15 != 15 || np6 != 6) {
+            goto done;
+        }
+        memcpy(s4, AC4_ENC_CORE_SUB2_DEE, 4);
+        stampbuf.p6 = p6;
+        stampbuf.n_p6 = 6;
+        stampbuf.i12 = i15;
+        stampbuf.n_i12 = 15;
+        stampbuf.s4 = s4;
+        stampbuf.n_s4 = 4;
+        stampbuf.fr0 = fr0;
+        stampbuf.n_fr0 = 15;
+        stamp51 = &stampbuf;
+    } else {
+        double *mono6 = av_malloc(
+            (size_t)(n6 > 0 ? n6 : 1) * sizeof *mono6);
+        double f, tf;
+        if (!mono6)
+            goto done;
+        for (int k = 0; k < n6; k++) {
+            long long s = 0;
+            for (int c = 0; c < 6; c++)
+                s += k < lens[c] ? pcm[c][k] : 0;
+            mono6[k] = (double)s / 6.0;
+        }
+        ac4_loud_flatness(mono6, n6, mono6, n6, 2048, &f, &tf);
+        av_free(mono6);
+        flat_file = f > AC4_ENC_CORE_FLAT_F_THRESH;
+    }
+    {
+        const double *dpp[6];
+        for (int c = 0; c < 6; c++)
+            dpp[c] = dp[c];
+        n = encode_pcm_mc_frames(dpp, lens, rate_kbps, interval,
+                                 trailer, window, shorts, forced,
+                                 nforced, drc, dmx, stamp51,
+                                 flat_file, out, outcap);
+    }
+done:
+    for (int c = 0; c < 6; c++) {
+        av_free(pcm[c]);
+        av_free(dp[c]);
+    }
+    return n;
+}
+
+static int
+encode_pcm_mc_frames(const double *const *dp, const int *lens,
+                     int rate_kbps, const char *interval,
+                     const char *trailer, const double *window,
+                     int shorts, const int *forced, int nforced,
+                     const ac4_enc_core_drc_t *drc, const int *dmx,
+                     const ac4_enc_core_stamp_t *stamp51,
+                     int flat_file, uint8_t *out,
+                     size_t outcap)
+{
+    /* r2: thin wrapper over the incremental engine (feed all,
+     * drain with sync wrap). Byte-identical to the former
+     * whole-stream body by construction (same per-frame code). */
+    ac4_enc_step_ctx_t *st = NULL;
+    ac4_enc_step_cfg_t cfg;
+    uint8_t *raw = NULL;
+    int n = -1, pos = 0;
+    if (!dp || !lens || !trailer || !out)
+        return -1;
+    for (int ch = 0; ch < 6; ch++)
+        if (!dp[ch] || lens[ch] < 0)
+            return -1;
+    memset(&cfg, 0, sizeof cfg);
+    cfg.nch = 6;
+    cfg.rate_kbps = rate_kbps;
+    cfg.interval = interval;
+    cfg.window = window;
+    cfg.shorts = shorts;
+    cfg.forced = forced;
+    cfg.nforced = nforced;
+    cfg.drc = drc;
+    cfg.dmx = dmx;
+    cfg.stamp = stamp51;
+    cfg.flat_file = flat_file;
+    if (ac4_enc_step_open(&st, &cfg))
+        return -1;
+    if (ac4_enc_step_feed(st, dp, lens) || ac4_enc_step_end(st))
+        goto done;
+    raw = av_malloc(65536);
+    if (!raw)
+        goto done;
+    for (;;) {
+        size_t olen = 0;
+        int is_if = 0, rc, n_sync;
+        rc = ac4_enc_step_ready(st);
+        if (rc < 0)
+            goto done;
+        if (rc == 0)
+            break;
+        rc = ac4_enc_step_emit(st, raw, 65536, &olen, &is_if);
+        if (rc != 1 || olen > 65536)
+            goto done;
+        n_sync = ac4_enc_core_write_sync_frame(
+            raw, (int)olen, trailer, out + pos,
+            outcap - (size_t)pos);
+        if (n_sync < 0)
+            goto done;
+        pos += n_sync;
+    }
+    n = pos;
+done:
+    av_free(raw);
+    ac4_enc_step_close(st);
+    return n;
+}
+
+/* Copy caller double rows (post-fold PCM). */
+static double *
+dbl_copy(const double *pcm, int n)
+{
+    double *d = av_malloc((size_t)(n > 0 ? n : 1) * sizeof *d);
+    if (!d)
+        return NULL;
+    if (n > 0)
+        memcpy(d, pcm, (size_t)n * sizeof *d);
+    return d;
+}
+
+int
+ac4_enc_core_encode_pcm_f(const double *pcmL, int nL,
+                      const double *pcmR, int nR, int rate_kbps,
+                      const char *layout, const char *interval,
+                      const char *trailer,
+                      const double *window, int ns2_tone,
+                      int shorts, double target_db, int has_bake,
+                      double bake_db, int joint_shorts,
+                      const int *forced, int nforced,
+                      const char *preset, const ac4_enc_core_drc_t *drc,
+                      const int *dmx, int priming, int iframe_base,
+                      int iframe_total, uint8_t *out,
+                      size_t outcap)
+{
+    int *bL = NULL, *bR = NULL;
+    double *dL = NULL, *dR = NULL;
+    uint8_t p6[6], i12[12], s4[4], fr0[12];
+    ac4_enc_core_stamp_t stampbuf;
+    const ac4_enc_core_stamp_t *stamp = NULL;
+    int flat_file = 0;
+    int n = -1;
+    if (!pcmL || !pcmR || nL < 0 || nR < 0 || !layout ||
+        !trailer || !out)
+        return -1;
+    if (strcmp(layout, "stereo"))
+        return -1;
+    if (strcmp(trailer, "crc") && strcmp(trailer, "zero"))
+        return -1;
+    if (!(target_db == 0.0 ||
+          (-31.0 <= target_db && target_db <= -10.0)))
+        return -1;
+    dL = dbl_copy(pcmL, nL);
+    dR = dbl_copy(pcmR, nR);
+    if (!dL || !dR)
+        goto done;
+    if (target_db != 0.0) {
+        double m, f, tf, gain, bake, in_peak = 0.0;
+        int nb = 0, ng = 0, peak = 0, sby;
+        int sparse, c16, t16, pid, np6, ni12, nfr0;
+        ac4_loud_integrated(dL, nL, dR, nR, 48000, &m, &nb,
+                        &ng);
+        ac4_loud_flatness(dL, nL, dR, nR, 2048, &f, &tf);
+        for (int k = 0; k < nL; k++)
+            if (fabs(dL[k]) > in_peak)
+                in_peak = fabs(dL[k]);
+        for (int k = 0; k < nR; k++)
+            if (fabs(dR[k]) > in_peak)
+                in_peak = fabs(dR[k]);
+        if (has_bake)
+            gain = bake_db;
+        else if (isinf(m) && m < 0)
+            gain = 0.0;
+        else
+            gain = ac4_loud_bake_gain(m, f, tf, target_db);
+        bake = pow(10.0, gain / 20.0);
+        bL = av_malloc((size_t)(nL > 0 ? nL : 1) * sizeof *bL);
+        bR = av_malloc((size_t)(nR > 0 ? nR : 1) * sizeof *bR);
+        if (!bL || !bR)
+            goto done;
+        for (int k = 0; k < nL; k++)
+            if (bake_round(dL[k] * bake, &bL[k]))
+                goto done;
+        for (int k = 0; k < nR; k++)
+            if (bake_round(dR[k] * bake, &bR[k]))
+                goto done;
+        for (int k = 0; k < nL; k++)
+            if (ac4_enc_core_abs_sat(bL[k]) > peak)
+                peak = ac4_enc_core_abs_sat(bL[k]);
+        for (int k = 0; k < nR; k++)
+            if (ac4_enc_core_abs_sat(bR[k]) > peak)
+                peak = ac4_enc_core_abs_sat(bR[k]);
+        if (!(peak < 32767)) {
+            goto done;
+        }
+        av_free(dL);
+        av_free(dR);
+        dL = pcm_to_double(bL, nL);
+        dR = pcm_to_double(bR, nR);
+        if (!dL || !dR)
+            goto done;
+        sby = ac4_pycompat_round_half_even(-4.0 * target_db);
+        sparse = tf < 0.6 && f > 0.5;
+        c16 = ac4_enc_core_content16_f(m, in_peak, f, target_db);
+        t16 = ac4_enc_core_tail16(sparse, tf);
+        pid = ac4_enc_core_preset_id(preset ? preset : "manual");
+        if (pid < 0)
+            goto done;
+        np6 = ac4_enc_core_compose_sub0(0, sparse, sby, 0, NULL,
+                                   pid, p6);
+        ni12 = ac4_enc_core_compose_sub0(
+            1, 0, sby, t16, AC4_ENC_CORE_I12_MID_TAIL, pid,
+            i12);
+        nfr0 = ac4_enc_core_compose_sub0(1, sparse, sby, c16,
+                                     NULL, pid, fr0);
+        if (np6 != 6 || ni12 != 12 ||
+            nfr0 != (sparse ? 11 : 12)) {
+            goto done;
+        }
+        memcpy(s4, AC4_ENC_CORE_SUB2_DEE, 4);
+        stampbuf.p6 = p6;
+        stampbuf.n_p6 = 6;
+        stampbuf.i12 = i12;
+        stampbuf.n_i12 = 12;
+        stampbuf.s4 = s4;
+        stampbuf.n_s4 = 4;
+        stampbuf.fr0 = fr0;
+        stampbuf.n_fr0 = nfr0;
+        stamp = &stampbuf;
+        flat_file = f > AC4_ENC_CORE_FLAT_F_THRESH;
+    } else {
+        double f, tf;
+        ac4_loud_flatness(dL, nL, dR, nR, 2048, &f, &tf);
+        flat_file = f > AC4_ENC_CORE_FLAT_F_THRESH;
+    }
+    n = encode_pcm_frames(dL, nL, dR, nR, rate_kbps, layout,
+                          interval, trailer, window, ns2_tone,
+                          shorts, joint_shorts, forced, nforced,
+                          drc, dmx, priming, iframe_base,
+                          iframe_total, stamp, flat_file, out,
+                          outcap);
+done:
+    av_free(bL);
+    av_free(bR);
+    av_free(dL);
+    av_free(dR);
+    return n;
+}
+
+int
+ac4_enc_core_encode_pcm_mc_f(const double *const *chs,
+                         const int *lens, int rate_kbps,
+                         const char *interval, const char *trailer,
+                         const double *window, double target_db,
+                         int has_bake, double bake_db, int shorts,
+                         const double *const *meter_chs,
+                         const int *meter_lens, const int *forced,
+                         int nforced, const char *preset,
+                         const ac4_enc_core_drc_t *drc, const int *dmx,
+                         uint8_t *out, size_t outcap)
+{
+    double *fc[6];
+    int *pcm[6];
+    double *dp[6];
+    uint8_t p6[6], i15[15], s4[4], fr0[15];
+    ac4_enc_core_stamp_t stampbuf;
+    const ac4_enc_core_stamp_t *stamp51 = NULL;
+    int n6 = 0;
+    int flat_file = 0;
+    int n = -1;
+    if (!chs || !lens || !trailer || !out)
+        return -1;
+    if (strcmp(trailer, "crc") && strcmp(trailer, "zero"))
+        return -1;
+    if (!(target_db == 0.0 ||
+          (-31.0 <= target_db && target_db <= -10.0)))
+        return -1;
+    for (int c = 0; c < 6; c++) {
+        fc[c] = NULL;
+        pcm[c] = NULL;
+        dp[c] = NULL;
+        if (!chs[c] || lens[c] < 0)
+            goto done;
+        if (lens[c] > n6)
+            n6 = lens[c];
+    }
+    for (int c = 0; c < 6; c++) {
+        fc[c] = dbl_copy(chs[c], lens[c]);
+        if (!fc[c])
+            goto done;
+    }
+    if (target_db != 0.0) {
+        const double *met[6];
+        int metlens[6];
+        double *mono6 = NULL;
+        double m, f, tf, gain, bake, lfe_bake, lin[6];
+        double peak = 0.0;
+        int nb = 0, ng = 0, sby, c16, pid;
+        int hits51, np6, ni15, nfr0, nm = 0;
+        for (int c = 0; c < 6; c++) {
+            if (meter_chs) {
+                if (!meter_chs[c] || !meter_lens ||
+                    meter_lens[c] < 0)
+                    goto done;
+                met[c] = meter_chs[c];
+                metlens[c] = meter_lens[c];
+            } else {
+                met[c] = fc[c];
+                metlens[c] = lens[c];
+            }
+            if (metlens[c] > nm)
+                nm = metlens[c];
+        }
+        ac4_loud_integrated_mc(met, metlens, 48000, &m, &nb,
+                           &ng);
+        mono6 = av_malloc((size_t)(nm > 0 ? nm : 1) *
+                       sizeof *mono6);
+        if (!mono6)
+            goto done;
+        for (int k = 0; k < nm; k++) {
+            double v6[6];
+            for (int c = 0; c < 6; c++)
+                v6[c] = k < metlens[c] ? met[c][k] : 0.0;
+            mono6[k] = ac4_pycompat_sum(v6, 6) / 6.0;
+        }
+        ac4_loud_flatness(mono6, nm, mono6, nm, 2048, &f, &tf);
+        av_free(mono6);
+        for (int c = 0; c < 6; c++)
+            for (int k = 0; k < metlens[c]; k++)
+                if (fabs(met[c][k]) > peak)
+                    peak = fabs(met[c][k]);
+        flat_file = f > AC4_ENC_CORE_FLAT_F_THRESH;
+        hits51 = tf < 0.6 && f > 0.5;
+        if (has_bake)
+            gain = bake_db;
+        else if (isinf(m) && m < 0)
+            gain = 0.0;
+        else if (hits51)
+            gain = AC4_ENC_CORE_T_HIT_51_DB -
+                (m > -23.0 ? m : -23.0) +
+                (target_db + 24.0);
+        else
+            gain = target_db - m;
+        bake = pow(10.0, gain / 20.0);
+        for (int c = 0; c < 6; c++)
+            lin[c] = pow(
+                10.0, AC4_ENC_CORE_LEG_COMP_51_DB[c] / 20.0);
+        lfe_bake = hits51
+            ? pow(10.0, AC4_ENC_CORE_LFE_HITS_BAKE_DB / 20.0)
+            : bake;
+        for (int c = 0; c < 6; c++) {
+            double bc = c == 3 ? lfe_bake : bake;
+            pcm[c] = av_malloc((size_t)(lens[c] > 0 ? lens[c]
+                                                 : 1) *
+                            sizeof *pcm[c]);
+            if (!pcm[c])
+                goto done;
+            for (int k = 0; k < lens[c]; k++) {
+                double v = fc[c][k] * bc * lin[c];
+                if (bake_round(v, &pcm[c][k]))
+                    goto done;
+            }
+        }
+        {
+            int pk = 0;
+            for (int c = 0; c < 6; c++)
+                for (int k = 0; k < lens[c]; k++)
+                    if (ac4_enc_core_abs_sat(pcm[c][k]) > pk)
+                        pk = ac4_enc_core_abs_sat(pcm[c][k]);
+            if (!(pk < 32767)) {
+                goto done;
+            }
+        }
+        for (int c = 0; c < 6; c++) {
+            dp[c] = pcm_to_double(pcm[c], lens[c]);
+            if (!dp[c])
+                goto done;
+        }
+        sby = ac4_pycompat_round_half_even(-4.0 * target_db);
+        c16 = ac4_enc_core_content16_f(m, peak, f, target_db);
+        pid = ac4_enc_core_preset_id(preset ? preset : "manual");
+        if (pid < 0)
+            goto done;
+        nfr0 = ac4_enc_core_compose_sub0_51(sby, c16, NULL, pid,
+                                        dmx, fr0);
+        ni15 = ac4_enc_core_compose_sub0_51(
+            sby, AC4_ENC_CORE_TAIL16_DENSE,
+            AC4_ENC_CORE_I12_MID_TAIL, pid, dmx, i15);
+        np6 = ac4_enc_core_compose_sub0(0, 0, sby, 0, NULL, pid,
+                                   p6);
+        if (nfr0 != 15 || ni15 != 15 || np6 != 6) {
+            goto done;
+        }
+        memcpy(s4, AC4_ENC_CORE_SUB2_DEE, 4);
+        stampbuf.p6 = p6;
+        stampbuf.n_p6 = 6;
+        stampbuf.i12 = i15;
+        stampbuf.n_i12 = 15;
+        stampbuf.s4 = s4;
+        stampbuf.n_s4 = 4;
+        stampbuf.fr0 = fr0;
+        stampbuf.n_fr0 = 15;
+        stamp51 = &stampbuf;
+    } else {
+        double *mono6 = av_malloc(
+            (size_t)(n6 > 0 ? n6 : 1) * sizeof *mono6);
+        double f, tf;
+        if (!mono6)
+            goto done;
+        for (int k = 0; k < n6; k++) {
+            double v6[6];
+            for (int c = 0; c < 6; c++)
+                v6[c] = k < lens[c] ? fc[c][k] : 0.0;
+            mono6[k] = ac4_pycompat_sum(v6, 6) / 6.0;
+        }
+        ac4_loud_flatness(mono6, n6, mono6, n6, 2048, &f, &tf);
+        av_free(mono6);
+        flat_file = f > AC4_ENC_CORE_FLAT_F_THRESH;
+        for (int c = 0; c < 6; c++) {
+            dp[c] = dbl_copy(fc[c], lens[c]);
+            if (!dp[c])
+                goto done;
+        }
+    }
+    {
+        const double *dpp[6];
+        for (int c = 0; c < 6; c++)
+            dpp[c] = dp[c];
+        n = encode_pcm_mc_frames(dpp, lens, rate_kbps,
+                                 interval, trailer, window,
+                                 shorts, forced, nforced, drc,
+                                 dmx, stamp51, flat_file, out,
+                                 outcap);
+    }
+done:
+    for (int c = 0; c < 6; c++) {
+        av_free(fc[c]);
+        av_free(pcm[c]);
+        av_free(dp[c]);
+    }
+    return n;
+}
