+/* Raw spectral legs (refs None): validate ranges only. */
+static int
+raw_legs_ok(const int *linesL, const int *qsL, int nL,
+            const int *linesR, const int *qsR, int nR)
+{
+    const int *offs = ac4_sfb_offsets48(2048);
+    if (!offs)
+        return -1;
+    if (leg_sf_ok(linesL, qsL, nL, 100,
+                  AC4_ENC_CORE_MAX_SFB_FULL, NULL, NULL, offs))
+        return -1;
+    if (leg_sf_ok(linesR, qsR, nR, 100,
+                  AC4_ENC_CORE_MAX_SFB_FULL, NULL, NULL, offs))
+        return -1;
+    return 0;
+}
+
+int
+ac4_enc_core_write_audio_spectral(const int *linesL, const int *qsL,
+                              int nL, int refL, const int *linesR,
+                              const int *qsR, int nR, int refR,
+                              uint8_t *out, size_t outcap)
+{
+    const int *offs = ac4_sfb_offsets48(2048);
+    ac4_bitwriter_t w;
+    int n;
+    if (!out || !offs || refL < 0 || refL > 255 || refR < 0 ||
+        refR > 255)
+        return -1;
+    if (raw_legs_ok(linesL, qsL, nL, linesR, qsR, nR))
+        return -1;
+    ac4_bw_init(&w);
+    ac4_bw_put(&w, 0, 2);
+    ac4_bw_put(&w, 0, 1);
+    ac4_bw_put(&w, 0, 1);
+    sf_info_fullband(&w);
+    ac4_bw_put(&w, 0, 1);
+    sf_info_fullband(&w);
+    ac4_asf_write_sf_data(&w, linesL, qsL, nL, refL,
+                      AC4_ENC_CORE_MAX_SFB_FULL, NULL, 0, offs, 5);
+    ac4_asf_write_sf_data(&w, linesR, qsR, nR, refR,
+                      AC4_ENC_CORE_MAX_SFB_FULL, NULL, 0, offs, 5);
+    ac4_bw_align(&w, 0);
+    n = w_extract(&w, out, outcap);
+    ac4_bw_free(&w);
+    return n;
+}
+
+static int
+audio_fullband_w(ac4_bitwriter_t *w, const ac4_enc_core_leg_t *l,
