index 41330bc7bb..cc882e0b5a 100644
--- a/tests/fate/ac4.mak
+++ b/tests/fate/ac4.mak
@@ -274,5 +274,38 @@ fate-ac4-parser: CMP = null
 
 fate-ac4-parse: $(FATE_AC4_PARSE-yes)
 
-FATE-yes += $(FATE_AC4_PARSE-yes)
