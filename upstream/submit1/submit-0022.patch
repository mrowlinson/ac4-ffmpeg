+FATE-yes += $(FATE_AC4_PARSE-yes) $(FATE_AC4_MP4-yes) $(FATE_AC4_RT-yes)
+# AC-4 MP4 mux/demux roundtrip. Frames and DSI are synthesized inside
+# the test tool, so this needs no fate-suite samples either: bare and
+# Annex G framed inputs mux to MP4 and demux back with byte-exact dac4
+# extradata, stsz/packet counts and payloads, plus mux/demux negatives.
+FATE_AC4_MP4-$(call ALLYES, MP4_MUXER MOV_DEMUXER AC4_PARSER) += fate-ac4-mp4-roundtrip
+fate-ac4-mp4-roundtrip: $(APITESTSDIR)/api-ac4-mp4-roundtrip-test$(EXESUF)
+fate-ac4-mp4-roundtrip: CMD = run $(APITESTSDIR)/api-ac4-mp4-roundtrip-test$(EXESUF)
+fate-ac4-mp4-roundtrip: CMP = null
+
+fate-ac4-mp4: $(FATE_AC4_MP4-yes)
+
+# --- T3: encoder->decoder audio roundtrip (priming/skip + DSI end-to-end) ---
+# Synth stereo encodes to raw AC-4 (GEN, no suite samples) and decodes
+# back; the framemd5 golden pins the 4096 first-frame offset, catching
+# encoder initial_padding vs decoder skip handling. Needs A+C+E
+# in-stack, so it rides the D tip.
+tests/data/fate/ac4-roundtrip.ac4: TAG = GEN
+tests/data/fate/ac4-roundtrip.ac4: tests/data/asynth-48000-2.wav
+tests/data/fate/ac4-roundtrip.ac4: ffmpeg$(PROGSSUF)$(EXESUF) | tests/data/fate
+	$(M)$(TARGET_EXEC) $(TARGET_PATH)/$< \
+	-hide_banner -loglevel error -nostdin \
+	-i $(TARGET_PATH)/tests/data/asynth-48000-2.wav \
+	-c:a ac4 -strict -2 -ab 128k -loudness_target 0 \
+	-flags +bitexact -fflags +bitexact -af aresample \
+	-f ac4 -y $(TARGET_PATH)/$@
+FATE_AC4_RT-$(call ALLYES, FFMPEG AC4_ENCODER AC4_DECODER AC4_MUXER AC4_DEMUXER \
+    WAV_DEMUXER PCM_S16LE_DECODER ARESAMPLE_FILTER FILE_PROTOCOL) += fate-ac4-roundtrip
+fate-ac4-roundtrip: tests/data/fate/ac4-roundtrip.ac4
+fate-ac4-roundtrip: SRC = $(TARGET_PATH)/tests/data/fate/ac4-roundtrip.ac4
+fate-ac4-roundtrip: CMD = framemd5 -strict -2 -i "$(SRC)"
+
+fate-ac4-rt: $(FATE_AC4_RT-yes)
+
+fate-ac4: $(FATE_AC4-yes) $(FATE_AC4_MD5-yes) $(FATE_AC4_REMUX-yes) $(FATE_AC4_ENCNEG-yes) $(FATE_AC4_ENC-yes) $(FATE_AC4_MPEGTS_PMT-yes) $(FATE_AC4_MPEGTS_PROBE-yes) $(FATE_AC4_PARSE-yes) $(FATE_AC4_MP4-yes) $(FATE_AC4_RT-yes)
