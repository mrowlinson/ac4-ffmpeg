 tests/ref/fate/ac4-fold8    |   1 +
 tests/ref/fate/ac4-framecrc |   1 +
 tests/ref/fate/ac4-tail     |   1 +
 10 files changed, 810 insertions(+), 1 deletion(-)
 create mode 100644 libavcodec/ac4dsi.c
 create mode 100644 libavcodec/ac4dsi.h
