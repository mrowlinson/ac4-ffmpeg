+
+#ifndef AVCODEC_AC4ENC_H
+#define AVCODEC_AC4ENC_H
+
+#include <stdint.h>
+
+#include "libavutil/opt.h"
+
+#include "ac4enc_lib.h"
+
+#define AC4ENC_MAX_CHANNELS 6
+
+typedef struct AC4EncodeContext {
+    const AVClass *class;
+
+    /* AVOptions (see ac4enc.c). */
+    char *iframe_interval;
+    int   priming;
+    int   short_blocks;
+    int   joint_shorts;
+    int   measure_loudness;
+    double loudness_target;
+
+    /* Validated at init; lib opened at first flush. */
+    int rate_kbps;
+    int nch;
+
+    /* Whole-stream input buffer: nch ch-major int rows in s16
+     * scale (CLI f32-ingest rule: round-half-even + clamp). */
+    int *pcm[AC4ENC_MAX_CHANNELS];
+    int  nsamples;
+    int  cap;
+
+    /* Drained packets (bare raw frames), served one per call. */
+    uint8_t *blob;
+    size_t   blob_cap;
+    size_t   blob_used;
+    int     *offs;
+    int     *lens;
+    int     *iframes;
+    int      nframes;
+    int      frames_cap; /* m5: exponential index growth */
+    int      cursor;
+    int      tail_rem;   /* m2: input samples in the short last frame */
+
+    /* m1: first non-NOPTS input pts, anchoring packet timestamps. */
+    int64_t  pts_base;
+    int      have_pts_base;
+
+    int opened;   /* lib encode done (success or loud failure) */
+    int failed;   /* sticky encode-side error (already logged) */
+} AC4EncodeContext;
+
+#endif /* AVCODEC_AC4ENC_H */
