+static unsigned br_u(br_t *b, int n) {
+    unsigned v = 0;
+    for (int i = 0; i < n; i++) {
+        if (b->pos >= b->nbits) {
+            b->err = 1;
+            return 0;
+        }
+        v = (v << 1) |
+            ((b->d[b->pos >> 3] >> (7 - (b->pos & 7))) & 1u);
+        b->pos++;
+    }
+    return v;
+}
