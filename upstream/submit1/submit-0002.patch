+     * row scan). Initialize all outputs up front. */
+    *ngi = 0;
+    *frf = 1;
+    *pndot = 0;
+    int single = (int)br_u(b, 1);
+    int cfg = -1;
+    if (!single) {
+        cfg = (int)br_u(b, 3);
+        if (cfg == 7)
+            cfg += (int)br_var(b, 2);
+    }
+    unsigned ver = 0;
+    while (br_u(b, 1) == 1) {
+        ver++;
+        if (ver > 8 || b->err)
+            return -1;
+    }
+    *pver = (int)ver;
+    int add_emdf = 0;
+    if (!single && cfg == 6) {
+        add_emdf = 1;
+    } else {
+        (void)br_u(b, 3); /* md_compat */
+        if (br_u(b, 1))
+            (void)br_var(b, 2); /* pres_id */
+        int f = br_frm_factor(b, rate);
+        *frf = f;
+        if ((rate == 5 || rate == 6 || rate == 7 || rate == 8 ||
+             rate == 9) &&
+            f == 1) {
+            if (br_u(b, 1))
+                (void)0; /* fraction 2 */
+        }
+        if (rate == 10 || rate == 11 || rate == 12) {
+            if (br_u(b, 1))
+                (void)br_u(b, 1); /* is_4 */
+        }
+        br_emdf_info(b);
+        if (br_u(b, 1))
+            (void)br_u(b, 1); /* enable */
+        *ngi = 0;
+        if (single) {
+            unsigned gi = br_u(b, 3);
+            if (gi == 7)
+                gi += br_var(b, 2);
+            gis[(*ngi)++] = (int)gi;
+        } else {
+            (void)br_u(b, 1); /* b_multi_pid */
+            int nmap = -1;
+            if (cfg >= 0 && cfg <= 4) {
+                static const int m[5] = {2, 2, 2, 3, 3};
+                nmap = m[cfg];
+            }
+            if (nmap > 0) {
+                for (int k = 0; k < nmap; k++) {
+                    unsigned gi = br_u(b, 3);
+                    if (gi == 7)
+                        gi += br_var(b, 2);
+                    if (*ngi >= E4_MAXGRP || b->err)
+                        return -1;
+                    gis[(*ngi)++] = (int)gi;
+                }
+            } else if (cfg == 5) {
+                unsigned ng = br_u(b, 2) + 2;
+                if (ng == 5)
+                    ng += br_var(b, 2);
+                if (ng > (unsigned)E4_MAXGRP)
+                    return -1;
+                for (unsigned k = 0; k < ng; k++) {
+                    unsigned gi = br_u(b, 3);
+                    if (gi == 7)
+                        gi += br_var(b, 2);
+                    if (*ngi >= E4_MAXGRP || b->err)
+                        return -1;
+                    gis[(*ngi)++] = (int)gi;
+                }
