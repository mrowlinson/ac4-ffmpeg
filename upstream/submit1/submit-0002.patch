+int ac4d_open(ac4d_ctx **cp, const ac4d_opts *o) {
+    ac4d_ctx *c;
+    int q, ch;
+    if (!cp)
+        return AC4D_ERR;
+    *cp = NULL;
+    c = av_calloc(1, sizeof *c);
+    if (!c)
+        return AC4D_NO_MEM;
+    _ac4d_self = c;
+    ac4d_state_init();
+    if (o)
+        c->ao = *o;
+    else {
+        memset(&c->ao, 0, sizeof c->ao);
+        c->ao.pres_sel = -1;
+    }
+    if (c->ao.bits == 0)
+        c->ao.bits = 16;
+    if (c->ao.bits != 16 && c->ao.bits != 24 && c->ao.bits != 32) {
+        av_free(c);
+        if (_ac4d_self == c)
+            _ac4d_self = NULL;
+        return AC4D_ERR;
+    }
+    if (c->ao.drc_boost_pct == 0)
+        c->ao.drc_boost_pct = 100;
+    if (c->ao.drc_cut_pct == 0)
+        c->ao.drc_cut_pct = 100;
+    /* Whole-stream legs unsupported in streaming v1. */
+    if (c->ao.drc_on) {
+        av_free(c);
+        if (_ac4d_self == c)
+            _ac4d_self = NULL;
+        return AC4D_UNSUPPORTED;
+    }
+    if (c->ao.de_given && c->ao.de_level != 0.0) {
+        av_free(c);
+        if (_ac4d_self == c)
+            _ac4d_self = NULL;
+        return AC4D_UNSUPPORTED;
+    }
+    /* Option mirrors from opts. */
+    e_drc_cli = c->ao.drc_on;
+    e_drc_or_given = c->ao.drc_ref_given;
+    e_drc_or_cli = (double)c->ao.drc_out_ref;
+    e_drc_boost = (double)c->ao.drc_boost_pct;
+    e_drc_cut = (double)c->ao.drc_cut_pct;
+    e_de_given = c->ao.de_given;
+    e_de_cli = c->ao.de_level;
+    e_ajoc_core = c->ao.ajoc_core;
+    e_wav_bps = c->ao.bits == 24 ? 3 : c->ao.bits == 32 ? 4 : 2;
+    /* One-shot stream inits. */
+    e_ax_have_cfg = 0;
+    e3_cmp_reset();
+    e_drc.valid = 0;
+    e_drc_noted = 0;
+    e_drc_dial = 27;
+    memset(&e_loud, 0, sizeof e_loud);
+    e_loud_latched = 0;
+    memset(&e_audmeta, 0, sizeof e_audmeta);
+    e_audmeta_latched = 0;
+    e_dn_have = 0;
+    e_dn_dial = 0;
+    e_dn_saw_pres = 0;
+    e_f0_have_gate = 0;
+    e_f0_gate = 0;
+    e_f0_have_dcfg = 0;
+    memset(&e_f0_dcfg, 0, sizeof e_f0_dcfg);
+    e_cmp_f0latched = 0;
+    e_cmp_f0nch = e_cmp_f0sync = e_cmp_f0mask = e_cmp_f0avg = 0;
+    e_5x_f0latched = 0;
+    e_5x_codec = e_5x_cc = e_5x_m2 = 0;
+    e_5x_mdct0 = e_5x_mdct1 = e_5x_ms = e_5x_lms = e_5x_3ch = 0;
+    e_decfg_have = 0;
+    e_decfg_frame = 0;
+    e_decfg_chan = e_decfg_tools = e_decfg_maxgain = e_decfg_method = 0;
+    e_dewalk_reset();
+    e_ncfg = 0;
+    e_icfg0 = e_icfg1 = -1;
+    for (q = 0; q < 4; q++)
+        e_ax_xover[q] = 0;
+    for (q = 0; q < 7; q++) {
+        e_ax_have_prev[q] = 0;
+        e_ax_prev_stop[q] = 0;
+    }
+    for (ch = 0; ch < 12; ch++) {
+        /* imdct_set_max deferred to latch (needs spf). */
+        e3_pendn[ch] = 0;
+        e3_prevn[ch] = 0;
+    }
+    e3_dngain = 1.0;
+    e3_imm_mode = -1;
+    e3_acpl_have = 0;
+    acpl_reset(&c->acpl);
+    for (q = 0; q < 4; q++)
+        e3_spill_oc[q] = 0;
+    e3_imm_fold_div = 1.4142135623730951;
+    e5_acpl_nbands = 15;
+    e5_acpl_fine = 1;
+    e5_acpl_have = 0;
+    e5_need_postpass = 0;
+    for (q = 0; q < 2; q++)
+        e5_spill_oc[q] = 0;
+    e5_spill_on = 0;
+    e5_last_acpl = 0;
+    e5_acpl_elig = 1;
+    e3_spill_on = 0;
+    e3_imm_elig = 1;
+    for (q = 0; q < 8; q++)
+        c->fr_fno[q] = -1;
+    for (q = 0; q < AC4D_SRCN; q++)
+        c->h_src_ring[q].ord = -1;
+    acpl_imm_init(&c->pp_imm);
+    acpl_5x_init(&c->pp_5x);
+    for (ch = 0; ch < 8; ch++) {
+        qmf_init(&c->cmp_qs[ch]);
+        c->cmp_held[ch] = 1.0;
+        for (q = 0; q < 16; q++)
+            c->cmp_gfifo[ch][q] = 1.0;
+    }
+    ac4d_cmp_snapshot();
+    c->ao_open = 1;
+    *cp = c;
+    return AC4D_OK;
+}
