+/* frame_rate_multiply -> factor (P1 T87). */
+static int br_frm_factor(br_t *b, int rate) {
+    if (rate == 2 || rate == 3 || rate == 4) {
+        unsigned m = br_u(b, 1);
+        if (m)
+            return br_u(b, 1) ? 4 : 2;
+        return 1;
+    }
+    if (rate == 0 || rate == 1 || rate == 7 || rate == 8 || rate == 9)
+        return br_u(b, 1) ? 2 : 1;
+    return 1;
+}
