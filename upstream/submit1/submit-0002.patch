+/* basic_p2 sus=1 walk-only. */
+static void e3_basic_skip(br_t *b, int cm) {
+    if (!br_u(b, 1))
+        return;
+    if (br_u(b, 1)) {
+        (void)br_u(b, 8); /* sub_loud */
+        if (br_u(b, 1))
+            e3_subloud_skip(b);
+    }
+    if (cm == 1) {
+        if (br_u(b, 1)) {
+            (void)br_u(b, 3);
+            (void)br_u(b, 2);
+        }
+    }
+    if (cm > 1) {
+        if (cm == 3 || cm == 4) {
+            if (br_u(b, 1))
+                (void)br_u(b, 3);
+            if (br_u(b, 1))
+                (void)br_u(b, 4);
+        }
+        if (cm >= 5 && cm <= 10) {
+            if (br_u(b, 1))
+                (void)br_u(b, 2);
+        }
+        (void)br_u(b, 2); /* phmc */
+        (void)br_u(b, 1); /* surr */
+        (void)br_u(b, 1); /* lfeatt */
+    }
+    if (br_u(b, 1))
+        (void)br_u(b, 1); /* dc */
+}
