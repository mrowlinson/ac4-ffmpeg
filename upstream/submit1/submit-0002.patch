+                (void)br_u(b, 8);
+                (void)br_u(b, 8);
+                (void)br_u(b, 2);
+            }
+        }
+    }
+    if (br_u(b, 1)) {
+        if (e3_contains(cm, 0) && br_u(b, 1))
+            (void)br_u(b, 1);
+        if (e3_contains(cm, 1)) {
+            if (br_u(b, 1))
+                (void)br_u(b, 1);
+            if (br_u(b, 1))
+                (void)br_u(b, 1);
+        }
+        if (e3_contains(cm, 2)) {
+            (void)br_u(b, 1);
+            (void)br_u(b, 1);
+        }
+        if (e3_contains(cm, 3))
+            (void)br_u(b, 1);
+    }
+    if (br_u(b, 1))
+        (void)br_u(b, 4); /* evp */
+}
