+         * silent skeleton (long, zero spectra; the 5XPOST pass
+         * overwrites lr[4,5] wholesale). Info mirrors slot 0 so
+         * the push stage sees valid long-block grouping. */
+        info[4] = info[0];
+        info[5] = info[0];
+        memset(&ch[4], 0, sizeof ch[4]);
+        memset(&ch[5], 0, sizeof ch[5]);
+        ch[4].nwin = 1;
+        ch[4].win_len[0] = spf;
+        ch[5].nwin = 1;
+        ch[5].win_len[0] = spf;
+    }
+    if (!e_5x_f0latched) {
+        e_5x_f0latched = 1;
+        e_5x_codec = codec;
+        e_5x_cc = cc;
+        e_5x_m2 = m2;
+        e_5x_mdct0 = mdct[0];
+        e_5x_mdct1 = mdct[1];
+        e_5x_ms = (int)matsel;
+        e_5x_lms = lms;
+        e_5x_3ch = is_3ch ? 1 : 0;
+    }
+    if (b->err) {
+        *note = "elem-trunc-5x";
+        return -1;
+    }
+    e3_cmp_endxov();
+    return 0;
+}
