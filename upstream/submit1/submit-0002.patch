+/* contains(cm, which): 0=c, 1=lr, 2=lsrs, 3=lfe. cm>4: none. */
+static int e3_contains(int cm, int which) {
+    switch (cm) {
+    case 0:
+        return which == 0;
+    case 1:
+        return which == 1;
+    case 2:
+        return which == 0 || which == 1;
+    case 3:
+    case 4:
+        return which != 3 || cm == 4;
+    default:
+        return 0;
+    }
+}
