+static void br_emdf_info(br_t *b) {
+    unsigned v = br_u(b, 2);
+    if (v == 3)
+        (void)br_var(b, 2);
+    unsigned k = br_u(b, 3);
+    if (k == 7)
+        (void)br_var(b, 3);
+    if (br_u(b, 1))
+        (void)br_substream_index(b);
+    unsigned lp = br_u(b, 2), ls = br_u(b, 2);
+    unsigned skip = 0;
+    if (lp > 0)
+        skip += 1u << (2 * (lp - 1));
+    if (ls > 0)
+        skip += 1u << (2 * (ls - 1));
+    if (skip)
+        (void)br_u(b, (int)(8 * skip));
