+                unsigned nb = br_u(b, 5);
+                if (br_u(b, 1))
+                    nb += br_var(b, 2) << 5;
+                if (nb)
+                    (void)br_u(b, (int)(8 * nb));
+            }
+        }
+        (void)br_u(b, 1); /* virt */
+        add_emdf = (int)br_u(b, 1);
+        (void)br_u(b, 1); /* alt */
+        *pndot = (int)br_u(b, 1); /* b_pres_ndot (TOC; NOT I-gate, A-80) */
+        (void)br_substream_index(b);
+    }
+    if (add_emdf) {
+        unsigned n = br_u(b, 2);
+        if (n == 0)
+            n = br_var(b, 2) + 4;
+        if (n > 16)
+            return -1;
+        for (unsigned k = 0; k < n; k++)
+            br_emdf_info(b);
+    }
+    return b->err ? -1 : 0;
+}
