+/* channel_mode prefix walk -> wire value (d2 parse_channel_mode). */
+static unsigned br_channel_mode(br_t *b) {
+    unsigned v = br_u(b, 1);
+    if (v == 0)
+        return 0;
+    v = (v << 1) | br_u(b, 1);
+    if (v == 2)
+        return v;
+    v = (v << 2) | br_u(b, 2);
+    if (v == 12 || v == 13 || v == 14)
+        return v;
+    v = (v << 3) | br_u(b, 3);
+    if (v != 126 && v != 127)
+        return v;
+    v = (v << 1) | br_u(b, 1);
+    if (v != 254 && v != 255)
+        return v;
+    v = (v << 1) | br_u(b, 1);
+    if (v != 511)
+        return v;
+    v += br_var(b, 2);
+    return v;
+}
