+/* Substream loudness walk-only (tool loudness(r, sus=1, pres_ldn=0):
+ * dg + 6 named + lra/mntry/maxmntry + rtll + e-ext). */
+static void e3_subloud_skip(br_t *b) {
+    (void)br_u(b, 1); /* dg */
+    for (int k = 0; k < 6; k++) {
+        if (br_u(b, 1)) {
+            (void)br_u(b, 11);
+            if (k == 1)
+                (void)br_u(b, 3);
+        }
+    }
+    if (br_u(b, 1)) {
+        (void)br_u(b, 10);
+        (void)br_u(b, 3);
+    }
+    if (br_u(b, 1))
+        (void)br_u(b, 11);
+    if (br_u(b, 1))
+        (void)br_u(b, 11);
+    if (br_u(b, 1))
+        (void)br_u(b, 8); /* rtll */
+    if (br_u(b, 1)) {
+        unsigned e = br_u(b, 5);
+        if (e == 31)
+            e += br_var(b, 4);
+        if (e)
+            (void)br_u(b, (int)e);
+    }
+}
