+/* Book select: sig 1=SIGNAL 0=NOISE; ht 0=F0 1=DF 2=DT. */
+static int e_ax_booksel(int sig, int qm, int sm, int ht) {
+    int fam;
+    if (sig)
+        fam = sm ? (qm ? 3 : 2) : (qm ? 1 : 0);
+    else
+        fam = sm ? 5 : 4;
+    return aspx_book(fam, ht);
+}
