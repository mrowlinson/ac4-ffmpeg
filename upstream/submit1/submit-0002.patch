+    if (fs == 1 && br_u(b, 1))
+        sf = br_u(b, 1) ? 4 : 2; /* sf_multiplier */
+    if (br_u(b, 1))
+        (void)br_u(b, 3); /* bitrate_indicator flat-3 (d2 OPEN-7) */
+    return sf;
