+int aspx_decode(const aspx_book_t *b,
+               int (*getbit)(void *ctx), void *ctx) {
+    uint32_t acc = 0;
+    for (int L = 1; L <= b->maxlen; L++) {
+        int bit = getbit(ctx);
+        if (bit < 0)
+            return -1;
+        acc = (acc << 1) | (uint32_t)(bit & 1);
+        for (int i = 0; i < b->entries; i++) {
+            if (b->len[i] == L && b->cw[i] == acc)
+                return i;
+        }
+    }
+    return -1;
