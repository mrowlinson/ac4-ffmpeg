+static uint64_t ac4d_layout_mask(int nch) {
+    /* ffmpeg AV_CH_* bit values (stable ABI). */
+    switch (nch) {
+    case 1:
+        return 0x4; /* FRONT_CENTER */
+    case 2:
+        return 0x1 | 0x2; /* FL|FR */
+    case 6:
+        return 0x3F; /* 5.1 */
+    case 8:
+        return 0x63F; /* 7.1 */
+    default:
+        return 0;
+    }
+}
