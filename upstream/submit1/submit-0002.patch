+        *note = "714-trunc";
+        return -1;
+    }
+    int is_aspx = 0;
+    if (mode == 0) {
+        ;
+    } else if (mode == 3) {
+        is_aspx = 1;
+        if (e_ax_config(b, ig, note))
+            return -1;
