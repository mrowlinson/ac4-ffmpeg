+/* variable_bits(n): P1 Table 3 loop. */
+static unsigned br_var(br_t *b, int n) {
+    unsigned v = 0;
+    for (;;) {
+        v += br_u(b, n);
+        if (b->err)
+            return 0;
+        if (!br_u(b, 1) || b->err)
+            return v;
+        v = (v << n) + (unsigned)(1 << n);
+    }
+}
