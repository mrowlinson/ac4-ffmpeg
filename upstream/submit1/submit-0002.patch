+    /* 7CH_STATIC extra: Lb/Rb pair -> slots 6/7. b_use_sap_add_ch=1
+     * (coupled against Ls/Rs per 5.2.3.2 steps 3-4) is an honest gap:
+     * unobserved (514 content carries Lb/Rb silence, flag expected 0). */
+    unsigned u = ebr_u(b, 1);
+    if (b->err) {
