@@ -317,6 +317,44 @@ Loud sounds are fully compressed.  Soft sounds are enhanced.
 
 @end table
 
+@section ac4
+
+AC-4 audio decoder.
+
+Native decoder for Dolby AC-4 (ATSC A/344), handling mono, stereo
+and multichannel beds up to 7.1. Output is 16-bit PCM.
+
+@subsection AC-4 Decoder Options
+
+@table @option
+
+@item -pres_sel @var{value}
+Presentation select. Default @option{-1} decodes the default
+presentation; @option{0} to @option{63} select a specific one.
+
+@item -drc @var{boolean}
+Apply dynamic range control. Reserved for future use: enabling it is
+currently rejected at decoder init. Default off.
+
+@item -drc_out_ref @var{value}
+DRC output reference level, @option{-31} to @option{0}. Takes effect
+only when DRC is supported. Default @option{-31}.
+
+@item -drc_boost @var{value}
+DRC boost factor in percent, @option{0} to @option{200}. Takes effect
+only when DRC is supported. Default @option{100}.
+
+@item -drc_cut @var{value}
+DRC cut factor in percent, @option{0} to @option{200}. Takes effect
+only when DRC is supported. Default @option{100}.
+
+@item -de_level @var{value}
+Dialog enhancement level in dB, @option{-12} to @option{12}.
+Reserved for future use: nonzero values are currently rejected at
+decoder init. Default @option{0} (off).
+
+@end table
+
 @section flac
 
 FLAC audio decoder.
