From fc4866bdcb09bafe3e251d6ead78517c7cde2bed Mon Sep 17 00:00:00 2001
From: Michael Rowlinson <mrowlinson@gmail.com>
Date: Fri, 16 Oct 2026 04:25:31 -0400
Subject: [PATCH] lavf/ac4: fill codecpar + timestamps from first frame

The raw AC-4 demuxer set only codec type/id, leaving sample_rate and
channels at 0 with no packet timestamps. That made the generic mux
layer reject every stream copy (EINVAL) and made generic index seeks
fail (EPERM).

Peek at the first sync frame in read_header and walk its TOC head
plus presentation-0's first channel-coded group (bitstream_version 2
path): frame_rate_index/fs_index yield the output sample rate (base
sample frequency x sf_mult per TS 103 190-2 section 5.11/Table 70
and Table E.1, never the internal spf x fps block grid), and
channel_mode yields the channel count/layout. Timestamps are
synthesized in read_packet from a frame counter times the exact
per-frame output sample count (av_rescale, absolute per frame, so
1001-rate rows get exact 1601/1602-style alternation with no drift);
the counter rebases from the generic index after seeks, and emits
NOPTS (duration 0) on rebase misses until the next hit, so seeks to
unvisited positions never stamp plausible-but-wrong pts. Whole sync
frames are flagged KEY (no parser yet for per-frame keyflags).

The peek is two-stage and bounded: a 4096-byte fast path covers every
real sample with zero extra IO, and a truncated walk re-peeks once up
to a 64 KiB hard cap (semantic rejects never re-peek). Oversize TOCs
warn naming the bound and leave params unset instead of being chased.

Any unsupported shape (non-v2 TOC, reserved rate rows 14/15,
multi-group, no-bed AJOC/object-only, extended channel modes) or any
walk overrun bails to previous behavior: params stay unset and decode
is unaffected, since the decoder parses the TOC itself. Non-seekable
inputs use a seekback window for the peek. codecpar bit_rate is
estimated from the first-frame size so generic code derives duration.

read_packet validates the sync word and rejects size-0 payloads
(INVALIDDATA) instead of emitting confidently-stamped garbage;
clean EOF still returns AVERROR_EOF silently, and a failed peek
rewind fails read_header (EIO) instead of succeeding desynced.

FATE: fate-ac4-demux / fate-ac4-demux-51 pin the latched params plus
monotonic pts and packet crcs over stereo and 5.1 clips, and
fate-seek-extra-ac4 pins exact rebase pts over mixed seeks. Samples
(clip-stereo.ac4, clip-51-real.ac4) reach fate-suite ac4/ through a
separate samples request.

A presentation_version unary past 7 is definitively malformed, so it
skips the TOC re-peek (single-probe) with one verbose note.

Signed-off-by: Michael Rowlinson <mrowlinson@gmail.com>
---
 libavformat/ac4dec.c        | 673 ++++++++++++++++++++++++++++++++++++
 tests/fate/demux.mak        |   4 +
 tests/fate/seek.mak         |   2 +
 tests/ref/fate/ac4-demux    |   8 +
 tests/ref/fate/ac4-demux-51 |   8 +
 tests/ref/seek/extra-ac4    |  40 +++
 6 files changed, 735 insertions(+)
 create mode 100644 tests/ref/fate/ac4-demux
 create mode 100644 tests/ref/fate/ac4-demux-51
 create mode 100644 tests/ref/seek/extra-ac4

diff --git a/libavformat/ac4dec.c b/libavformat/ac4dec.c
index dc6638d..70e9968 100644
--- a/libavformat/ac4dec.c
+++ b/libavformat/ac4dec.c
@@ -20,11 +20,612 @@
  */
 
 #include "libavutil/avassert.h"
+#include "libavutil/channel_layout.h"
 #include "libavutil/crc.h"
+#include "libavutil/mem.h"
+#include "libavcodec/get_bits.h"
 #include "avformat.h"
+#include "avio_internal.h"
 #include "demux.h"
+#include "internal.h"
 #include "rawdec.h"
 
+typedef struct AC4DemuxContext {
+    int64_t frame;      /* emitted packet counter for timestamps */
+    int     frame_valid;/* frame counter known-good (0 after rebase miss) */
+    int     sample_rate;/* latched from first-frame TOC, 0 = unknown */
+    int     frame_dur_num;/* output samples per frame, exact rational */
+    int     frame_dur_den;/* (num/den; den != 1 on 1001-rate rows) */
+    int64_t next_pos;   /* expected offset of next sequential packet */
+} AC4DemuxContext;
+
+/* frame_rate_index rows 0-12 as exact frame rates, num/den fps
+ * (ATSC A/342-2 Table 5.1; the fps column matches ETSI TS 103 190-2
+ * Table E.1). Row 13 is free-running (no fixed rate). */
+static const int ac4_fps_num[13] = {
+    24000, 24, 25, 30000, 30, 48000, 48,
+    50, 60000, 60, 100, 120000, 120,
+};
+static const int ac4_fps_den[13] = {
+    1001, 1, 1, 1001, 1, 1001, 1,
+    1, 1001, 1, 1, 1001, 1,
+};
+
+/* Nominal output pts (in 1/sample_rate units) of frame number f: the
+ * decoder resamples its internal blocks to base_samp_freq output, so
+ * exact output samples per frame is L = base_fs*sf_mult*fps_den/fps_num
+ * (Table E.1 sample_delta: e.g. 1601.6 at 29.97 fps, emitted as
+ * 1601/1602 per Sec. 5.11 Table 70). Rounding is per-frame absolute, so
+ * period sums stay exact and no drift accumulates. This is the nominal
+ * (unlocked) phase, not Table 70's sequence_counter-locked pattern:
+ * single 1001-row pts may differ by +/-1 sample from a locked decoder
+ * on some frames of each period. The demuxer skips sequence_counter
+ * and the spec's lock is conditional ("If the phase ... is locked"),
+ * so nominal timing is used. */
+static int64_t ac4_frame_pts(const AC4DemuxContext *ctx, int64_t f)
+{
+    return av_rescale(f, ctx->frame_dur_num, ctx->frame_dur_den);
+}
+
+/* First-frame TOC peek: two stages, hard-bounded. D12 requires the peek
+ * stay bounded (never a full-frame read: raw frames run to 16 MB, and a
+ * slow-reject scan of such input is a known 120 s sink), while a valid
+ * 64-presentation TOC must never be truncated (the old 4096-byte window
+ * cut such TOCs, leaving params unset).
+ *
+ * Stage 1 reads up to AC4_TOC_PEEK_INIT bytes. Ordinary TOCs are tens of
+ * bytes, so every real sample parses here with zero extra IO. When the
+ * TOC walk exhausts a truncated stage-1 window, stage 2 re-peeks once up
+ * to AC4_TOC_PEEK_MAX bytes; semantic rejects never re-peek.
+ *
+ * Bound derivation: a minimal single-group presentation record is ~4
+ * bytes, so 64 of them (the walker's enforced npres cap) fit in ~256
+ * bytes. The only large per-record growth is additional EMDF info: each
+ * emdf_info carries at most 32 payload bytes (each 2-bit length field
+ * contributes at most 1 << (2 * (3 - 1)) = 16 bytes) plus an ~8-byte
+ * header, and valid presentations carry a handful. 64 KiB covers 64
+ * presentations averaging 1 KiB each (~25 max-size EMDF records per
+ * presentation), far past any valid content, while staying 256x below
+ * the largest frame. Deliberately not covered: variable_bits abuse
+ * (n_add_emdf_substreams up to 1367 per presentation, ~3.5 MB across
+ * 64) fails loud at the cap instead of being chased.
+ *
+ * Truncation is impossible for 16-bit-sized frames (size <= 0xFFFE <
+ * 64 KiB, so stage 2 always covers the whole frame). Only 24-bit
+ * extended frames can overrun the cap; the walk then fails loud (a
+ * warning naming the bound, params unset), never silently truncated. */
+#define AC4_TOC_PEEK_INIT 4096
+#define AC4_TOC_PEEK_MAX  (64 * 1024)
+
+/* Checked bit reader: 0 on success, <0 when fewer than n bits remain. */
+static int ac4_get_bits(GetBitContext *gb, int n, unsigned *val)
+{
+    if (n < 1 || n > 25 || get_bits_left(gb) < n)
+        return AVERROR_INVALIDDATA;
+    *val = get_bits(gb, n);
+    return 0;
+}
+
+static int ac4_skip_bits(GetBitContext *gb, int n)
+{
+    unsigned val;
+
+    if (n < 0)
+        return AVERROR_INVALIDDATA;
+    while (n > 0) {
+        int k = FFMIN(n, 25);
+        if (ac4_get_bits(gb, k, &val) < 0)
+            return AVERROR_INVALIDDATA;
+        n -= k;
+    }
+    return 0;
+}
+
+/* variable_bits(n): n-bit groups each followed by a 1-bit continue flag. */
+static int ac4_var_bits(GetBitContext *gb, int n, unsigned *val)
+{
+    unsigned v, more;
+    int i;
+
+    if (ac4_get_bits(gb, n, &v) < 0)
+        return AVERROR_INVALIDDATA;
+    for (i = 0; i < 4; i++) {
+        if (ac4_get_bits(gb, 1, &more) < 0)
+            return AVERROR_INVALIDDATA;
+        if (!more)
+            break;
+        if (ac4_get_bits(gb, n, &more) < 0)
+            return AVERROR_INVALIDDATA;
+        v = (v << n) + (1u << n) + more;
+    }
+    if (i == 4)
+        return AVERROR_INVALIDDATA;
+    *val = v;
+    return 0;
+}
+
+static int ac4_skip_emdf_info(GetBitContext *gb)
+{
+    unsigned ver, key, b_si, si, len_pri, len_sec, t, skip = 0;
+
+    if (ac4_get_bits(gb, 2, &ver) < 0)
+        return AVERROR_INVALIDDATA;
+    if (ver == 3 && ac4_var_bits(gb, 2, &t) < 0)
+        return AVERROR_INVALIDDATA;
+    if (ac4_get_bits(gb, 3, &key) < 0)
+        return AVERROR_INVALIDDATA;
+    if (key == 7 && ac4_var_bits(gb, 3, &t) < 0)
+        return AVERROR_INVALIDDATA;
+    if (ac4_get_bits(gb, 1, &b_si) < 0)
+        return AVERROR_INVALIDDATA;
+    if (b_si) {
+        if (ac4_get_bits(gb, 2, &si) < 0)
+            return AVERROR_INVALIDDATA;
+        if (si == 3 && ac4_var_bits(gb, 2, &t) < 0)
+            return AVERROR_INVALIDDATA;
+    }
+    if (ac4_get_bits(gb, 2, &len_pri) < 0 ||
+        ac4_get_bits(gb, 2, &len_sec) < 0)
+        return AVERROR_INVALIDDATA;
+    if (len_pri)
+        skip += 1u << (2 * (len_pri - 1));
+    if (len_sec)
+        skip += 1u << (2 * (len_sec - 1));
+    return ac4_skip_bits(gb, skip * 8);
+}
+
+/* Skip one P2 ac4_presentation_v1_info record, returning its substream
+ * group index and frame-rate factor (ndot repeat count). Returns 0,
+ * AVERROR_PATCHWELCOME (unsupported shape), AVERROR(EINVAL)
+ * (definitively malformed version unary), or AVERROR_INVALIDDATA
+ * (bit exhaustion, possibly a truncated window). */
+static int ac4_skip_pres_info(GetBitContext *gb, unsigned fri,
+                              unsigned *group_index, unsigned *factor)
+{
+    unsigned b_single, ver = 0, t, b_pid, b_mult, mult_bit;
+    unsigned b_filter, gi, b_add, n_add, si, i;
+
+    if (ac4_get_bits(gb, 1, &b_single) < 0)
+        return AVERROR_INVALIDDATA;
+    if (!b_single)
+        return AVERROR_PATCHWELCOME; /* multi-group presentation */
+    /* presentation_version unary; ver > 7 is definitively malformed
+     * (8 one-bits already read, so a wider window cannot change them). */
+    do {
+        if (ac4_get_bits(gb, 1, &t) < 0)
+            return AVERROR_INVALIDDATA;
+        if (t && ++ver > 7)
+            return AVERROR(EINVAL);
+    } while (t);
+    if (ac4_skip_bits(gb, 3) < 0) /* md_compat */
+        return AVERROR_INVALIDDATA;
+    if (ac4_get_bits(gb, 1, &b_pid) < 0)
+        return AVERROR_INVALIDDATA;
+    if (b_pid && ac4_var_bits(gb, 2, &t) < 0)
+        return AVERROR_INVALIDDATA;
+    /* frame_rate_multiply_info; rows 5-6/10-13 carry none and skip */
+    if (fri >= 2 && fri <= 4) {
+        if (ac4_get_bits(gb, 1, &b_mult) < 0)
+            return AVERROR_INVALIDDATA;
+        if (b_mult) {
+            if (ac4_get_bits(gb, 1, &mult_bit) < 0)
+                return AVERROR_INVALIDDATA;
+            *factor = mult_bit ? 4 : 2;
+        }
+    } else if (fri <= 1 || (fri >= 7 && fri <= 9)) {
+        if (ac4_get_bits(gb, 1, &b_mult) < 0)
+            return AVERROR_INVALIDDATA;
+        if (b_mult)
+            *factor = 2;
+    }
+    if (ac4_skip_emdf_info(gb) < 0)
+        return AVERROR_INVALIDDATA;
+    if (ac4_get_bits(gb, 1, &b_filter) < 0)
+        return AVERROR_INVALIDDATA;
+    if (b_filter && ac4_skip_bits(gb, 1) < 0)
+        return AVERROR_INVALIDDATA;
+    if (ac4_get_bits(gb, 3, &gi) < 0)
+        return AVERROR_INVALIDDATA;
+    if (gi == 7) {
+        if (ac4_var_bits(gb, 2, &t) < 0)
+            return AVERROR_INVALIDDATA;
+        gi += t;
+    }
+    if (ac4_skip_bits(gb, 1) < 0) /* b_pre_virtualized */
+        return AVERROR_INVALIDDATA;
+    if (ac4_get_bits(gb, 1, &b_add) < 0)
+        return AVERROR_INVALIDDATA;
+    if (ac4_skip_bits(gb, 2) < 0) /* b_alternative + b_pres_ndot */
+        return AVERROR_INVALIDDATA;
+    if (ac4_get_bits(gb, 2, &si) < 0)
+        return AVERROR_INVALIDDATA;
+    if (si == 3 && ac4_var_bits(gb, 2, &t) < 0)
+        return AVERROR_INVALIDDATA;
+    if (b_add) {
+        if (ac4_get_bits(gb, 2, &n_add) < 0)
+            return AVERROR_INVALIDDATA;
+        if (!n_add) {
+            if (ac4_var_bits(gb, 2, &t) < 0)
+                return AVERROR_INVALIDDATA;
+            n_add = t + 4;
+        }
+        /* No spec cap on the count; the bit reader bounds the loop. */
+        for (i = 0; i < n_add; i++)
+            if (ac4_skip_emdf_info(gb) < 0)
+                return AVERROR_INVALIDDATA;
+    }
+    *group_index = gi;
+    return 0;
+}
+
+static int ac4_cm_channels(unsigned cm)
+{
+    switch (cm) {
+    case 0:   return 1;
+    case 2:   return 2;
+    case 12:  return 3;
+    case 13:  return 5;
+    case 14:  return 6;
+    case 120:
+    case 122:
+    case 124: return 7;
+    case 121:
+    case 123:
+    case 125: return 8;
+    default:  return -1;
+    }
+}
+
+/* Peek at the first sync frame, walk its TOC head plus presentation-0's
+ * first channel-coded group, and latch sample_rate / frame duration /
+ * channel layout. Soft failures leave params unset (previous behavior);
+ * the decoder parses the TOC itself, so decode is unaffected. A hard
+ * failure (peek consumed bytes but the rewind failed) sets *desynced,
+ * and the caller must fail the open: mid-frame reads would emit garbage.
+ * The peek runs in two stages (see AC4_TOC_PEEK_INIT/MAX above): a small
+ * probe first, then one bounded re-peek when the walk exhausts a
+ * truncated window. Returns 0 with ctx + ch_layout filled, <0 otherwise. */
+static int ac4_parse_first_params(AVFormatContext *s, AVStream *st,
+                                  int *desynced)
+{
+    AC4DemuxContext *ctx = s->priv_data;
+    AVIOContext *pb = s->pb;
+    GetBitContext gb;
+    uint8_t *buf = NULL;
+    int64_t pos0 = avio_tell(pb);
+    unsigned sync, size, toread, hdr_len = 4, frame_bytes;
+    unsigned bv, b_wait, wait, fs, fri;
+    unsigned b_single_pres, npres = 1, b_pbase, t;
+    unsigned gi = 0, factor = 1, dummy;
+    unsigned b_present, b_single_sus, b_cc, cm, sf_mult = 1;
+    unsigned p, base_fs;
+    int channels, ret;
+    int retried = 0;
+
+    if (!(pb->seekable & AVIO_SEEKABLE_NORMAL) &&
+        ffio_ensure_seekback(pb, AC4_TOC_PEEK_INIT + 16) < 0) {
+        av_log(s, AV_LOG_VERBOSE, "ac4: no seekback for TOC peek\n");
+        return AVERROR(ENOMEM);
+    }
+
+    sync = avio_rb16(pb);
+    size = avio_rb16(pb);
+    if (size == 0xFFFF) {
+        size = avio_rb24(pb);
+        hdr_len = 7;
+    }
+    if (pb->error)
+        goto bail_io;
+    if (sync != 0xAC40 && sync != 0xAC41) {
+        av_log(s, AV_LOG_VERBOSE, "ac4: first frame has no sync word\n");
+        goto bail_io;
+    }
+    if (!size) {
+        av_log(s, AV_LOG_VERBOSE, "ac4: bogus first-frame size\n");
+        goto bail_io;
+    }
+
+    toread = FFMIN(size, AC4_TOC_PEEK_INIT);
+    goto peek;
+
+retry:
+    /* The stage-1 window truncated the TOC: one bounded re-peek. The
+     * stage-1 read rewound to pos0, so skip the frame header and read
+     * the wider window from the same start. */
+    av_freep(&buf);
+    toread = FFMIN(size, AC4_TOC_PEEK_MAX);
+    if (!(pb->seekable & AVIO_SEEKABLE_NORMAL) &&
+        ffio_ensure_seekback(pb, toread + 16) < 0) {
+        av_log(s, AV_LOG_WARNING,
+               "ac4: no seekback for %u-byte TOC re-peek\n", toread);
+        ret = AVERROR(ENOMEM);
+        goto out;
+    }
+    if (avio_skip(pb, hdr_len) != (int64_t)hdr_len)
+        goto bail_io;
+
+peek:
+    buf = av_malloc(toread + AV_INPUT_BUFFER_PADDING_SIZE);
+    if (!buf)
+        goto bail_io;
+    if (avio_read(pb, buf, toread) != (int)toread)
+        goto bail_io;
+    memset(buf + toread, 0, AV_INPUT_BUFFER_PADDING_SIZE);
+    if (avio_seek(pb, pos0, SEEK_SET) < 0) {
+        av_log(s, AV_LOG_WARNING, "ac4: TOC peek seek-back failed\n");
+        *desynced = 1;
+        ret = AVERROR(EIO);
+        goto out;
+    }
+    if (init_get_bits8(&gb, buf, toread) < 0) {
+        ret = AVERROR_INVALIDDATA;
+        goto out;
+    }
+
+    /* TOC head */
+    if (ac4_get_bits(&gb, 2, &bv) < 0)
+        goto bail_bits;
+    if (bv != 2) {
+        av_log(s, AV_LOG_VERBOSE,
+               "ac4: bitstream_version %u has no TOC walk\n", bv);
+        ret = AVERROR_PATCHWELCOME;
+        goto out;
+    }
+    if (ac4_skip_bits(&gb, 10) < 0) /* sequence_counter */
+        goto bail_bits;
+    if (ac4_get_bits(&gb, 1, &b_wait) < 0)
+        goto bail_bits;
+    if (b_wait) {
+        if (ac4_get_bits(&gb, 3, &wait) < 0)
+            goto bail_bits;
+        if (wait && ac4_skip_bits(&gb, 2) < 0) /* br_code */
+            goto bail_bits;
+    }
+    if (ac4_get_bits(&gb, 1, &fs) < 0 ||
+        ac4_get_bits(&gb, 4, &fri) < 0)
+        goto bail_bits;
+    if (fri >= 14) {
+        av_log(s, AV_LOG_VERBOSE, "ac4: reserved frame_rate_index %u\n", fri);
+        ret = AVERROR_INVALIDDATA;
+        goto out;
+    }
+    if (ac4_skip_bits(&gb, 1) < 0) /* b_iframe_global */
+        goto bail_bits;
+    if (ac4_get_bits(&gb, 1, &b_single_pres) < 0)
+        goto bail_bits;
+    if (!b_single_pres) {
+        unsigned b_more;
+        if (ac4_get_bits(&gb, 1, &b_more) < 0)
+            goto bail_bits;
+        if (!b_more) {
+            av_log(s, AV_LOG_VERBOSE, "ac4: empty TOC\n");
+            ret = AVERROR_INVALIDDATA;
+            goto out;
+        }
+        if (ac4_var_bits(&gb, 2, &npres) < 0)
+            goto bail_bits;
+        npres += 2;
+        if (npres > 64) {
+            ret = AVERROR_INVALIDDATA;
+            goto out;
+        }
+    }
+    if (ac4_get_bits(&gb, 1, &b_pbase) < 0)
+        goto bail_bits;
+    if (b_pbase) {
+        /* payload_base_minus1 (+ext when 31); value unneeded */
+        if (ac4_get_bits(&gb, 5, &t) < 0)
+            goto bail_bits;
+        if (t == 31 && ac4_var_bits(&gb, 3, &t) < 0)
+            goto bail_bits;
+    }
+    if (ac4_get_bits(&gb, 1, &t) < 0) /* b_program_id */
+        goto bail_bits;
+    if (t) {
+        if (ac4_skip_bits(&gb, 16) < 0) /* short_program_id */
+            goto bail_bits;
+        if (ac4_get_bits(&gb, 1, &t) < 0) /* b_program_uuid_present */
+            goto bail_bits;
+        if (t && ac4_skip_bits(&gb, 128) < 0)
+            goto bail_bits;
+    }
+
+    /* Presentation records; keep pres-0's group index and rate factor.
+     * Every record must be walked to reach the groups, so an exotic
+     * later presentation aborts the whole walk: multi-pres files with
+     * an unsupported pres>0 get no params (decode still parses). */
+    for (p = 0; p < npres; p++) {
+        unsigned *gip = p ? &dummy : &gi;
+        unsigned *facp = p ? &dummy : &factor;
+        ret = ac4_skip_pres_info(&gb, fri, gip, facp);
+        if (ret == AVERROR_PATCHWELCOME) {
+            av_log(s, AV_LOG_VERBOSE,
+                   "ac4: presentation %u shape unsupported\n", p);
+            goto out;
+        }
+        if (ret == AVERROR(EINVAL)) {
+            /* Definitively malformed version: the bits were read, so
+             * no wider window can help; skip the re-peek. */
+            av_log(s, AV_LOG_VERBOSE,
+                   "ac4: presentation %u version invalid\n", p);
+            ret = AVERROR_INVALIDDATA;
+            goto out;
+        }
+        if (ret < 0) {
+            /* Bit exhaustion: the window may have truncated the
+             * presentations, so let bail_bits decide on a re-peek. */
+            goto bail_bits;
+        }
+    }
+    if (gi) {
+        av_log(s, AV_LOG_VERBOSE,
+               "ac4: pres-0 group_index %u unsupported\n", gi);
+        ret = AVERROR_PATCHWELCOME;
+        goto out;
+    }
+
+    /* First (and pres-0's) substream group, first channel element only. */
+    if (ac4_get_bits(&gb, 1, &b_present) < 0 ||
+        ac4_skip_bits(&gb, 1) < 0 || /* b_hsf_ext */
+        ac4_get_bits(&gb, 1, &b_single_sus) < 0)
+        goto bail_bits;
+    if (!b_single_sus) {
+        if (ac4_get_bits(&gb, 2, &t) < 0)
+            goto bail_bits;
+        if (t == 3 && ac4_var_bits(&gb, 2, &t) < 0)
+            goto bail_bits;
+    }
+    if (ac4_get_bits(&gb, 1, &b_cc) < 0)
+        goto bail_bits;
+    if (!b_cc) {
+        av_log(s, AV_LOG_VERBOSE, "ac4: no bed (AJOC/object-only)\n");
+        ret = AVERROR_PATCHWELCOME;
+        goto out;
+    }
+    /* channel_mode prefix: 0 / 10->2 / 11xx->12..14 / 1111xxx->120.. */
+    if (ac4_get_bits(&gb, 1, &t) < 0)
+        goto bail_bits;
+    if (!t) {
+        cm = 0;
+    } else {
+        if (ac4_get_bits(&gb, 1, &t) < 0)
+            goto bail_bits;
+        if (!t) {
+            cm = 2;
+        } else {
+            if (ac4_get_bits(&gb, 2, &cm) < 0)
+                goto bail_bits;
+            cm |= 0xC;
+            if (cm == 15) {
