+ * extended frames can overrun the cap; the walk then fails loud (a
+ * warning naming the bound, params unset), never silently truncated. */
+#define AC4_TOC_PEEK_INIT 4096
+#define AC4_TOC_PEEK_MAX  (64 * 1024)
+
+/* Peek at the first sync frame, run the shared TOC walk over it, and
+ * latch sample_rate / frame duration / channel layout. Soft failures
+ * leave params unset; the decoder parses the TOC itself, so decode is
+ * unaffected. A hard failure (peek consumed bytes but the rewind
+ * failed) sets *desynced, and the caller must fail the open: mid-frame
+ * reads would emit garbage. The peek runs in two stages (see
+ * AC4_TOC_PEEK_INIT/MAX above): a small probe first, then one bounded
+ * re-peek when the walk exhausts a truncated window. Returns 0 with
+ * ctx + ch_layout filled, <0 otherwise. */
