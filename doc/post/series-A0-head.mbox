+                                  int *desynced)
+{
+    AC4DemuxContext *ctx = s->priv_data;
+    AVIOContext *pb = s->pb;
+    FFAC4TOC toc;
+    uint8_t *buf = NULL;
+    int64_t pos0 = avio_tell(pb);
+    unsigned sync, size, toread, hdr_len = 4, frame_bytes;
+    unsigned base_fs;
+    int ret;
+    int retried = 0;
+
+    if (!(pb->seekable & AVIO_SEEKABLE_NORMAL) &&
+        ffio_ensure_seekback(pb, AC4_TOC_PEEK_INIT + 16) < 0) {
+        av_log(s, AV_LOG_VERBOSE, "ac4: no seekback for TOC peek\n");
+        return AVERROR(ENOMEM);
+    }
+
+    sync = avio_rb16(pb);
+    size = avio_rb16(pb);
+    if (size == 0xFFFF) {
+        size = avio_rb24(pb);
+        hdr_len = 7;
+    }
+    if (pb->error)
+        goto bail_io;
+    if (sync != 0xAC40 && sync != 0xAC41) {
+        av_log(s, AV_LOG_VERBOSE, "ac4: first frame has no sync word\n");
+        goto bail_io;
+    }
+    if (!size) {
+        av_log(s, AV_LOG_VERBOSE, "ac4: bogus first-frame size\n");
+        goto bail_io;
+    }
+
+    toread = FFMIN(size, AC4_TOC_PEEK_INIT);
+    goto peek;
+
+retry:
+    /* The stage-1 window truncated the TOC: one bounded re-peek. The
+     * stage-1 read rewound to pos0, so skip the frame header and read
+     * the wider window from the same start. */
+    av_freep(&buf);
+    toread = FFMIN(size, AC4_TOC_PEEK_MAX);
+    if (!(pb->seekable & AVIO_SEEKABLE_NORMAL) &&
+        ffio_ensure_seekback(pb, toread + 16) < 0) {
+        av_log(s, AV_LOG_WARNING,
+               "ac4: no seekback for %u-byte TOC re-peek\n", toread);
+        ret = AVERROR(ENOMEM);
+        goto out;
+    }
+    if (avio_skip(pb, hdr_len) != (int64_t)hdr_len)
+        goto bail_io;
+
+peek:
+    buf = av_malloc(toread + AV_INPUT_BUFFER_PADDING_SIZE);
+    if (!buf)
+        goto bail_io;
+    if (avio_read(pb, buf, toread) != (int)toread)
+        goto bail_io;
+    memset(buf + toread, 0, AV_INPUT_BUFFER_PADDING_SIZE);
+    if (avio_seek(pb, pos0, SEEK_SET) < 0) {
+        av_log(s, AV_LOG_WARNING, "ac4: TOC peek seek-back failed\n");
+        *desynced = 1;
+        ret = AVERROR(EIO);
+        goto out;
+    }
+    /* TOC walk: the single shared reader (libavcodec/ac4_toc.h),
+     * the same walk the frame parser runs per packet. Bit exhaustion
+     * may mean a truncated window (re-peek below); any other failure
+     * read definitive bits, so no wider window can help. */
+    ret = ff_ac4_toc_parse(buf, toread, &toc);
+    if (ret == AVERROR_INVALIDDATA)
+        goto bail_bits;
+    if (ret < 0) {
+        av_log(s, AV_LOG_VERBOSE, "ac4: first-frame TOC unsupported\n");
+        goto out;
+    }
+
+    /* Output rate is base_samp_freq x sf_mult on every row: the decoder
+     * resamples its internal blocks (spf x fps grid, e.g. 1536 @29.97)
+     * to base-fs PCM (1601/1602 @48 kHz; TS 103 190-2 Sec. 5.11 Table 70),
+     * so the grid is not the output rate. Timestamps advance by exact
+     * output samples per frame (Table E.1 sample_delta); row 13
+     * free-runs 2048-sample frames. Table E.1 reserves 44.1 kHz rows
+     * 0-12 (MP4 context) and Table 70/E.4 cover only the 48 kHz base,
+     * so raw-stream 44.1 kHz fixed-rate legality is unconfirmed in the
+     * 190-2 extract (needs 190-1); accepted here as the natural
+     * generalization. sf_mult is pres-0/group-0 only: mixed-sf_mult
+     * multi-group files would be misdescribed by the single rate. */
+    base_fs = toc.fs ? 48000 : 44100;
+    ctx->sample_rate = base_fs * toc.sf_mult;
+    ff_ac4_toc_frame_len(toc.rate, toc.fs, toc.sf_mult,
+                         &ctx->frame_dur_num, &ctx->frame_dur_den);
+
+    switch (toc.channels) {
+    case 1:
+        st->codecpar->ch_layout = (AVChannelLayout)AV_CHANNEL_LAYOUT_MONO;
+        break;
+    case 2:
+        st->codecpar->ch_layout = (AVChannelLayout)AV_CHANNEL_LAYOUT_STEREO;
+        break;
+    case 6:
+        /* cm 14 assumed side-surround 5.1 (190-1 confirm pending). */
+        st->codecpar->ch_layout = (AVChannelLayout)AV_CHANNEL_LAYOUT_5POINT1;
+        break;
+    case 8:
+        st->codecpar->ch_layout = (AVChannelLayout)AV_CHANNEL_LAYOUT_7POINT1;
+        break;
+    default:
+        /* Every other count stays unspecified with the count set. */
+        st->codecpar->ch_layout.order       = AV_CHANNEL_ORDER_UNSPEC;
+        st->codecpar->ch_layout.nb_channels = toc.channels;
+        break;
+    }
+    /* First-frame bitrate estimate (frames vary a little, so this is
+     * approximate) lets generic code derive duration; ffprobe showed
+     * N/A duration without it. */
+    frame_bytes = hdr_len + size + (sync == 0xAC41 ? 2 : 0);
+    st->codecpar->bit_rate = av_rescale((int64_t)frame_bytes * 8 *
+                                        ctx->frame_dur_den,
+                                        ctx->sample_rate,
+                                        ctx->frame_dur_num);
+    ret = 0;
+    goto out;
+
+bail_bits:
+    /* The walk exhausted the window. Retry once with the wider window
+     * when this peek was truncated; a fully-read frame (toread ==
+     * size) holds no more bits, so the TOC itself is short. */
+    if (!retried && toread < size && toread < AC4_TOC_PEEK_MAX) {
+        retried = 1;
+        goto retry;
+    }
+    if (toread < size)
+        av_log(s, AV_LOG_WARNING,
+               "ac4: TOC exceeds %u-byte peek bound, params unset\n",
+               AC4_TOC_PEEK_MAX);
+    else
+        av_log(s, AV_LOG_VERBOSE, "ac4: first-frame TOC walk overran\n");
+    ret = AVERROR_INVALIDDATA;
+    goto out;
+
+bail_io:
+    if (avio_tell(pb) != pos0 && avio_seek(pb, pos0, SEEK_SET) < 0)
+        *desynced = 1;
+    av_log(s, AV_LOG_VERBOSE, "ac4: first-frame peek failed\n");
+    ret = AVERROR_INVALIDDATA;
+
+out:
+    av_free(buf);
+    return ret;
+}
