+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+/**
+ * @file
+ * The single AC-4 table-of-contents reader for libavformat/libavcodec.
+ *
+ * Both the raw demuxer (libavformat/ac4dec.c, first-frame params plus
+ * timestamps) and the frame parser (libavcodec/ac4_parser.c, per-frame
+ * keyflags plus params) walk the TOC through this header, so the two
+ * can never drift apart. Rates are exact output-domain rationals
+ * (base sample frequency x sf_mult over the Table E.1 row rate, i.e.
+ * the N5 decoder output, never the internal spf x fps block grid).
+ *
+ * Return-code contract: 0 once the head is fully read (bed_ok reports
+ * whether the bed walk completed); AVERROR_INVALIDDATA on bit
+ * exhaustion, which may mean a truncated window; AVERROR_PATCHWELCOME
+ * for definitively-read unsupported shapes; AVERROR(EINVAL) for
+ * definitively-read malformed fields. Only INVALIDDATA may retry
+ * with a wider window.
+ */
+
+#ifndef AVCODEC_AC4_TOC_H
+#define AVCODEC_AC4_TOC_H
+
+#include <stdint.h>
+
+#include "libavutil/error.h"
+#include "libavutil/mathematics.h"
+
+#include "get_bits.h"
+
+/* Frame-rate rows 0-12 as exact frame rates, num/den fps (Table E.1
+ * frame_rate). Row 13 is free-running (no fixed rate). */
+static const int ff_ac4_toc_fps_num[13] = {
+    24000, 24, 25, 30000, 30, 48000, 48,
+    50, 60000, 60, 100, 120000, 120,
+};
+static const int ff_ac4_toc_fps_den[13] = {
+    1001, 1, 1, 1001, 1, 1001, 1,
+    1, 1001, 1, 1, 1001, 1,
+};
+
+/* Exact output samples per frame as num/den (Table E.1 sample_delta;
+ * row 13 free-runs 2048 x sf_mult). fri is 0-13, fs 0/1, sf 1/2/4. */
+static inline void ff_ac4_toc_frame_len(int fri, int fs, int sf_mult,
+                                        int *num, int *den)
+{
+    if (fri == 13) {
+        *num = 2048 * sf_mult;
+        *den = 1;
+    } else {
+        int base = fs ? 48000 : 44100;
+
+        *num = base * sf_mult * ff_ac4_toc_fps_den[fri];
+        *den = ff_ac4_toc_fps_num[fri];
+    }
+}
+
+/* Nominal output pts (in output samples) of frame number f: absolute
+ * per-frame rounding, so period sums stay exact and no drift
+ * accumulates. This is the nominal (unlocked) phase, not the
+ * sequence_counter-locked Table 70 pattern, so single 1001-row frame
+ * counts may differ by one sample from a locked decoder on some
+ * frames of each period. */
+static inline int64_t ff_ac4_toc_frame_pts(int num, int den, int64_t f)
+{
+    return av_rescale(f, num, den);
+}
+
+static inline int ff_ac4_toc_frame_dur(int num, int den, int64_t f)
+{
+    return (int) (ff_ac4_toc_frame_pts(num, den, f + 1) -
+                  ff_ac4_toc_frame_pts(num, den, f));
+}
+
+typedef struct FFAC4TOC {
+    int head_ok;    /* head parsed and gated */
+    int bed_ok;     /* bed walk completed */
+    int ig;         /* b_iframe_global */
+    int rate;       /* frame_rate_index 0-13 */
+    int fs;         /* fs_index: 0 = 44.1 kHz base, 1 = 48 kHz base */
+    int sf_mult;    /* substream sample-rate multiplier 1/2/4 */
+    int channels;   /* bed channel count (IMS presented, see below) */
+    int tentative;  /* cm >= 511 tentative 24-channel layout */
+} FFAC4TOC;
+
+typedef struct FFAC4TocReader {
+    GetBitContext gb;
+    int err;
+} FFAC4TocReader;
+
+static inline int ff_ac4_toc_get(FFAC4TocReader *r, int n, unsigned *val)
+{
+    if (r->err)
+        return r->err;
+    if (n < 1 || n > 25 || get_bits_left(&r->gb) < n) {
+        r->err = AVERROR_INVALIDDATA;
+        return r->err;
+    }
+    *val = get_bits(&r->gb, n);
+    return 0;
+}
+
+static inline int ff_ac4_toc_skip(FFAC4TocReader *r, int n)
+{
+    unsigned val;
+
+    if (r->err)
+        return r->err;
+    if (n < 0) {
+        r->err = AVERROR(EINVAL);
+        return r->err;
+    }
+    while (n > 0) {
+        int k = n > 25 ? 25 : n;
+
+        if (ff_ac4_toc_get(r, k, &val) < 0)
+            return r->err;
+        n -= k;
+    }
+    return 0;
+}
+
+/* variable_bits(n): n-bit groups plus a more bit; each continuation
+ * maps value to (value + 1) << n before adding the next group. */
+static inline int ff_ac4_toc_varbits(FFAC4TocReader *r, int n, unsigned *val)
+{
+    unsigned v = 0;
+
+    for (int i = 0; i < 8 && !r->err; i++) {
+        unsigned more;
+
+        if (ff_ac4_toc_get(r, n, &more) < 0)
+            return r->err;
+        v += more;
+        if (v > 0xFFFFFF) {
+            r->err = AVERROR(EINVAL);
+            return r->err;
+        }
+        if (ff_ac4_toc_get(r, 1, &more) < 0)
+            return r->err;
+        if (!more) {
+            *val = v;
+            return 0;
+        }
+        v = (v + 1) << n;
+    }
+    if (!r->err)
+        r->err = AVERROR(EINVAL);
+    return r->err;
+}
+
+/* presentation_version: count of leading one bits. Versions past 8
+ * are definitively malformed (9 one-bits already read). */
+static inline int ff_ac4_toc_unary(FFAC4TocReader *r, unsigned *val)
+{
+    unsigned v = 0;
+
+    for (;;) {
+        unsigned b;
+
+        if (ff_ac4_toc_get(r, 1, &b) < 0)
+            return r->err;
+        if (!b) {
+            *val = v;
+            return 0;
+        }
+        if (++v > 8) {
+            r->err = AVERROR(EINVAL);
+            return r->err;
+        }
+    }
+}
+
+static inline int ff_ac4_toc_substream_index(FFAC4TocReader *r)
+{
+    unsigned si, t;
+
+    if (ff_ac4_toc_get(r, 2, &si) < 0)
+        return r->err;
+    if (si == 3 && ff_ac4_toc_varbits(r, 2, &t) < 0)
+        return r->err;
+    return 0;
+}
+
+static inline int ff_ac4_toc_emdf(FFAC4TocReader *r)
+{
+    unsigned v, k, b_si, lp, ls, t, skip = 0;
+
+    if (ff_ac4_toc_get(r, 2, &v) < 0)
+        return r->err;
+    if (v == 3 && ff_ac4_toc_varbits(r, 2, &t) < 0)
+        return r->err;
+    if (ff_ac4_toc_get(r, 3, &k) < 0)
+        return r->err;
+    if (k == 7 && ff_ac4_toc_varbits(r, 3, &t) < 0)
+        return r->err;
+    if (ff_ac4_toc_get(r, 1, &b_si) < 0)
+        return r->err;
+    if (b_si && ff_ac4_toc_substream_index(r) < 0)
+        return r->err;
+    if (ff_ac4_toc_get(r, 2, &lp) < 0 ||
+        ff_ac4_toc_get(r, 2, &ls) < 0)
+        return r->err;
+    if (lp > 0)
+        skip += 1u << (2 * (lp - 1));
+    if (ls > 0)
+        skip += 1u << (2 * (ls - 1));
+    return ff_ac4_toc_skip(r, skip * 8);
+}
+
+/* frame_rate_multiply_info: bit shape depends on the rate row. The
+ * factor value only keeps the walk aligned (frame_rate_fractions
+ * below reads it); nothing params need follows from it. */
+static inline int ff_ac4_toc_factor(FFAC4TocReader *r, int rate,
+                                   unsigned *factor)
+{
+    unsigned bm, mb;
+
+    *factor = 1;
+    if (rate == 2 || rate == 3 || rate == 4) {
+        if (ff_ac4_toc_get(r, 1, &bm) < 0)
+            return r->err;
+        if (bm) {
+            if (ff_ac4_toc_get(r, 1, &mb) < 0)
+                return r->err;
+            *factor = mb ? 4 : 2;
+        }
+    } else if (rate <= 1 || (rate >= 7 && rate <= 9)) {
+        if (ff_ac4_toc_get(r, 1, &bm) < 0)
+            return r->err;
+        if (bm)
+            *factor = 2;
+    }
+    return 0;
+}
+
+static inline int ff_ac4_toc_fractions(FFAC4TocReader *r, int rate,
+                                      unsigned factor)
+{
+    unsigned t;
+
+    if (rate >= 5 && rate <= 9 && factor == 1) {
+        return ff_ac4_toc_get(r, 1, &t);
+    } else if (rate >= 10 && rate <= 12) {
+        if (ff_ac4_toc_get(r, 1, &t) < 0)
+            return r->err;
+        if (t && ff_ac4_toc_get(r, 1, &t) < 0)
+            return r->err;
+    }
+    return 0;
+}
+
+/* channel_mode prefix walk 1/2/4/7/8/9 bits with the all-ones escape.
+ * The 7-bit values 126/127 continue into 8 bits, 254/255 into 9; only
+ * 511 escapes into varbits. Value 510 is terminal but unmapped. */
+static inline int ff_ac4_toc_channel_mode(FFAC4TocReader *r, unsigned *cm)
+{
+    unsigned v, t;
+
+    if (ff_ac4_toc_get(r, 1, &v) < 0)
+        return r->err;
+    if (!v) {
+        *cm = 0;
+        return 0;
+    }
+    if (ff_ac4_toc_get(r, 1, &t) < 0)
+        return r->err;
+    v = (v << 1) | t;
+    if (v == 2) {
+        *cm = 2;
+        return 0;
+    }
+    if (ff_ac4_toc_get(r, 2, &t) < 0)
+        return r->err;
+    v = (v << 2) | t;
+    if (v >= 12 && v <= 14) {
+        *cm = v;
+        return 0;
+    }
+    if (ff_ac4_toc_get(r, 3, &t) < 0)
+        return r->err;
+    v = (v << 3) | t;
+    if (v < 126 || v > 127) {
+        *cm = v;
+        return 0;
+    }
+    if (ff_ac4_toc_get(r, 1, &t) < 0)
+        return r->err;
+    v = (v << 1) | t;
+    if (v < 254 || v > 255) {
+        *cm = v;
+        return 0;
+    }
+    if (ff_ac4_toc_get(r, 1, &t) < 0)
+        return r->err;
+    v = (v << 1) | t;
+    if (v != 511) {
+        *cm = v;
+        return 0;
+    }
+    if (ff_ac4_toc_varbits(r, 2, &t) < 0)
+        return r->err;
+    *cm = v + t;
+    return 0;
+}
+
+typedef struct FFAC4TocHead {
+    int bv;      /* bitstream_version */
+    int fs;      /* fs_index */
+    int rate;    /* frame_rate_index */
+    int ig;      /* b_iframe_global */
+    int n_pres;  /* presentation count */
+} FFAC4TocHead;
+
+/* TOC head through the program-id block. */
+static inline int ff_ac4_toc_head(FFAC4TocReader *r, FFAC4TocHead *h)
+{
+    unsigned bv, t, br;
+
+    if (ff_ac4_toc_get(r, 2, &bv) < 0)
+        return r->err;
+    if (bv == 3) {
+        if (ff_ac4_toc_varbits(r, 2, &t) < 0)
+            return r->err;
+        bv += t;
+    }
+    if (bv > 2) {
+        r->err = AVERROR_PATCHWELCOME;
+        return r->err;
+    }
+    if (ff_ac4_toc_skip(r, 10) < 0)        /* sequence_counter: ignored */
+        return r->err;
+    if (ff_ac4_toc_get(r, 1, &t) < 0)
+        return r->err;
+    if (t) {
+        if (ff_ac4_toc_get(r, 3, &br) < 0)
+            return r->err;
+        if (br > 0 && ff_ac4_toc_skip(r, 2) < 0)  /* br_code/reserved */
+            return r->err;
+    }
+    if (ff_ac4_toc_get(r, 1, &t) < 0)
+        return r->err;
+    h->fs = t;
+    if (ff_ac4_toc_get(r, 4, &t) < 0)
+        return r->err;
+    if (t >= 14) {
+        r->err = AVERROR(EINVAL);
+        return r->err;
+    }
+    h->rate = t;
+    if (ff_ac4_toc_get(r, 1, &t) < 0)
+        return r->err;
+    h->ig = t;
+    if (ff_ac4_toc_get(r, 1, &t) < 0)
+        return r->err;
+    if (t) {
+        h->n_pres = 1;
+    } else if (ff_ac4_toc_get(r, 1, &t) < 0) {
+        return r->err;
+    } else if (t) {
+        if (ff_ac4_toc_varbits(r, 2, &t) < 0)
+            return r->err;
+        if (t + 2 > 64) {
+            r->err = AVERROR(EINVAL);
+            return r->err;
+        }
+        h->n_pres = t + 2;
+    } else {
+        h->n_pres = 0;
+    }
+    if (ff_ac4_toc_get(r, 1, &t) < 0)
+        return r->err;
+    if (t) {
+        if (ff_ac4_toc_get(r, 5, &t) < 0)
+            return r->err;
+        if (t == 31 && ff_ac4_toc_varbits(r, 3, &t) < 0)
+            return r->err;
+    }
+    h->bv = bv;
+    if (bv == 2) {
+        if (ff_ac4_toc_get(r, 1, &t) < 0)
+            return r->err;
+        if (t) {
+            if (ff_ac4_toc_skip(r, 16) < 0)
+                return r->err;
+            if (ff_ac4_toc_get(r, 1, &t) < 0)
+                return r->err;
+            if (t && ff_ac4_toc_skip(r, 128) < 0)
+                return r->err;
+        }
+    }
+    return 0;
+}
+
+/* One v1 presentation record. Records version/group for presentation 0
+ * and skips the rest. Multi-group records bail: resolving them needs
+ * skip walks with no wire validation. */
+static inline int ff_ac4_toc_pres_v1(FFAC4TocReader *r,
+                                    const FFAC4TocHead *h,
+                                    unsigned *pver_out, unsigned *gi_out)
+{
+    unsigned single, pver, t, factor, gi, b_filter, add_emdf, n;
+
+    if (ff_ac4_toc_get(r, 1, &single) < 0)
+        return r->err;
+    if (!single) {
+        r->err = AVERROR_PATCHWELCOME;
+        return r->err;
+    }
+    if (ff_ac4_toc_unary(r, &pver) < 0)
+        return r->err;
+    if (ff_ac4_toc_skip(r, 3) < 0)         /* md_compat */
+        return r->err;
+    if (ff_ac4_toc_get(r, 1, &t) < 0)
+        return r->err;
+    if (t && ff_ac4_toc_varbits(r, 2, &t) < 0)
+        return r->err;
+    if (ff_ac4_toc_factor(r, h->rate, &factor) < 0)
+        return r->err;
+    if (ff_ac4_toc_fractions(r, h->rate, factor) < 0)
+        return r->err;
+    if (ff_ac4_toc_emdf(r) < 0)
+        return r->err;
+    if (ff_ac4_toc_get(r, 1, &b_filter) < 0)
+        return r->err;
+    if (b_filter && ff_ac4_toc_skip(r, 1) < 0)
+        return r->err;
+    if (ff_ac4_toc_get(r, 3, &gi) < 0)
+        return r->err;
+    if (gi == 7) {
+        if (ff_ac4_toc_varbits(r, 2, &t) < 0)
+            return r->err;
+        gi += t;
+    }
+    if (ff_ac4_toc_skip(r, 1) < 0)         /* b_pre_virtualized */
+        return r->err;
+    if (ff_ac4_toc_get(r, 1, &add_emdf) < 0)
+        return r->err;
+    if (ff_ac4_toc_skip(r, 2) < 0)         /* b_alternative + b_pres_ndot */
+        return r->err;
+    if (ff_ac4_toc_substream_index(r) < 0)
+        return r->err;
+    if (add_emdf) {
+        if (ff_ac4_toc_get(r, 2, &n) < 0)
+            return r->err;
+        if (!n) {
+            if (ff_ac4_toc_varbits(r, 2, &t) < 0)
+                return r->err;
+            n = t + 4;
+        }
+        for (unsigned k = 0; k < n; k++)
+            if (ff_ac4_toc_emdf(r) < 0)
+                return r->err;
+    }
+    *pver_out = pver;
+    *gi_out   = gi;
+    return 0;
+}
+
+/* Bitstream version 2: presentation 0 selects group 0, whose first
+ * channel-coded element carries the bed mode. A group without a bed
+ * (AJOC/object only) stops the walk with params untouched. */
+static inline int ff_ac4_toc_bed_v2(FFAC4TocReader *r,
+                                   const FFAC4TocHead *h,
+                                   unsigned *cm_out, unsigned *sf_out,
+                                   unsigned *pver_out)
+{
+    unsigned pver = 0, gi = 0, dummy_p, dummy_g, t;
+
+    if (h->n_pres < 1) {
+        r->err = AVERROR(EINVAL);
+        return r->err;
+    }
+    for (int i = 0; i < h->n_pres; i++) {
+        if (!i) {
+            if (ff_ac4_toc_pres_v1(r, h, &pver, &gi) < 0)
+                return r->err;
+        } else if (ff_ac4_toc_pres_v1(r, h, &dummy_p, &dummy_g) < 0) {
+            return r->err;
+        }
+    }
+    if (gi) {
+        r->err = AVERROR_PATCHWELCOME;
+        return r->err;
+    }
+    /* b_substreams_present + b_hsf_ext */
+    if (ff_ac4_toc_skip(r, 2) < 0)
+        return r->err;
+    if (ff_ac4_toc_get(r, 1, &t) < 0)
+        return r->err;
+    if (!t) {
+        if (ff_ac4_toc_get(r, 2, &t) < 0)
+            return r->err;
+        if (t == 3 && ff_ac4_toc_varbits(r, 2, &t) < 0)
+            return r->err;
+    }
+    if (ff_ac4_toc_get(r, 1, &t) < 0)
+        return r->err;
+    if (!t) {
+        r->err = AVERROR_PATCHWELCOME;     /* no bed in this group */
+        return r->err;
+    }
+    if (ff_ac4_toc_channel_mode(r, cm_out) < 0)
+        return r->err;
+    if (*cm_out == 252 || *cm_out == 253 ||
+        *cm_out == 508 || *cm_out == 509)
+        if (ff_ac4_toc_skip(r, 4) < 0)     /* immersive presence bits */
+            return r->err;
+    *sf_out = 1;
+    if (h->fs) {
+        if (ff_ac4_toc_get(r, 1, &t) < 0)
+            return r->err;
+        if (t) {
+            if (ff_ac4_toc_get(r, 1, &t) < 0)
+                return r->err;
+            *sf_out = t ? 4 : 2;
+        }
+    }
+    *pver_out = pver;
+    return 0;
+}
+
+/* Bitstream versions 0/1: presentation 0 carries an inline channel
+ * element, and nothing params need follows it, so later presentations
+ * need no walk. Zero wire vectors: spec positions, bail-safe. */
+static inline int ff_ac4_toc_bed_p1(FFAC4TocReader *r,
+                                   const FFAC4TocHead *h,
+                                   unsigned *cm_out, unsigned *sf_out,
+                                   unsigned *pver_out)
+{
+    unsigned single, config = 0, pver, t, factor;
+
+    if (h->n_pres < 1) {
+        r->err = AVERROR(EINVAL);
+        return r->err;
+    }
+    if (ff_ac4_toc_get(r, 1, &single) < 0)
+        return r->err;
+    if (!single) {
+        if (ff_ac4_toc_get(r, 3, &config) < 0)
+            return r->err;
+        if (config == 7) {
+            if (ff_ac4_toc_varbits(r, 2, &t) < 0)
+                return r->err;
+            config += t;
+        }
+        if (config >= 6) {
+            r->err = AVERROR_PATCHWELCOME;
+            return r->err;
+        }
+    }
+    if (ff_ac4_toc_unary(r, &pver) < 0)
+        return r->err;
+    if (ff_ac4_toc_skip(r, 3) < 0)         /* md_compat */
+        return r->err;
+    if (ff_ac4_toc_get(r, 1, &t) < 0)
+        return r->err;
+    if (t && ff_ac4_toc_varbits(r, 2, &t) < 0)
+        return r->err;
+    if (ff_ac4_toc_factor(r, h->rate, &factor) < 0)
+        return r->err;
+    if (ff_ac4_toc_emdf(r) < 0)
+        return r->err;
+    if (!single && ff_ac4_toc_skip(r, 1) < 0)  /* b_hsf_ext */
+        return r->err;
+    if (ff_ac4_toc_channel_mode(r, cm_out) < 0)
+        return r->err;
+    *sf_out = 1;
+    if (h->fs) {
+        if (ff_ac4_toc_get(r, 1, &t) < 0)
+            return r->err;
+        if (t) {
+            if (ff_ac4_toc_get(r, 1, &t) < 0)
+                return r->err;
+            *sf_out = t ? 4 : 2;
+        }
+    }
+    *pver_out = pver;
+    return 0;
+}
+
+/* channel_mode value to bed channel count; IMS pres_ver 2 reports the
+ * presented counts for cm 120/121 (5.1 IMS render / stereo core).
+ * Returns -1 for the unmapped 510 class. */
+static inline int ff_ac4_toc_channels(unsigned cm, unsigned pres_ver,
+                                     int *tentative)
+{
+    *tentative = 0;
+    if (pres_ver == 2 && (cm == 120 || cm == 121))
+        return cm == 120 ? 6 : 2;
+    switch (cm) {
+    case   0: return 1;
+    case   2: return 2;
+    case  12: return 3;
+    case  13: return 5;
+    case  14: return 6;
+    case 120:
+    case 122:
+    case 124: return 7;
+    case 121:
+    case 123:
+    case 125: return 8;
+    case 252: return 11;
+    case 253: return 12;
+    case 508: return 13;
+    case 509: return 14;
+    }
+    if (cm >= 511) {
+        *tentative = 1;
+        return 24;
+    }
+    return -1;
+}
+
+static inline int ff_ac4_toc_parse(const uint8_t *raw, int raw_len,
+                                  FFAC4TOC *toc)
+{
+    FFAC4TocReader r;
+    FFAC4TocHead h;
+    unsigned cm, sf, pver;
+    int nch, tentative = 0;
+
+    toc->head_ok   = 0;
+    toc->bed_ok    = 0;
+    toc->ig        = 0;
+    toc->rate      = 0;
+    toc->fs        = 0;
+    toc->channels  = 0;
+    toc->sf_mult   = 1;
+    toc->tentative = 0;
+    if (raw_len <= 0)
+        return AVERROR_INVALIDDATA;
+    if (init_get_bits8(&r.gb, raw, raw_len) < 0)
+        return AVERROR_INVALIDDATA;
+    r.err = 0;
+    if (ff_ac4_toc_head(&r, &h) < 0)
+        return r.err;
+    toc->head_ok = 1;
+    toc->ig      = h.ig;
+    toc->rate    = h.rate;
+    toc->fs      = h.fs;
+    if (h.bv <= 1) {
+        if (ff_ac4_toc_bed_p1(&r, &h, &cm, &sf, &pver) < 0)
+            return r.err;
+    } else if (ff_ac4_toc_bed_v2(&r, &h, &cm, &sf, &pver) < 0) {
+        return r.err;
+    }
+    nch = ff_ac4_toc_channels(cm, pver, &tentative);
+    if (nch <= 0)
+        return AVERROR_PATCHWELCOME;
+    toc->bed_ok    = 1;
+    toc->channels  = nch;
+    toc->sf_mult   = sf;
+    toc->tentative = tentative;
+    return 0;
+}
+
+#endif /* AVCODEC_AC4_TOC_H */
