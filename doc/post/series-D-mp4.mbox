+/**
+ * @file
+ * AC-4 frame splitter and TOC prober.
+ *
+ * Streaming mode splits the Annex G sync stream (AC40 bare / AC41
+ * checksummed markers). AC41 frames accept on CRC-16; AC40 frames
+ * accept on a chaining anchor (the next head parses exactly at the
+ * frame end) or, at EOF, on an exact end plus a valid TOC head.
+ * Every accept also passes a TOC-head gate (reserved rate rows 14/15
+ * rejected). Any reject advances exactly one byte.
+ *
+ * COMPLETE_FRAMES mode passes bare raw frames through (MP4 samples,
+ * raw-demux packets) and only probes the TOC. It never scans.
+ *
+ * Split and param fill are decoupled: the frame emits once framing
+ * verifies, while avctx/params update atomically and only when the
+ * bed walk completes. Any TOC failure leaves params untouched.
+ */
+
+#include <string.h>
+
+#include "libavutil/channel_layout.h"
+#include "libavutil/common.h"
+#include "libavutil/error.h"
+#include "libavutil/intreadwrite.h"
+#include "libavutil/log.h"
+#include "libavutil/mem.h"
+
+#include "get_bits.h"
+#include "parser.h"
+#include "parser_internal.h"
+
+#define AC4_SYNC_BARE 0xAC40
+#define AC4_SYNC_CRC  0xAC41
+
+/* Largest representable sync frame: 7-byte header + 2^24-1 raw + CRC. */
+#define AC4_MAX_TOTAL 16777224
+
+/* Largest plausible sync frame. The corpus max is 4286 B and the 16-bit
+ * length field tops out at 65540 B total, so a claim past 128 KiB would
+ * need ~24 Mbps of audio in one 43 ms frame: absurd. Heads claiming more
+ * reject before buffering or CRC, bounding per-position resync work. */
+#define AC4_MAX_SCAN (128 * 1024)
+
+typedef struct AC4ParseContext {
+    ParseContext pc;
+    int tent_logged;        /* tentative-layout notice already shown */
+    int64_t frame_number;   /* param fills, for the bit_rate average */
+} AC4ParseContext;
+
+/* Native-grid sample counts and grid rates per frame_rate_index. */
+static const uint16_t ac4_spf[14] = {
+    1920, 1920, 2048, 1536, 1536, 960, 960, 1024,
+     768,  768,  512,  384,  384, 2048
+};
+static const uint16_t ac4_grid_rate[13] = {
+    46034, 46080, 51200, 46034, 46080, 46034, 46080, 51200,
+    46034, 46080, 51200, 46034, 46080
+};
+
+/* CRC-16, MSB-first, poly 0x8005, init 0. The span covers the length
+ * field, the raw frame and the stored word; accept on zero remainder.
+ * AV_CRC_16_ANSI is reflected, so it cannot be used here. */
+static int ac4_crc_ok(const uint8_t *p, int len)
+{
+    unsigned int crc = 0;
+
+    for (int i = 0; i < len; i++) {
+        crc ^= (unsigned int) p[i] << 8;
+        for (int k = 0; k < 8; k++)
+            crc = (crc & 0x8000) ? ((crc << 1) ^ 0x8005) : (crc << 1);
+        crc &= 0xFFFF;
+    }
+    return !crc;
+}
+
+/* Fail-fast bit reader: every primitive checks the budget first, so a
+ * truncated or hostile TOC ends the walk instead of over-reading. */
+typedef struct AC4Bits {
+    GetBitContext gb;
+    int ok;
+} AC4Bits;
+
+static int ac4_bits_read(AC4Bits *r, int n)
+{
+    if (!r->ok || n < 1 || n > 24 || get_bits_left(&r->gb) < n) {
+        r->ok = 0;
+        return 0;
+    }
+    return get_bits(&r->gb, n);
+}
+
+static void ac4_bits_skip(AC4Bits *r, int n)
+{
+    if (!r->ok || n < 0 || get_bits_left(&r->gb) < n) {
+        r->ok = 0;
+        return;
+    }
+    skip_bits_long(&r->gb, n);
+}
+
+/* variable_bits(n): n-bit groups plus a more bit; each continuation
+ * maps value to (value + 1) << n before adding the next group. */
+static int ac4_varbits(AC4Bits *r, int n)
+{
+    int v = 0;
+
+    for (int i = 0; i < 8 && r->ok; i++) {
+        int more;
+
+        v += ac4_bits_read(r, n);
+        if (!r->ok)
+            return 0;
+        if (v > 0xFFFFFF) {
+            r->ok = 0;
+            return 0;
+        }
+        more = ac4_bits_read(r, 1);
+        if (!r->ok)
+            return 0;
+        if (!more)
+            return v;
+        v = (v + 1) << n;
+    }
+    r->ok = 0;
+    return 0;
+}
+
+/* presentation_version: count of leading one bits. */
+static int ac4_unary(AC4Bits *r)
+{
+    int v = 0;
+
+    for (;;) {
+        int b = ac4_bits_read(r, 1);
+
+        if (!r->ok)
+            return 0;
+        if (!b)
+            return v;
+        if (++v > 16) {
+            r->ok = 0;
+            return 0;
+        }
+    }
+}
+
+static void ac4_skip_substream_index(AC4Bits *r)
+{
+    if (ac4_bits_read(r, 2) == 3)
+        ac4_varbits(r, 2);
+}
+
+static void ac4_skip_emdf(AC4Bits *r)
+{
+    int lp, ls, skip = 0;
+
+    if (ac4_bits_read(r, 2) == 3)
+        ac4_varbits(r, 2);
+    if (ac4_bits_read(r, 3) == 7)
+        ac4_varbits(r, 3);
+    if (ac4_bits_read(r, 1))
+        ac4_skip_substream_index(r);
+    lp = ac4_bits_read(r, 2);
+    ls = ac4_bits_read(r, 2);
+    if (lp > 0)
+        skip += 1 << (2 * (lp - 1));
+    if (ls > 0)
+        skip += 1 << (2 * (ls - 1));
+    ac4_bits_skip(r, 8 * skip);
+}
+
+/* frame_rate_multiply_info: bit shape depends on the rate row. */
+static int ac4_frame_rate_factor(AC4Bits *r, int rate)
+{
+    int bm, mb;
+
+    if (rate == 2 || rate == 3 || rate == 4) {
+        bm = ac4_bits_read(r, 1);
+        mb = bm ? ac4_bits_read(r, 1) : 0;
+        return (bm && mb) ? 4 : bm ? 2 : 1;
+    }
+    if (rate <= 1 || (rate >= 7 && rate <= 9)) {
+        bm = ac4_bits_read(r, 1);
+        return bm ? 2 : 1;
+    }
+    return 1;
+}
+
+static void ac4_skip_fractions(AC4Bits *r, int rate, int factor)
+{
+    if (rate >= 5 && rate <= 9 && factor == 1) {
+        ac4_bits_read(r, 1);
+    } else if (rate >= 10 && rate <= 12) {
+        if (ac4_bits_read(r, 1))
+            ac4_bits_read(r, 1);
+    }
+}
+
+/* channel_mode prefix walk 1/2/4/7/8/9 bits with the all-ones escape.
+ * The 7-bit values 126/127 continue into 8 bits, 254/255 into 9; only
+ * 511 escapes into varbits. Value 510 is terminal but unmapped. */
+static int ac4_channel_mode(AC4Bits *r)
+{
+    int v = ac4_bits_read(r, 1);
+
+    if (!v)
+        return 0;
+    v = (v << 1) | ac4_bits_read(r, 1);
+    if (v == 2)
+        return 2;
+    v = (v << 2) | ac4_bits_read(r, 2);
+    if (v >= 12 && v <= 14)
+        return v;
+    v = (v << 3) | ac4_bits_read(r, 3);
+    if (v < 126 || v > 127)
+        return v;
+    v = (v << 1) | ac4_bits_read(r, 1);
+    if (v < 254 || v > 255)
+        return v;
+    v = (v << 1) | ac4_bits_read(r, 1);
+    if (v != 511)
+        return v;
+    return v + ac4_varbits(r, 2);
+}
+
+typedef struct AC4HeadInfo {
+    int bv;      /* bitstream_version */
+    int fs;      /* fs_index */
+    int rate;    /* frame_rate_index */
+    int ig;      /* b_iframe_global */
+    int n_pres;  /* presentation count */
+} AC4HeadInfo;
+
+/* TOC head through the program-id block. Failure rejects the frame in
+ * streaming mode (split gate); the caller emits nothing on failure. */
+static int ac4_parse_head(AC4Bits *r, AC4HeadInfo *h)
+{
+    int bv = ac4_bits_read(r, 2);
+
+    if (bv == 3)
+        bv += ac4_varbits(r, 2);
+    if (!r->ok || bv > 2)
+        goto fail;
+    ac4_bits_read(r, 10);                 /* sequence_counter: ignored */
+    if (ac4_bits_read(r, 1)) {
+        if (ac4_bits_read(r, 3) > 0)
+            ac4_bits_read(r, 2);          /* br_code/reserved */
+    }
+    h->fs   = ac4_bits_read(r, 1);
+    h->rate = ac4_bits_read(r, 4);
+    if (!r->ok || h->rate >= 14)
+        goto fail;
+    h->ig = ac4_bits_read(r, 1);
+    if (ac4_bits_read(r, 1)) {
+        h->n_pres = 1;
+    } else if (ac4_bits_read(r, 1)) {
+        h->n_pres = ac4_varbits(r, 2) + 2;
+    } else {
+        h->n_pres = 0;
+    }
+    if (ac4_bits_read(r, 1)) {
+        if (ac4_bits_read(r, 5) == 31)
+            ac4_varbits(r, 3);
+    }
+    if (bv == 2 && ac4_bits_read(r, 1)) {
+        ac4_bits_read(r, 16);
+        if (ac4_bits_read(r, 1))
+            ac4_bits_skip(r, 128);
+    }
+    if (!r->ok)
+        goto fail;
+    h->bv = bv;
+    return 0;
+fail:
+    r->ok = 0;
+    return -1;
+}
+
+/* One v1 presentation record. Records version/group for presentation 0
+ * and skips the rest. Multi-group records bail: resolving them needs
+ * skip walks with no wire validation. */
+static int ac4_walk_pres_v1(AC4Bits *r, const AC4HeadInfo *h,
+                            int *pver_out, int *gi_out)
+{
+    int factor, gi, add_emdf, n;
+
+    if (!ac4_bits_read(r, 1) || !r->ok)
+        return -1;
+    *pver_out = ac4_unary(r);
+    ac4_bits_read(r, 3);                    /* md_compat */
+    if (ac4_bits_read(r, 1))
+        ac4_varbits(r, 2);
+    factor = ac4_frame_rate_factor(r, h->rate);
+    ac4_skip_fractions(r, h->rate, factor);
+    ac4_skip_emdf(r);
+    if (ac4_bits_read(r, 1))
+        ac4_bits_read(r, 1);
+    gi = ac4_bits_read(r, 3);
+    if (gi == 7)
+        gi += ac4_varbits(r, 2);
+    *gi_out = gi;
+    ac4_bits_read(r, 1);                    /* b_pre_virtualized */
+    add_emdf = ac4_bits_read(r, 1);
+    ac4_bits_read(r, 1);                    /* b_alternative */
+    ac4_bits_read(r, 1);                    /* b_pres_ndot */
+    ac4_skip_substream_index(r);
+    if (add_emdf) {
+        n = ac4_bits_read(r, 2);
+        if (!n)
+            n = ac4_varbits(r, 2) + 4;
+        for (int k = 0; k < n && r->ok; k++)
+            ac4_skip_emdf(r);
+    }
+    return r->ok ? 0 : -1;
+}
+
+/* Bitstream version 2: presentation 0 selects group 0, whose first
+ * channel-coded element carries the bed mode. A group without a bed
+ * (AJOC/object only) stops the walk with params untouched. */
+static int ac4_walk_bed_v2(AC4Bits *r, const AC4HeadInfo *h,
+                           int *cm_out, int *sf_out, int *pver_out)
+{
+    int pver = 0, gi = 0, dummy_p, dummy_g;
+
+    if (h->n_pres < 1)
+        return -1;
+    for (int i = 0; i < h->n_pres && r->ok; i++) {
+        if (!i) {
+            if (ac4_walk_pres_v1(r, h, &pver, &gi) < 0)
+                return -1;
+        } else if (ac4_walk_pres_v1(r, h, &dummy_p, &dummy_g) < 0) {
+            return -1;
+        }
+    }
+    if (!r->ok || gi)
+        return -1;
+    ac4_bits_read(r, 1);                    /* b_substreams_present */
+    ac4_bits_read(r, 1);                    /* b_hsf_ext */
+    if (!ac4_bits_read(r, 1)) {
+        if (ac4_bits_read(r, 2) == 3)
+            ac4_varbits(r, 2);
+    }
+    if (!r->ok)
+        return -1;
+    if (!ac4_bits_read(r, 1))
+        return -1;                          /* no bed in this group */
+    *cm_out = ac4_channel_mode(r);
+    if (!r->ok)
+        return -1;
+    if (*cm_out == 252 || *cm_out == 253 ||
+        *cm_out == 508 || *cm_out == 509)
+        ac4_bits_skip(r, 4);                /* immersive presence bits */
+    *sf_out = 1;
+    if (h->fs && ac4_bits_read(r, 1))
+        *sf_out = ac4_bits_read(r, 1) ? 4 : 2;
+    if (!r->ok)
+        return -1;
+    *pver_out = pver;
+    return 0;
+}
+
+/* Bitstream versions 0/1: presentation 0 carries an inline channel
+ * element, and nothing params need follows it, so later presentations
+ * need no walk. Zero wire vectors: spec positions, bail-safe. */
+static int ac4_walk_bed_p1(AC4Bits *r, const AC4HeadInfo *h,
+                           int *cm_out, int *sf_out, int *pver_out)
+{
+    int single, config = 0;
+
+    if (h->n_pres < 1)
+        return -1;
+    single = ac4_bits_read(r, 1);
+    if (!r->ok)
+        return -1;
+    if (!single) {
+        config = ac4_bits_read(r, 3);
+        if (config == 7)
+            config += ac4_varbits(r, 2);
+        if (!r->ok || config >= 6)
+            return -1;
+    }
+    *pver_out = ac4_unary(r);
+    ac4_bits_read(r, 3);                    /* md_compat */
+    if (ac4_bits_read(r, 1))
+        ac4_varbits(r, 2);
+    ac4_frame_rate_factor(r, h->rate);
+    ac4_skip_emdf(r);
+    if (!single)
+        ac4_bits_read(r, 1);                /* b_hsf_ext */
+    if (!r->ok)
+        return -1;
+    *cm_out = ac4_channel_mode(r);
+    *sf_out = 1;
+    if (h->fs && ac4_bits_read(r, 1))
+        *sf_out = ac4_bits_read(r, 1) ? 4 : 2;
+    return r->ok ? 0 : -1;
+}
+
+/* channel_mode value to bed channel count; -1 carries no count. */
+static int ac4_channel_count(int cm, int pres_ver, int *tentative)
+{
+    *tentative = 0;
+    if (pres_ver == 2 && (cm == 120 || cm == 121))
+        return cm == 120 ? 6 : 2;
+    switch (cm) {
+    case   0: return 1;
+    case   2: return 2;
+    case  12: return 3;
+    case  13: return 5;
+    case  14: return 6;
+    case 120:
+    case 122:
+    case 124: return 7;
+    case 121:
+    case 123:
+    case 125: return 8;
+    case 252: return 11;
+    case 253: return 12;
+    case 508: return 13;
+    case 509: return 14;
+    }
+    if (cm >= 511) {
+        *tentative = 1;
+        return 24;
+    }
+    return -1;
+}
+
+typedef struct AC4TOC {
+    int head_ok;    /* head parsed and gated */
+    int bed_ok;     /* bed walk completed */
+    int ig;
+    int rate;
+    int fs;
+    int channels;
+    int sf_mult;
+    int tentative;
+} AC4TOC;
+
+static void ac4_parse_toc(const uint8_t *raw, int raw_len, AC4TOC *toc)
+{
+    AC4Bits r;
+    AC4HeadInfo h;
+    int cm, sf, pver, nch, tentative = 0;
+
+    memset(toc, 0, sizeof(*toc));
+    toc->sf_mult = 1;
+    if (raw_len <= 0)
+        return;
+    if (init_get_bits8(&r.gb, raw, raw_len) < 0)
+        return;
+    r.ok = 1;
+    if (ac4_parse_head(&r, &h) < 0)
+        return;
+    toc->head_ok = 1;
+    toc->ig      = h.ig;
+    toc->rate    = h.rate;
+    toc->fs      = h.fs;
+    if (h.bv <= 1) {
+        if (ac4_walk_bed_p1(&r, &h, &cm, &sf, &pver) < 0)
+            return;
+    } else if (ac4_walk_bed_v2(&r, &h, &cm, &sf, &pver) < 0) {
+        return;
+    }
+    nch = ac4_channel_count(cm, pver, &tentative);
+    if (nch <= 0)
+        return;
+    toc->bed_ok    = 1;
+    toc->channels  = nch;
+    toc->sf_mult   = sf;
+    toc->tentative = tentative;
+}
+
+typedef struct AC4Candidate {
+    int total;  /* full sync-frame span */
+    int hlen;   /* header bytes: 4, or 7 with the extended length */
+    int crc;    /* 1 for the checksummed marker */
+} AC4Candidate;
+
+/* Classify the head at p: 1 = complete head, 0 = not a head (resync),
+ * -1 = split head, more data needed. The span is hlen + rawlen plus
+ * the stored word for checksummed frames. Absurd claims past AC4_MAX_SCAN
+ * count as not-a-head, so they resync without buffering or CRC. */
+static int ac4_head_at(const uint8_t *p, int avail, AC4Candidate *c)
+{
+    unsigned int marker, rawlen;
+
+    if (avail < 2)
+        return -1;
+    marker = AV_RB16(p);
+    if (marker != AC4_SYNC_BARE && marker != AC4_SYNC_CRC)
+        return 0;
+    if (avail < 4)
+        return -1;
+    c->crc  = (marker == AC4_SYNC_CRC);
+    c->hlen = 4;
+    rawlen  = AV_RB16(p + 2);
+    if (rawlen == 0xFFFF) {
+        if (avail < 7)
+            return -1;
+        c->hlen = 7;
+        rawlen  = AV_RB24(p + 4);
+    }
+    c->total = (int) ((unsigned int) c->hlen + rawlen + (c->crc ? 2u : 0u));
+    if (c->total > AC4_MAX_TOTAL)
+        return 0;
+    if (c->total > AC4_MAX_SCAN)
+        return 0;
+    return 1;
+}
+
+/* Append exactly n input bytes to the carried window. Only bytes
+ * inside the current candidate frame (plus a bounded AC40 anchor
+ * probe past its end) ever enter the window, so emission via
+ * ff_combine_frame always spans exactly the carried bytes. */
+static int ac4_append(AC4ParseContext *s, const uint8_t **in, int *in_len,
+                      int n, int *consumed)
+{
+    ParseContext *pc = &s->pc;
+    uint8_t *nb = av_fast_realloc(pc->buffer, &pc->buffer_size,
+                                  (size_t) pc->index + n +
+                                  AV_INPUT_BUFFER_PADDING_SIZE);
+
+    if (!nb) {
+        pc->index = 0;
+        return AVERROR(ENOMEM);
+    }
+    pc->buffer = nb;
+    memcpy(pc->buffer + pc->index, *in, n);
+    memset(pc->buffer + pc->index + n, 0, AV_INPUT_BUFFER_PADDING_SIZE);
+    pc->index += n;
+    *in       += n;
+    *in_len   -= n;
+    *consumed += n;
+    return 0;
+}
+
+/* Drop the first n window bytes (rejected head bytes, resync noise). */
+static void ac4_drop(AC4ParseContext *s, int n)
+{
+    ParseContext *pc = &s->pc;
+
+    if (n > pc->index)
+        n = pc->index;
+    pc->index -= n;
+    if (pc->index > 0)
+        memmove(pc->buffer, pc->buffer + n, pc->index);
+}
+
+typedef enum AC4Verdict {
+    AC4_ACCEPT,
+    AC4_REJECT,
+    AC4_NEED_MORE,   /* AC40 anchor split past the available bytes */
+} AC4Verdict;
+
+/* Judge one complete candidate frame: the TOC-head gate first, then
+ * the CRC for checksummed frames or the chaining anchor for bare
+ * ones. `after`/`after_len` are the bytes past the frame end. */
+static AC4Verdict ac4_validate(const uint8_t *frame, const AC4Candidate *c,
+                               const uint8_t *after, int after_len,
+                               int eof, AC4TOC *toc)
+{
+    const uint8_t *raw = frame + c->hlen;
+    int raw_len = c->total - c->hlen - (c->crc ? 2 : 0);
+
+    ac4_parse_toc(raw, raw_len, toc);
+    if (!toc->head_ok)
+        return AC4_REJECT;
+    if (c->crc)
+        return ac4_crc_ok(frame + 2, c->total - 2) ? AC4_ACCEPT : AC4_REJECT;
+    {
+        AC4Candidate a;
+        int ar = ac4_head_at(after, after_len, &a);
+
+        if (ar > 0)
+            return AC4_ACCEPT;
+        if (ar == 0)
+            return AC4_REJECT;
+        if (!eof)
+            return AC4_NEED_MORE;
+        return after_len == 0 ? AC4_ACCEPT : AC4_REJECT;
+    }
+}
+
+static void ac4_fill_params(AC4ParseContext *s, AVCodecParserContext *s1,
+                            AVCodecContext *avctx, const AC4TOC *toc,
+                            int emitted_bytes)
+{
+    int grid = (toc->rate == 13)
+        ? (toc->fs ? 48000 : 44100)
+        : ac4_grid_rate[toc->rate];
+    int sample_rate = grid * toc->sf_mult;
+    int duration    = ac4_spf[toc->rate] * toc->sf_mult;
+    int64_t bit_rate;
+
+    s1->key_frame = toc->ig;
+    if (!toc->bed_ok)
+        return;
+    s1->duration       = duration;
+    avctx->sample_rate = sample_rate;
+    av_channel_layout_uninit(&avctx->ch_layout);
+    switch (toc->channels) {
+    case 1:
+        av_channel_layout_from_mask(&avctx->ch_layout, AV_CH_LAYOUT_MONO);
+        break;
+    case 2:
+        av_channel_layout_from_mask(&avctx->ch_layout, AV_CH_LAYOUT_STEREO);
+        break;
+    case 6:
+        av_channel_layout_from_mask(&avctx->ch_layout, AV_CH_LAYOUT_5POINT1);
+        break;
+    case 8:
+        av_channel_layout_from_mask(&avctx->ch_layout, AV_CH_LAYOUT_7POINT1);
+        break;
+    default:
+        avctx->ch_layout.order       = AV_CHANNEL_ORDER_UNSPEC;
+        avctx->ch_layout.nb_channels = toc->channels;
+        break;
+    }
+    if (toc->tentative && !s->tent_logged) {
+        s->tent_logged = 1;
+        av_log(avctx, AV_LOG_DEBUG,
+               "ac4: tentative 24-channel layout for row-15 mode\n");
+    }
+    bit_rate = (int64_t) emitted_bytes * 8 * sample_rate / duration;
+    s->frame_number++;
+    avctx->bit_rate += (bit_rate - avctx->bit_rate) / s->frame_number;
+}
+
+static int ac4_parse(AVCodecParserContext *s1, AVCodecContext *avctx,
+                     const uint8_t **poutbuf, int *poutbuf_size,
+                     const uint8_t *buf, int buf_size)
+{
+    AC4ParseContext *s = s1->priv_data;
+    ParseContext *pc = &s->pc;
+    const uint8_t *in = buf;
+    int in_len = buf_size;
+    int consumed = 0;
+    int eof = (buf_size == 0);
+
+    *poutbuf      = NULL;
+    *poutbuf_size = 0;
+    s1->key_frame = -1;
+
+    if (s1->flags & PARSER_FLAG_COMPLETE_FRAMES) {
+        if (buf_size > 0) {
+            AC4TOC toc;
+
+            ac4_parse_toc(buf, buf_size, &toc);
+            if (toc.head_ok)
+                ac4_fill_params(s, s1, avctx, &toc, buf_size);
+            *poutbuf      = buf;
+            *poutbuf_size = buf_size;
+        }
+        return buf_size;
+    }
+
+    /* Streaming is scan-then-combine. Noise is skipped in the input
+     * without buffering, and only candidate-frame bytes (plus a
+     * bounded AC40 anchor probe past the frame end) enter the carried
+     * window, so every emit spans exactly the frame and the return
+     * value is the frame-end offset. Every iteration consumes input,
+     * shrinks the window, emits, or returns, so the loop terminates;
+     * every return on input consumes at least one byte. */
+    if (pc->overread) {
+        /* Restore the anchor-probe tail kept back by the previous
+         * emit. Deferred to this call because the emitted packet
+         * aliases the window. */
+        for (; pc->overread > 0; pc->overread--)
+            pc->buffer[pc->index++] = pc->buffer[pc->overread_index++];
+    }
+    for (;;) {
+        AC4Candidate c;
+        AC4TOC toc;
+        AC4Verdict v;
+        int hr, ret;
+
+        /* The carried window starts at a head, or is empty. */
+        while (pc->index > 0) {
+            hr = ac4_head_at(pc->buffer, pc->index, &c);
+            if (hr > 0)
+                break;
+            if (hr == 0) {
+                ac4_drop(s, 1);
+                continue;
+            }
+            if (eof || in_len == 0) {
+                if (eof)
+                    ac4_drop(s, 1);
+                else
+                    return consumed;
+            } else if (ac4_append(s, &in, &in_len,
+                                  FFMIN(7 - pc->index, in_len),
+                                  &consumed) < 0) {
+                return buf_size;
+            }
+        }
+
+        if (!pc->index) {
+            const uint8_t *m;
+
+            if (!in_len)
+                return consumed;
+            /* Skip noise in the input; it never enters the window. */
+            m = memchr(in, 0xAC, in_len);
+            if (!m)
+                return consumed + in_len;
+            consumed += m - in;
+            in_len   -= m - in;
+            in        = m;
+            hr = ac4_head_at(in, in_len, &c);
+            if (hr == 0) {
+                consumed++;
+                in++;
+                in_len--;
+                continue;
+            }
+            if (hr < 0 || in_len < c.total) {
+                /* Split head or partial frame: every remaining byte
+                 * lies inside the candidate span, so buffer it all. */
+                if (ac4_append(s, &in, &in_len, in_len, &consumed) < 0)
+                    return buf_size;
+                return consumed;
+            }
+            v = ac4_validate(in, &c, in + c.total, in_len - c.total,
+                             eof, &toc);
+            if (v == AC4_REJECT) {
+                consumed++;
+                in++;
+                in_len--;
+                continue;
+            }
+            if (v == AC4_NEED_MORE) {
+                /* The frame is complete but the anchor runs past the
+                 * input end; carry the frame and probe the anchor
+                 * from the next input. */
+                if (ac4_append(s, &in, &in_len, c.total, &consumed) < 0)
+                    return buf_size;
+                continue;
+            }
+            ret = ff_combine_frame(pc, c.total, &in, &in_len);
+            if (ret < 0)
+                return buf_size;
+            ac4_fill_params(s, s1, avctx, &toc, c.total);
+            *poutbuf      = in;
+            *poutbuf_size = in_len;
+            return consumed + c.total;
+        }
+
+        hr = ac4_head_at(pc->buffer, pc->index, &c);
+        if (pc->index < c.total) {
+            int need;
+
+            if (eof) {
+                /* A head that never completes still resyncs: later
+                 * bytes may hold the next frame. */
+                ac4_drop(s, 1);
+                continue;
+            }
+            if (!in_len)
+                return consumed;
+            need = c.total - pc->index;
+            if (ac4_append(s, &in, &in_len, FFMIN(need, in_len),
+                           &consumed) < 0)
+                return buf_size;
+            if (pc->index < c.total)
+                return consumed;
+        }
+        v = ac4_validate(pc->buffer, &c, pc->buffer + c.total,
+                         pc->index - c.total, eof, &toc);
+        if (v == AC4_REJECT) {
+            ac4_drop(s, 1);
+            continue;
+        }
+        if (v == AC4_NEED_MORE) {
+            int probe = pc->index - c.total;
+
+            if (!in_len)
+                return consumed;
+            /* Top up the anchor probe, at most to a classifiable
+             * head past the frame end. */
+            if (ac4_append(s, &in, &in_len, FFMIN(7 - probe, in_len),
+                           &consumed) < 0)
+                return buf_size;
+            continue;
+        }
+        /* A negative next keeps the probe tail past the frame end in
+         * the overread area; it is restored on the next call. */
+        ret = ff_combine_frame(pc, c.total - pc->index, &in, &in_len);
+        if (ret < 0)
+            return buf_size;
+        ac4_fill_params(s, s1, avctx, &toc, c.total);
+        *poutbuf      = in;
+        *poutbuf_size = in_len;
+        return consumed;
+    }
+}
+
+const FFCodecParser ff_ac4_parser = {
+    PARSER_CODEC_LIST(AV_CODEC_ID_AC4),
+    .priv_data_size = sizeof(AC4ParseContext),
+    .parse          = ac4_parse,
+    .close          = ff_parse_close,
+};
diff --git a/libavcodec/parsers.c b/libavcodec/parsers.c
index 263b606..d205bb6 100644
--- a/libavcodec/parsers.c
+++ b/libavcodec/parsers.c
@@ -24,6 +24,7 @@
 extern const FFCodecParser ff_aac_parser;
 extern const FFCodecParser ff_aac_latm_parser;
 extern const FFCodecParser ff_ac3_parser;
+extern const FFCodecParser ff_ac4_parser;
 extern const FFCodecParser ff_adx_parser;
 extern const FFCodecParser ff_ahx_parser;
 extern const FFCodecParser ff_amr_parser;
-- 
