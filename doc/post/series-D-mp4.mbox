+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+/**
+ * @file
+ * AC-4 frame splitter and TOC prober.
+ *
+ * Streaming mode splits the Annex G sync stream (AC40 bare / AC41
+ * checksummed markers). AC41 frames accept on CRC-16; AC40 frames
+ * accept on a chaining anchor (the next head parses exactly at the
+ * frame end) or, at EOF, on an exact end plus a valid TOC head.
+ * Every accept also passes a TOC-head gate (reserved rate rows 14/15
+ * rejected). Any reject advances exactly one byte.
+ *
+ * COMPLETE_FRAMES mode passes bare raw frames through (MP4 samples,
+ * raw-demux packets) and only probes the TOC. It never scans.
+ *
+ * Split and param fill are decoupled: the frame emits once framing
+ * verifies, while avctx/params update atomically and only when the
+ * bed walk completes. Any TOC failure leaves params untouched.
+ */
+
+#include <string.h>
+
+#include "libavutil/channel_layout.h"
+#include "libavutil/common.h"
+#include "libavutil/error.h"
+#include "libavutil/intreadwrite.h"
+#include "libavutil/log.h"
+#include "libavutil/mem.h"
+
+#include "ac4_toc.h"
+#include "get_bits.h"
+#include "parser.h"
+#include "parser_internal.h"
+
+#define AC4_SYNC_BARE 0xAC40
+#define AC4_SYNC_CRC  0xAC41
+
+/* Largest representable sync frame: 7-byte header + 2^24-1 raw + CRC. */
+#define AC4_MAX_TOTAL 16777224
+
+/* Largest plausible sync frame. The corpus max is 4286 B and the 16-bit
+ * length field tops out at 65540 B total, so a claim past 128 KiB would
+ * need ~24 Mbps of audio in one 43 ms frame: absurd. Heads claiming more
+ * reject before buffering or CRC, bounding per-position resync work. */
+#define AC4_MAX_SCAN (128 * 1024)
+
+typedef struct AC4ParseContext {
+    ParseContext pc;
+    int tent_logged;        /* tentative-layout notice already shown */
+    int64_t frame_number;   /* param fills, for the bit_rate average */
+} AC4ParseContext;
+
+
+/* CRC-16, MSB-first, poly 0x8005, init 0. The span covers the length
+ * field, the raw frame and the stored word; accept on zero remainder.
+ * AV_CRC_16_ANSI is reflected, so it cannot be used here. */
+static int ac4_crc_ok(const uint8_t *p, int len)
+{
+    unsigned int crc = 0;
+
+    for (int i = 0; i < len; i++) {
+        crc ^= (unsigned int) p[i] << 8;
+        for (int k = 0; k < 8; k++)
+            crc = (crc & 0x8000) ? ((crc << 1) ^ 0x8005) : (crc << 1);
+        crc &= 0xFFFF;
+    }
+    return !crc;
+}
+
+typedef struct AC4Candidate {
+    int total;  /* full sync-frame span */
+    int hlen;   /* header bytes: 4, or 7 with the extended length */
+    int crc;    /* 1 for the checksummed marker */
+} AC4Candidate;
+
+/* Classify the head at p: 1 = complete head, 0 = not a head (resync),
+ * -1 = split head, more data needed. The span is hlen + rawlen plus
+ * the stored word for checksummed frames. Absurd claims past AC4_MAX_SCAN
+ * count as not-a-head, so they resync without buffering or CRC. */
+static int ac4_head_at(const uint8_t *p, int avail, AC4Candidate *c)
+{
+    unsigned int marker, rawlen;
+
+    if (avail < 2)
+        return -1;
+    marker = AV_RB16(p);
+    if (marker != AC4_SYNC_BARE && marker != AC4_SYNC_CRC)
+        return 0;
+    if (avail < 4)
+        return -1;
+    c->crc  = (marker == AC4_SYNC_CRC);
+    c->hlen = 4;
+    rawlen  = AV_RB16(p + 2);
+    if (rawlen == 0xFFFF) {
+        if (avail < 7)
+            return -1;
+        c->hlen = 7;
+        rawlen  = AV_RB24(p + 4);
+    }
+    c->total = (int) ((unsigned int) c->hlen + rawlen + (c->crc ? 2u : 0u));
+    if (c->total > AC4_MAX_TOTAL)
+        return 0;
+    if (c->total > AC4_MAX_SCAN)
+        return 0;
+    return 1;
+}
+
+/* Append exactly n input bytes to the carried window. Only bytes
+ * inside the current candidate frame (plus a bounded AC40 anchor
+ * probe past its end) ever enter the window, so emission via
+ * ff_combine_frame always spans exactly the carried bytes. */
+static int ac4_append(AC4ParseContext *s, const uint8_t **in, int *in_len,
+                      int n, int *consumed)
+{
+    ParseContext *pc = &s->pc;
+    uint8_t *nb = av_fast_realloc(pc->buffer, &pc->buffer_size,
+                                  (size_t) pc->index + n +
+                                  AV_INPUT_BUFFER_PADDING_SIZE);
+
+    if (!nb) {
+        pc->index = 0;
+        return AVERROR(ENOMEM);
+    }
+    pc->buffer = nb;
+    memcpy(pc->buffer + pc->index, *in, n);
+    memset(pc->buffer + pc->index + n, 0, AV_INPUT_BUFFER_PADDING_SIZE);
+    pc->index += n;
+    *in       += n;
+    *in_len   -= n;
+    *consumed += n;
+    return 0;
+}
+
+/* Drop the first n window bytes (rejected head bytes, resync noise). */
+static void ac4_drop(AC4ParseContext *s, int n)
+{
+    ParseContext *pc = &s->pc;
+
+    if (n > pc->index)
+        n = pc->index;
+    pc->index -= n;
+    if (pc->index > 0)
+        memmove(pc->buffer, pc->buffer + n, pc->index);
+}
+
+typedef enum AC4Verdict {
+    AC4_ACCEPT,
+    AC4_REJECT,
+    AC4_NEED_MORE,   /* AC40 anchor split past the available bytes */
+} AC4Verdict;
+
+/* Judge one complete candidate frame: the TOC-head gate first, then
+ * the CRC for checksummed frames or the chaining anchor for bare
+ * ones. `after`/`after_len` are the bytes past the frame end. */
+static AC4Verdict ac4_validate(const uint8_t *frame, const AC4Candidate *c,
+                               const uint8_t *after, int after_len,
+                               int eof, FFAC4TOC *toc)
+{
+    const uint8_t *raw = frame + c->hlen;
+    int raw_len = c->total - c->hlen - (c->crc ? 2 : 0);
+
+    ff_ac4_toc_parse(raw, raw_len, toc);
+    if (!toc->head_ok)
+        return AC4_REJECT;
+    if (c->crc)
+        return ac4_crc_ok(frame + 2, c->total - 2) ? AC4_ACCEPT : AC4_REJECT;
+    {
+        AC4Candidate a;
+        int ar = ac4_head_at(after, after_len, &a);
+
+        if (ar > 0)
+            return AC4_ACCEPT;
+        if (ar == 0)
+            return AC4_REJECT;
+        if (!eof)
+            return AC4_NEED_MORE;
+        return after_len == 0 ? AC4_ACCEPT : AC4_REJECT;
+    }
+}
+
+static void ac4_fill_params(AC4ParseContext *s, AVCodecParserContext *s1,
+                            AVCodecContext *avctx, const FFAC4TOC *toc,
+                            int emitted_bytes)
+{
+    int sample_rate = (toc->fs ? 48000 : 44100) * toc->sf_mult;
+    int num, den, duration;
+    int64_t bit_rate;
+
+    ff_ac4_toc_frame_len(toc->rate, toc->fs, toc->sf_mult, &num, &den);
+    duration = ff_ac4_toc_frame_dur(num, den, s->frame_number);
+
+    s1->key_frame = toc->ig;
+    if (!toc->bed_ok)
+        return;
+    s1->duration       = duration;
+    avctx->sample_rate = sample_rate;
+    av_channel_layout_uninit(&avctx->ch_layout);
+    switch (toc->channels) {
+    case 1:
+        av_channel_layout_from_mask(&avctx->ch_layout, AV_CH_LAYOUT_MONO);
+        break;
+    case 2:
+        av_channel_layout_from_mask(&avctx->ch_layout, AV_CH_LAYOUT_STEREO);
+        break;
+    case 6:
+        av_channel_layout_from_mask(&avctx->ch_layout, AV_CH_LAYOUT_5POINT1);
+        break;
+    case 8:
+        av_channel_layout_from_mask(&avctx->ch_layout, AV_CH_LAYOUT_7POINT1);
+        break;
+    default:
+        avctx->ch_layout.order       = AV_CHANNEL_ORDER_UNSPEC;
+        avctx->ch_layout.nb_channels = toc->channels;
+        break;
+    }
+    if (toc->tentative && !s->tent_logged) {
+        s->tent_logged = 1;
+        av_log(avctx, AV_LOG_DEBUG,
+               "ac4: tentative 24-channel layout for row-15 mode\n");
+    }
+    bit_rate = (int64_t) emitted_bytes * 8 * sample_rate / duration;
+    s->frame_number++;
+    avctx->bit_rate += (bit_rate - avctx->bit_rate) / s->frame_number;
+}
+
+static int ac4_parse(AVCodecParserContext *s1, AVCodecContext *avctx,
+                     const uint8_t **poutbuf, int *poutbuf_size,
+                     const uint8_t *buf, int buf_size)
+{
+    AC4ParseContext *s = s1->priv_data;
+    ParseContext *pc = &s->pc;
+    const uint8_t *in = buf;
+    int in_len = buf_size;
+    int consumed = 0;
+    int eof = (buf_size == 0);
+
+    *poutbuf      = NULL;
+    *poutbuf_size = 0;
+    s1->key_frame = -1;
+
+    if (s1->flags & PARSER_FLAG_COMPLETE_FRAMES) {
+        if (buf_size > 0) {
+            FFAC4TOC toc;
+
+            ff_ac4_toc_parse(buf, buf_size, &toc);
+            if (toc.head_ok)
+                ac4_fill_params(s, s1, avctx, &toc, buf_size);
+            *poutbuf      = buf;
+            *poutbuf_size = buf_size;
+        }
+        return buf_size;
+    }
+
+    /* Streaming is scan-then-combine. Noise is skipped in the input
+     * without buffering, and only candidate-frame bytes (plus a
+     * bounded AC40 anchor probe past the frame end) enter the carried
+     * window, so every emit spans exactly the frame and the return
+     * value is the frame-end offset. Every iteration consumes input,
+     * shrinks the window, emits, or returns, so the loop terminates;
+     * every return on input consumes at least one byte. */
+    if (pc->overread) {
+        /* Restore the anchor-probe tail kept back by the previous
+         * emit. Deferred to this call because the emitted packet
+         * aliases the window. */
+        for (; pc->overread > 0; pc->overread--)
+            pc->buffer[pc->index++] = pc->buffer[pc->overread_index++];
+    }
+    for (;;) {
+        AC4Candidate c;
+        FFAC4TOC toc;
+        AC4Verdict v;
+        int hr, ret;
+
+        /* The carried window starts at a head, or is empty. */
+        while (pc->index > 0) {
+            hr = ac4_head_at(pc->buffer, pc->index, &c);
+            if (hr > 0)
+                break;
+            if (hr == 0) {
+                ac4_drop(s, 1);
+                continue;
+            }
+            if (eof || in_len == 0) {
+                if (eof)
+                    ac4_drop(s, 1);
+                else
+                    return consumed;
+            } else if (ac4_append(s, &in, &in_len,
+                                  FFMIN(7 - pc->index, in_len),
+                                  &consumed) < 0) {
+                return buf_size;
+            }
+        }
+
+        if (!pc->index) {
+            const uint8_t *m;
+
+            if (!in_len)
+                return consumed;
+            /* Skip noise in the input; it never enters the window. */
+            m = memchr(in, 0xAC, in_len);
+            if (!m)
+                return consumed + in_len;
+            consumed += m - in;
+            in_len   -= m - in;
+            in        = m;
+            hr = ac4_head_at(in, in_len, &c);
+            if (hr == 0) {
+                consumed++;
+                in++;
+                in_len--;
+                continue;
+            }
+            if (hr < 0 || in_len < c.total) {
+                /* Split head or partial frame: every remaining byte
+                 * lies inside the candidate span, so buffer it all. */
+                if (ac4_append(s, &in, &in_len, in_len, &consumed) < 0)
+                    return buf_size;
+                return consumed;
+            }
+            v = ac4_validate(in, &c, in + c.total, in_len - c.total,
+                             eof, &toc);
+            if (v == AC4_REJECT) {
+                consumed++;
+                in++;
+                in_len--;
+                continue;
+            }
+            if (v == AC4_NEED_MORE) {
+                /* The frame is complete but the anchor runs past the
+                 * input end; carry the frame and probe the anchor
+                 * from the next input. */
+                if (ac4_append(s, &in, &in_len, c.total, &consumed) < 0)
+                    return buf_size;
+                continue;
+            }
+            ret = ff_combine_frame(pc, c.total, &in, &in_len);
+            if (ret < 0)
+                return buf_size;
+            ac4_fill_params(s, s1, avctx, &toc, c.total);
+            *poutbuf      = in;
+            *poutbuf_size = in_len;
+            return consumed + c.total;
+        }
+
+        hr = ac4_head_at(pc->buffer, pc->index, &c);
+        if (pc->index < c.total) {
+            int need;
+
+            if (eof) {
+                /* A head that never completes still resyncs: later
+                 * bytes may hold the next frame. */
+                ac4_drop(s, 1);
+                continue;
+            }
+            if (!in_len)
+                return consumed;
+            need = c.total - pc->index;
+            if (ac4_append(s, &in, &in_len, FFMIN(need, in_len),
+                           &consumed) < 0)
+                return buf_size;
+            if (pc->index < c.total)
+                return consumed;
+        }
+        v = ac4_validate(pc->buffer, &c, pc->buffer + c.total,
+                         pc->index - c.total, eof, &toc);
+        if (v == AC4_REJECT) {
+            ac4_drop(s, 1);
+            continue;
+        }
+        if (v == AC4_NEED_MORE) {
+            int probe = pc->index - c.total;
+
+            if (!in_len)
+                return consumed;
+            /* Top up the anchor probe, at most to a classifiable
+             * head past the frame end. */
+            if (ac4_append(s, &in, &in_len, FFMIN(7 - probe, in_len),
+                           &consumed) < 0)
+                return buf_size;
+            continue;
+        }
+        /* A negative next keeps the probe tail past the frame end in
+         * the overread area; it is restored on the next call. */
+        ret = ff_combine_frame(pc, c.total - pc->index, &in, &in_len);
+        if (ret < 0)
+            return buf_size;
+        ac4_fill_params(s, s1, avctx, &toc, c.total);
+        *poutbuf      = in;
+        *poutbuf_size = in_len;
+        return consumed;
+    }
+}
+
+const FFCodecParser ff_ac4_parser = {
+    PARSER_CODEC_LIST(AV_CODEC_ID_AC4),
+    .priv_data_size = sizeof(AC4ParseContext),
+    .parse          = ac4_parse,
+    .close          = ff_parse_close,
+};
