From 0747972024798f32a2ae2ca79fd83a970d3074fc Mon Sep 17 00:00:00 2001
From: Michael Rowlinson <mrowlinson@gmail.com>
Date: Fri, 16 Oct 2026 04:07:57 -0400
Subject: [PATCH 5/6] fate: add self-contained ac4 mp4 mux/demux roundtrip test

Upstream will not take a testless mux/demux pair. New
api-ac4-mp4-roundtrip-test synthesizes its vectors in code, so the
suite needs no uploaded samples: bare raw_ac4_frame packets (the same
minimal version-2 stereo TOC shape as fate-ac4-parser) plus AC40, AC41
and ext-len AC41 Annex G framings with CRCs solved per frame, muxed to
MP4 and demuxed back, asserting dac4 payload byte-exact vs the DSI
golden at both the box level and the demux extradata level, stsz ==
packets == 4, byte-identical payloads, and post-parse 48 kHz stereo
params. Three negatives fail loud: mux without extradata refuses
EINVAL, a file cut inside dac4 and a dac4 box claiming a 2-byte payload
both fail open with INVALIDDATA. Wired as fate-ac4-mp4-roundtrip behind
MP4_MUXER + MOV_DEMUXER + AC4_PARSER.

Rebased onto Series C: appends to the C-created tests/fate/ac4.mak
(and extends the fate-ac4 aggregate) instead of creating it.

Signed-off-by: Michael Rowlinson <mrowlinson@gmail.com>
---
 tests/api/Makefile                     |   1 +
 tests/api/api-ac4-mp4-roundtrip-test.c | 691 +++++++++++++++++++++++++
 tests/fate/ac4.mak                     |  14 +-
 3 files changed, 704 insertions(+), 2 deletions(-)
 create mode 100644 tests/api/api-ac4-mp4-roundtrip-test.c

diff --git a/tests/api/Makefile b/tests/api/Makefile
index 751c84e..8beff3f 100644
--- a/tests/api/Makefile
+++ b/tests/api/Makefile
@@ -11,6 +11,7 @@ APITESTPROGS-$(HAVE_THREADS) += api-threadmessage
 APITESTPROGS-$(CONFIG_AVCODEC) += api-enc-info
 APITESTPROGS-$(call ALLYES, H261_ENCODER H261_PARSER) += api-enc-parser
 APITESTPROGS-$(CONFIG_AC4_PARSER) += api-ac4-parser
+APITESTPROGS-$(call ALLYES, MP4_MUXER MOV_DEMUXER AC4_PARSER) += api-ac4-mp4-roundtrip
 APITESTPROGS += $(APITESTPROGS-yes)
 
 APITESTOBJS  := $(APITESTOBJS:%=$(APITESTSDIR)%) $(APITESTPROGS:%=$(APITESTSDIR)/%-test.o)
diff --git a/tests/api/api-ac4-mp4-roundtrip-test.c b/tests/api/api-ac4-mp4-roundtrip-test.c
new file mode 100644
index 0000000..c14dd10
--- /dev/null
+++ b/tests/api/api-ac4-mp4-roundtrip-test.c
@@ -0,0 +1,691 @@
+/*
+ * AC-4 MP4 mux/demux roundtrip test.
+ * Copyright (c) 2026 Michael Rowlinson
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+/**
+ * @file
+ * Self-contained AC-4 MP4 roundtrip tests. Bare raw_ac4_frame vectors
+ * are synthesized in code (the same minimal version-2 stereo TOC shape
+ * as api-ac4-parser-test), muxed to MP4, demuxed back, and checked for
+ * dac4/extradata byte-exactness, stsz/packet counts and byte-identical
+ * payloads. Framed (Annex G) inputs cover the mux strip path; mux and
+ * demux negatives must fail loud. No fate-suite samples needed.
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdint.h>
+
+#include "libavformat/avformat.h"
+#include "libavcodec/avcodec.h"
+#include "libavutil/channel_layout.h"
+#include "libavutil/error.h"
+#include "libavutil/mem.h"
+
+static int failures = 0;
+#define CHECK(cond, ...) do { \
+    if (!(cond)) { \
+        printf("FAIL: " __VA_ARGS__); printf("\n"); failures++; \
+    } \
+} while (0)
+
+/* Deterministic noise without stray sync bytes. */
+static uint32_t lcg_state;
+static void noise(uint8_t *d, int n, uint32_t seed)
+{
+    lcg_state = seed;
+    for (int i = 0; i < n; i++) {
+        int b;
+        lcg_state = lcg_state * 1103515245u + 12345u;
+        b = (lcg_state >> 16) & 0xFF;
+        d[i] = (b == 0xAC) ? 0xAD : b;
+    }
+}
+
+/* CRC-16, MSB-first, poly 0x8005, init 0 (test-local copy of the
+ * sync-layer rule: accept on zero remainder over the span). */
+static unsigned int crc16_update(unsigned int crc, const uint8_t *p, int len)
+{
+    for (int i = 0; i < len; i++) {
+        crc ^= (unsigned int) p[i] << 8;
+        for (int k = 0; k < 8; k++)
+            crc = (crc & 0x8000) ? ((crc << 1) ^ 0x8005) : (crc << 1);
+        crc &= 0xFFFF;
+    }
+    return crc;
+}
+
+/* Stored word making (span plus word) check to zero. The map from the
+ * 16 stored bits to the final remainder is bijective, so the search
+ * always terminates. */
+static unsigned int crc16_fix(const uint8_t *span, int len)
+{
+    unsigned int r = crc16_update(0, span, len);
+
+    for (int v = 0; v < 65536; v++) {
+        uint8_t tail[2] = { v >> 8, v & 0xFF };
+        if (crc16_update(r, tail, 2) == 0)
+            return v;
+    }
+    return 0;
+}
+
+typedef struct BitW {
+    uint8_t *d;
+    int bit;
+} BitW;
+
+static void put_bits(BitW *w, int n, unsigned int v)
+{
+    for (int i = n - 1; i >= 0; i--) {
+        if ((v >> i) & 1)
+            w->d[w->bit / 8] |= 1 << (7 - w->bit % 8);
+        w->bit++;
+    }
+}
+
+/* Minimal version-2 stereo TOC: presentation 0, group 0, one
+ * channel-coded bed element, channel_mode 2. All other fields take
+ * their zero/absent shape. */
+static int build_toc(uint8_t *raw, int bv, int seq, int fs, int rate,
+                     int ig, int n_pres)
+{
+    BitW w = { raw, 0 };
+
+    put_bits(&w, 2, bv);
+    put_bits(&w, 10, seq);
+    put_bits(&w, 1, 0);
+    put_bits(&w, 1, fs);
+    put_bits(&w, 4, rate);
+    put_bits(&w, 1, ig);
+    if (n_pres) {
+        put_bits(&w, 1, 1);
+    } else {
+        put_bits(&w, 1, 0);
+        put_bits(&w, 1, 0);
+    }
+    put_bits(&w, 1, 0);
+    if (bv == 2)
+        put_bits(&w, 1, 0);
+    if (!n_pres)
+        return (w.bit + 7) / 8;
+    /* One v1 presentation record, group index 0. */
+    put_bits(&w, 1, 1);
+    put_bits(&w, 1, 0);       /* presentation_version 0 */
+    put_bits(&w, 3, 0);
+    put_bits(&w, 1, 0);
+    put_bits(&w, 2, 0);       /* emdf substream/version/shape: absent */
+    put_bits(&w, 3, 0);
+    put_bits(&w, 1, 0);
+    put_bits(&w, 2, 0);
+    put_bits(&w, 2, 0);
+    put_bits(&w, 1, 0);
+    put_bits(&w, 3, 0);       /* group index */
+    put_bits(&w, 1, 0);
+    put_bits(&w, 1, 0);
+    put_bits(&w, 1, 0);
+    put_bits(&w, 1, 0);
+    put_bits(&w, 2, 0);
+    /* Group 0 head: bed present, channel_mode 2 (stereo). */
+    put_bits(&w, 1, 0);
+    put_bits(&w, 1, 0);
+    put_bits(&w, 1, 1);
+    put_bits(&w, 1, 1);
+    put_bits(&w, 1, 1);
+    put_bits(&w, 1, 0);
+    if (fs)
+        put_bits(&w, 1, 0);
+    return (w.bit + 7) / 8;
+}
+
+#define RAW_LEN 64
+#define NFRAMES 4
+#define PKT_MAX 80
+
+/* One synthetic bare raw frame: bv2, 48 kHz grid, iframe. */
+static void build_raw(uint8_t *raw, int seq, uint32_t seed)
+{
+    int head_bytes;
+
+    memset(raw, 0, RAW_LEN);
+    head_bytes = build_toc(raw, 2, seq, 1, 13, 1, 1);
+    noise(raw + head_bytes, RAW_LEN - head_bytes, seed);
+}
+
+/* Annex G wrappers for the mux strip-path cases. CRCs solved per frame. */
+static int wrap_ac40(uint8_t *d, const uint8_t *raw)
+{
+    d[0] = 0xAC;
+    d[1] = 0x40;
+    d[2] = RAW_LEN >> 8;
+    d[3] = RAW_LEN & 0xFF;
+    memcpy(d + 4, raw, RAW_LEN);
+    return 4 + RAW_LEN;
+}
+
+static int wrap_ac41(uint8_t *d, const uint8_t *raw)
+{
+    unsigned int crc;
+
+    d[0] = 0xAC;
+    d[1] = 0x41;
+    d[2] = RAW_LEN >> 8;
+    d[3] = RAW_LEN & 0xFF;
+    memcpy(d + 4, raw, RAW_LEN);
+    /* CRC over the length bytes plus raw, stored big-endian. */
+    crc = crc16_fix(d + 2, 2 + RAW_LEN);
+    d[4 + RAW_LEN]     = crc >> 8;
+    d[4 + RAW_LEN + 1] = crc & 0xFF;
+    return 4 + RAW_LEN + 2;
+}
+
+static int wrap_ac41_ext(uint8_t *d, const uint8_t *raw)
+{
+    unsigned int crc;
+
+    d[0] = 0xAC;
+    d[1] = 0x41;
+    d[2] = 0xFF;
+    d[3] = 0xFF;
+    d[4] = (RAW_LEN >> 16) & 0xFF;
+    d[5] = (RAW_LEN >> 8) & 0xFF;
+    d[6] = RAW_LEN & 0xFF;
+    memcpy(d + 7, raw, RAW_LEN);
+    /* CRC over the 5 length bytes plus raw. */
+    crc = crc16_fix(d + 2, 5 + RAW_LEN);
+    d[7 + RAW_LEN]     = crc >> 8;
+    d[7 + RAW_LEN + 1] = crc & 0xFF;
+    return 7 + RAW_LEN + 2;
+}
+
+/* DSI golden: stereo 34 B payload (dashif shape, DSI-CONTRACT 5). */
+static const uint8_t dsi_golden[] = {
+    0x20, 0xa4, 0x01, 0x80, 0x96, 0x30, 0x00, 0x00,
+    0x00, 0x0f, 0xff, 0xff, 0xff, 0xf0, 0x01, 0x12,
+    0xf8, 0xa8, 0x00, 0x00, 0x42, 0x00, 0x00, 0x02,
+    0x50, 0x10, 0x00, 0x00, 0x03, 0x10, 0x99, 0x5b,
+    0x80, 0x80,
+};
+
+/* Minimal box reader for file-level asserts (stsz counts, dac4 bytes). */
+static uint32_t rb32(const uint8_t *p)
+{
+    return ((uint32_t) p[0] << 24) | ((uint32_t) p[1] << 16) |
+           ((uint32_t) p[2] << 8) | p[3];
+}
+
+/* First child box of type `want` in [start, end): payload range out,
+ * box head offset returned, -1 when absent. size 1/0 handled. */
+static int64_t find_box(const uint8_t *buf, int64_t start, int64_t end,
+                        uint32_t want, int64_t *pay_off, int64_t *pay_len)
+{
+    int64_t p = start;
+
+    while (p + 8 <= end) {
+        uint64_t size = rb32(buf + p);
+        uint32_t type = rb32(buf + p + 4);
+        int64_t head = 8;
+
+        if (size == 1) {
+            uint64_t hi, lo;
+            if (p + 16 > end)
+                return -1;
+            hi = rb32(buf + p + 8);
+            lo = rb32(buf + p + 12);
+            size = (hi << 32) | lo;
+            head = 16;
+        } else if (size == 0) {
+            size = end - p;
+        }
+        if (size < (uint64_t) head || p + (int64_t) size > end)
+            return -1;
+        if (type == want) {
+            *pay_off = p + head;
+            *pay_len = (int64_t) size - head;
+            return p;
+        }
+        p += size;
+    }
+    return -1;
+}
+
+static int64_t find_path(const uint8_t *buf, int64_t start, int64_t end,
+                         const uint32_t *types, int n,
+                         int64_t *pay_off, int64_t *pay_len)
+{
+    for (int i = 0; i < n; i++) {
+        if (find_box(buf, start, end, types[i], &start, pay_len) < 0)
+            return -1;
+        end = start + *pay_len;
+    }
+    *pay_off = start;
+    return start;
+}
+
+static uint8_t *read_file(const char *path, int *len_out)
+{
+    FILE *f = fopen(path, "rb");
+    uint8_t *buf;
+    long len;
+
+    if (!f)
+        return NULL;
+    fseek(f, 0, SEEK_END);
+    len = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    if (len < 0 || len > 16 * 1024 * 1024) {
+        fclose(f);
+        return NULL;
+    }
+    buf = malloc(len + 1);
+    if (!buf) {
+        fclose(f);
+        return NULL;
+    }
+    if (len > 0 && fread(buf, 1, len, f) != (size_t) len) {
+        free(buf);
+        fclose(f);
+        return NULL;
+    }
+    fclose(f);
+    *len_out = (int) len;
+    return buf;
+}
+
+static int write_file(const char *path, const uint8_t *buf, int len)
+{
+    FILE *f = fopen(path, "wb");
+
+    if (!f)
+        return -1;
+    if (len > 0 && fwrite(buf, 1, len, f) != (size_t) len) {
+        fclose(f);
+        return -1;
+    }
+    fclose(f);
+    return 0;
+}
+
+static int mux_file(const char *path, uint8_t pkts[][PKT_MAX],
+                    const int *lens, int n,
+                    const uint8_t *dsi, int dsi_len)
+{
+    AVFormatContext *out = NULL;
+    AVStream *st;
+    AVPacket *pkt = NULL;
+    int ret, i;
+
+    ret = avformat_alloc_output_context2(&out, NULL, "mp4", path);
+    if (ret < 0 || !out)
+        return ret < 0 ? ret : AVERROR(ENOMEM);
+    st = avformat_new_stream(out, NULL);
+    if (!st) {
+        avformat_free_context(out);
+        return AVERROR(ENOMEM);
+    }
+    st->codecpar->codec_type  = AVMEDIA_TYPE_AUDIO;
+    st->codecpar->codec_id    = AV_CODEC_ID_AC4;
+    st->codecpar->sample_rate = 48000;
+    av_channel_layout_default(&st->codecpar->ch_layout, 2);
+    st->time_base = (AVRational){ 1, 48000 };
+    if (dsi) {
+        st->codecpar->extradata =
+            av_memdup(dsi, dsi_len + AV_INPUT_BUFFER_PADDING_SIZE);
+        if (!st->codecpar->extradata) {
+            avformat_free_context(out);
+            return AVERROR(ENOMEM);
+        }
+        memset(st->codecpar->extradata + dsi_len, 0,
+               AV_INPUT_BUFFER_PADDING_SIZE);
+        st->codecpar->extradata_size = dsi_len;
+    }
+
+    ret = avio_open(&out->pb, path, AVIO_FLAG_WRITE);
+    if (ret < 0) {
+        avformat_free_context(out);
+        return ret;
+    }
+    ret = avformat_write_header(out, NULL);
+    if (ret < 0)
+        goto done;
+    pkt = av_packet_alloc();
+    if (!pkt) {
+        ret = AVERROR(ENOMEM);
+        goto done;
+    }
+    for (i = 0; i < n; i++) {
+        ret = av_new_packet(pkt, lens[i]);
+        if (ret < 0)
+            break;
+        memcpy(pkt->data, pkts[i], lens[i]);
+        pkt->pts = pkt->dts = (int64_t) i * 2048;
+        pkt->duration = 2048;
+        pkt->stream_index = 0;
+        ret = av_interleaved_write_frame(out, pkt);
+        av_packet_unref(pkt);
+        if (ret < 0)
+            break;
+    }
+    if (ret >= 0)
+        ret = av_write_trailer(out);
+done:
+    av_packet_free(&pkt);
+    if (out->pb)
+        avio_closep(&out->pb);
+    avformat_free_context(out);
+    return ret;
+}
+
+#define TAG(a, b, c, d) \
+    (((uint32_t) (a) << 24) | ((uint32_t) (b) << 16) | \
+     ((uint32_t) (c) << 8) | (uint32_t) (d))
+
+/* stsz sample_count and per-sample sizes, straight from the boxes. */
+static int check_stsz(const char *tag, const uint8_t *buf, int len, int n)
+{
+    static const uint32_t path[] = {
+        TAG('m', 'o', 'o', 'v'), TAG('t', 'r', 'a', 'k'),
+        TAG('m', 'd', 'i', 'a'), TAG('m', 'i', 'n', 'f'),
+        TAG('s', 't', 'b', 'l'), TAG('s', 't', 's', 'z'),
+    };
+    int64_t off, plen;
+    uint32_t count, sample_size;
+    int i;
+
+    if (find_path(buf, 0, len, path, 6, &off, &plen) < 0) {
+        CHECK(0, "%s: stsz box missing", tag);
+        return -1;
+    }
+    if (plen < 12) {
+        CHECK(0, "%s: stsz payload short", tag);
+        return -1;
+    }
+    sample_size = rb32(buf + off + 4);
+    count       = rb32(buf + off + 8);
+    CHECK(count == (uint32_t) n, "%s: stsz count %u != %d", tag, count, n);
+    if (sample_size == 0) {
+        if (plen < 12 + 4 * (int64_t) count) {
+            CHECK(0, "%s: stsz entries short", tag);
+            return -1;
+        }
+        for (i = 0; i < n && (uint32_t) i < count; i++)
+            CHECK(rb32(buf + off + 12 + 4 * i) == RAW_LEN,
+                  "%s: stsz[%d] %u != %d", tag, i,
+                  rb32(buf + off + 12 + 4 * i), RAW_LEN);
+    } else {
+        CHECK(sample_size == RAW_LEN, "%s: stsz uniform %u != %d",
+              tag, sample_size, RAW_LEN);
+    }
+    return (int) count;
+}
+
+/* dac4 payload bytes, straight from the ac-4 sample entry. */
+static int64_t find_dac4(const uint8_t *buf, int len,
+                         int64_t *pay_off, int64_t *pay_len)
+{
+    static const uint32_t path[] = {
+        TAG('m', 'o', 'o', 'v'), TAG('t', 'r', 'a', 'k'),
+        TAG('m', 'd', 'i', 'a'), TAG('m', 'i', 'n', 'f'),
+        TAG('s', 't', 'b', 'l'), TAG('s', 't', 's', 'd'),
+    };
+    int64_t off, plen, entry, entry_len, children;
+
+    if (find_path(buf, 0, len, path, 6, &off, &plen) < 0)
+        return -1;
+    /* stsd: version/flags + entry_count, then sample entries. */
+    if (plen < 8 || rb32(buf + off + 4) != 1)
+        return -1;
+    off += 8;
+    plen -= 8;
+    entry_len = rb32(buf + off);
+    if (entry_len > plen || entry_len < 36 ||
+        rb32(buf + off + 4) != TAG('a', 'c', '-', '4'))
+        return -1;
+    entry = off;
+    /* v0 SoundSampleEntry header is 36 bytes; dac4 is a child. */
+    children = entry + 36;
+    return find_box(buf, children, entry + entry_len,
+                    TAG('d', 'a', 'c', '4'), pay_off, pay_len);
+}
+
+static void check_roundtrip(const char *tag, const char *path,
+                            uint8_t raws[][RAW_LEN], int n)
+{
+    AVFormatContext *in = NULL;
+    AVPacket *pkt = NULL;
+    uint8_t *file;
+    int file_len, stsz_count, count = 0, ret;
+    int64_t dac4_head, dac4_off, dac4_len;
+
+    file = read_file(path, &file_len);
+    CHECK(file != NULL, "%s: cannot read back %s", tag, path);
+    if (!file)
+        return;
+    stsz_count = check_stsz(tag, file, file_len, n);
+    dac4_head = find_dac4(file, file_len, &dac4_off, &dac4_len);
+    CHECK(dac4_head >= 0, "%s: dac4 box missing", tag);
+    if (dac4_head >= 0) {
+        CHECK(dac4_len == (int64_t) sizeof(dsi_golden),
+              "%s: dac4 payload %lld != %d", tag,
+              (long long) dac4_len, (int) sizeof(dsi_golden));
+        if (dac4_len == (int64_t) sizeof(dsi_golden))
+            CHECK(memcmp(file + dac4_off, dsi_golden, sizeof(dsi_golden)) == 0,
+                  "%s: dac4 payload differs from DSI", tag);
+    }
+    free(file);
+
+    ret = avformat_open_input(&in, path, NULL, NULL);
+    CHECK(ret >= 0, "%s: open failed (%d)", tag, ret);
+    if (ret < 0)
+        return;
+    ret = avformat_find_stream_info(in, NULL);
+    CHECK(ret >= 0, "%s: find_stream_info failed (%d)", tag, ret);
+    CHECK(in->nb_streams == 1, "%s: %d streams != 1", tag, in->nb_streams);
+    if (in->nb_streams == 1) {
+        AVCodecParameters *par = in->streams[0]->codecpar;
+        CHECK(par->codec_id == AV_CODEC_ID_AC4, "%s: codec %d != ac4",
+              tag, par->codec_id);
+        CHECK(par->extradata_size == (int) sizeof(dsi_golden) &&
+              memcmp(par->extradata, dsi_golden, sizeof(dsi_golden)) == 0,
+              "%s: demux extradata not byte-exact", tag);
+        CHECK(par->sample_rate == 48000, "%s: rate %d != 48000",
+              tag, par->sample_rate);
+        CHECK(par->ch_layout.nb_channels == 2, "%s: ch %d != 2",
+              tag, par->ch_layout.nb_channels);
+    }
+    pkt = av_packet_alloc();
+    if (!pkt) {
+        CHECK(0, "%s: packet alloc failed", tag);
+        avformat_close_input(&in);
+        return;
+    }
+    for (;;) {
+        ret = av_read_frame(in, pkt);
+        if (ret == AVERROR_EOF)
+            break;
+        if (ret < 0) {
+            CHECK(0, "%s: read failed (%d)", tag, ret);
+            break;
+        }
+        if (pkt->stream_index == 0) {
+            CHECK(pkt->size == RAW_LEN, "%s: pkt %d size %d != %d",
+                  tag, count, pkt->size, RAW_LEN);
+            if (count < n && pkt->size == RAW_LEN)
+                CHECK(memcmp(pkt->data, raws[count], RAW_LEN) == 0,
+                      "%s: pkt %d payload differs", tag, count);
+            count++;
+        }
+        av_packet_unref(pkt);
+    }
+    av_packet_free(&pkt);
+    avformat_close_input(&in);
+    CHECK(count == n, "%s: %d packets != %d", tag, count, n);
+    CHECK(count == stsz_count, "%s: %d packets != stsz %d",
+          tag, count, stsz_count);
+}
+
+/* Empty extradata must refuse with EINVAL, never an empty dac4 box. */
+static void check_mux_noext(const char *tag, const char *path,
+                            uint8_t pkts[][PKT_MAX], const int *lens, int n)
+{
+    int ret = mux_file(path, pkts, lens, n, NULL, 0);
+
+    CHECK(ret == AVERROR(EINVAL), "%s: mux-noext ret %d, want EINVAL",
+          tag, ret);
+}
+
+/* A file cut inside the dac4 payload must fail open, not misparse. */
+static void check_trunc_dac4(const char *tag, const char *good,
+                             const char *path)
+{
+    AVFormatContext *in = NULL;
+    uint8_t *file;
+    int file_len, ret;
+    int64_t dac4_head, dac4_off, dac4_len;
+
+    file = read_file(good, &file_len);
+    CHECK(file != NULL, "%s: cannot read %s", tag, good);
+    if (!file)
+        return;
+    dac4_head = find_dac4(file, file_len, &dac4_off, &dac4_len);
+    CHECK(dac4_head >= 0, "%s: dac4 box missing", tag);
+    if (dac4_head < 0) {
+        free(file);
+        return;
+    }
+    ret = write_file(path, file, (int) dac4_off + 10);
+    free(file);
+    CHECK(ret == 0, "%s: cannot write %s", tag, path);
+    if (ret)
+        return;
+    ret = avformat_open_input(&in, path, NULL, NULL);
+    CHECK(ret == AVERROR_INVALIDDATA,
+          "%s: trunc-dac4 ret %d, want INVALIDDATA", tag, ret);
+    if (ret >= 0)
+        avformat_close_input(&in);
+}
+
+/* A dac4 box claiming a sub-minimum payload must fail open loudly. */
+static void check_bad_dac4_size(const char *tag, const char *good,
+                                const char *path)
+{
+    AVFormatContext *in = NULL;
+    uint8_t *file;
+    int file_len, ret;
+    int64_t dac4_head, dac4_off, dac4_len;
+
+    file = read_file(good, &file_len);
+    CHECK(file != NULL, "%s: cannot read %s", tag, good);
+    if (!file)
+        return;
+    dac4_head = find_dac4(file, file_len, &dac4_off, &dac4_len);
+    CHECK(dac4_head >= 0, "%s: dac4 box missing", tag);
+    if (dac4_head < 0) {
+        free(file);
+        return;
+    }
+    /* Box length 10: a 2-byte payload trips the demux sanity floor. */
+    file[dac4_head] = 0;
+    file[dac4_head + 1] = 0;
+    file[dac4_head + 2] = 0;
+    file[dac4_head + 3] = 10;
+    ret = write_file(path, file, file_len);
+    free(file);
+    CHECK(ret == 0, "%s: cannot write %s", tag, path);
+    if (ret)
+        return;
+    ret = avformat_open_input(&in, path, NULL, NULL);
+    CHECK(ret == AVERROR_INVALIDDATA,
+          "%s: bad-dac4-size ret %d, want INVALIDDATA", tag, ret);
+    if (ret >= 0)
+        avformat_close_input(&in);
+}
+
+static const char *tmpdir(void)
+{
+    const char *t = getenv("TMPDIR");
+
+    return t && *t ? t : "/tmp";
+}
+
+int main(void)
+{
+    static uint8_t raws[NFRAMES][RAW_LEN];
+    static uint8_t pkts[NFRAMES][PKT_MAX];
+    static int lens[NFRAMES];
+    char path[512], good[512], bad[512];
+    int i;
+
+    av_log_set_level(AV_LOG_ERROR);
+    for (i = 0; i < NFRAMES; i++)
+        build_raw(raws[i], i, 101 + i);
+
+    /* Bare raw frames: mux writes samples as-is. */
+    for (i = 0; i < NFRAMES; i++) {
+        memcpy(pkts[i], raws[i], RAW_LEN);
+        lens[i] = RAW_LEN;
+    }
+    snprintf(path, sizeof(path), "%s/ac4rt-bare.mp4", tmpdir());
+    CHECK(mux_file(path, pkts, lens, NFRAMES,
+                   dsi_golden, sizeof(dsi_golden)) == 0, "bare: mux failed");
+    check_roundtrip("bare", path, raws, NFRAMES);
+    snprintf(good, sizeof(good), "%s", path);
+
+    /* AC40/AC41/ext wrappers: mux strips to the same bare samples. */
+    for (i = 0; i < NFRAMES; i++)
+        lens[i] = wrap_ac40(pkts[i], raws[i]);
+    snprintf(path, sizeof(path), "%s/ac4rt-ac40.mp4", tmpdir());
+    CHECK(mux_file(path, pkts, lens, NFRAMES,
+                   dsi_golden, sizeof(dsi_golden)) == 0, "ac40: mux failed");
+    check_roundtrip("ac40", path, raws, NFRAMES);
+
+    for (i = 0; i < NFRAMES; i++)
+        lens[i] = wrap_ac41(pkts[i], raws[i]);
+    snprintf(path, sizeof(path), "%s/ac4rt-ac41.mp4", tmpdir());
+    CHECK(mux_file(path, pkts, lens, NFRAMES,
+                   dsi_golden, sizeof(dsi_golden)) == 0, "ac41: mux failed");
+    check_roundtrip("ac41", path, raws, NFRAMES);
+
+    for (i = 0; i < NFRAMES; i++)
+        lens[i] = wrap_ac41_ext(pkts[i], raws[i]);
+    snprintf(path, sizeof(path), "%s/ac4rt-ac41ext.mp4", tmpdir());
+    CHECK(mux_file(path, pkts, lens, NFRAMES,
+                   dsi_golden, sizeof(dsi_golden)) == 0, "ac41ext: mux failed");
+    check_roundtrip("ac41ext", path, raws, NFRAMES);
+
+    /* Negatives fail loud. */
+    for (i = 0; i < NFRAMES; i++) {
+        memcpy(pkts[i], raws[i], RAW_LEN);
+        lens[i] = RAW_LEN;
+    }
+    snprintf(path, sizeof(path), "%s/ac4rt-noext.mp4", tmpdir());
+    check_mux_noext("neg", path, pkts, lens, NFRAMES);
+    snprintf(bad, sizeof(bad), "%s/ac4rt-trunc.mp4", tmpdir());
+    check_trunc_dac4("neg", good, bad);
+    snprintf(bad, sizeof(bad), "%s/ac4rt-badsize.mp4", tmpdir());
+    check_bad_dac4_size("neg", good, bad);
+
+    if (failures == 0)
+        printf("PASS: ac4 mp4 roundtrip (4 shapes + 3 negatives)\n");
+    else
+        printf("%d FAILURES\n", failures);
+    return failures != 0;
+}
