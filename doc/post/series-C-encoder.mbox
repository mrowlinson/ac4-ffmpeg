+                double v =
+                    (double)pcm[c][k] * bc * lin[c];
+                if (bake_round(v, &pcm[c][k]))
+                    goto done;
+            }
+        }
+        {
+            int pk = 0;
+            for (int c = 0; c < 6; c++)
+                for (int k = 0; k < lens[c]; k++)
+                    if (ac4_enc_core_abs_sat(pcm[c][k]) > pk)
+                        pk = ac4_enc_core_abs_sat(pcm[c][k]);
+            if (!(pk < 32767)) {
+                goto done;
+            }
+        }
+        for (int c = 0; c < 6; c++) {
+            av_free(dp[c]);
+            dp[c] = pcm_to_double(pcm[c], lens[c]);
+            if (!dp[c])
+                goto done;
+        }
+        sby = ac4_pycompat_round_half_even(-4.0 * target_db);
+        c16 = ac4_enc_core_content16(m, peak, f, target_db);
+        pid = ac4_enc_core_preset_id(preset ? preset : "manual");
+        if (pid < 0)
+            goto done;
+        nfr0 = ac4_enc_core_compose_sub0_51(sby, c16, NULL, pid,
+                                        dmx, fr0);
+        ni15 = ac4_enc_core_compose_sub0_51(
+            sby, AC4_ENC_CORE_TAIL16_DENSE,
+            AC4_ENC_CORE_I12_MID_TAIL, pid, dmx, i15);
+        np6 = ac4_enc_core_compose_sub0(0, 0, sby, 0, NULL, pid,
+                                   p6);
+        if (nfr0 != 15 || ni15 != 15 || np6 != 6) {
+            goto done;
+        }
+        memcpy(s4, AC4_ENC_CORE_SUB2_DEE, 4);
+        stampbuf.p6 = p6;
+        stampbuf.n_p6 = 6;
+        stampbuf.i12 = i15;
+        stampbuf.n_i12 = 15;
+        stampbuf.s4 = s4;
+        stampbuf.n_s4 = 4;
+        stampbuf.fr0 = fr0;
+        stampbuf.n_fr0 = 15;
+        stamp51 = &stampbuf;
+    } else if (ms) {
+        flat_file = ms->f_flat > AC4_ENC_CORE_FLAT_F_THRESH;
+    } else {
+        flat_file = 0;
+    }
+    {
+        const double *dpp[6];
+        for (int c = 0; c < 6; c++)
+            dpp[c] = dp[c];
+        n = encode_pcm_mc_frames(dpp, lens, rate_kbps, interval,
+                                 trailer, window, shorts, forced,
+                                 nforced, drc, dmx, stamp51,
+                                 flat_file, out, outcap);
+    }
+done:
+    for (int c = 0; c < 6; c++) {
+        av_free(pcm[c]);
+        av_free(dp[c]);
+    }
+    return n;
+}
+
+int
+ac4_enc_core_encode_pcm_f_m(const double *pcmL, int nL,
+                        const double *pcmR, int nR, int rate_kbps,
+                        const char *layout, const char *interval,
+                        const char *trailer,
+                        const double *window, int ns2_tone,
+                        int shorts, double target_db, int has_bake,
+                        double bake_db, int joint_shorts,
+                        const int *forced, int nforced,
+                        const char *preset,
+                        const ac4_enc_core_drc_t *drc, const int *dmx,
+                        int priming, int iframe_base,
+                        int iframe_total,
+                        const ac4_enc_core_measure_t *ms, uint8_t *out,
+                        size_t outcap)
+{
+    int *bL = NULL, *bR = NULL;
+    double *dL = NULL, *dR = NULL;
+    uint8_t p6[6], i12[12], s4[4], fr0[12];
+    ac4_enc_core_stamp_t stampbuf;
+    const ac4_enc_core_stamp_t *stamp = NULL;
+    int flat_file = 0;
+    int n = -1;
+    if (!pcmL || !pcmR || nL < 0 || nR < 0 || !layout ||
+        !trailer || !out)
+        return -1;
+    if (strcmp(layout, "stereo"))
+        return -1;
+    if (strcmp(trailer, "crc") && strcmp(trailer, "zero"))
+        return -1;
+    if (!(target_db == 0.0 ||
+          (-31.0 <= target_db && target_db <= -10.0)))
+        return -1;
+    dL = dbl_copy(pcmL, nL);
+    dR = dbl_copy(pcmR, nR);
+    if (!dL || !dR)
+        goto done;
+    if (ms && target_db != 0.0) {
+        double m = ms->m_db, f = ms->f_flat;
+        double tf = ms->tf_tone, gain, bake;
+        double in_peak = ms->has_d_peak ? ms->d_peak
+                                        : (double)ms->in_peak;
+        int peak = 0, sby;
+        int sparse, c16, t16, pid, np6, ni12, nfr0;
+        if (has_bake)
+            gain = bake_db;
+        else if (isinf(m) && m < 0)
+            gain = 0.0;
+        else
+            gain = ac4_loud_bake_gain(m, f, tf, target_db);
+        bake = pow(10.0, gain / 20.0);
+        bL = av_malloc((size_t)(nL > 0 ? nL : 1) * sizeof *bL);
+        bR = av_malloc((size_t)(nR > 0 ? nR : 1) * sizeof *bR);
+        if (!bL || !bR)
+            goto done;
+        for (int k = 0; k < nL; k++)
+            if (bake_round(dL[k] * bake, &bL[k]))
+                goto done;
+        for (int k = 0; k < nR; k++)
+            if (bake_round(dR[k] * bake, &bR[k]))
+                goto done;
+        for (int k = 0; k < nL; k++)
+            if (ac4_enc_core_abs_sat(bL[k]) > peak)
+                peak = ac4_enc_core_abs_sat(bL[k]);
+        for (int k = 0; k < nR; k++)
+            if (ac4_enc_core_abs_sat(bR[k]) > peak)
+                peak = ac4_enc_core_abs_sat(bR[k]);
+        if (!(peak < 32767)) {
+            goto done;
+        }
+        av_free(dL);
+        av_free(dR);
+        dL = pcm_to_double(bL, nL);
+        dR = pcm_to_double(bR, nR);
+        if (!dL || !dR)
+            goto done;
+        sby = ac4_pycompat_round_half_even(-4.0 * target_db);
+        sparse = tf < 0.6 && f > 0.5;
+        c16 = ac4_enc_core_content16_f(m, in_peak, f, target_db);
+        t16 = ac4_enc_core_tail16(sparse, tf);
+        pid = ac4_enc_core_preset_id(preset ? preset : "manual");
+        if (pid < 0)
+            goto done;
+        np6 = ac4_enc_core_compose_sub0(0, sparse, sby, 0, NULL,
+                                   pid, p6);
+        ni12 = ac4_enc_core_compose_sub0(
+            1, 0, sby, t16, AC4_ENC_CORE_I12_MID_TAIL, pid,
+            i12);
+        nfr0 = ac4_enc_core_compose_sub0(1, sparse, sby, c16,
+                                     NULL, pid, fr0);
+        if (np6 != 6 || ni12 != 12 ||
+            nfr0 != (sparse ? 11 : 12)) {
+            goto done;
+        }
+        memcpy(s4, AC4_ENC_CORE_SUB2_DEE, 4);
+        stampbuf.p6 = p6;
+        stampbuf.n_p6 = 6;
+        stampbuf.i12 = i12;
+        stampbuf.n_i12 = 12;
+        stampbuf.s4 = s4;
+        stampbuf.n_s4 = 4;
+        stampbuf.fr0 = fr0;
+        stampbuf.n_fr0 = nfr0;
+        stamp = &stampbuf;
+        flat_file = f > AC4_ENC_CORE_FLAT_F_THRESH;
+    } else if (ms) {
+        flat_file = ms->f_flat > AC4_ENC_CORE_FLAT_F_THRESH;
+    } else {
+        flat_file = 0;
+    }
+    n = encode_pcm_frames(dL, nL, dR, nR, rate_kbps, layout,
+                          interval, trailer, window, ns2_tone,
+                          shorts, joint_shorts, forced, nforced,
+                          drc, dmx, priming, iframe_base,
+                          iframe_total, stamp, flat_file, out,
+                          outcap);
+done:
+    av_free(bL);
+    av_free(bR);
+    av_free(dL);
+    av_free(dR);
+    return n;
+}
+
+int
+ac4_enc_core_encode_pcm_mc_f_m(const double *const *chs,
+                           const int *lens, int rate_kbps,
+                           const char *interval, const char *trailer,
+                           const double *window, double target_db,
+                           int has_bake, double bake_db, int shorts,
+                           const int *forced, int nforced,
+                           const char *preset,
+                           const ac4_enc_core_drc_t *drc, const int *dmx,
+                           const ac4_enc_core_measure_t *ms,
+                           uint8_t *out, size_t outcap)
+{
+    double *fc[6];
+    int *pcm[6];
+    double *dp[6];
+    uint8_t p6[6], i15[15], s4[4], fr0[15];
+    ac4_enc_core_stamp_t stampbuf;
+    const ac4_enc_core_stamp_t *stamp51 = NULL;
+    int flat_file = 0;
+    int n = -1;
+    if (!chs || !lens || !trailer || !out)
+        return -1;
+    if (strcmp(trailer, "crc") && strcmp(trailer, "zero"))
+        return -1;
+    if (!(target_db == 0.0 ||
+          (-31.0 <= target_db && target_db <= -10.0)))
+        return -1;
+    for (int c = 0; c < 6; c++) {
+        fc[c] = NULL;
+        pcm[c] = NULL;
+        dp[c] = NULL;
+        if (!chs[c] || lens[c] < 0)
+            goto done;
+    }
+    for (int c = 0; c < 6; c++) {
+        fc[c] = dbl_copy(chs[c], lens[c]);
+        if (!fc[c])
+            goto done;
+    }
+    if (ms && target_db != 0.0) {
+        double m = ms->m_db, f = ms->f_flat;
+        double tf = ms->tf_tone;
+        double gain, bake, lfe_bake, lin[6];
+        double peak = ms->has_d_peak ? ms->d_peak
+                                     : (double)ms->in_peak;
+        int sby, c16, pid;
+        int hits51, np6, ni15, nfr0;
+        flat_file = f > AC4_ENC_CORE_FLAT_F_THRESH;
+        hits51 = tf < 0.6 && f > 0.5;
+        if (has_bake)
+            gain = bake_db;
+        else if (isinf(m) && m < 0)
+            gain = 0.0;
+        else if (hits51)
+            gain = AC4_ENC_CORE_T_HIT_51_DB -
+                (m > -23.0 ? m : -23.0) +
+                (target_db + 24.0);
+        else
+            gain = target_db - m;
+        bake = pow(10.0, gain / 20.0);
+        for (int c = 0; c < 6; c++)
+            lin[c] = pow(
+                10.0, AC4_ENC_CORE_LEG_COMP_51_DB[c] / 20.0);
+        lfe_bake = hits51
+            ? pow(10.0, AC4_ENC_CORE_LFE_HITS_BAKE_DB / 20.0)
+            : bake;
+        for (int c = 0; c < 6; c++) {
+            double bc = c == 3 ? lfe_bake : bake;
+            pcm[c] = av_malloc((size_t)(lens[c] > 0 ? lens[c]
+                                                 : 1) *
+                            sizeof *pcm[c]);
+            if (!pcm[c])
+                goto done;
+            for (int k = 0; k < lens[c]; k++) {
+                double v = fc[c][k] * bc * lin[c];
+                if (bake_round(v, &pcm[c][k]))
+                    goto done;
+            }
+        }
+        {
+            int pk = 0;
+            for (int c = 0; c < 6; c++)
+                for (int k = 0; k < lens[c]; k++)
+                    if (ac4_enc_core_abs_sat(pcm[c][k]) > pk)
+                        pk = ac4_enc_core_abs_sat(pcm[c][k]);
+            if (!(pk < 32767)) {
+                goto done;
+            }
+        }
+        for (int c = 0; c < 6; c++) {
+            dp[c] = pcm_to_double(pcm[c], lens[c]);
+            if (!dp[c])
+                goto done;
+        }
+        sby = ac4_pycompat_round_half_even(-4.0 * target_db);
+        c16 = ac4_enc_core_content16_f(m, peak, f, target_db);
+        pid = ac4_enc_core_preset_id(preset ? preset : "manual");
+        if (pid < 0)
+            goto done;
+        nfr0 = ac4_enc_core_compose_sub0_51(sby, c16, NULL, pid,
+                                        dmx, fr0);
+        ni15 = ac4_enc_core_compose_sub0_51(
+            sby, AC4_ENC_CORE_TAIL16_DENSE,
+            AC4_ENC_CORE_I12_MID_TAIL, pid, dmx, i15);
+        np6 = ac4_enc_core_compose_sub0(0, 0, sby, 0, NULL, pid,
+                                   p6);
+        if (nfr0 != 15 || ni15 != 15 || np6 != 6) {
+            goto done;
+        }
+        memcpy(s4, AC4_ENC_CORE_SUB2_DEE, 4);
+        stampbuf.p6 = p6;
+        stampbuf.n_p6 = 6;
+        stampbuf.i12 = i15;
+        stampbuf.n_i12 = 15;
+        stampbuf.s4 = s4;
+        stampbuf.n_s4 = 4;
+        stampbuf.fr0 = fr0;
+        stampbuf.n_fr0 = 15;
+        stamp51 = &stampbuf;
+    } else if (ms) {
+        flat_file = ms->f_flat > AC4_ENC_CORE_FLAT_F_THRESH;
+        for (int c = 0; c < 6; c++) {
+            dp[c] = dbl_copy(fc[c], lens[c]);
+            if (!dp[c])
+                goto done;
+        }
+    } else {
+        flat_file = 0;
+        for (int c = 0; c < 6; c++) {
+            dp[c] = dbl_copy(fc[c], lens[c]);
+            if (!dp[c])
+                goto done;
+        }
+    }
+    {
+        const double *dpp[6];
+        for (int c = 0; c < 6; c++)
+            dpp[c] = dp[c];
+        n = encode_pcm_mc_frames(dpp, lens, rate_kbps,
+                                 interval, trailer, window,
+                                 shorts, forced, nforced, drc,
+                                 dmx, stamp51, flat_file, out,
+                                 outcap);
+    }
+done:
+    for (int c = 0; c < 6; c++) {
+        av_free(fc[c]);
+        av_free(pcm[c]);
+        av_free(dp[c]);
+    }
+    return n;
+}
+
+/* ---- ac4enc-lib r2: incremental engine ----
+ *
+ * Single frame-stepping implementation behind the whole-stream
+ * drivers (thin wrappers below... above) and the incremental
+ * ac4enc_lib ctx. Loop bodies are moved verbatim from
+ * encode_pcm_frames / encode_pcm_mc_frames with mechanical
+ * adaptations only:
+ *   sizes[j] -> running CBR step (positional, exact);
+ *   is_iframe  -> rule predicate (exact; joint open-ended edge
+ *     documented in ac4_enc_step.h);
+ *   orient[] whole array -> compute-once ring (exact: masks use
+ *     fed-so-far, which provably equals the true total wherever
+ *     the mask is read pre-end);
+ *   whole-input PCM -> sliding window (all MDCT reads provably
+ *     stay inside fed data pre-end; end() freezes the total);
+ *   function-static scratch -> heap ctx (B1);
+ *   per-frame mallocs -> reusable ctx buffers (H11);
+ *   sync wrap -> caller (lib takes bare frames; wrappers wrap).
+ * lines[] (H6) arrive via cfg from the caller's pass 1.
+ */
+
+struct ac4_enc_step_ctx {
+    int nch;
+    int rate_kbps;
+    const char *layout;
+    const char *interval;
+    int ns2_tone;
+    int shorts;
+    int joint_shorts;
+    int priming;
+    int iframe_base;
+    int iframe_total;
+    const int *forced;
+    int nforced;
+    const ac4_enc_core_drc_t *drc;
+    const int *dmx;
+    const ac4_enc_core_stamp_t *stamp;
+    int flat_file;
+    int do_bake;
+    int do_peak;
+    int bake_two;
+    double bake0[6];
+    double bake1[6];
+    int nlines;
+    int lines[7];
+    double win[4096];
+    long long cbr_num;
+    long long cbr_acc;
+    int if_rule;
+    long long if_step;
+    long long if_n;
+    long long if_j;
+    int or_base;
+    int or_have;
+    int or_ring[8];
+    double *rows[8];
+    int fed[8];
+    int wcap;
+    int wbase;
+    int fed_max;
+    int ended;
+    int end_frames;
+    int ns_total;
+    int emitted;
+    int baked_peak;
+    int fail_rc;
+    int detail;
+    /* EBAKE failing-sample locus (R3 loud refusal); err_ch is
+     * -1 unless an ingest bake_round overflowed. */
+    int err_ch;
+    int err_idx;
+    double err_val;
+    union {
+        struct {
+            double sL[16][128];
+            double sR[16][128];
+            double s9L[9][1024];
+            double s9R[9][1024];
+            double sM[16][128];
+            double sS[16][128];
+            double XL[2048];
+            double XR[2048];
+        } st;
+        struct {
+            double sp[6][16][128];
+            double x9[5][9][1024];
+            double xlfe[2048];
+            double xs[6][2048];
+        } mc;
+    } u;
+    uint8_t *b_full;
+    uint8_t *b_audio;
+    uint8_t *b_body;
+};
+
+static int
+step_fail(ac4_enc_step_ctx_t *c, int detail, int rc)
+{
+    c->detail = detail;
+    if (detail != AC4_ENC_STEP_ESHORT && !c->fail_rc)
+        c->fail_rc = rc;
+    return rc;
+}
+
+int
+ac4_enc_step_max_cbr(int rate_kbps)
+{
+    long long num, acc;
+    int best = 0;
+    if (rate_kbps <= 0 || rate_kbps > 1000000)
+        return -1;
+    num = (long long)rate_kbps * 16;
+    acc = ((-num) % 3 + 3) % 3;
+    for (int i = 0; i < 6; i++) {
+        int q;
+        acc += num;
+        q = (int)(acc / 3);
+        acc = acc % 3;
+        if (q > best)
+            best = q;
+    }
+    return best;
+}
+
+static int
+cbr_peek(const ac4_enc_step_ctx_t *c)
+{
+    return (int)((c->cbr_acc + c->cbr_num) / 3);
+}
+
+static void
+cbr_advance(ac4_enc_step_ctx_t *c)
+{
+    c->cbr_acc = (c->cbr_acc + c->cbr_num) % 3;
+}
+
+static void
+if_advance(ac4_enc_step_ctx_t *c)
+{
+    if (c->if_rule == 0) {
+        c->if_n++;
+        c->if_j = 1 + (c->if_n * 48000) / 2048;
+    } else if (c->if_j > LLONG_MAX - c->if_step) {
+        c->if_j = LLONG_MAX;
+    } else {
+        c->if_j += c->if_step;
+    }
+}
+
+/* Priming/5.1 rule: {0,1} + cadence + forced (positional, exact). */
+static int
+iframe_pred51(ac4_enc_step_ctx_t *c, int j)
+{
+    if (j == 0 || j == 1)
+        return 1;
+    while (c->if_j < j)
+        if_advance(c);
+    if (c->if_j == j)
+        return 1;
+    if (c->forced) {
+        for (int k = 0; k < c->nforced; k++)
+            if (c->forced[k] == j)
+                return 1;
+    }
+    return 0;
+}
+
+/* Joint rule over global indices (exact for explicit total and
+ * for base==0 open-ended; see ac4_enc_step.h). */
+static int
+iframe_pred_joint(ac4_enc_step_ctx_t *c, int j)
+{
+    long long g = (long long)c->iframe_base + j;
+    long long total = c->iframe_total < 0 ? LLONG_MAX
+                                          : c->iframe_total;
+    if (j == 0)
+        return 1;
+    while (c->if_j < g)
+        if_advance(c);
+    if (c->if_j == g && g < total)
+        return 1;
+    if (c->forced) {
+        for (int k = 0; k < c->nforced; k++)
+            if ((long long)c->forced[k] == g)
+                return 1;
+    }
+    return 0;
+}
+
+static int
+is01(int v)
+{
+    return v == 0 || v == 1;
+}
+
+int
+ac4_enc_step_open(ac4_enc_step_ctx_t **cp, const ac4_enc_step_cfg_t *cfg)
+{
+    ac4_enc_step_ctx_t *c;
+    long long step = 0;
+    int istep, nrows;
+    if (!cp || !cfg)
+        return -EINVAL;
+    if (cfg->nch != 2 && cfg->nch != 6)
+        return -EINVAL;
+    if (cfg->rate_kbps <= 0 || cfg->rate_kbps > 1000000)
+        return -EINVAL;
+    if (cfg->nch == 2 && (!cfg->layout ||
+                          strcmp(cfg->layout, "stereo")))
+        return -EINVAL;
+    if (!is01(cfg->ns2_tone) || !is01(cfg->shorts) ||
+        !is01(cfg->joint_shorts) || !is01(cfg->priming) ||
+        !is01(cfg->do_bake) || !is01(cfg->do_peak) ||
+        !is01(cfg->bake_two))
+        return -EINVAL;
+    if (cfg->nch == 6 && cfg->joint_shorts)
+        return -EINVAL;
+    if (cfg->nforced < 0 ||
+        (cfg->nforced > 0 && !cfg->forced))
+        return -EINVAL;
+    if (cfg->nlines < 0 || cfg->nlines > 7)
+        return -EINVAL;
+    for (int k = 0; k < cfg->nlines; k++)
+        if (cfg->lines[k] < 0 ||
+            cfg->lines[k] >= AC4_MDCT_NCOEFF)
+            return -EINVAL;
+    istep = parse_interval(cfg->interval, &step);
+    if (istep < 0)
+        return -EINVAL;
+    if (cfg->drc) {
+        /* Dry-run the real metadata writer over both iframe
+         * values: validates nmodes/mid/kind/eac3/gain/curve. */
+        uint8_t tmp[1024];
+        if (ac4_enc_core_write_metadata(cfg->nch == 2 ? "stereo"
+                                                  : "5.1",
+                                    0, cfg->drc, tmp,
+                                    sizeof tmp) < 0 ||
+            ac4_enc_core_write_metadata(cfg->nch == 2 ? "stereo"
+                                                  : "5.1",
+                                    1, cfg->drc, tmp,
+                                    sizeof tmp) < 0)
+            return -EINVAL;
+    }
+    c = av_calloc(1, sizeof *c);
+    if (!c)
+        return -ENOMEM;
+    c->detail = AC4_ENC_STEP_OK;
+    c->err_ch = -1;
+    c->nch = cfg->nch;
+    c->rate_kbps = cfg->rate_kbps;
+    c->layout = cfg->layout;
+    c->interval = cfg->interval;
+    c->ns2_tone = cfg->ns2_tone;
+    c->shorts = cfg->shorts;
+    c->joint_shorts = cfg->joint_shorts;
+    c->priming = cfg->priming;
+    c->iframe_base = cfg->iframe_base;
+    c->iframe_total = cfg->iframe_total;
+    c->forced = cfg->forced;
+    c->nforced = cfg->nforced;
+    c->drc = cfg->drc;
+    c->dmx = cfg->dmx;
+    c->stamp = cfg->stamp;
+    c->flat_file = cfg->flat_file;
+    c->do_bake = cfg->do_bake;
+    c->do_peak = cfg->do_peak;
+    c->bake_two = cfg->bake_two;
+    memcpy(c->bake0, cfg->bake0, sizeof c->bake0);
+    memcpy(c->bake1, cfg->bake1, sizeof c->bake1);
+    c->nlines = cfg->nlines;
+    memcpy(c->lines, cfg->lines, sizeof c->lines);
+    if (cfg->window)
+        memcpy(c->win, cfg->window, sizeof c->win);
+    else
+        ac4_mdct_kbd_window(4096, 3.0, c->win);
+    c->cbr_num = (long long)cfg->rate_kbps * 16;
+    c->cbr_acc =
+        ((-c->cbr_num) % 3 + 3) % 3;
+    c->if_rule = istep;
+    c->if_step = step;
+    if (istep == 0) {
+        c->if_n = 1;
+        c->if_j = 1 + (1 * 48000) / 2048;
+    } else {
+        c->if_n = 0;
+        c->if_j = 1 + step;
+    }
+    nrows = cfg->nch +
+        (cfg->nch == 2 && cfg->joint_shorts ? 2 : 0);
+    c->wcap = 8192;
+    for (int r = 0; r < nrows; r++) {
+        c->rows[r] =
+            av_malloc((size_t)c->wcap * sizeof *c->rows[r]);
+        if (!c->rows[r]) {
+            ac4_enc_step_close(c);
+            return -ENOMEM;
+        }
+    }
+    *cp = c;
+    return 0;
+}
+
+void
+ac4_enc_step_close(ac4_enc_step_ctx_t *c)
+{
+    int nrows;
+    if (!c)
+        return;
+    nrows = c->nch +
+        (c->nch == 2 && c->joint_shorts ? 2 : 0);
+    for (int r = 0; r < nrows; r++)
+        av_free(c->rows[r]);
+    av_free(c->b_full);
+    av_free(c->b_audio);
+    av_free(c->b_body);
+    av_free(c);
+}
+
+int
+ac4_enc_step_emitted(const ac4_enc_step_ctx_t *c)
+{
+    return c ? c->emitted : 0;
+}
+
+int
+ac4_enc_step_detail(const ac4_enc_step_ctx_t *c)
+{
+    return c ? c->detail : AC4_ENC_STEP_OK;
+}
+
+int
+ac4_enc_step_err_peak(const ac4_enc_step_ctx_t *c)
+{
+    return c ? c->baked_peak : -1;
+}
+
+int
+ac4_enc_step_err_sample(const ac4_enc_step_ctx_t *c, int *ch,
+                    int *idx, double *val)
+{
+    if (!c || !ch || !idx || !val || c->err_ch < 0)
+        return -1;
+    *ch = c->err_ch;
+    *idx = c->err_idx;
+    *val = c->err_val;
+    return 0;
+}
+
+static int
+step_coff(const ac4_enc_step_ctx_t *c)
+{
+    return (c->nch == 2 && !c->priming) ? 2 : 0;
+}
+
+/* Start sample of absolute orient index k (k>=2). */
+static int
+or_start(int k)
+{
+    return (k - 2) * AC4_ENC_CORE_FRAME_SAMPLES;
+}
+
+/* Ensure room for n more fed samples; slide to zero first. */
+static int
+win_grow(ac4_enc_step_ctx_t *c, int n)
+{
+    int nrows =
+        c->nch + (c->nch == 2 && c->joint_shorts ? 2 : 0);
+    if (n < 0)
+        return -1;
+    if (c->fed_max + n <= c->wbase + c->wcap)
+        return 0;
+    if (c->wbase > 0) {
+        for (int r = 0; r < nrows; r++) {
+            int keep = c->fed[r] - c->wbase;
+            if (keep > 0)
+                memmove(c->rows[r], c->rows[r] + c->wbase,
+                        (size_t)keep * sizeof *c->rows[r]);
+            c->fed[r] = keep > 0 ? keep : 0;
+        }
+        c->fed_max -= c->wbase;
+        if (c->fed_max < 0)
+            c->fed_max = 0;
+        c->wbase = 0;
+        if (c->fed_max + n <= c->wcap)
+            return 0;
+    }
+    {
+        int want = c->wcap > 0 ? c->wcap : 2048;
+        while (want < c->fed_max + n - c->wbase) {
+            if (want > INT_MAX / 2)
+                return -1;
+            want *= 2;
+        }
+        for (int r = 0; r < nrows; r++) {
+            double *nr = av_realloc(c->rows[r],
+                                 (size_t)want *
+                                     sizeof *nr);
+            if (!nr)
+                return -1;
+            c->rows[r] = nr;
+        }
+        c->wcap = want;
+    }
+    return 0;
+}
+
+/* Ingest one already-ordered double sample (post int-cast). */
+static int
+ingest_d(ac4_enc_step_ctx_t *c, int ch, double x)
+{
+    double v = x;
+    if (c->do_bake) {
+        int bi;
+        if (c->bake_two)
+            v = (x * c->bake0[ch]) * c->bake1[ch];
+        else
+            v = x * c->bake0[ch];
+        if (bake_round(v, &bi))
+            return -1;
+        /* INT_MIN-safe magnitudes (m1), same scans as the core. */
+        if (c->do_peak && ac4_enc_core_abs_sat(bi) > c->baked_peak)
+            c->baked_peak = ac4_enc_core_abs_sat(bi);
+        v = (double)bi;
+    }
+    c->rows[ch][c->fed[ch] - c->wbase] = v;
+    return 0;
+}
+
+static int
+feed_common(ac4_enc_step_ctx_t *c, const double *const *df,
+            const int *const *di, const int *ns)
+{
+    int add = 0;
+    if (!c || !ns)
+        return -EINVAL;
+    if (c->ended || c->fail_rc)
+        return step_fail(c, AC4_ENC_STEP_EPROTO, -EINVAL);
+    if ((!df && !di) || (df && di))
+        return step_fail(c, AC4_ENC_STEP_EPROTO, -EINVAL);
+    for (int ch = 0; ch < c->nch; ch++) {
+        if (ns[ch] < 0)
+            return step_fail(c, AC4_ENC_STEP_EPROTO, -EINVAL);
+        if (ns[ch] > 0 && !(df ? df[ch] : (const void *)di[ch]))
+            return step_fail(c, AC4_ENC_STEP_EPROTO, -EINVAL);
+        if (ns[ch] > add)
+            add = ns[ch];
+    }
+    if (add == 0)
+        return 0;
+    if (win_grow(c, add))
+        return step_fail(c, AC4_ENC_STEP_ENOMEM, -ENOMEM);
+    for (int ch = 0; ch < c->nch; ch++) {
+        for (int k = 0; k < ns[ch]; k++) {
+            double x = df ? df[ch][k]
+                          : (double)di[ch][k];
+            if (ingest_d(c, ch, x)) {
+                c->err_ch = ch;
+                c->err_idx = c->fed[ch];
+                c->err_val = x;
+                return step_fail(c, AC4_ENC_STEP_EBAKE, -EIO);
+            }
+            c->fed[ch]++;
+        }
+    }
+    {
+        int mx = 0;
+        for (int ch = 0; ch < c->nch; ch++)
+            if (c->fed[ch] > mx)
+                mx = c->fed[ch];
+        /* M/S rows over the newly fed span (core pcmM/pcmS
+         * order: zero-fill past each row's end). */
+        if (c->nch == 2 && c->joint_shorts) {
+            int old = c->fed[2];
+            int nl = c->fed[0], nr = c->fed[1];
+            for (int g = old; g < mx; g++) {
+                double a = g < nl
+                    ? c->rows[0][g - c->wbase]
+                    : 0.0;
+                double b = g < nr
+                    ? c->rows[1][g - c->wbase]
+                    : 0.0;
+                c->rows[2][g - c->wbase] = (a + b) / 2.0;
+                c->rows[3][g - c->wbase] = (a - b) / 2.0;
+            }
+            c->fed[2] = c->fed[3] = mx;
+        }
+        c->fed_max = mx;
+    }
+    return 0;
+}
+
+int
+ac4_enc_step_feed(ac4_enc_step_ctx_t *c, const double *const *rows,
+              const int *ns)
+{
+    return feed_common(c, rows, NULL, ns);
+}
+
+int
+ac4_enc_step_feed_int(ac4_enc_step_ctx_t *c, const int *const *rows,
+                  const int *ns)
+{
+    return feed_common(c, NULL, rows, ns);
+}
+
+int
+ac4_enc_step_end(ac4_enc_step_ctx_t *c)
+{
+    if (!c)
+        return -EINVAL;
+    if (c->ended || c->fail_rc)
+        return step_fail(c, AC4_ENC_STEP_EPROTO, -EINVAL);
+    c->ended = 1;
+    c->ns_total = c->fed_max;
+    if (c->nch == 6 || c->priming)
+        c->end_frames =
+            ac4_enc_core_nframes_for_samples(c->ns_total);
+    else if (c->ns_total <= 0)
+        c->end_frames = 0;
+    else
+        c->end_frames =
+            (c->ns_total + AC4_ENC_CORE_FRAME_SAMPLES - 1) /
+            AC4_ENC_CORE_FRAME_SAMPLES;
+    if (c->do_peak && !(c->baked_peak < 32767))
+        return step_fail(c, AC4_ENC_STEP_EPEAK, -EIO);
+    return 0;
+}
+
+/* Data needed above a frame start: 4160 with the orient
+ * lookahead (shorts), else 3072 (MDCT span). */
+static int
+emit_ahead(const ac4_enc_step_ctx_t *c)
+{
+    return c->shorts ? 4160 : 3072;
+}
+
+int
+ac4_enc_step_ready(ac4_enc_step_ctx_t *c)
+{
+    int j, i, start;
+    if (!c)
+        return -EINVAL;
+    if (c->fail_rc)
+        return c->fail_rc;
+    j = c->emitted;
+    if (c->ended)
+        return j < c->end_frames ? 1 : 0;
+    i = j + step_coff(c);
+    if (i < 2)
+        return c->fed_max > 0 ? 1 : 0;
+    start = or_start(i);
+    return c->fed_max >= start + emit_ahead(c) ? 1 : 0;
+}
+
+int
+ac4_enc_step_ready_after(const ac4_enc_step_ctx_t *c, int n)
+{
+    int j, i, start;
+    if (!c || n < 0)
+        return 0;
+    if (c->fail_rc)
+        return 0;
+    j = c->emitted;
+    if (c->ended)
+        return j < c->end_frames ? 1 : 0;
+    i = j + step_coff(c);
+    if (i < 2)
+        return c->fed_max + n > 0 ? 1 : 0;
+    start = or_start(i);
+    return c->fed_max + n >= start + emit_ahead(c) ? 1
+                                                  : 0;
+}
+
+int
+ac4_enc_step_set_stamp(ac4_enc_step_ctx_t *c,
+                   const ac4_enc_core_stamp_t *stamp)
+{
+    if (!c)
+        return -EINVAL;
+    if (c->emitted != 0 || c->fail_rc)
+        return step_fail(c, AC4_ENC_STEP_EPROTO, -EINVAL);
+    c->stamp = stamp;
+    return 0;
+}
+
+int
+ac4_enc_step_next_size(ac4_enc_step_ctx_t *c)
+{
+    if (!c)
+        return -1;
+    if (c->fail_rc || (c->ended && c->emitted >= c->end_frames)) {
+        c->detail = AC4_ENC_STEP_EPROTO;
+        return -1;
+    }
+    return cbr_peek(c);
+}
+/* Orient ring: compute-once absolute indices, shared by the
+ * pre-scan twin and emission. Values match the whole-stream
+ * pre-scan exactly (mask total = fed-so-far pre-end, which
+ * provably reads identically wherever consulted). */
+static int
+or_compute(ac4_enc_step_ctx_t *c, int k)
+{
+    int start = or_start(k);
+    int total = c->ended ? c->ns_total : c->fed_max;
+    int o0 = 0, o1 = 0, rc;
+    if (c->nch == 2) {
+        const double *sp[2];
+        int wlen0 = c->fed[0] - c->wbase;
+        int wlen1 = c->fed[1] - c->wbase;
+        if (wlen0 < 0)
+            wlen0 = 0;
+        if (wlen1 < 0)
+            wlen1 = 0;
+        tile_specs_128(c->rows[0], wlen0, start - c->wbase,
+                       c->u.st.sL);
+        tile_specs_128(c->rows[1], wlen1, start - c->wbase,
+                       c->u.st.sR);
+        sp[0] = &c->u.st.sL[0][0];
+        sp[1] = &c->u.st.sR[0][0];
+        rc = tile_orient(sp, 2, start, total, &o0, &o1, 0);
+    } else {
+        const double *sl[6];
+        for (int ch = 0; ch < 6; ch++) {
+            int wlen = c->fed[ch] - c->wbase;
+            if (wlen < 0)
+                wlen = 0;
+            tile_specs_128(c->rows[ch], wlen,
+                           start - c->wbase, c->u.mc.sp[ch]);
+            sl[ch] = &c->u.mc.sp[ch][0][0];
+        }
+        rc = tile_orient(sl, 6, start, total, &o0, &o1, 1);
+    }
+    if (rc < 0)
+        return -1;
+    if (rc > 0)
+        return o0 == AC4_ENC_CORE_TL_1024
+            ? AC4_ENC_CORE_ORIENT_1024_FIRST
+            : AC4_ENC_CORE_ORIENT_128_FIRST;
+    return AC4_ENC_CORE_ORIENT_LONG;
+}
+
+static int
+or_need(ac4_enc_step_ctx_t *c, int i, int *out)
+{
+    if (!c->shorts || i < 2) {
+        *out = AC4_ENC_CORE_ORIENT_LONG;
+        return 0;
+    }
+    while (c->or_base + c->or_have <= i) {
+        int k = c->or_base + c->or_have;
+        int v;
+        if (!c->ended &&
+            c->fed_max < or_start(k) + 2112)
+            return -1;
+        v = or_compute(c, k);
+        if (v < 0)
+            return -1;
+        if (c->or_have == 8) {
+            c->or_base++;
+            c->or_have--;
+        }
+        c->or_ring[(c->or_base + c->or_have) % 8] = v;
+        c->or_have++;
+    }
+    *out = c->or_ring[i % 8];
+    return 0;
+}
+
+/* Drop window history before start_next-1024 (no future read
+ * reaches below it). */
+static void
+win_compact(ac4_enc_step_ctx_t *c, int start_next)
+{
+    int nrows =
+        c->nch + (c->nch == 2 && c->joint_shorts ? 2 : 0);
+    int want = start_next - 1024;
+    int shift;
+    if (want <= c->wbase)
+        return;
+    if (want > c->fed_max)
+        want = c->fed_max;
+    shift = want - c->wbase;
+    for (int r = 0; r < nrows; r++) {
+        int keep = c->fed[r] - want;
+        if (keep > 0)
+            memmove(c->rows[r], c->rows[r] + shift,
+                    (size_t)keep * sizeof *c->rows[r]);
+    }
+    c->wbase = want;
+}
+
+static int
+emit_bufs(ac4_enc_step_ctx_t *c)
+{
+    if (!c->b_full) {
+        c->b_full = av_malloc(65536);
+        c->b_audio = av_malloc(65536);
+        c->b_body = av_malloc(65536);
+        if (!c->b_full || !c->b_audio || !c->b_body)
+            return -1;
+    }
+    return 0;
+}
+
+/* Stereo frame step: moved encode_pcm_frames loop body. */
+static int
+st_emit(ac4_enc_step_ctx_t *c, int j, uint8_t *out, size_t outcap,
+        size_t *out_len, int *is_iframe)
+{
+    int coff = step_coff(c);
+    int i = j + coff;
+    int iframe = c->priming ? iframe_pred51(c, j)
+                            : iframe_pred_joint(c, j);
+    int size = cbr_peek(c);
+    int oi_prev = AC4_ENC_CORE_ORIENT_LONG;
+    int oi = AC4_ENC_CORE_ORIENT_LONG;
+    int oi_next = AC4_ENC_CORE_ORIENT_LONG;
+    uint8_t *raw = NULL;
+    int n_raw = -1, have_full = 0, have_audio = 0;
+    int n_audio = 0;
+    int wlen0 = c->fed[0] - c->wbase;
+    int wlen1 = c->fed[1] - c->wbase;
+    if (wlen0 < 0)
+        wlen0 = 0;
+    if (wlen1 < 0)
+        wlen1 = 0;
+    if (emit_bufs(c))
+        return step_fail(c, AC4_ENC_STEP_ENOMEM, -ENOMEM);
+    /* Fresh-zero each frame: the moved bodies replaced per-frame
+     * 64K mallocs (fresh zero pages in practice); writers may
+     * leave gaps that must read back as zero, not stale. */
+    memset(c->b_full, 0, 65536);
+    memset(c->b_audio, 0, 65536);
+    memset(c->b_body, 0, 65536);
+    if (or_need(c, i - 1, &oi_prev) || or_need(c, i, &oi))
+        return step_fail(c, AC4_ENC_STEP_EEMIT, -EIO);
+    if (c->ended && i + 1 >= c->end_frames + coff)
+        oi_next = AC4_ENC_CORE_ORIENT_LONG;
+    else if (or_need(c, i + 1, &oi_next))
+        return step_fail(c, AC4_ENC_STEP_EEMIT, -EIO);
+    if (i >= 2) {
+        int start = or_start(i);
+        int ts = start - c->wbase;
+        if (oi != AC4_ENC_CORE_ORIENT_LONG) {
+            const double *rL[9], *rR[9];
+            int pf, pl, nf, nl;
+            frame_edge_lens(oi_prev, &pf, &pl);
+            frame_edge_lens(oi_next, &nf, &nl);
+            tile_specs_128(c->rows[0], wlen0, ts,
+                           c->u.st.sL);
+            tile_specs_128(c->rows[1], wlen1, ts,
+                           c->u.st.sR);
+            if (c->joint_shorts) {
+                int wlenM = c->fed[2] - c->wbase;
+                int wlenS = c->fed[3] - c->wbase;
+                if (wlenM < 0)
+                    wlenM = 0;
+                if (wlenS < 0)
+                    wlenS = 0;
+                for (int a = 0; a < 16; a++) {
+                    for (int b = 0; b < 128; b++) {
+                        c->u.st.sM[a][b] =
+                            (c->u.st.sL[a][b] +
+                             c->u.st.sR[a][b]) /
+                            2.0;
+                        c->u.st.sS[a][b] =
+                            (c->u.st.sL[a][b] -
+                             c->u.st.sR[a][b]) /
+                            2.0;
+                    }
+                }
+                if (ac4_enc_core_mixed_specs_for_frame(
+                        c->rows[2], wlenM, ts, oi,
+                        &c->u.st.sM[0][0], pl, nf,
+                        c->u.st.s9L) ||
+                    ac4_enc_core_mixed_specs_for_frame(
+                        c->rows[3], wlenS, ts, oi,
+                        &c->u.st.sS[0][0], pl, nf,
+                        c->u.st.s9R))
+                    return step_fail(c, AC4_ENC_STEP_EEMIT,
+                                     -EIO);
+            } else {
+                if (ac4_enc_core_mixed_specs_for_frame(
+                        c->rows[0], wlen0, ts, oi,
+                        &c->u.st.sL[0][0], pl, nf,
+                        c->u.st.s9L) ||
+                    ac4_enc_core_mixed_specs_for_frame(
+                        c->rows[1], wlen1, ts, oi,
+                        &c->u.st.sR[0][0], pl, nf,
+                        c->u.st.s9R))
+                    return step_fail(c, AC4_ENC_STEP_EEMIT,
+                                     -EIO);
+            }
+            for (int g = 0; g < 9; g++) {
+                rL[g] = c->u.st.s9L[g];
+                rR[g] = c->u.st.s9R[g];
+            }
+            {
+                int n_full;
+                if (c->joint_shorts)
+                    n_full =
+                        ac4_enc_core_encode_joint_mixed_frame(
+                            j, rL, rR, oi, size,
+                            c->layout, iframe, c->stamp,
+                            c->drc, c->dmx, c->b_full,
+                            65536);
+                else
+                    n_full = ac4_enc_core_encode_mixed_frame(
+                        j, rL, rR, oi, size, c->layout,
+                        iframe, c->stamp, c->drc, c->dmx,
+                        c->b_full, 65536);
+                if (n_full >= 0) {
+                    raw = c->b_full;
+                    n_raw = n_full;
+                    have_full = 1;
+                }
+            }
+        } else {
+            double wspan[4096];
+            const double *ww = c->win;
+            int pf, pl, nf, nl, bridged;
+            int tl = 0, tr = 0;
+            frame_edge_lens(oi_prev, &pf, &pl);
+            frame_edge_lens(oi_next, &nf, &nl);
+            if (pl < 2048)
+                tl = pl;
+            if (nf < 2048)
+                tr = nf;
+            bridged = tl || tr;
+            if (bridged) {
+                ac4_mdct_bridged_window(2048, tl, tr, wspan);
+                ww = wspan;
+            }
+            ac4_mdct_forward_full(c->rows[0], wlen0, ts, ww,
+                              c->u.st.XL);
+            ac4_mdct_forward_full(c->rows[1], wlen1, ts, ww,
+                              c->u.st.XR);
+            if (c->nlines > 0 && !bridged &&
+                ac4_enc_core_tile_pure(c->u.st.XL,
+                                   c->u.st.XR, 2048,
+                                   c->lines,
+                                   c->nlines) > 0) {
+                ac4_enc_core_leg_t cL, cR;
+                if (ac4_enc_core_quantize_frame(
+                        c->rows[0], wlen0, ts, c->lines,
+                        c->nlines, c->win,
+                        AC4_ENC_CORE_DIG_GAIN_STEREO, &cL) ||
+                    ac4_enc_core_quantize_frame(
+                        c->rows[1], wlen1, ts, c->lines,
+                        c->nlines, c->win,
+                        AC4_ENC_CORE_DIG_GAIN_STEREO, &cR))
+                    return step_fail(c, AC4_ENC_STEP_EEMIT,
+                                     -EIO);
+                if (cL.n > 0 || cR.n > 0) {
+                    n_audio =
+                        ac4_enc_core_write_audio_spectral(
+                            cL.lines, cL.qs, cL.n, cL.ref,
+                            cR.lines, cR.qs, cR.n, cR.ref,
+                            c->b_audio, 65536);
+                    if (n_audio < 0)
+                        return step_fail(c, AC4_ENC_STEP_EEMIT,
+                                         -EIO);
+                    have_audio = 1;
+                }
+            } else {
+                int n_full;
+                n_full = ac4_enc_core_encode_fullband_frame(
+                    j, c->u.st.XL, c->u.st.XR, size,
+                    c->layout, iframe, 1, c->stamp, c->drc,
+                    c->dmx, !c->flat_file, c->b_full,
+                    65536);
+                if (n_full >= 0) {
+                    raw = c->b_full;
+                    n_raw = n_full;
+                    have_full = 1;
+                }
+            }
+        }
+    }
+    if (!have_full) {
+        if (!have_audio) {
+            int n_body;
+            if (c->stamp && j == 0) {
+                bytebuf_t s1 = { NULL, 0, 0 };
+                const uint8_t *subs[3];
+                int nlens[3];
+                if (!iframe) {
+                    bb_free(&s1);
+                    return step_fail(c, AC4_ENC_STEP_EEMIT,
+                                     -EIO);
+                }
+                if (priming_sub1_bb(&s1, c->drc, c->dmx)) {
+                    bb_free(&s1);
+                    return step_fail(c, AC4_ENC_STEP_EEMIT,
+                                     -EIO);
+                }
+                subs[0] = c->stamp->fr0;
+                nlens[0] = c->stamp->n_fr0;
+                subs[1] = s1.p;
+                nlens[1] = (int)s1.n;
+                subs[2] = c->stamp->s4;
+                nlens[2] = c->stamp->n_s4;
+                n_body = assemble_raw(j, 1, c->layout, 0,
+                                      subs, nlens, 3, size,
+                                      c->b_body, 65536);
+                bb_free(&s1);
+            } else {
+                n_body = ac4_enc_core_write_raw_frame(
+                    j, size, c->layout, iframe, c->drc,
+                    c->dmx, c->b_body, 65536);
+            }
+            if (n_body < 0)
+                return step_fail(c, AC4_ENC_STEP_EEMIT, -EIO);
+            raw = c->b_body;
+            n_raw = n_body;
+        } else {
+            int n_body;
+            n_body = ac4_enc_core_assemble_content_frame(
+                j, c->b_audio, n_audio, size, c->layout,
+                iframe, c->ns2_tone, c->stamp, c->drc,
+                c->dmx, c->b_body, 65536);
+            if (n_body < 0)
+                return step_fail(c, AC4_ENC_STEP_EEMIT, -EIO);
+            raw = c->b_body;
+            n_raw = n_body;
+        }
+    }
+    if (n_raw < 0 || n_raw > 65536)
+        return step_fail(c, AC4_ENC_STEP_EEMIT, -EIO);
+    *out_len = (size_t)n_raw;
+    if ((size_t)n_raw > outcap || !out)
+        return step_fail(c, AC4_ENC_STEP_ESHORT, -EINVAL);
+    memcpy(out, raw, (size_t)n_raw);
+    if (is_iframe)
+        *is_iframe = iframe;
+    cbr_advance(c);
+    c->emitted++;
+    win_compact(c, or_start(i + 1));
+    return 1;
+}
+/* 5.1 frame step: moved encode_pcm_mc_frames loop body. */
+static int
+mc_emit(ac4_enc_step_ctx_t *c, int j, uint8_t *out, size_t outcap,
+        size_t *out_len, int *is_iframe)
+{
+    int iframe = iframe_pred51(c, j);
+    int size = cbr_peek(c);
+    int oi_prev = AC4_ENC_CORE_ORIENT_LONG;
+    int oi = AC4_ENC_CORE_ORIENT_LONG;
+    int oi_next = AC4_ENC_CORE_ORIENT_LONG;
+    uint8_t *raw = NULL;
+    int n_raw = -1;
+    if (emit_bufs(c))
+        return step_fail(c, AC4_ENC_STEP_ENOMEM, -ENOMEM);
+    /* Fresh-zero each frame: the moved bodies replaced per-frame
+     * 64K mallocs (fresh zero pages in practice); writers may
+     * leave gaps that must read back as zero, not stale. */
+    memset(c->b_full, 0, 65536);
+    memset(c->b_audio, 0, 65536);
+    memset(c->b_body, 0, 65536);
+    if (or_need(c, j - 1, &oi_prev) || or_need(c, j, &oi))
+        return step_fail(c, AC4_ENC_STEP_EEMIT, -EIO);
+    if (c->ended && j + 1 >= c->end_frames)
+        oi_next = AC4_ENC_CORE_ORIENT_LONG;
+    else if (or_need(c, j + 1, &oi_next))
+        return step_fail(c, AC4_ENC_STEP_EEMIT, -EIO);
+    if (j >= 2) {
+        int start = or_start(j);
+        int ts = start - c->wbase;
+        if (oi != AC4_ENC_CORE_ORIENT_LONG) {
+            const double *rows[45];
+            int pf, pl, nf, nl, any = 0;
+            int chmap[5] = { 0, 1, 2, 4, 5 };
+            int wlen3 = c->fed[3] - c->wbase;
+            frame_edge_lens(oi_prev, &pf, &pl);
+            frame_edge_lens(oi_next, &nf, &nl);
+            if (wlen3 < 0)
+                wlen3 = 0;
+            for (int ch = 0; ch < 6; ch++) {
+                int wlen = c->fed[ch] - c->wbase;
+                if (wlen < 0)
+                    wlen = 0;
+                tile_specs_128(c->rows[ch], wlen, ts,
+                               c->u.mc.sp[ch]);
+            }
+            for (int k = 0; k < 5; k++) {
+                int wlen = c->fed[chmap[k]] - c->wbase;
+                if (wlen < 0)
+                    wlen = 0;
+                if (ac4_enc_core_mixed_specs_for_frame(
+                        c->rows[chmap[k]], wlen, ts, oi,
+                        &c->u.mc.sp[chmap[k]][0][0], pl,
+                        nf, c->u.mc.x9[k]))
+                    return step_fail(c, AC4_ENC_STEP_EEMIT,
+                                     -EIO);
+                for (int g = 0; g < 9; g++)
+                    rows[k * 9 + g] = c->u.mc.x9[k][g];
+            }
+            ac4_mdct_forward_full(c->rows[3], wlen3, ts, c->win,
+                              c->u.mc.xlfe);
+            for (int k = 0; k < 5 && !any; k++)
+                for (int g = 0; g < 9 && !any; g++)
+                    for (int v = 0; v < 1024; v++)
+                        if (fabs(c->u.mc.x9[k][g][v]) >
+                            0.0) {
+                            any = 1;
+                            break;
+                        }
+            for (int v = 0; v < 2048 && !any; v++)
+                if (fabs(c->u.mc.xlfe[v]) > 0.0)
+                    any = 1;
+            if (any) {
+                int n_body;
+                n_body = fit_51_mixed(j, rows, c->u.mc.xlfe,
+                                      oi, size, iframe,
+                                      c->stamp, c->drc,
+                                      c->dmx, c->b_body,
+                                      65536);
+                if (n_body >= 0) {
+                    raw = c->b_body;
+                    n_raw = n_body;
+                }
+            }
+        } else {
+            const double *rows[6];
+            int pf, pl, nf, nl, tl = 0, tr = 0;
+            int any = 0;
+            double wspan[4096];
+            const double *ww = c->win;
+            frame_edge_lens(oi_prev, &pf, &pl);
+            frame_edge_lens(oi_next, &nf, &nl);
+            if (pl < 2048)
+                tl = pl;
+            if (nf < 2048)
+                tr = nf;
+            if (tl || tr) {
+                ac4_mdct_bridged_window(2048, tl, tr, wspan);
+                ww = wspan;
+            }
+            for (int ch = 0; ch < 6; ch++) {
+                int wlen = c->fed[ch] - c->wbase;
+                if (wlen < 0)
+                    wlen = 0;
+                ac4_mdct_forward_full(c->rows[ch], wlen, ts,
+                                  ch == 3 ? c->win : ww,
+                                  c->u.mc.xs[ch]);
+                rows[ch] = c->u.mc.xs[ch];
+            }
+            for (int ch = 0; ch < 6 && !any; ch++)
+                for (int v = 0; v < 2048; v++)
+                    if (c->u.mc.xs[ch][v] != 0.0) {
+                        any = 1;
+                        break;
+                    }
+            if (any) {
+                int n_body;
+                n_body = fit_51(j, rows, size, iframe,
+                                c->stamp, c->drc, c->dmx,
+                                !c->flat_file, c->b_body,
+                                65536);
+                if (n_body >= 0) {
+                    raw = c->b_body;
+                    n_raw = n_body;
+                }
+            }
+        }
+    }
+    if (!raw) {
+        int n_body;
+        if (c->stamp && j == 0) {
+            bytebuf_t s1 = { NULL, 0, 0 };
+            const uint8_t *subs[3];
+            int nlens[3], n_aud;
+            if (!iframe) {
+                bb_free(&s1);
+                return step_fail(c, AC4_ENC_STEP_EEMIT, -EIO);
+            }
+            n_aud = ac4_enc_core_write_audio_data(
+                "5.1", 1, c->b_audio, 65536);
+            if (n_aud < 0 ||
+                sub_audio_bb(&s1, c->b_audio, n_aud,
+                             "5.1", 1, c->drc)) {
+                bb_free(&s1);
+                return step_fail(c, AC4_ENC_STEP_EEMIT, -EIO);
+            }
+            subs[0] = c->stamp->fr0;
+            nlens[0] = c->stamp->n_fr0;
+            subs[1] = s1.p;
+            nlens[1] = (int)s1.n;
+            subs[2] = c->stamp->s4;
+            nlens[2] = c->stamp->n_s4;
+            n_body = assemble_raw(j, 1, "5.1", 0, subs,
+                                  nlens, 3, size,
+                                  c->b_body, 65536);
+            bb_free(&s1);
+        } else {
+            n_body = ac4_enc_core_write_raw_frame(
+                j, size, "5.1", iframe, c->drc, c->dmx,
+                c->b_body, 65536);
+        }
+        if (n_body < 0)
+            return step_fail(c, AC4_ENC_STEP_EEMIT, -EIO);
+        raw = c->b_body;
+        n_raw = n_body;
+    }
+    if (n_raw < 0 || n_raw > 65536)
+        return step_fail(c, AC4_ENC_STEP_EEMIT, -EIO);
+    *out_len = (size_t)n_raw;
+    if ((size_t)n_raw > outcap || !out)
+        return step_fail(c, AC4_ENC_STEP_ESHORT, -EINVAL);
+    memcpy(out, raw, (size_t)n_raw);
+    if (is_iframe)
+        *is_iframe = iframe;
+    cbr_advance(c);
+    c->emitted++;
+    win_compact(c, or_start(j + 1));
+    return 1;
+}
+
+int
+ac4_enc_step_emit(ac4_enc_step_ctx_t *c, uint8_t *out, size_t outcap,
+              size_t *out_len, int *is_iframe)
+{
+    int j;
+    if (!c || !out_len)
+        return -EINVAL;
+    *out_len = 0;
+    if (c->fail_rc)
+        return c->fail_rc;
+    j = c->emitted;
+    if (c->ended && j >= c->end_frames)
+        return step_fail(c, AC4_ENC_STEP_EPROTO, -EINVAL);
+    if (!c->ended) {
+        int i = j + step_coff(c);
+        if (i >= 2 &&
+            c->fed_max < or_start(i) + emit_ahead(c))
+            return step_fail(c, AC4_ENC_STEP_EPROTO, -EINVAL);
+        if (i < 2 && c->fed_max <= 0)
+            return step_fail(c, AC4_ENC_STEP_EPROTO, -EINVAL);
+    }
+    if (c->nch == 2)
+        return st_emit(c, j, out, outcap, out_len,
+                       is_iframe);
+    return mc_emit(c, j, out, outcap, out_len, is_iframe);
+}
