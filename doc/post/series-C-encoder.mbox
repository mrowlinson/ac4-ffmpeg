+    const int *lines;
+    const int *wins; /* NULL = every coeff is window 0 */
+    const int *qs;
+    int n;
+    const int *offs;
+    int max_sfb;
+    int sect_bits;
+    int nwins;
+    const int *refs_by_band; /* size max_sfb */
+} ac4_asf_group_t;
+
+void ac4_asf_write_mixed_leg(ac4_bitwriter_t *w, const ac4_asf_group_t *groups,
+                         int ngroups, int ref);
+
+#endif
diff --git a/libavcodec/ac4_bits.c b/libavcodec/ac4_bits.c
new file mode 100644
index 0000000..beee6f0
--- /dev/null
+++ b/libavcodec/ac4_bits.c
@@ -0,0 +1,173 @@
+/*
+ * MSB-first bit writer and CRC-16
+ * Copyright (c) 2026 Michael Rowlinson
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+/* ac4_bits.c: MSB-first bit writer + CRC-16. See ac4_bits.h. */
+#include "ac4_bits.h"
+#include "libavutil/mem.h"
+
+#include <assert.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define CRC_POLY 0x8005u
+
+
+uint16_t
+ac4_crc16(const uint8_t *data, size_t len)
+{
+    uint32_t crc = 0;
+    for (size_t i = 0; i < len; i++) {
+        crc ^= (uint32_t)data[i] << 8;
+        for (int k = 0; k < 8; k++) {
+            if (crc & 0x8000u)
+                crc = ((crc << 1) ^ CRC_POLY) & 0xFFFFu;
+            else
+                crc = (crc << 1) & 0xFFFFu;
+        }
+    }
+    return (uint16_t)crc;
+}
+
+
+void
+ac4_bw_init(ac4_bitwriter_t *w)
+{
+    w->buf = NULL;
+    w->nbits = 0;
+    w->cap_bits = 0;
+}
+
+
+void
+ac4_bw_free(ac4_bitwriter_t *w)
+{
+    av_free(w->buf);
+    w->buf = NULL;
+    w->nbits = 0;
+    w->cap_bits = 0;
+}
+
+
+static void
+ac4_bw_reserve(ac4_bitwriter_t *w, size_t extra)
+{
+    size_t need = w->nbits + extra;
+    if (need <= w->cap_bits)
+        return;
+    size_t cap = w->cap_bits ? w->cap_bits : 64;
+    while (cap < need)
+        cap *= 2;
+    uint8_t *nb = av_realloc(w->buf, (cap + 7) / 8);
+    assert(nb != NULL);
+    memset(nb + (w->cap_bits + 7) / 8, 0,
+           (cap + 7) / 8 - (w->cap_bits + 7) / 8);
+    w->buf = nb;
+    w->cap_bits = cap;
+}
+
+
+static void
+ac4_bw_push_bit(ac4_bitwriter_t *w, int bit)
+{
+    ac4_bw_reserve(w, 1);
+    if (bit)
+        w->buf[w->nbits / 8] |= (uint8_t)(0x80u >> (w->nbits % 8));
+    w->nbits++;
+}
+
+
+void
+ac4_bw_put(ac4_bitwriter_t *w, uint64_t value, int nbits)
+{
+    assert(nbits >= 0 && nbits <= 64);
+    assert(nbits == 0 ? value == 0
+                      : nbits == 64 || (value >> nbits) == 0);
+    for (int i = nbits - 1; i >= 0; i--)
+        ac4_bw_push_bit(w, (int)((value >> i) & 1u));
+}
+
+
+void
+ac4_bw_putbits(ac4_bitwriter_t *w, const char *bits)
+{
+    for (const char *p = bits; *p; p++) {
+        assert(*p == '0' || *p == '1');
+        ac4_bw_push_bit(w, *p - '0');
+    }
+}
+
+
+int
+ac4_bw_align(ac4_bitwriter_t *w, int fill)
+{
+    int pad = (int)((8 - w->nbits % 8) % 8);
+    for (int i = 0; i < pad; i++)
+        ac4_bw_push_bit(w, fill);
+    return pad;
+}
+
+
+void
+ac4_bw_varbits(ac4_bitwriter_t *w, int nbits, uint64_t value)
+{
+    assert(nbits > 0 && nbits < 64 && (value >> nbits) == 0);
+    ac4_bw_put(w, value, nbits);
+    ac4_bw_put(w, 0, 1);
+}
+
+
+void
+ac4_bw_varbits_long(ac4_bitwriter_t *w, int nbits, uint64_t value)
+{
+    uint64_t base = 1u << nbits;
+    uint64_t off = 0, span = base;
+    int groups = 1;
+    while (value >= off + span) {
+        off += span;
+        span *= base;
+        groups++;
+    }
+    uint64_t rem = value - off;
+    for (int j = 0; j < groups; j++) {
+        int shift = nbits * (groups - 1 - j);
+        ac4_bw_put(w, (rem >> shift) & (base - 1), nbits);
+        ac4_bw_put(w, j < groups - 1 ? 1u : 0u, 1);
+    }
+}
+
+
+size_t
+ac4_bw_nbits(const ac4_bitwriter_t *w)
+{
+    return w->nbits;
+}
+
+
+size_t
+ac4_bw_bytes(const ac4_bitwriter_t *w, uint8_t *out, size_t outcap)
+{
+    if (w->nbits % 8 != 0)
+        return 0;
+    if (outcap < w->nbits / 8)
+        return 0;
+    memcpy(out, w->buf, w->nbits / 8);
+    return w->nbits / 8;
+}
diff --git a/libavcodec/ac4_bits.h b/libavcodec/ac4_bits.h
new file mode 100644
index 0000000..9c9d2d4
--- /dev/null
+++ b/libavcodec/ac4_bits.h
@@ -0,0 +1,70 @@
+/*
+ * MSB-first bit writer and CRC-16
+ * Copyright (c) 2026 Michael Rowlinson
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+/* ac4_bits.h: MSB-first bit writer + CRC-16 for the clean AC-4 encoder.
+ *
+ * Byte-identical contract: the same op sequence produces the
+ * same bit stream as the reference BitWriter; see
+ * tests/test_bits_parity.py. C11, zero deps.
+ */
+#ifndef AC4_BITS_H
+#define AC4_BITS_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+typedef struct {
+    uint8_t *buf;     /* packed bits, MSB-first within each byte */
+    size_t nbits;     /* live bit count */
+    size_t cap_bits;  /* allocated capacity in bits */
+} ac4_bitwriter_t;
+
+void ac4_bw_init(ac4_bitwriter_t *w);
+void ac4_bw_free(ac4_bitwriter_t *w);
+
+/* Append the low nbits of value, most-significant bit first. */
+void ac4_bw_put(ac4_bitwriter_t *w, uint64_t value, int nbits);
+
+/* Append a "0101..." string. */
+void ac4_bw_putbits(ac4_bitwriter_t *w, const char *bits);
+
+/* Pad with fill bits to the next byte; returns the pad count. */
+int ac4_bw_align(ac4_bitwriter_t *w, int fill);
+
+/* variable_bits() writer, single group + stop bit. */
+void ac4_bw_varbits(ac4_bitwriter_t *w, int nbits, uint64_t value);
+
+/* variable_bits() writer, any value (multi-group + stop). */
+void ac4_bw_varbits_long(ac4_bitwriter_t *w, int nbits, uint64_t value);
+
+size_t ac4_bw_nbits(const ac4_bitwriter_t *w);
+
+/*
+ * Pack whole bytes MSB-first into out (outcap bytes). Returns the
+ * byte count, or 0 when the writer is not byte-aligned or outcap
+ * is short (mirrors bytes()' assert on alignment).
+ */
+size_t ac4_bw_bytes(const ac4_bitwriter_t *w, uint8_t *out, size_t outcap);
+
+/* CRC-16: poly 0x8005, init 0, no reflect, no xorout. */
+uint16_t ac4_crc16(const uint8_t *data, size_t len);
+
+#endif
diff --git a/libavcodec/ac4_enc_acpl.c b/libavcodec/ac4_enc_acpl.c
new file mode 100644
index 0000000..7f9fb7e
--- /dev/null
+++ b/libavcodec/ac4_enc_acpl.c
@@ -0,0 +1,89 @@
+/*
+ * Encoder-side A-CPL param writer
+ * Copyright (c) 2026 Michael Rowlinson
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include "ac4_enc_acpl.h"
+
+#include "ac4_huffman_tab.h"
+
+const ac4_enc_acpl_books_t AC4_ENC_ACPL_FINE_BOOKS = {
+    {AC4_ACPL_HCB_ALPHA_FINE_F0_CW, AC4_ACPL_HCB_ALPHA_FINE_F0_LEN, 33, 0},
+    {AC4_ACPL_HCB_ALPHA_FINE_DF_CW, AC4_ACPL_HCB_ALPHA_FINE_DF_LEN, 65, 32},
+    {AC4_ACPL_HCB_BETA_FINE_F0_CW, AC4_ACPL_HCB_BETA_FINE_F0_LEN, 9, 0},
+    {AC4_ACPL_HCB_BETA_FINE_DF_CW, AC4_ACPL_HCB_BETA_FINE_DF_LEN, 17, 8},
+};
+
+int ac4_enc_acpl_write_param(ac4_bitwriter_t *w, int f0, const int *dfs,
+                         int ndfs, const ac4_enc_acpl_book_t *f0book,
+                         const ac4_enc_acpl_book_t *dfbook, int diff_t) {
+    if (diff_t < 0 || diff_t > 1)
+        return -1;
+    if (f0 < 0 || f0 >= f0book->entries)
+        return -1;
+    ac4_bw_put(w, (unsigned)diff_t, 1);
+    ac4_bw_put(w, f0book->cw[f0], f0book->ln[f0]);
+    for (int i = 0; i < ndfs; i++) {
+        int sym = dfs[i] + dfbook->off;
+        if (sym < 0 || sym >= dfbook->entries)
+            return -1;
+        ac4_bw_put(w, dfbook->cw[sym], dfbook->ln[sym]);
+    }
+    return 0;
+}
+
+int ac4_enc_acpl_write_1ch(ac4_bitwriter_t *w, int interp, int alpha_f0,
+                       const int *alpha_dfs, int nalpha, int beta_f0,
+                       const int *beta_dfs, int nbeta,
+                       const ac4_enc_acpl_books_t *books, int has_slot,
+                       int slot_val, int nps, int beta_first) {
+    const int *f0s[2];
+    const int *dfss[2];
+    int ndfs[2];
+    const ac4_enc_acpl_book_t *f0b[2], *dfb[2];
+    int ia = beta_first ? 1 : 0;
+
+    if (interp < 0 || interp > 1)
+        return -1;
+    if (nps != 0)
+        return -1;
+    if (has_slot && (slot_val < 0 || slot_val > 31))
+        return -1;
+    ac4_bw_put(w, (unsigned)interp, 1);
+    ac4_bw_put(w, 0u, 1);
+    if (has_slot)
+        ac4_bw_put(w, (unsigned)slot_val, 5);
+    f0s[ia] = &alpha_f0;
+    dfss[ia] = alpha_dfs;
+    ndfs[ia] = nalpha;
+    f0b[ia] = &books->alpha_f0;
+    dfb[ia] = &books->alpha_df;
+    f0s[1 - ia] = &beta_f0;
+    dfss[1 - ia] = beta_dfs;
+    ndfs[1 - ia] = nbeta;
+    f0b[1 - ia] = &books->beta_f0;
+    dfb[1 - ia] = &books->beta_df;
+    for (int i = 0; i < 2; i++) {
+        int rc = ac4_enc_acpl_write_param(w, *f0s[i], dfss[i], ndfs[i],
+                                      f0b[i], dfb[i], 0);
+        if (rc)
+            return rc;
+    }
+    return 0;
+}
diff --git a/libavcodec/ac4_enc_acpl.h b/libavcodec/ac4_enc_acpl.h
new file mode 100644
index 0000000..950f001
--- /dev/null
+++ b/libavcodec/ac4_enc_acpl.h
@@ -0,0 +1,66 @@
+/*
+ * Encoder-side A-CPL param writer
+ * Copyright (c) 2026 Michael Rowlinson
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
