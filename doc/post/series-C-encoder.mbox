+ */
+
+/* ac4_enc_core_fit51.c: mode-3 5.1 CBR rate loop. See ac4_enc_core.h
+ * for the contract. */
+#include "ac4_enc_core.h"
+#include "libavutil/mem.h"
+
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "ac4_asf.h"
+#include "ac4_pycompat.h"
+#include "ac4_sfb_offsets.h"
+
+/* Empty-coeff mono leg -> proven silence-leg shape. */
+static void
+quiet_leg(ac4_enc_core_leg_t *leg)
+{
+    if (leg->n == 0) {
+        for (int b = 0; b < 63; b++)
+            leg->refs[b] = -1;
+        leg->ref = 100;
+        leg->msfb = 1;
+    }
+}
+
+static void
+leg_to_mc3(const ac4_enc_core_leg_t *leg, ac4_enc_mc3_leg_t *out)
+{
+    out->lines = leg->lines;
+    out->qs = leg->qs;
+    out->n = leg->n;
+    out->ref = leg->ref;
+    out->refs_by_band = leg->n > 0 ? leg->refs : NULL;
+    out->has_refs = leg->n > 0 ? 1 : 0;
+    out->msfb = leg->msfb;
+}
+
+int
+ac4_enc_core_fit_frame_51(int i, const double *const *Xs,
+                      const int *lens, int raw_size, int iframe,
+                      const ac4_enc_acpl_books_t *abooks,
+                      const ac4_enc_core_stamp_t *stamp51,
+                      ac4_enc_core_fit_info_t *info, uint8_t *out,
+                      size_t outcap)
+{
+    static const int kcaps[6] = { 63, 31, 15, 7, 3, 1 };
+    const int *offs = ac4_sfb_offsets48(2048);
+    double peak = 0.0;
+    double *XA = NULL, *XB = NULL;
+    double peaks[6][63];
+    ac4_enc_core_acpl_dual_t dual;
+    ac4_enc_mc3_quiet_t quiet;
+    ac4_enc_mc3_tail_t tail;
+    ac4_bitwriter_t w;
+    uint8_t *sil_audio = NULL;
+    int n_sil = 0;
+    uint8_t *sil_body = NULL;
+    int n_sil_body = -1;
+    int n = -1;
+    if (!Xs || !lens || !offs || !abooks || !info || !out)
+        return -1;
+    for (int c = 0; c < 6; c++) {
+        if (!Xs[c] || lens[c] < 0)
+            return -1;
+        for (int k = 0; k < lens[c]; k++) {
+            double a = fabs(Xs[c][k]);
+            if (a > peak)
+                peak = a;
+        }
+    }
+    ac4_bw_init(&w);
+    if (ac4_enc_mc3_write_audio_51_mode3_silence(&w, !!iframe,
+                                             abooks)) {
+        ac4_bw_free(&w);
+        return -1;
+    }
+    {
+        size_t nb = ac4_bw_nbits(&w) / 8;
+        if (ac4_bw_nbits(&w) % 8 != 0) {
+            ac4_bw_free(&w);
+            return -1;
+        }
+        sil_audio = av_malloc(nb ? nb : 1);
+        if (!sil_audio ||
+            ac4_bw_bytes(&w, sil_audio, nb) != nb) {
+            av_free(sil_audio);
+            ac4_bw_free(&w);
+            return -1;
+        }
+        n_sil = (int)nb;
+    }
+    ac4_bw_free(&w);
+    sil_body = av_malloc(65536);
+    if (!sil_body) {
+        av_free(sil_audio);
+        return -1;
+    }
+    n_sil_body = ac4_enc_core_assemble_51(i, sil_audio, n_sil,
+                                      raw_size, !!iframe,
+                                      stamp51, 0, NULL,
+                                      NULL, sil_body,
+                                      65536);
+    if (peak <= 0.0) {
+        /* Exact-digital-zero short-circuit (A-155). */
+        if (n_sil_body < 0)
+            goto done;
+        if ((size_t)n_sil_body > outcap)
+            goto done;
+        memcpy(out, sil_body, (size_t)n_sil_body);
+        info->kcap = 0;
+        info->shift = 0;
+        info->msfb[0] = info->msfb[1] = info->msfb[2] = 1;
+        info->nbets = 0;
+        info->audio_len = n_sil;
+        n = n_sil_body;
+        goto done;
+    }
+    {
+        int nXA = lens[0] < lens[4] ? lens[0] : lens[4];
+        int nXB = lens[1] < lens[5] ? lens[1] : lens[5];
+        double floor_ = peak * 1e-3;
+        XA = av_malloc((size_t)(nXA > 0 ? nXA : 1) *
+                    sizeof *XA);
+        XB = av_malloc((size_t)(nXB > 0 ? nXB : 1) *
+                    sizeof *XB);
+        if (!XA || !XB)
+            goto done;
+        for (int k = 0; k < nXA; k++)
+            XA[k] = Xs[0][k] + Xs[4][k];
+        for (int k = 0; k < nXB; k++)
+            XB[k] = Xs[1][k] + Xs[5][k];
+        for (int c = 0; c < 6; c++)
+            if (ac4_enc_core_band_peaks(Xs[c], lens[c], offs,
+                                    63, peaks[c]))
+                goto done;
+        if (ac4_enc_core_pack_acpl_dual(
+                peaks[0], peaks[4], peaks[1], peaks[5],
+                63, floor_ * floor_, 0, &dual))
+            goto done;
+        if (ac4_enc_mc3_quiet_aspx(0, &quiet))
+            goto done;
+        tail.s2ch = &quiet.s2ch;
+        tail.s1ch = &quiet.s1ch;
+        tail.a0 = &dual.a0;
+        tail.a1 = &dual.a1;
+        tail.abooks = abooks;
+        for (int k = 0; k < 6; k++) {
+            int shift = 0;
+            while (shift <= AC4_ENC_CORE_SHIFT_MAX) {
+                ac4_enc_core_joint_pack_t *pack =
+                    av_malloc(sizeof *pack);
+                ac4_enc_core_leg_t mono, lfe;
+                int deg;
+                if (!pack)
+                    goto done;
+                if (ac4_enc_core_pack_joint_long(
+                        XA, nXA, XB, nXB, 0, 0.0, 48,
+                        floor_, shift, kcaps[k], pack)) {
+                    av_free(pack);
+                    goto done;
+                }
+                if (ac4_enc_core_pack_mono(Xs[2], lens[2], 0,
+                                       0.0, 48, shift,
+                                       kcaps[k], &mono) ||
+                    ac4_enc_core_pack_mono(Xs[3], lens[3], 0,
+                                       0.0, 7, shift, 63,
+                                       &lfe)) {
+                    av_free(pack);
+                    goto done;
+                }
+                quiet_leg(&mono);
+                quiet_leg(&lfe);
+                deg = pack->n0 == 0 && pack->n1 == 0 &&
+                    mono.n == 0 && lfe.n == 0;
+                if (deg) {
+                    if (n_sil_body < 0) {
+                        av_free(pack);
+                        break;
+                    }
+                    if ((size_t)n_sil_body > outcap) {
+                        av_free(pack);
+                        goto done;
+                    }
+                    memcpy(out, sil_body,
+                           (size_t)n_sil_body);
+                    info->kcap = 0;
+                    info->shift = shift;
+                    info->msfb[0] = info->msfb[1] =
+                        info->msfb[2] = 1;
+                    info->nbets = 0;
+                    info->audio_len = n_sil;
+                    n = n_sil_body;
+                    av_free(pack);
+                    goto done;
+                }
+                {
+                    ac4_enc_mc3_leg_t lfe_leg, mono_leg;
+                    uint8_t *audio = NULL;
+                    uint8_t *body = NULL;
+                    int n_audio, n_body;
+                    leg_to_mc3(&lfe, &lfe_leg);
+                    leg_to_mc3(&mono, &mono_leg);
+                    ac4_bw_init(&w);
+                    if (ac4_enc_mc3_write_audio_51_mode3(
+                            &w, !!iframe, &lfe_leg,
+                            &pack->joint, &mono_leg,
+                            &tail)) {
+                        ac4_bw_free(&w);
+                        av_free(pack);
+                        goto done;
+                    }
+                    {
+                        size_t nb = ac4_bw_nbits(&w) / 8;
+                        if (ac4_bw_nbits(&w) % 8 != 0) {
+                            ac4_bw_free(&w);
+                            av_free(pack);
+                            goto done;
+                        }
+                        audio = av_malloc(nb ? nb : 1);
+                        if (!audio ||
+                            ac4_bw_bytes(&w, audio, nb) !=
+                                nb) {
+                            av_free(audio);
+                            ac4_bw_free(&w);
+                            av_free(pack);
+                            goto done;
+                        }
+                        n_audio = (int)nb;
+                    }
+                    ac4_bw_free(&w);
+                    body = av_malloc(65536);
+                    if (!body) {
+                        av_free(audio);
+                        av_free(pack);
+                        goto done;
+                    }
+                    n_body = ac4_enc_core_assemble_51(
+                        i, audio, n_audio, raw_size,
+                        !!iframe, stamp51, 0, NULL, NULL,
+                        body, 65536);
+                    if (n_body >= 0) {
+                        if ((size_t)n_body > outcap) {
+                            av_free(audio);
+                            av_free(body);
+                            av_free(pack);
+                            goto done;
+                        }
+                        memcpy(out, body, (size_t)n_body);
+                        info->kcap = kcaps[k];
+                        info->shift = shift;
+                        info->msfb[0] = pack->msfb;
+                        info->msfb[1] = mono.msfb;
+                        info->msfb[2] = lfe.msfb;
+                        for (int b = 0;
+                             b < pack->nbets; b++)
+                            info->bets[b] =
+                                pack->bets[b];
+                        info->nbets = pack->nbets;
+                        info->audio_len = n_audio;
+                        n = n_body;
+                        av_free(audio);
+                        av_free(body);
+                        av_free(pack);
+                        goto done;
+                    }
+                    av_free(audio);
+                    av_free(body);
+                }
+                av_free(pack);
+                shift += AC4_ENC_CORE_SHIFT_STEP;
+            }
+        }
+    }
+done:
+    av_free(XA);
+    av_free(XB);
+    av_free(sil_audio);
+    av_free(sil_body);
+    return n;
+}
diff --git a/libavcodec/ac4_enc_core_long51.c b/libavcodec/ac4_enc_core_long51.c
new file mode 100644
index 0000000..2bc35c2
--- /dev/null
+++ b/libavcodec/ac4_enc_core_long51.c
@@ -0,0 +1,471 @@
+/*
+ * Steady-LONG 5.1 content packing
+ * Copyright (c) 2026 Michael Rowlinson
