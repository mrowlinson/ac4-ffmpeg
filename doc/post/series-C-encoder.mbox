 create mode 100644 libavcodec/ac4dsi.c
 create mode 100644 libavcodec/ac4dsi.h
 create mode 100644 libavcodec/ac4dsi_priv.h
 create mode 100644 libavcodec/ac4dsi_putbits.c
 create mode 100644 libavcodec/ac4dsi_putbits.h

diff --git a/libavcodec/Makefile b/libavcodec/Makefile
