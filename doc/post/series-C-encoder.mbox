+const uint8_t AC4_ENC_CORE_I12_MID[2] = { 0x58, 0x80 };
+const uint8_t AC4_ENC_CORE_I12_MID_TAIL[2] = { 0x58, 0x82 };
+const uint8_t AC4_ENC_CORE_I12_TAIL[6] =
