+/* ---- diagnostics (M1) ---- */
+
+const char *
+ac4enc_strerror(int rc)
+{
+    switch (rc) {
+    case 0:
+        return "ok";
+    case 1:
+        return "frame ready";
+    case -EINVAL:
+        return "invalid argument or option";
+    case -ENOMEM:
+        return "out of memory";
+    case -EIO:
+        return "encode failure";
+    default:
+        return "unknown";
+    }
+}
+
+const char *
+ac4enc_subcode_str(ac4enc_subcode_t sub)
+{
+    switch (sub) {
+    case AC4ENC_EOK:
+        return "ok";
+    case AC4ENC_EBADCALL:
+        return "bad call";
+    case AC4ENC_EBADOPT:
+        return "bad option";
+    case AC4ENC_ENOMEM:
+        return "out of memory";
+    case AC4ENC_EBAKE_OVERFLOW:
+        return "bake overflow";
+    case AC4ENC_EBAKE_PEAK:
+        return "baked peak overflow";
+    case AC4ENC_EENCODE:
+        return "encode refusal";
+    case AC4ENC_ESHORTBUF:
+        return "short buffer";
+    case AC4ENC_EFPENV:
+        return "unsafe FP environment";
+    default:
+        return "unknown";
+    }
+}
+
+ac4enc_subcode_t
+ac4enc_err_sub(const ac4enc_ctx_t *c)
+{
+    return c ? c->err_sub : AC4ENC_EOK;
+}
+
+const char *
+ac4enc_err_stage(const ac4enc_ctx_t *c)
+{
+    return c ? c->err_stage : "-";
+}
+
+int
+ac4enc_err_frame(const ac4enc_ctx_t *c)
+{
+    return c ? c->err_frame : -1;
+}
+
+const char *
+ac4enc_err_detail(const ac4enc_ctx_t *c)
+{
+    return c ? c->err_detail : "";
+}
+
+int64_t
+ac4enc_fed_samples(const ac4enc_ctx_t *c)
+{
+    return c ? c->fed_total : -1;
+}
+
+int64_t
+ac4enc_emitted_frames(const ac4enc_ctx_t *c)
+{
+    if (!c)
+        return -1;
+    return (int64_t)ac4_enc_step_emitted(c->eng);
+}
+
+static int
+record(ac4enc_ctx_t *c, ac4enc_subcode_t sub,
+       const char *stage, int frame, int rc)
+{
+    c->err_sub = sub;
+    c->err_stage = stage;
+    c->err_frame = frame;
+    c->err_detail[0] = '\0';
+    /* Protocol + short-buffer errors are retryable (the ctx
+     * survives); encode/memory failures are sticky. */
+    if (sub != AC4ENC_ESHORTBUF && sub != AC4ENC_EBADCALL &&
+        !c->enc_err)
+        c->enc_err = rc;
+    return rc;
+}
+
+/* Net per-ch bake factor (stereo: b0; mc: (b0*b1)). */
+static double
+net_bake(const ac4enc_ctx_t *c, int ch)
+{
+    double b = c->b0[ch];
+    if (c->bake_two)
+        b *= c->b1[ch];
+    return b;
+}
+
+/* Map an engine return onto the lib error model (sticky). */
+static int
+from_engine(ac4enc_ctx_t *c, const char *stage, int rc)
+{
+    int detail = ac4_enc_step_detail(c->eng);
+    int frame = ac4_enc_step_emitted(c->eng);
+    if (rc == 0 || rc == 1)
+        return rc;
+    if (rc == -ENOMEM)
+        return record(c, AC4ENC_ENOMEM, stage, frame, rc);
+    if (detail == AC4_ENC_STEP_EBAKE) {
+        int ech = 0, eidx = 0;
+        double x = 0.0, nb;
+        long long fr = c->fed_total / AC4ENC_FRAME_SAMPLES;
+        record(c, AC4ENC_EBAKE_OVERFLOW, stage,
+               fr > INT_MAX ? INT_MAX : (int)fr, rc);
+        if (ac4_enc_step_err_sample(c->eng, &ech, &eidx, &x))
+            ech = eidx = 0;
+        if (ech < 0 || ech >= c->nch)
+            ech = 0;
+        nb = net_bake(c, ech);
+        snprintf(c->err_detail, sizeof c->err_detail,
+                 "bake_round gate: int32 overflow at ch=%d "
+                 "idx=%d (x=%.17g, bake x%.17g)",
+                 ech, eidx, x, nb);
+        return rc;
+    }
+    if (detail == AC4_ENC_STEP_EPEAK) {
+        int pk = ac4_enc_step_err_peak(c->eng);
+        double nb = 0.0;
+        record(c, AC4ENC_EBAKE_PEAK, stage, -1, rc);
+        for (int ch = 0; ch < c->nch; ch++) {
+            double b = net_bake(c, ch);
+            if (fabs(b) > fabs(nb))
+                nb = b;
+        }
+        snprintf(c->err_detail, sizeof c->err_detail,
+                 "baked peak gate: baked_peak=%d >= 32767 "
+                 "(max-|bake| x%.17g)", pk, nb);
+        return rc;
+    }
+    if (detail == AC4_ENC_STEP_ESHORT)
+        return record(c, AC4ENC_ESHORTBUF, stage, frame,
+                      rc);
+    if (detail == AC4_ENC_STEP_EBCFG)
+        return record(c, AC4ENC_EBADOPT, stage, frame, rc);
+    if (detail == AC4_ENC_STEP_EPROTO)
+        return record(c, AC4ENC_EBADCALL, stage, frame, rc);
+    return record(c, AC4ENC_EENCODE, stage, frame, rc);
+}
+
+/* ---- FP environment self-check (M5) ----
+ * Probe: a*b+c with a=b=1+2^-52, c=-(1+2^-51). Unfused:
+ * fl(a*b)=1+2^-51 (the 2^-104 term rounds away), minus c is
+ * exactly 0. Fused: fl(2^-104)=2^-104. Nonzero observes
+ * contraction (verified: 0 under -ffp-contract=off at -O0/-O2,
+ * 2^-104 under =fast). Volatile defeats const-folding; the
+ * expression fuses iff the TU allows contraction. */
+static int
+fp_contract_active(void)
+{
+    volatile double a = 0x1.0000000000001p0;
+    volatile double b = 0x1.0000000000001p0;
+    volatile double c = -0x1.0000000000002p0;
+    return (a * b + c) != 0.0;
+}
+
+int
+ac4enc_fp_ok(void)
+{
+    return fp_contract_active() ? 0 : 1;
+}
+
+int
+ac4enc_max_packet(int rate_kbps)
+{
+    int m = ac4_enc_step_max_cbr(rate_kbps);
+    return m < 0 ? -EINVAL : m;
+}
+
+/* ---- pass-1 measure (same op order as the core prologues) ---- */
+
+static int
+measure_i(const int *const *chs, const int *lens, int nch,
+          ac4enc_measure_t *out)
+{
+    double m = 0, f = 0, tf = 0;
+    int peak = 0;
+    int nb = 0, ng = 0;
+    if (!chs || !lens || !out)
+        return -EINVAL;
+    if (nch != 2 && nch != 6)
+        return -EINVAL;
+    for (int c = 0; c < nch; c++)
+        if (!chs[c] || lens[c] < 0)
+            return -EINVAL;
+    if (nch == 2) {
+        double *d0 = NULL, *d1 = NULL;
+        d0 = av_malloc((size_t)(lens[0] > 0 ? lens[0] : 1) *
+                     sizeof *d0);
+        d1 = av_malloc((size_t)(lens[1] > 0 ? lens[1] : 1) *
+                     sizeof *d1);
+        if (!d0 || !d1) {
+            av_free(d0);
+            av_free(d1);
+            return -ENOMEM;
+        }
+        for (int k = 0; k < lens[0]; k++)
+            d0[k] = (double)chs[0][k];
+        for (int k = 0; k < lens[1]; k++)
+            d1[k] = (double)chs[1][k];
+        ac4_loud_integrated(d0, lens[0], d1, lens[1], 48000, &m,
+                        &nb, &ng);
+        ac4_loud_flatness(d0, lens[0], d1, lens[1], 2048, &f,
+                      &tf);
+        av_free(d0);
+        av_free(d1);
+        for (int k = 0; k < lens[0]; k++)
+            if (ac4_enc_core_abs_sat(chs[0][k]) > peak)
+                peak = ac4_enc_core_abs_sat(chs[0][k]);
+        for (int k = 0; k < lens[1]; k++)
+            if (ac4_enc_core_abs_sat(chs[1][k]) > peak)
+                peak = ac4_enc_core_abs_sat(chs[1][k]);
+    } else {
+        double *dm[6];
+        const double *dmp[6];
+        double *mono = NULL;
+        int nm = 0;
+        for (int c = 0; c < 6; c++) {
+            dm[c] = av_malloc(
+                (size_t)(lens[c] > 0 ? lens[c] : 1) *
+                sizeof *dm[c]);
+            if (!dm[c]) {
+                for (int k = 0; k < c; k++)
+                    av_free(dm[k]);
+                return -ENOMEM;
+            }
+            for (int k = 0; k < lens[c]; k++)
+                dm[c][k] = (double)chs[c][k];
+            dmp[c] = dm[c];
+            if (lens[c] > nm)
+                nm = lens[c];
+        }
+        ac4_loud_integrated_mc(dmp, lens, 48000, &m, &nb, &ng);
+        mono = av_malloc((size_t)(nm > 0 ? nm : 1) *
+                      sizeof *mono);
+        if (!mono) {
+            for (int c = 0; c < 6; c++)
+                av_free(dm[c]);
+            return -ENOMEM;
+        }
+        for (int k = 0; k < nm; k++) {
+            long long s = 0;
+            for (int c = 0; c < 6; c++)
+                s += k < lens[c] ? chs[c][k] : 0;
+            mono[k] = (double)s / 6.0;
+        }
+        ac4_loud_flatness(mono, nm, mono, nm, 2048, &f, &tf);
+        av_free(mono);
+        for (int c = 0; c < 6; c++) {
+            for (int k = 0; k < lens[c]; k++)
+                if (ac4_enc_core_abs_sat(chs[c][k]) > peak)
+                    peak = ac4_enc_core_abs_sat(chs[c][k]);
+            av_free(dm[c]);
+        }
+    }
+    out->m_db = m;
+    out->f_flat = f;
+    out->tf_tone = tf;
+    out->in_peak = peak;
+    out->d_peak = 0.0;
+    out->has_d_peak = 0;
+    return 0;
+}
+
+static int
+measure_f(const double *const *chs, const int *lens, int nch,
+          ac4enc_measure_t *out)
+{
+    double m = 0, f = 0, tf = 0, peak = 0.0;
+    int nb = 0, ng = 0;
+    if (!chs || !lens || !out)
+        return -EINVAL;
+    if (nch != 2 && nch != 6)
+        return -EINVAL;
+    for (int c = 0; c < nch; c++)
+        if (!chs[c] || lens[c] < 0)
+            return -EINVAL;
+    if (nch == 2) {
+        ac4_loud_integrated(chs[0], lens[0], chs[1], lens[1],
+                        48000, &m, &nb, &ng);
+        ac4_loud_flatness(chs[0], lens[0], chs[1], lens[1], 2048,
+                      &f, &tf);
+        for (int k = 0; k < lens[0]; k++)
+            if (fabs(chs[0][k]) > peak)
+                peak = fabs(chs[0][k]);
+        for (int k = 0; k < lens[1]; k++)
+            if (fabs(chs[1][k]) > peak)
+                peak = fabs(chs[1][k]);
+    } else {
+        double *mono = NULL;
+        int nm = 0;
+        for (int c = 0; c < 6; c++)
+            if (lens[c] > nm)
+                nm = lens[c];
+        ac4_loud_integrated_mc(chs, lens, 48000, &m, &nb, &ng);
+        mono = av_malloc((size_t)(nm > 0 ? nm : 1) *
+                      sizeof *mono);
+        if (!mono)
+            return -ENOMEM;
+        for (int k = 0; k < nm; k++) {
+            double v6[6];
+            for (int c = 0; c < 6; c++)
+                v6[c] = k < lens[c] ? chs[c][k] : 0.0;
+            mono[k] = ac4_pycompat_sum(v6, 6) / 6.0;
+        }
+        ac4_loud_flatness(mono, nm, mono, nm, 2048, &f, &tf);
+        av_free(mono);
+        for (int c = 0; c < 6; c++)
+            for (int k = 0; k < lens[c]; k++)
+                if (fabs(chs[c][k]) > peak)
+                    peak = fabs(chs[c][k]);
+    }
+    out->m_db = m;
+    out->f_flat = f;
+    out->tf_tone = tf;
+    out->in_peak =
+        peak >= 2147483647.0 ? INT_MAX : (int)peak;
+    out->d_peak = peak;
+    out->has_d_peak = 1;
+    return 0;
+}
+
+int
+ac4enc_measure(const int *const *chs, const int *lens, int nch,
+               double *m_db, double *f_flat, double *tf_tone,
+               int *in_peak)
+{
+    ac4enc_measure_t full;
+    int rc;
+    if (!m_db || !f_flat || !tf_tone || !in_peak)
+        return -EINVAL;
+    rc = measure_i(chs, lens, nch, &full);
+    if (rc)
+        return rc;
+    *m_db = full.m_db;
+    *f_flat = full.f_flat;
+    *tf_tone = full.tf_tone;
+    *in_peak = full.in_peak;
+    return 0;
+}
+
+int
+ac4enc_measure_f(const double *const *chs, const int *lens,
+                 int nch, double *m_db, double *f_flat,
+                 double *tf_tone, int *in_peak)
+{
+    ac4enc_measure_t full;
+    int rc;
+    if (!m_db || !f_flat || !tf_tone || !in_peak)
+        return -EINVAL;
+    rc = measure_f(chs, lens, nch, &full);
+    if (rc)
+        return rc;
+    *m_db = full.m_db;
+    *f_flat = full.f_flat;
+    *tf_tone = full.tf_tone;
+    *in_peak = full.in_peak;
+    return 0;
+}
+
+int
+ac4enc_measure2(const int *const *chs, const int *lens, int nch,
+                ac4enc_measure_t *out)
+{
+    return measure_i(chs, lens, nch, out);
+}
+
+int
+ac4enc_measure2_f(const double *const *chs, const int *lens,
+                  int nch, ac4enc_measure_t *out)
+{
+    return measure_f(chs, lens, nch, out);
+}
+
+/* ---- bake gain + stamp (mirror the _m prologues exactly) ---- */
+
+static double
+stereo_gain(double m, double f, double tf, double target_db,
+            int has_bake, double bake_db)
+{
+    double gain;
+    if (has_bake)
+        gain = bake_db;
+    else if (isinf(m) && m < 0)
+        gain = 0.0;
+    else
+        gain = ac4_loud_bake_gain(m, f, tf, target_db);
+    return gain;
+}
+
+static double
+mc_gain(double m, double f, double tf, double target_db,
+        int has_bake, double bake_db, int *hits51)
+{
+    double gain;
+    int hits = tf < 0.6 && f > 0.5;
+    if (hits51)
+        *hits51 = hits;
+    if (has_bake)
+        gain = bake_db;
+    else if (isinf(m) && m < 0)
+        gain = 0.0;
+    else if (hits)
+        gain = AC4_ENC_CORE_T_HIT_51_DB -
+            (m > -23.0 ? m : -23.0) + (target_db + 24.0);
+    else
+        gain = target_db - m;
+    return gain;
+}
+
+/* bake_round twin (core uses a file-static; same op order). */
+static int
+lib_bake_round(double v, int *out)
+{
+    long long ll;
+    if (ac4_pycompat_round_half_even_ll(v, &ll))
+        return -1;
+    if (ll < -2147483647L - 1 || ll > 2147483647L)
+        return -1;
+    *out = (int)ll;
+    return 0;
+}
+
+/* Compose one stereo stamp (peak selects int/float twin). */
+static int
+stereo_stamp(double m, int in_peak, double d_peak,
+             int has_d_peak, int is_f, double f, double tf,
+             double target_db, const char *preset,
+             uint8_t *p6, uint8_t *i12, uint8_t *s4,
+             uint8_t *fr0, ac4_enc_core_stamp_t *stamp)
+{
+    double fpeak =
+        has_d_peak ? d_peak : (double)in_peak;
+    int sparse, c16, t16, pid, np6, ni12, nfr0;
+    int sby = ac4_pycompat_round_half_even(-4.0 * target_db);
+    sparse = tf < 0.6 && f > 0.5;
+    c16 = is_f ? ac4_enc_core_content16_f(m, fpeak, f, target_db)
+               : ac4_enc_core_content16(m, in_peak, f,
+                                    target_db);
+    t16 = ac4_enc_core_tail16(sparse, tf);
+    pid = ac4_enc_core_preset_id(preset ? preset : "manual");
+    if (pid < 0)
+        return -1;
+    np6 = ac4_enc_core_compose_sub0(0, sparse, sby, 0, NULL,
+                               pid, p6);
+    ni12 = ac4_enc_core_compose_sub0(
+        1, 0, sby, t16, AC4_ENC_CORE_I12_MID_TAIL, pid, i12);
+    nfr0 = ac4_enc_core_compose_sub0(1, sparse, sby, c16, NULL,
+                                pid, fr0);
+    /* S1: the sparse-iframe fr0 stamp is legitimately 11
+     * bytes (enc.py sparse branch); accept the actual length
+     * and store it (downstream splice is length-agnostic). */
+    if (np6 != 6 || ni12 != 12 ||
+        nfr0 != (sparse ? 11 : 12))
+        return -1;
+    memcpy(s4, AC4_ENC_CORE_SUB2_DEE, 4);
+    stamp->p6 = p6;
+    stamp->n_p6 = 6;
+    stamp->i12 = i12;
+    stamp->n_i12 = 12;
+    stamp->s4 = s4;
+    stamp->n_s4 = 4;
+    stamp->fr0 = fr0;
+    stamp->n_fr0 = nfr0;
+    return 0;
+}
+
+/* Compose one 5.1 stamp (peak selects int/float twin). */
+static int
+mc_stamp(double m, int in_peak, double d_peak,
+         int has_d_peak, int is_f, double f,
+         double target_db, const char *preset,
+         const int *dmx, uint8_t *p6, uint8_t *i15,
+         uint8_t *s4, uint8_t *fr0,
+         ac4_enc_core_stamp_t *stamp)
+{
+    double fpeak =
+        has_d_peak ? d_peak : (double)in_peak;
+    int peak = in_peak;
+    int sby, c16, pid, nfr0, ni15, np6;
+    sby = ac4_pycompat_round_half_even(-4.0 * target_db);
+    /* NOTE: the int _mc_m entry passes ms->in_peak to
+     * content16; the float twin passes the selected peak to
+     * content16_f. Mirrored per is_f. */
+    c16 = is_f ? ac4_enc_core_content16_f(m, fpeak, f, target_db)
+               : ac4_enc_core_content16(m, peak, f, target_db);
+    pid = ac4_enc_core_preset_id(preset ? preset : "manual");
+    if (pid < 0)
+        return -1;
+    nfr0 = ac4_enc_core_compose_sub0_51(sby, c16, NULL, pid,
+                                    dmx, fr0);
+    ni15 = ac4_enc_core_compose_sub0_51(
+        sby, AC4_ENC_CORE_TAIL16_DENSE, AC4_ENC_CORE_I12_MID_TAIL,
+        pid, dmx, i15);
+    np6 = ac4_enc_core_compose_sub0(0, 0, sby, 0, NULL, pid,
+                               p6);
+    if (nfr0 != 15 || ni15 != 15 || np6 != 6)
+        return -1;
+    memcpy(s4, AC4_ENC_CORE_SUB2_DEE, 4);
+    stamp->p6 = p6;
+    stamp->n_p6 = 6;
+    stamp->i12 = i15;
+    stamp->n_i12 = 15;
+    stamp->s4 = s4;
+    stamp->n_s4 = 4;
+    stamp->fr0 = fr0;
+    stamp->n_fr0 = 15;
+    return 0;
+}
+
+/* H6 pass-1: spec-lines estimate over the (possibly baked) L
+ * row. Stereo only (the mc core path takes no lines). */
+int
+ac4enc_spectral_lines(const double *L, int nL,
+                      const ac4enc_measure_t *m,
+                      double target_db, int has_bake,
+                      double bake_db, int *nlines,
+                      int lines[7])
+{
+    double freq;
+    if (!nlines || !lines || !m)
+        return -EINVAL;
+    if (!L || nL < 0)
+        return -EINVAL;
+    if (!(target_db == 0.0 ||
+          (-31.0 <= target_db && target_db <= -10.0)))
+        return -EINVAL;
+    if (has_bake != 0 && has_bake != 1)
+        return -EINVAL;
+    if (has_bake && isnan(bake_db))
+        return -EINVAL;
+    if (isnan(m->m_db) || isnan(m->f_flat) ||
+        isnan(m->tf_tone))
+        return -EINVAL;
+    if (target_db != 0.0) {
+        double gain = stereo_gain(m->m_db, m->f_flat,
+                                  m->tf_tone, target_db,
+                                  has_bake, bake_db);
+        double bake = pow(10.0, gain / 20.0);
+        double *baked = av_malloc(
+            (size_t)(nL > 0 ? nL : 1) * sizeof *baked);
+        if (!baked)
+            return -ENOMEM;
+        for (int k = 0; k < nL; k++) {
+            int bi;
+            if (lib_bake_round(L[k] * bake, &bi)) {
+                av_free(baked);
+                return -EIO;
+            }
+            baked[k] = (double)bi;
+        }
+        freq = ac4_mdct_estimate_freq(baked, nL, 50.0,
+                                  20000.0);
+        av_free(baked);
+    } else {
+        freq = ac4_mdct_estimate_freq(L, nL, 50.0, 20000.0);
+    }
+    *nlines = ac4_mdct_lines_for_freq(freq, 3, lines);
+    if (*nlines < 0) {
+        *nlines = 0;
+        return -EIO;
+    }
+    return 0;
+}
+
+/* ---- open ---- */
+
+static int
+rate_ok(int rate, int floor)
+{
+    int hit = 0;
+    if (rate < floor)
+        return 0;
+    for (size_t i = 0; i < sizeof kRates / sizeof kRates[0];
+         i++)
+        if (kRates[i] == rate)
+            hit = 1;
+    return hit;
+}
+
+static int
+is01(int v)
+{
+    return v == 0 || v == 1;
+}
+
+/* Fill prologue products; validates stamp composition
+ * (preset/dmx/peak ranges) eagerly at open. */
+static int
+prologue(ac4enc_ctx_t *c, const ac4enc_opts_t *opts)
+{
+    int baked;
+    c->do_bake = 0;
+    c->do_peak = 0;
+    c->bake_two = 0;
+    c->have_stamp = 0;
+    c->flat_file = 0;
+    for (int k = 0; k < 6; k++) {
+        c->b0[k] = 1.0;
+        c->b1[k] = 1.0;
+    }
+    if (!opts->has_measure)
+        return 0;
+    c->flat_file =
+        opts->f_flat > AC4_ENC_CORE_FLAT_F_THRESH ? 1 : 0;
+    baked = opts->target_db != 0.0;
+    if (!baked)
+        return 0;
+    c->do_bake = 1;
+    c->do_peak = 1;
+    if (c->nch == 2) {
+        double gain = stereo_gain(opts->m_db, opts->f_flat,
+                                  opts->tf_tone,
+                                  opts->target_db,
+                                  opts->has_bake,
+                                  opts->bake_db);
+        double bake = pow(10.0, gain / 20.0);
+        c->b0[0] = bake;
+        c->b0[1] = bake;
+        if (stereo_stamp(opts->m_db, opts->in_peak,
+                         opts->d_peak, opts->has_d_peak, 0,
+                         opts->f_flat, opts->tf_tone,
+                         opts->target_db, opts->preset,
+                         c->si_p6, c->si_i12, c->si_s4,
+                         c->si_fr0, &c->stamp_i))
+            return -1;
+        if (stereo_stamp(opts->m_db, opts->in_peak,
+                         opts->d_peak, opts->has_d_peak, 1,
+                         opts->f_flat, opts->tf_tone,
+                         opts->target_db, opts->preset,
+                         c->sf_p6, c->sf_i12, c->sf_s4,
+                         c->sf_fr0, &c->stamp_f))
+            return -1;
+    } else {
+        double gain;
+        double bake, lfe_bake;
+        int hits51 = 0;
+        gain = mc_gain(opts->m_db, opts->f_flat,
+                       opts->tf_tone, opts->target_db,
+                       opts->has_bake, opts->bake_db,
+                       &hits51);
+        bake = pow(10.0, gain / 20.0);
+        lfe_bake = hits51
+            ? pow(10.0, AC4_ENC_CORE_LFE_HITS_BAKE_DB / 20.0)
+            : bake;
+        for (int k = 0; k < 6; k++) {
+            double bc = k == 3 ? lfe_bake : bake;
+            c->b0[k] = bc;
+            c->b1[k] = pow(
+                10.0, AC4_ENC_CORE_LEG_COMP_51_DB[k] / 20.0);
+        }
+        c->bake_two = 1;
+        if (mc_stamp(opts->m_db, opts->in_peak,
+                     opts->d_peak, opts->has_d_peak, 0,
+                     opts->f_flat, opts->target_db,
+                     opts->preset, opts->dmx, c->si_p6,
+                     c->si_i12, c->si_s4, c->si_fr0,
+                     &c->stamp_i))
+            return -1;
+        if (mc_stamp(opts->m_db, opts->in_peak,
+                     opts->d_peak, opts->has_d_peak, 1,
+                     opts->f_flat, opts->target_db,
+                     opts->preset, opts->dmx, c->sf_p6,
+                     c->sf_i12, c->sf_s4, c->sf_fr0,
+                     &c->stamp_f))
+            return -1;
+    }
+    c->have_stamp = 1;
+    return 0;
+}
+
+static int
+open_engine(ac4enc_ctx_t *c)
+{
+    ac4_enc_step_cfg_t cfg;
+    memset(&cfg, 0, sizeof cfg);
+    cfg.nch = c->nch;
+    cfg.rate_kbps = c->rate_kbps;
+    cfg.layout = c->layout;
+    cfg.interval = c->interval;
+    cfg.window = c->window;
+    cfg.ns2_tone = c->ns2_tone;
+    cfg.shorts = c->shorts;
+    cfg.joint_shorts = c->joint_shorts;
+    cfg.forced = c->forced;
+    cfg.nforced = c->nforced;
+    cfg.drc = c->has_drc ? &c->drcbuf : NULL;
+    cfg.dmx = c->dmx;
+    cfg.priming = c->priming;
+    cfg.iframe_base = c->iframe_base;
+    cfg.iframe_total = c->iframe_total;
+    memcpy(cfg.bake0, c->b0, sizeof cfg.bake0);
+    memcpy(cfg.bake1, c->b1, sizeof cfg.bake1);
+    cfg.bake_two = c->bake_two;
+    cfg.do_bake = c->do_bake;
+    cfg.do_peak = c->do_peak;
+    cfg.stamp = NULL; /* per-domain, set at first feed */
+    cfg.flat_file = c->flat_file;
+    if (c->nch == 2 && c->has_spec_lines) {
+        cfg.nlines = c->n_spec_lines;
+        memcpy(cfg.lines, c->spec_lines,
+               sizeof cfg.lines);
+    }
+    return ac4_enc_step_open(&c->eng, &cfg);
+}
+
+int
+ac4enc_open(ac4enc_ctx_t **ctx, const ac4enc_opts_t *opts)
+{
+    ac4enc_ctx_t *c;
+    int nch, floor, rc;
+    if (!ctx || !opts || !opts->layout)
+        return -EINVAL;
+    if (!ac4enc_fp_ok())
+        return -EIO;
+    if (!strcmp(opts->layout, "stereo")) {
+        nch = 2;
+        floor = 48;
+    } else if (!strcmp(opts->layout, "5.1")) {
+        nch = 6;
+        floor = 96;
+    } else {
+        return -EINVAL;
+    }
+    if (!rate_ok(opts->rate_kbps, floor))
+        return -EINVAL;
+    if (!(opts->target_db == 0.0 ||
+          (-31.0 <= opts->target_db &&
+           opts->target_db <= -10.0)))
+        return -EINVAL;
+    if (!is01(opts->ns2_tone) || !is01(opts->shorts) ||
+        !is01(opts->joint_shorts) || !is01(opts->priming) ||
+        !is01(opts->has_bake) || !is01(opts->has_measure) ||
+        !is01(opts->has_d_peak) ||
+        !is01(opts->has_spec_lines))
+        return -EINVAL;
+    if (nch == 6 && (opts->joint_shorts || !opts->priming))
+        return -EINVAL;
+    if (opts->has_bake && isnan(opts->bake_db))
+        return -EINVAL;
+    if (opts->has_bake && !opts->has_measure)
+        return -EINVAL;
+    if (opts->nforced < 0 ||
+        (opts->nforced > 0 && !opts->forced))
+        return -EINVAL;
+    if (opts->preset &&
+        ac4_enc_core_preset_id(opts->preset) < 0)
+        return -EINVAL;
+    if (opts->drc && (opts->drc->nmodes < 1 ||
+                      !opts->drc->modes))
+        return -EINVAL;
+    if (opts->has_measure) {
+        if (isnan(opts->m_db) || isnan(opts->f_flat) ||
+            isnan(opts->tf_tone) || opts->in_peak < 0)
+            return -EINVAL;
+        if (opts->has_d_peak &&
+            (isnan(opts->d_peak) || opts->d_peak < 0.0))
+            return -EINVAL;
+    }
+    if (opts->sample_rate != 0 && opts->sample_rate != 48000)
+        return -EINVAL;
+    if (opts->has_spec_lines) {
+        if (opts->n_spec_lines < 0 ||
+            opts->n_spec_lines > 7)
+            return -EINVAL;
+        for (int k = 0; k < opts->n_spec_lines; k++)
+            if (opts->spec_lines[k] < 0 ||
+                opts->spec_lines[k] >= 2048)
+                return -EINVAL;
+    }
+    c = av_calloc(1, sizeof *c);
+    if (!c)
+        return -ENOMEM;
+    c->err_sub = AC4ENC_EOK;
+    c->err_stage = "-";
+    c->err_frame = -1;
+    c->layout = dup_str(opts->layout);
+    c->interval = dup_str(opts->interval);
+    c->preset = dup_str(opts->preset);
+    if (!c->layout ||
+        (opts->interval && !c->interval) ||
+        (opts->preset && !c->preset))
+        goto oom;
+    c->nch = nch;
+    c->rate_kbps = opts->rate_kbps;
+    c->nforced = opts->nforced;
+    if (opts->nforced > 0) {
+        c->forced = av_malloc((size_t)opts->nforced *
+                           sizeof *c->forced);
+        if (!c->forced)
+            goto oom;
+        memcpy(c->forced, opts->forced,
+               (size_t)opts->nforced * sizeof *c->forced);
+    }
+    if (opts->window) {
+        c->window = av_malloc(4096 * sizeof *c->window);
+        if (!c->window)
+            goto oom;
+        memcpy(c->window, opts->window,
+               4096 * sizeof *c->window);
+    }
+    c->ns2_tone = opts->ns2_tone;
+    c->shorts = opts->shorts;
+    c->joint_shorts = opts->joint_shorts;
+    c->priming = opts->priming;
+    c->iframe_base = opts->iframe_base;
+    c->iframe_total = opts->iframe_total;
+    c->target_db = opts->target_db;
+    c->has_bake = opts->has_bake;
+    c->bake_db = opts->bake_db;
+    if (opts->drc) {
+        /* Convert the public mirror (same layout, copied
+         * field-wise: no aliasing). */
+        c->modes = av_malloc((size_t)opts->drc->nmodes *
+                          sizeof *c->modes);
+        if (!c->modes)
+            goto oom;
+        for (int k = 0; k < opts->drc->nmodes; k++) {
+            c->modes[k].mid = opts->drc->modes[k].mid;
+            c->modes[k].kind = opts->drc->modes[k].kind;
+            c->modes[k].gain = opts->drc->modes[k].gain;
+            memcpy(&c->modes[k].curve,
+                   &opts->drc->modes[k].curve,
+                   sizeof c->modes[k].curve);
+        }
+        c->drcbuf.eac3 = opts->drc->eac3;
+        c->drcbuf.modes = c->modes;
+        c->drcbuf.nmodes = opts->drc->nmodes;
+        c->has_drc = 1;
+    }
+    if (opts->dmx) {
+        c->dmx = av_malloc(5 * sizeof *c->dmx);
+        if (!c->dmx)
+            goto oom;
+        memcpy(c->dmx, opts->dmx, 5 * sizeof *c->dmx);
+    }
+    c->sample_rate =
+        opts->sample_rate == 0 ? 48000 : opts->sample_rate;
+    c->has_measure = opts->has_measure;
+    if (opts->has_measure) {
+        c->ms.m_db = opts->m_db;
+        c->ms.f_flat = opts->f_flat;
+        c->ms.tf_tone = opts->tf_tone;
+        c->ms.in_peak = opts->in_peak;
+        c->ms.d_peak = opts->d_peak;
+        c->ms.has_d_peak = opts->has_d_peak;
+    }
+    c->has_spec_lines = opts->has_spec_lines;
+    c->n_spec_lines = opts->n_spec_lines;
+    memcpy(c->spec_lines, opts->spec_lines,
+           sizeof c->spec_lines);
+    if (prologue(c, opts)) {
+        /* Stamp-shape refusal (e.g. uncomposable loudness
+         * stamp): the config is valid but the core refuses
+         * the encode, so -EIO (fail-fast at open instead of
+         * late at flush). */
+        ac4enc_close(c);
+        return -EIO;
+    }
+    rc = open_engine(c);
+    if (rc) {
+        /* Engine open validates the interval rule + DRC
+         * contents: config errors, -EINVAL by shape. */
+        ac4enc_close(c);
+        return rc == -ENOMEM ? -ENOMEM : -EINVAL;
+    }
+    *ctx = c;
+    return 0;
+oom:
+    ac4enc_close(c);
+    return -ENOMEM;
+}
+
+void
+ac4enc_close(ac4enc_ctx_t *c)
+{
+    if (!c)
+        return;
+    ac4_enc_step_close(c->eng);
+    av_free(c->layout);
+    av_free(c->interval);
+    av_free(c->preset);
+    av_free(c->window);
+    av_free(c->forced);
+    av_free(c->modes);
+    av_free(c->dmx);
+    av_free(c);
+}
+
+int
+ac4enc_reset(ac4enc_ctx_t *c)
+{
+    int rc;
+    if (!c)
+        return -EINVAL;
+    ac4_enc_step_close(c->eng);
+    c->eng = NULL;
+    c->domain = 0;
+    c->fed_total = 0;
+    c->input_ended = 0;
+    c->enc_err = 0;
+    c->err_sub = AC4ENC_EOK;
+    c->err_stage = "-";
+    c->err_frame = -1;
+    c->err_detail[0] = '\0';
+    c->stamp_set = 0;
+    rc = open_engine(c);
+    if (rc) {
+        /* Degraded: same opts failed reopen (OOM). The ctx
+         * stays closed-able but unusable; record it. */
+        c->enc_err = rc;
+        c->err_sub = rc == -ENOMEM ? AC4ENC_ENOMEM
+                                   : AC4ENC_EBADOPT;
+        c->err_stage = "reset";
+        return rc;
+    }
+    return 0;
+}
+
+/* ---- feed / emit / flush ---- */
+
+/* Per-domain stamp select (int default, float twin on float
+ * input). No-feed streams keep the int default (v1 parity). */
+static int
+ensure_stamp(ac4enc_ctx_t *c, const char *stage)
+{
+    const ac4_enc_core_stamp_t *st;
+    int rc;
+    if (c->stamp_set || !c->have_stamp)
+        return 0;
+    st = c->domain == 2 ? &c->stamp_f : &c->stamp_i;
+    rc = ac4_enc_step_set_stamp(c->eng, st);
+    if (rc)
+        return from_engine(c, stage, rc);
+    c->stamp_set = 1;
+    return 0;
+}
+
+/* Serve one ready frame (out_len required). Not ready -> 0.
+ * Short buffer -> *out_len = needed, -EINVAL, nothing lost
+ * (the frame stays pending for a roomy retry). */
+static int
+serve(ac4enc_ctx_t *c, const char *stage, uint8_t *out,
+      size_t outcap, size_t *out_len, int *is_iframe)
+{
+    size_t olen = 0;
+    int is_if = 0, rc, need;
+    *out_len = 0;
+    if (ac4_enc_step_ready(c->eng) != 1)
+        return 0;
+    need = ac4_enc_step_next_size(c->eng);
+    if (need < 0)
+        return record(c, AC4ENC_EENCODE, stage,
+                      ac4_enc_step_emitted(c->eng), -EIO);
+    if (!out || (size_t)need > outcap) {
+        *out_len = (size_t)need;
+        return record(c, AC4ENC_ESHORTBUF, stage,
+                      ac4_enc_step_emitted(c->eng), -EINVAL);
+    }
+    rc = ac4_enc_step_emit(c->eng, out, outcap, &olen, &is_if);
+    if (rc != 1)
+        return from_engine(c, stage, rc);
+    *out_len = olen;
+    if (is_iframe)
+        *is_iframe = is_if;
+    return 1;
+}
+
+/* Shared feed core. Pre-checks the emit buffer BEFORE feeding
+ * (a short buffer consumes no input); serves at most one frame
+ * per call, so undrained frames never accumulate past one. */
+static int
+feed2(ac4enc_ctx_t *c, const char *stage, int domain,
+      const int *const *pi, const double *const *pf, int n,
+      int is_tail, uint8_t *out, size_t outcap,
+      size_t *out_len, int *is_iframe)
+{
+    int ns[6], rc, will_emit;
+    if (!c || !out_len)
+        return -EINVAL;
+    *out_len = 0;
+    if (c->enc_err)
+        return c->enc_err;
+    if (!c->eng)
+        return record(c, AC4ENC_ENOMEM, stage, -1,
+                      -ENOMEM);
+    if (c->input_ended)
+        return record(c, AC4ENC_EBADCALL, stage, -1,
+                      -EINVAL);
+    if (n <= 0 || n > AC4ENC_FRAME_SAMPLES)
+        return record(c, AC4ENC_EBADCALL, stage, -1,
+                      -EINVAL);
+    if ((!pi && !pf) || (pi && pf))
+        return record(c, AC4ENC_EBADCALL, stage, -1,
+                      -EINVAL);
+    for (int ch = 0; ch < c->nch; ch++) {
+        if ((domain == 1 && !pi[ch]) ||
+            (domain == 2 && !pf[ch]))
+            return record(c, AC4ENC_EBADCALL, stage, -1,
+                          -EINVAL);
+        ns[ch] = n;
+    }
+    if (c->domain == 0) {
+        c->domain = domain;
+    } else if (c->domain != domain) {
+        return record(c, AC4ENC_EBADCALL, stage, -1,
+                      -EINVAL);
+    }
+    if (is_tail) {
+        /* Tail ends input: frame #emitted is forthcoming
+         * iff it precedes the now-known plan. Totals are
+         * 64-bit (m2); the int plan saturates (only the
+         * < comparison below consumes it). */
+        long long total = c->fed_total + n;
+        int plan;
+        if (c->nch == 6 || c->priming) {
+            int tin = total > INT_MAX ? INT_MAX : (int)total;
+            plan = ac4_enc_core_nframes_for_samples(tin);
+        } else if (total <= 0) {
+            plan = 0;
+        } else {
+            long long p = (total + AC4ENC_FRAME_SAMPLES - 1) /
+                AC4ENC_FRAME_SAMPLES;
+            plan = p > INT_MAX ? INT_MAX : (int)p;
+        }
+        will_emit = ac4_enc_step_emitted(c->eng) < plan;
+    } else {
+        will_emit = ac4_enc_step_ready(c->eng) == 1 ||
+            ac4_enc_step_ready_after(c->eng, n);
+    }
+    if (will_emit) {
+        int need = ac4_enc_step_next_size(c->eng);
+        if (need < 0)
+            return record(c, AC4ENC_EENCODE, stage, -1,
+                          -EIO);
+        if (!out || (size_t)need > outcap) {
+            *out_len = (size_t)need;
+            return record(c, AC4ENC_ESHORTBUF, stage,
+                          ac4_enc_step_emitted(c->eng),
+                          -EINVAL);
+        }
+    }
+    rc = domain == 1 ? ac4_enc_step_feed_int(c->eng, pi, ns)
+                     : ac4_enc_step_feed(c->eng, pf, ns);
+    if (rc)
+        return from_engine(c, stage, rc);
+    c->fed_total += n;
+    rc = ensure_stamp(c, stage);
+    if (rc)
+        return rc;
+    if (is_tail) {
+        c->input_ended = 1;
+        rc = ac4_enc_step_end(c->eng);
+        if (rc)
+            return from_engine(c, stage, rc);
+    }
+    return serve(c, stage, out, outcap, out_len,
+                 is_iframe);
+}
+
+int
+ac4enc_encode_frame2(ac4enc_ctx_t *c,
+                     const int *const *pcm, uint8_t *out,
+                     size_t outcap, size_t *out_len,
+                     int *is_iframe)
+{
+    if (!c || !pcm)
+        return -EINVAL;
+    return feed2(c, "feed", 1, pcm, NULL,
+                 AC4ENC_FRAME_SAMPLES, 0, out, outcap,
+                 out_len, is_iframe);
+}
+
+int
+ac4enc_encode_frame_f2(ac4enc_ctx_t *c,
+                       const double *const *pcm,
+                       uint8_t *out, size_t outcap,
+                       size_t *out_len, int *is_iframe)
+{
+    if (!c || !pcm)
+        return -EINVAL;
+    return feed2(c, "feed", 2, NULL, pcm,
+                 AC4ENC_FRAME_SAMPLES, 0, out, outcap,
+                 out_len, is_iframe);
+}
+
+int
+ac4enc_encode_frame(ac4enc_ctx_t *c,
+                    const int *const *pcm, uint8_t *out,
+                    size_t outcap, int *is_iframe)
+{
+    size_t olen = 0;
+    if (!c || !pcm)
+        return -EINVAL;
+    return feed2(c, "feed", 1, pcm, NULL,
+                 AC4ENC_FRAME_SAMPLES, 0, out, outcap,
+                 &olen, is_iframe);
+}
+
+int
+ac4enc_encode_frame_f(ac4enc_ctx_t *c,
+                      const double *const *pcm, uint8_t *out,
+                      size_t outcap, int *is_iframe)
+{
+    size_t olen = 0;
+    if (!c || !pcm)
+        return -EINVAL;
+    return feed2(c, "feed", 2, NULL, pcm,
+                 AC4ENC_FRAME_SAMPLES, 0, out, outcap,
+                 &olen, is_iframe);
+}
+
+int
+ac4enc_encode_tail2(ac4enc_ctx_t *c,
+                    const int *const *pcm, int n_valid,
+                    uint8_t *out, size_t outcap,
+                    size_t *out_len, int *is_iframe)
+{
+    if (!c || !pcm)
+        return -EINVAL;
+    return feed2(c, "tail", 1, pcm, NULL, n_valid, 1, out,
+                 outcap, out_len, is_iframe);
+}
+
+int
+ac4enc_encode_tail_f2(ac4enc_ctx_t *c,
+                      const double *const *pcm, int n_valid,
+                      uint8_t *out, size_t outcap,
+                      size_t *out_len, int *is_iframe)
+{
+    if (!c || !pcm)
+        return -EINVAL;
+    return feed2(c, "tail", 2, NULL, pcm, n_valid, 1, out,
+                 outcap, out_len, is_iframe);
+}
+
+int
+ac4enc_encode_tail(ac4enc_ctx_t *c,
+                   const int *const *pcm, int n_valid,
+                   uint8_t *out, size_t outcap,
+                   int *is_iframe)
+{
+    size_t olen = 0;
+    if (!c || !pcm)
+        return -EINVAL;
+    return feed2(c, "tail", 1, pcm, NULL, n_valid, 1, out,
+                 outcap, &olen, is_iframe);
+}
+
+int
+ac4enc_encode_tail_f(ac4enc_ctx_t *c,
+                     const double *const *pcm, int n_valid,
+                     uint8_t *out, size_t outcap,
+                     int *is_iframe)
+{
+    size_t olen = 0;
+    if (!c || !pcm)
+        return -EINVAL;
+    return feed2(c, "tail", 2, NULL, pcm, n_valid, 1, out,
+                 outcap, &olen, is_iframe);
+}
+
+int
+ac4enc_flush2(ac4enc_ctx_t *c, uint8_t *out, size_t outcap,
+              size_t *out_len, int *is_iframe)
+{
+    int rc;
+    if (!c || !out || !out_len)
+        return -EINVAL;
+    *out_len = 0;
+    if (c->enc_err)
+        return c->enc_err;
+    if (!c->eng)
+        return record(c, AC4ENC_ENOMEM, "flush", -1,
+                      -ENOMEM);
+    if (!c->input_ended) {
+        c->input_ended = 1;
+        rc = ensure_stamp(c, "flush");
+        if (rc)
+            return rc;
+        rc = ac4_enc_step_end(c->eng);
+        if (rc)
+            return from_engine(c, "flush", rc);
+    }
+    return serve(c, "flush", out, outcap, out_len,
+                 is_iframe);
+}
diff --git a/libavcodec/ac4enc_lib.h b/libavcodec/ac4enc_lib.h
new file mode 100644
index 0000000..a503a1c
--- /dev/null
+++ b/libavcodec/ac4enc_lib.h
@@ -0,0 +1,357 @@
+/*
+ * Opaque-ctx incremental encoder API
+ * Copyright (c) 2026 Michael Rowlinson
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+/* ac4enc_lib.h: opaque-ctx incremental API over the AC-4 core.
+ *
+ * Design source: ENC-LIBDESIGN.md sec 1. r2 is the incremental
+ * ctx the design calls for: feed 2048-sample frames, pull bare
+ * raw AC-4 frames (TOC..pad, NO sync/size/trailer) with 1-frame
+ * lookahead (2 for priming=0 joint mode), drain the tail at
+ * flush. Memory is bounded (window + scratch, ~1MB worst case);
+ * open-ended streams are NOT bounded by RAM. No whole-stream
+ * run exists anywhere in the lib path.
+ *
+ * Packet contract (normative): each emitted packet is exactly
+ * the bytes `assemble_raw` returns for that frame index,
+ * byte-identical to the corresponding raw payload inside CLI
+ * .ac4 output when opts+measure (+spec lines) match, in
+ * measured mode. Muxer adds sync+size (+CRC).
+ *
+ * H1 (loudness two-pass) is REAL, not buffered away: the
+ * stamp+bake path is driven by the CALLER's pass-1 measure
+ * (opts.has_measure via ac4enc_measure2[_f]). Without a measure
+ * the lib uses the NEUTRAL path (no stamp, no bake,
+ * flat_file=0, default spec lines) and documents the
+ * byte-divergence (README.md). No silent default pretends CLI
+ * parity. H6 (spec lines) likewise needs pass 1:
+ * ac4enc_spectral_lines over the full input; measured stereo
+ * without caller lines uses the neutral default (documented).
+ *
+ * Thread-safety (H7): RESOLVED. The ctx owns all state and the
+ * engine keeps zero shared mutable state, so concurrent encodes
+ * on SEPARATE ctx objects are safe. One ctx is still
+ * single-threaded (no internal locking).
+ *
+ * Error model (H8): 0 ok / 1 frame ready / -EINVAL bad arg or
+ * config or short buffer / -ENOMEM / -EIO encode refusal or
+ * internal failure. No other negatives are returned.
+ * ac4enc_strerror names the code; ac4enc_err_sub/_stage/_frame/
+ * _detail report the sticky last-error detail (subcode + stage
+ * + frame + gate/values text for bake refusals). Short-buffer
+ * -EINVAL sets the required size through
+ * the out_len param (2-variants + flush2) and consumes no
+ * input; the call is retryable with room. After -EIO,
+ * ac4enc_err_detail() carries the ctx-carried diagnostic,
+ * if any, for the refusing call.
+ *
+ * Rate contract (M3): 48 kHz ONLY. opts.sample_rate accepts 0
+ * (legacy default = 48000) or 48000; anything else fails open
+ * with -EINVAL. Feeding other rates is not quietly mistreated:
+ * it is refused up front.
+ *
+ * Lifecycle: one stream per ctx. encode frames, optional
+ * encode_tail for a final partial 1..2048 samples, then flush
+ * to drain. After a tail call or the first flush, only flush
+ * (then close) may follow; ac4enc_reset reuses the ctx (same
+ * opts) for a new stream. After an error (-EIO/-ENOMEM) the
+ * ctx is sticky-failed: calls keep returning the error until
+ * reset or close.
+ *
+ * This header is self-contained and exposes NO core internals
+ * (M4): it does not include ac4_enc_core.h. In-tree core consumers
+ * (tests, equivalence probes) include ac4_enc_core.h directly.
+ */
+#ifndef AC4ENC_LIB_H
+#define AC4ENC_LIB_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+/* M5 compile-time guard: these modes silently break bit-parity
+ * (constant folding, contraction, isinf removal). Downstream
+ * builds must use the flags contract (README.md) instead. */
+#if defined(__FAST_MATH__) || \
+    (defined(__FINITE_MATH_ONLY__) && __FINITE_MATH_ONLY__ + 0)
+#error "ac4enc: -ffast-math/-ffinite-math-only break bit-parity"
+#endif
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define AC4ENC_FRAME_SAMPLES 2048
+#define AC4ENC_OUTCAP_SAFE 65536
+
+typedef struct ac4enc_ctx ac4enc_ctx_t;
+
+/* Full pass-1 measure. m_db/f_flat/tf_tone feed the bake gain
+ * and stamp; in_peak feeds content16 (int path); d_peak feeds
+ * content16_f (float path) when has_d_peak is set, else the
+ * float path falls back to (double)in_peak. */
+typedef struct {
+    double m_db;
+    double f_flat;
+    double tf_tone;
+    int in_peak;
+    double d_peak;
+    int has_d_peak;
+} ac4enc_measure_t;
+
+/* Public DRC option mirror (layout-identical to the core
+ * types; the lib converts at open, so the core header stays
+ * private). Contents are validated at open (dry-run through
+ * the real metadata writer): nmodes>=1 required when drc is
+ * present, mid/kind/eac3/gain/curve ranges enforced. */
+typedef struct {
+    int nb_lo;
+    int nb_hi;
+    int maxboost;
+    int lev_b;
+    int nr_b;
+    int g_b;
+    int l_b;
+    int maxcut;
+    int lev_c;
+    int nr_c;
+    int g_c;
+    int l_c;
+    int tcdef;
+    int tc[4];
+    int has_thr;
+    int thr0;
+    int thr1;
+} ac4enc_drc_curve_t;
+
+#define AC4ENC_DRC_DEFAULT 0
+#define AC4ENC_DRC_GAINS 1
+#define AC4ENC_DRC_CURVE 2
+
+typedef struct {
+    int mid;
+    int kind;
+    int gain;
+    ac4enc_drc_curve_t curve;
+} ac4enc_drc_mode_t;
+
+typedef struct {
+    int eac3;
+    const ac4enc_drc_mode_t *modes;
+    int nmodes;
+} ac4enc_drc_t;
+
+/* All whole-stream options. Strings/arrays are copied at open. */
+typedef struct {
+    const char *layout; /* "stereo" | "5.1" (only) */
+    int rate_kbps; /* DATA_RATES steps, layout floor */
+    const char *interval; /* iframe rule: NULL/"1sec"/decimal
+                                 * 2..LLONG_MAX-1 (huge/saturating
+                                 * rejected: 1+step must not ovf) */
+    const int *forced;
+    int nforced; /* forced iframe indices (CORE indices: the
+                  * CLI's csvfile user index shifted +1) */
+    const char *preset; /* NULL=manual stamp path */
+    const double *window; /* NULL=KBD4096 default, else 4096 */
+    int ns2_tone; /* 0/1 */
+    int shorts; /* 0/1 */
+    int joint_shorts; /* 0/1; stereo only */
+    int priming; /* stereo: 1 priming (coff 0) | 0 joint (coff 2).
+                  * 5.1: must be 1 (joint is stereo-only). */
+    int iframe_base; /* joint mode global base (any int) */
+    int iframe_total; /* joint mode: >=0 explicit total cap,
+                       * <0 open-ended (exact for base==0) */
+    double target_db; /* 0.0 or -31..-10 */
+    int has_bake; /* 0/1; requires has_measure */
+    double bake_db; /* explicit gain dB (finite, not NaN) */
+    const ac4enc_drc_t *drc; /* NULL or validated modes */
+    const int *dmx; /* NULL or 5 ints (range-free: bit-packed) */
+    int sample_rate; /* 0 (=48000) or 48000; else -EINVAL */
+    /* Pass-1 measurement (H1). All-or-nothing: */
+    int has_measure;
+    double m_db; /* not NaN */
+    double f_flat; /* not NaN */
+    double tf_tone; /* not NaN */
+    int in_peak; /* >= 0 */
+    double d_peak; /* >= 0, not NaN when has_d_peak */
+    int has_d_peak;
+    /* Pass-1 spec lines (H6, stereo only; mc ignores). Without
+     * these, measured stereo uses the neutral default
+     * (nlines=0: fullband-only LONG path), which is
+     * byte-divergent from the CLI on tonal content. */
+    int has_spec_lines; /* 0/1 */
+    int n_spec_lines; /* 0..7 */
+    int spec_lines[7]; /* each 0..2047 */
+} ac4enc_opts_t;
+
+/* Sticky last-error detail (post-open calls only; open reports
+ * the rc alone). */
+typedef enum {
+    AC4ENC_EOK = 0,
+    AC4ENC_EBADCALL, /* protocol misuse (domain mix, feed after
+                      * tail/flush, emit without input...) */
+    AC4ENC_EBADOPT, /* rejected option value (open-time) */
+    AC4ENC_ENOMEM, /* allocation failure */
+    AC4ENC_EBAKE_OVERFLOW, /* bake_round overflow (refusal) */
+    AC4ENC_EBAKE_PEAK, /* baked peak >= 32767 at end (refusal) */
+    AC4ENC_EENCODE, /* per-frame encode refusal / internal */
+    AC4ENC_ESHORTBUF, /* outcap < frame (out_len = needed) */
+    AC4ENC_EFPENV /* unsafe FP environment (open-time) */
+} ac4enc_subcode_t;
+
+/* 0 ok / -EINVAL bad opts / -ENOMEM / -EIO fpenv or core
+ * refusal (e.g. uncomposable stamp: fail-fast at open).
+ * Copies opts content; validates everything (interval rule,
+ * DRC dry-run, measure/line ranges, rate). */
+int ac4enc_open(ac4enc_ctx_t **ctx, const ac4enc_opts_t *opts);
+
+/* Feed exactly 2048 samples per ch (ch-major, same scale as
+ * ac4_enc_core_encode_pcm). Returns 1 frame ready (bare frame in
+ * out) / 0 need-more-input / <0 error. If the call makes a
+ * frame ready, out must be non-NULL with outcap >= the packet
+ * size (see ac4enc_max_packet); otherwise -EINVAL WITHOUT
+ * consuming input (retry with room). Non-emitting calls ignore
+ * out/outcap. At most one frame per call; undrained ready
+ * frames never accumulate past one. */
+int ac4enc_encode_frame(ac4enc_ctx_t *c,
+                        const int *const *pcm /* nch x 2048 */,
+                        uint8_t *out, size_t outcap,
+                        int *is_iframe /* NULL ok */);
+
+/* Float twin: double rows, same contract as _f entries. */
+int ac4enc_encode_frame_f(ac4enc_ctx_t *c,
+                          const double *const *pcm,
+                          uint8_t *out, size_t outcap,
+                          int *is_iframe);
+
+/* Length-reporting twins (preferred): *out_len always set on
+ * 1, and to the needed size on short-buffer -EINVAL. */
+int ac4enc_encode_frame2(ac4enc_ctx_t *c,
+                         const int *const *pcm,
+                         uint8_t *out, size_t outcap,
+                         size_t *out_len /* required */,
+                         int *is_iframe);
+int ac4enc_encode_frame_f2(ac4enc_ctx_t *c,
+                           const double *const *pcm,
+                           uint8_t *out, size_t outcap,
+                           size_t *out_len /* required */,
+                           int *is_iframe);
+
+/* Tail call: feed the final 0 < n_valid <= 2048 samples per
+ * ch. Ends input (runs the baked-peak check); after a tail
+ * call only flush may follow. Same 1/0/<0 contract. */
+int ac4enc_encode_tail(ac4enc_ctx_t *c,
+                       const int *const *pcm /* nch x n_valid */,
+                       int n_valid, uint8_t *out,
+                       size_t outcap, int *is_iframe);
+int ac4enc_encode_tail_f(ac4enc_ctx_t *c,
+                         const double *const *pcm,
+                         int n_valid, uint8_t *out,
+                         size_t outcap, int *is_iframe);
+int ac4enc_encode_tail2(ac4enc_ctx_t *c,
+                        const int *const *pcm,
+                        int n_valid, uint8_t *out,
+                        size_t outcap,
+                        size_t *out_len /* required */,
+                        int *is_iframe);
+int ac4enc_encode_tail_f2(ac4enc_ctx_t *c,
+                          const double *const *pcm,
+                          int n_valid, uint8_t *out,
+                          size_t outcap,
+                          size_t *out_len /* required */,
+                          int *is_iframe);
+
+/* Drain encoded frames. 1 = bare frame in out (with
+ * *out_len set), 0 = done, <0 error. The first call ends
+ * input (no-feed streams encode the priming plan: 2 frames
+ * at fed 0, m9) and runs the baked-peak check. Short-buffer
+ * -EINVAL sets *out_len to the needed size. */
+int ac4enc_flush2(ac4enc_ctx_t *c, uint8_t *out,
+                  size_t outcap, size_t *out_len /* required */,
+                  int *is_iframe);
+void ac4enc_close(ac4enc_ctx_t *c); /* NULL-safe */
+
+/* Reuse the ctx (same opts) for a new stream: clears fed
+ * input, emitted frames, end/error state. 0 ok / -EINVAL NULL
+ * / -ENOMEM reopen failure (ctx stays closed-able). */
+int ac4enc_reset(ac4enc_ctx_t *c);
+
+/* Name an rc (0/1/-EINVAL/-ENOMEM/-EIO, else "unknown"). */
+const char *ac4enc_strerror(int rc);
+/* Name a subcode (else "unknown"). */
+const char *ac4enc_subcode_str(ac4enc_subcode_t sub);
+/* Sticky last-error detail. Stage is one of "-"/"feed"/
+ * "tail"/"flush"/"reset". Frame is the emit index or -1. */
+ac4enc_subcode_t ac4enc_err_sub(const ac4enc_ctx_t *c);
+const char *ac4enc_err_stage(const ac4enc_ctx_t *c);
+int ac4enc_err_frame(const ac4enc_ctx_t *c);
+/* R3 loud refusal: gate + offending values for the bake
+ * subcodes ("baked peak gate: ...", "bake_round gate: ..."),
+ * else "". Never NULL (NULL ctx -> ""). Follows err_sub. */
+const char *ac4enc_err_detail(const ac4enc_ctx_t *c);
+
+/* 64-bit stream totals (m2): samples fed per ch (all feeds)
+ * and bare frames emitted. int64 never wraps in practice
+ * (the old int total overflowed past ~12h at 48 kHz).
+ * -1 on NULL. Reset clears both. */
+int64_t ac4enc_fed_samples(const ac4enc_ctx_t *c);
+int64_t ac4enc_emitted_frames(const ac4enc_ctx_t *c);
+
+/* Max bare-frame bytes for a rate (exact CBR period max), or
+ * -EINVAL on bad rate. Buffers of this size never go short. */
+int ac4enc_max_packet(int rate_kbps);
+
+/* 1 iff the FP environment is contraction-free (M5 runtime
+ * self-check). ac4enc_open refuses (-EIO) when this is 0. */
+int ac4enc_fp_ok(void);
+
+/* Pass-1 helpers for H1: whole-input measure, feeds opts.
+ * nch 2 = stereo ops, 6 = 5.1 ops (integrated_mc + mono6
+ * flatness + 6ch peak scan, same op order as the core).
+ * Inputs are 48 kHz by contract (M3). */
+int ac4enc_measure(const int *const *chs, const int *lens, int nch,
+                   double *m_db, double *f_flat, double *tf_tone,
+                   int *in_peak);
+int ac4enc_measure_f(const double *const *chs, const int *lens,
+                     int nch, double *m_db, double *f_flat,
+                     double *tf_tone, int *in_peak);
+/* Full-struct twins (preferred; carry d_peak for the float
+ * path without loss). */
+int ac4enc_measure2(const int *const *chs, const int *lens,
+                    int nch, ac4enc_measure_t *out);
+int ac4enc_measure2_f(const double *const *chs, const int *lens,
+                      int nch, ac4enc_measure_t *out);
+
+/* H6 pass-1: spec-lines estimate over the L row (baked when
+ * target_db != 0, mirroring the core prologue). Stereo only
+ * (mc ignores lines). Int callers convert L exactly to
+ * double. Feeds opts.has_spec_lines/n_spec_lines/spec_lines.
+ * -EIO if the bake itself overflows (the encode would refuse
+ * too: consistent). */
+int ac4enc_spectral_lines(const double *L, int nL,
+                          const ac4enc_measure_t *m,
+                          double target_db, int has_bake,
+                          double bake_db, int *nlines,
+                          int lines[7]);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
\ No newline at end of file
