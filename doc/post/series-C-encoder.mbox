@@ -0,0 +1,604 @@
+/*
+ * Encoder core: frame assembly, rate loops, TOC
+ * Copyright (c) 2026 Michael Rowlinson
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+/* ac4_enc_core.h: encoder core -- frame assembly, rate loops, TOC.
+ *
+ * Frame assembly lives in src/ac4_enc_core_enc.c, steady-LONG
+ * 5.1 packing in src/ac4_enc_core_long51.c, the mode-3 CBR rate
+ * loop in src/ac4_enc_core_fit51.c; all share this header.
+ *
+ * Reuses the shared deps (bits/asf/mdct/loudness/enc_mc3/enc_jshort/
+ * enc_tail59/enc_acpl/pycompat/ac4_sfb_offsets); nothing is re-ported.
+ * Float discipline: builtin sum() of floats is ac4_pycompat_sum
+ * (Neumaier), round() is ac4_pycompat_round_half_even, x**y is libm
+ * pow() (kept a real call via -fno-builtin-pow: GCC would fold
+ * pow(2.0,x)->exp2 etc., breaking bit-parity with CPython).
+ * The _f entry points take float (post-fold) PCM doubles and are
+ * bit-exact vs Python on fractional inputs (same op order incl
+ * Neumaier nesting); the int-only entries are unchanged.
+ *
+ * Python dicts become fixed-size structs (coeffs sorted ascending;
+ * refs_by_band carries -1 for absent keys). Python None returns on
+ * the Optional-bytes entry points (encode, fit, assemble, fit_frame)
+ * share the -1 channel with assert-class failures (never abort;
+ * writer/buffers untouched on -1).
+ */
+#ifndef AC4_ENC_CORE_H
+#define AC4_ENC_CORE_H
+
+#include <limits.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include "ac4_bits.h"
+#include "ac4_enc_mc3.h"
+
+/* m1: INT_MIN-safe int magnitude (abs(INT_MIN) is UB).
+ * Saturates to INT_MAX; identical to abs() on every other
+ * input. All PCM/baked peak scans use this. */
+static inline int
+ac4_enc_core_abs_sat(int v)
+{
+    long long lv = v;
+    long long a = lv < 0 ? -lv : lv;
+    return a > INT_MAX ? INT_MAX : (int)a;
+}
+
+#define AC4_ENC_CORE_SYNC 0xAC41
+#define AC4_ENC_CORE_FRAME_SAMPLES 2048
+#define AC4_ENC_CORE_SAMPLE_RATE 48000
+#define AC4_ENC_CORE_DIG_GAIN 3.0
+/* S5FU: stereo spectral gain is 2.0, not 3.0. DEE stages
+ * stereo coefficients at x2.0 of the forward correlation
+ * (offset-+2 aligned pre-IMDCT CODUMP peak pairing:
+ * DEE/forward = 1.9995 on G7 997Hz, residual -0.002 dB;
+ * the figure is alignment-sensitive: unaligned aggregates
+ * understate it) while 5.1 stages at x3.0 (G5 spectral
+ * ratio ours/DEE = 0.99). The uniform 3.0 decoded
+ * every stereo file exactly 3/2 (+3.52 dB) hot on all
+ * correct decoders (DRP G7 = -30.17, ours = -26.56, same
+ * dialnorm). Multichannel keeps AC4_ENC_CORE_DIG_GAIN. */
+#define AC4_ENC_CORE_DIG_GAIN_STEREO 2.0
+#define AC4_ENC_CORE_X_EMIT_MAX 80000000.0
+#define AC4_ENC_CORE_DEE_SUB0_P 6
+#define AC4_ENC_CORE_DEE_SUB0_I 10
+#define AC4_ENC_CORE_DEE_SUB2_I 4
+#define AC4_ENC_CORE_MAX_SFB_FULL 63
+#define AC4_ENC_CORE_MAX_SFB_LFE 7
+#define AC4_ENC_CORE_TL_1024 3
+#define AC4_ENC_CORE_TL_128 0
+#define AC4_ENC_CORE_MSFB_MIX_1024 33
+#define AC4_ENC_CORE_MSFB_MIX_128 9
+#define AC4_ENC_CORE_MIX_GROUPING 0
+#define AC4_ENC_CORE_DIALNORM_BITS 0
+#define AC4_ENC_CORE_FLOOR_FRAC 1e-3
+#define AC4_ENC_CORE_FLAT_F_THRESH 0.3
+#define AC4_ENC_CORE_PURE_RATIO 1e-4
+#define AC4_ENC_CORE_SHIFT_STEP 4
+#define AC4_ENC_CORE_SHIFT_MAX 120
+#define AC4_ENC_CORE_MIX_HF_LO 64
+#define AC4_ENC_CORE_MIX_HF_RATIO 32.0
+#define AC4_ENC_CORE_M_UNGATED_FLOOR -120.0
+#define AC4_ENC_CORE_T_HIT_51_DB -17.2
+#define AC4_ENC_CORE_LFE_HITS_BAKE_DB -8.8
+#define AC4_ENC_CORE_TAIL16_DENSE 0xc400
+#define AC4_ENC_CORE_TAIL16_GATED 0xc440
+#define AC4_ENC_CORE_TAIL16_DIRAC 0xa140
+#define AC4_ENC_CORE_TAIL16_IMPULSE 0xb040
+#define AC4_ENC_CORE_N_MIX_SHORT 8
+#define AC4_ENC_CORE_N_MIX_TILE128 16
+
+/* Orient codes for the (3,0)/(0,3) mixed pair. */
+#define AC4_ENC_CORE_ORIENT_LONG 0
