+const uint8_t AC4_ENC_CORE_I11_TAIL[5] = { 0xf2, 0xc2, 0x54, 0xb5, 0x00 };
+const uint8_t AC4_ENC_CORE_SUB2_DEE[4] = { 0xa0, 0x40, 0x40, 0x00 };
+const uint8_t AC4_ENC_CORE_I15_TAIL51[3] = { 0xc9, 0x90, 0x80 };
