+ * Only the .c file needs lavc headers; this header is standalone.
+ * Adopted by the native AC-4 encoder wrapper (ac4enc.c), which emits
+ * this payload as codec extradata.
+ */
+#ifndef AC4DSI_PUTBITS_H
+#define AC4DSI_PUTBITS_H
+
+#include "ac4dsi.h"
+
+/**
+ * Serialize one ac4_dsi_v1 payload with PutBitContext emission.
+ *
+ * Parameters, return codes, and failure semantics follow the
+ * parent-lib oracle contract (EINVAL leaves out and *out_len
+ * untouched, ENOSPC leaves the zero-padded partial payload and
+ * reports the full need). Output is byte-identical to the oracle for
+ * every input, including short-buffer partials.
+ */
+int ac4dsi_serialize_putbits(const ac4dsi_stream_t *s,
+                             const ac4dsi_pres_t *pres, size_t n_pres,
+                             uint8_t *out, size_t out_cap, size_t *out_len);
+
+#endif /* AC4DSI_PUTBITS_H */
