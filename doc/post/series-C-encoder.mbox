+static const int off_1536[56] = {
+    0, 4, 8, 12, 16, 20, 24, 28, 32, 36, 40, 44,
+    52, 60, 68, 76, 84, 92, 100, 108, 116, 124, 136, 148,
+    160, 172, 188, 204, 220, 240, 260, 284, 308, 336, 364, 396,
+    432, 468, 508, 552, 600, 652, 704, 768, 832, 896, 960, 1024,
+    1088, 1152, 1216, 1280, 1344, 1408, 1472, 1536,
+};
+
+static const int off_1920[62] = {
+    0, 4, 8, 12, 16, 20, 24, 28, 32, 36, 40, 44,
+    52, 60, 68, 76, 84, 92, 100, 108, 116, 124, 136, 148,
+    160, 172, 188, 204, 220, 240, 260, 284, 308, 336, 364, 396,
+    432, 468, 508, 552, 600, 652, 704, 768, 832, 896, 960, 1024,
+    1088, 1152, 1216, 1280, 1344, 1408, 1472, 1536, 1600, 1664, 1728, 1792,
+    1856, 1920,
+};
+
+static const int off_2048[64] = {
+    0, 4, 8, 12, 16, 20, 24, 28, 32, 36, 40, 44,
+    52, 60, 68, 76, 84, 92, 100, 108, 116, 124, 136, 148,
+    160, 172, 188, 204, 220, 240, 260, 284, 308, 336, 364, 396,
+    432, 468, 508, 552, 600, 652, 704, 768, 832, 896, 960, 1024,
+    1088, 1152, 1216, 1280, 1344, 1408, 1472, 1536, 1600, 1664, 1728, 1792,
+    1856, 1920, 1984, 2048,
+};
+
+int ac4_sfb_nbands48(int length) {
+    switch (length) {
+    case 96: return 12;
+    case 120: return 14;
+    case 128: return 14;
+    case 192: return 18;
+    case 240: return 20;
+    case 256: return 20;
+    case 384: return 33;
+    case 480: return 36;
+    case 512: return 36;
+    case 768: return 43;
+    case 960: return 49;
+    case 1024: return 49;
+    case 1536: return 55;
+    case 1920: return 61;
+    case 2048: return 63;
+    default: return 0;
+    }
+}
+
+const int *ac4_sfb_offsets48(int length) {
+    switch (length) {
+    case 96: return off_96;
+    case 120: return off_120;
+    case 128: return off_128;
+    case 192: return off_192;
+    case 240: return off_240;
+    case 256: return off_256;
+    case 384: return off_384;
+    case 480: return off_480;
+    case 512: return off_512;
+    case 768: return off_768;
+    case 960: return off_960;
+    case 1024: return off_1024;
+    case 1536: return off_1536;
+    case 1920: return off_1920;
+    case 2048: return off_2048;
+    default: return NULL;
+    }
+}
