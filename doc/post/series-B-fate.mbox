diff --git a/tests/fate/ac4.mak b/tests/fate/ac4.mak
new file mode 100644
index 0000000..f9414fd
--- /dev/null
+++ b/tests/fate/ac4.mak
@@ -0,0 +1,116 @@
+# AC-4 decoder and demux FATE tests.
+#
+# Inputs live in the fate-suite under ac4/ (see the [samples-request]
+# AC-4 decoder mail for the 12-file set); pcm REF files are suite
+# files too, while framemd5/framecrc goldens live in tests/ref/fate/.
+# The Series A decoder is experimental, so every decode CMD carries
+# -strict -2 (fate/acodec.mak DCA precedent).
+
+# --- decode (pcm): stereo, byte-exact pcm vs suite ref ---
+FATE_AC4 += fate-ac4-stereo
+fate-ac4-stereo: CMD = pcm -strict -2 -i $(TARGET_SAMPLES)/ac4/clip-stereo.ac4
+fate-ac4-stereo: REF = $(SAMPLES)/ac4/clip-stereo-ref.pcm
+# clip-stereo.ac4: 3 packets stereo, middle skipped w/ warning; suite
+# ref 16384 B s16le 48 kHz (2 frames).
+fate-ac4-stereo: CMP = oneoff
+
+# --- decode (pcm): input seek decodes the 2-packet suffix ---
+FATE_AC4 += fate-ac4-seek
+fate-ac4-seek: CMD = pcm -ss 0.05 -strict -2 -i $(TARGET_SAMPLES)/ac4/clip-stereo.ac4
+fate-ac4-seek: REF = $(SAMPLES)/ac4/clip-stereo-seek-0.05.pcm
+# Suite slice ref 8192 B (2nd half of the stereo ref).
+fate-ac4-seek: CMP = oneoff
+
+# --- decode (framemd5): 5.1 real clip ---
+FATE_AC4_MD5 += fate-ac4-51
+fate-ac4-51: CMD = framemd5 -strict -2 -i $(TARGET_SAMPLES)/ac4/clip-51-real.ac4
+# clip-51-real.ac4: 5.1 beds; golden pins saturated S16 bytes as-is
+# (middle packet skipped w/ warning, 2 survivors).
+
+# --- decode (framemd5): immersive clip, presentation 1 (stereo) ---
+FATE_AC4_MD5 += fate-ac4-ims120
+fate-ac4-ims120: CMD = framemd5 -strict -2 -pres_sel 1 -i $(TARGET_SAMPLES)/ac4/clip-ims120.ac4
+# clip-ims120.ac4: cm120 immersive (BSD-3 Chromium test file). Default
+# pres hits a v1-fatal mid-stream config change at packet 17 (clip
+# carries a distinct 16-packet region); pres 1 skips that region with
+# warnings and decodes 41 stereo frames (exit 0). Golden pins pres 1.
+
+# --- decode (framemd5): 7.1 clip, 8ch presented ---
+FATE_AC4_MD5 += fate-ac4-714
+fate-ac4-714: CMD = framemd5 -strict -2 -i $(TARGET_SAMPLES)/ac4/clip-714.ac4
+# clip-714.ac4: cm253 7.1 excerpt (broadcast capture, suite-accepted);
+# 51200 Hz clip reality, 3 frames, no skips.
+
+# --- decode (framemd5): stereo program in a 5.1 bed ---
+FATE_AC4_MD5 += fate-ac4-stereo51
+fate-ac4-stereo51: CMD = framemd5 -strict -2 -i $(TARGET_SAMPLES)/ac4/clip-stereo51.ac4
+# L/R content + 4 digital-silent channels; golden pins c2-c5 exact-zero
+# (middle packet skipped w/ warning, 2 survivors).
+
+# --- decode (framemd5): impulse pins the codec delay ---
+FATE_AC4_MD5 += fate-ac4-delay
+fate-ac4-delay: CMD = framemd5 -strict -2 -i $(TARGET_SAMPLES)/ac4/clip-impulse.ac4
+# Golden is post-trim bytes; any delay change shifts bytes and fails
+# (middle packet skipped w/ warning, 5 survivors).
+
+# --- decode (framemd5): corrupt packet skipped, survivors decode ---
+FATE_AC4_MD5 += fate-ac4-crc-bad
+fate-ac4-crc-bad: CMD = framemd5 -strict -2 -i $(TARGET_SAMPLES)/ac4/clip-crc-bad.ac4
+# Bad packet skipped with warning, 2 survivors decode (exit 0); bytes
+# equal the stereo decode (wrap performs no CRC check: AC40 re-frame).
+# Decode-phase only: the demuxer passes corrupt payloads through.
+FATE_AC4_MD5 += fate-ac4-crc-bad-note
+fate-ac4-crc-bad-note: CMD = framemd5 -strict -2 -i $(TARGET_SAMPLES)/ac4/clip-crc-bad.ac4
+fate-ac4-crc-bad-note: CMP = grep
+fate-ac4-crc-bad-note: REF = skipping bad packet
+# Stderr companion: asserts the skip warning (astc.mak grep idiom). The
+# same warning fires on the clean stereo clip (no CRC check); the test
+# pins the skip, not a reject count.
+
+# --- decode (framemd5+grep): truncated input fails loudly ---
+FATE_AC4_MD5 += fate-ac4-gap-trunc
+fate-ac4-gap-trunc: CMD = framemd5 -strict -2 -i $(TARGET_SAMPLES)/ac4/clip-gap-fail.ac4 ; test $$? -ne 0
+fate-ac4-gap-trunc: CMP = grep
+fate-ac4-gap-trunc: REF = no-sync
+# clip-gap-fail.ac4: 500 B truncated mid-frame; nonzero exit, no-sync
+# diagnostic, no output. Must never silent-pass.
+
+# --- demux: copy roundtrips, framecrc CMP (muxer rewrites file bytes) ---
+FATE_AC4_REMUX += fate-ac4-copy-stereo
+fate-ac4-copy-stereo: CMD = framecrc -i $(TARGET_SAMPLES)/ac4/clip-stereo.ac4 -c copy
+# Compares framecrc, never file bytes: the muxer rewrites framing.
+FATE_AC4_REMUX += fate-ac4-copy-51
+fate-ac4-copy-51: CMD = framecrc -i $(TARGET_SAMPLES)/ac4/clip-51-real.ac4 -c copy
+# Same framecrc-not-file-bytes rule as copy-stereo.
+
+# --- demux: past-EOF seek clamps to the last packet ---
+FATE_AC4_REMUX += fate-ac4-seek-eof
+fate-ac4-seek-eof: CMD = framecrc -ss 5 -i $(TARGET_SAMPLES)/ac4/clip-stereo.ac4 -c copy
+# Emits the last packet, exit 0; golden is never empty.
+
+# --- demux: garbage input yields no stream (negative slot) ---
+FATE_AC4_REMUX += fate-ac4-probe-garbage
+fate-ac4-probe-garbage: CMD = framecrc -i $(TARGET_SAMPLES)/ac4/garbage.ac4 -c copy ; test $$? -eq 234
+fate-ac4-probe-garbage: CMP = grep
+fate-ac4-probe-garbage: REF = Output file does not contain any stream
+# 1 KiB noise probes by extension; exit 234 (EINVAL) + pinned message.
+
+FATE_AC4-$(call PCM, AC4, AC4, ARESAMPLE_FILTER) += $(FATE_AC4)
+FATE_AC4_MD5-$(call FRAMEMD5, AC4, AC4, ARESAMPLE_FILTER) += $(FATE_AC4_MD5)
+FATE_AC4_REMUX-$(call REMUX, AC4) += $(FATE_AC4_REMUX)
+# Three split gates (PCM / FRAMEMD5 / REMUX) so --disable-everything
+# runs pull only the deps each group needs. REMUX needs no decoder.
+
+# --- deferred slots (comment-only; no sample bytes exist) ---
+# fate-ac4-mono: needs ac4/clip-mono.ac4 + suite ref. No public mono
+#   AC-4 exists anywhere; add the stanza once a sample is proposed.
+# fate-ac4-gap-fails: needs ac4/clip-51-acpl4.ac4 (codec-4 5.1 stub).
+#   No public codec-4 bytes exist; pins deterministic-silence bytes
+#   via framemd5 once they do.
+# fate-ac4-delay-1536: needs a 1536-spf impulse ref (does not exist).
+# fate-ac4-float: needs float-stage plumbing; no quantized-float
+#   golden is ever pinned before then.
+
+FATE_SAMPLES_AVCONV += $(FATE_AC4-yes) $(FATE_AC4_MD5-yes) $(FATE_AC4_REMUX-yes)
+
+fate-ac4: $(FATE_AC4-yes) $(FATE_AC4_MD5-yes) $(FATE_AC4_REMUX-yes)
